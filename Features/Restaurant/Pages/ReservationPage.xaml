<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:POS_in_NET.Views"
             x:Class="POS_in_NET.Pages.ReservationPage"
             Title="Reservation"
             BackgroundColor="#F6F8FB">
    <Grid RowDefinitions="Auto,*">
        <views:TopBar x:Name="TopBar" Grid.Row="0" />

        <Grid Grid.Row="1"
              Padding="24"
              ColumnDefinitions="420,*"
              RowDefinitions="Auto,*"
              ColumnSpacing="22"
              RowSpacing="18">

        <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="*,*,Auto" ColumnSpacing="14">
            <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" Padding="20" StrokeShape="RoundRectangle 14">
                <Border.Shadow>
                    <Shadow Brush="#CBD5E1" Radius="10" Opacity="0.08" Offset="0,2" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="4">
                    <Label Text="Bookings Today" FontSize="12" FontAttributes="Bold" TextColor="#64748B" />
                    <Label Text="{Binding TodayCountText}" FontSize="24" FontAttributes="Bold" TextColor="#0F172A" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" Padding="20" StrokeShape="RoundRectangle 14">
                <Border.Shadow>
                    <Shadow Brush="#CBD5E1" Radius="10" Opacity="0.08" Offset="0,2" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="4">
                    <Label Text="People Today" FontSize="12" FontAttributes="Bold" TextColor="#64748B" />
                    <Label Text="{Binding GuestCountText}" FontSize="24" FontAttributes="Bold" TextColor="#0F766E" />
                </VerticalStackLayout>
            </Border>
            <HorizontalStackLayout Grid.Column="2" Spacing="12" VerticalOptions="Center">
                <Button Text="Update"
                        BackgroundColor="#EEF2FF"
                        TextColor="#3730A3"
                        FontAttributes="Bold"
                        FontSize="18"
                        CornerRadius="12"
                        HeightRequest="62"
                        WidthRequest="130"
                        Clicked="OnUpdateClicked" />
                <Button Text="+ New"
                        BackgroundColor="#2563EB"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="18"
                        CornerRadius="12"
                        HeightRequest="62"
                        WidthRequest="130"
                        Clicked="OnNewReservationClicked" />
            </HorizontalStackLayout>
        </Grid>

        <Border Grid.Row="1"
                Grid.Column="0"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                Padding="18"
                StrokeShape="RoundRectangle 18">
            <Border.Shadow>
                <Shadow Brush="#CBD5E1" Radius="12" Opacity="0.08" Offset="0,2" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="16">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Button Text="‹"
                            WidthRequest="42"
                            HeightRequest="38"
                            BackgroundColor="#F1F5F9"
                            TextColor="#0F172A"
                            CornerRadius="10"
                            Clicked="OnPreviousMonthClicked" />
                    <Label Grid.Column="1"
                           Text="{Binding CalendarMonthText}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#0F172A"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                    <Button Grid.Column="2"
                            Text="›"
                            WidthRequest="42"
                            HeightRequest="38"
                            BackgroundColor="#F1F5F9"
                            TextColor="#0F172A"
                            CornerRadius="10"
                            Clicked="OnNextMonthClicked" />
                </Grid>

                <Grid ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="4">
                    <Label Text="Mon" FontSize="12" FontAttributes="Bold" TextColor="#64748B" HorizontalTextAlignment="Center" />
                    <Label Grid.Column="1" Text="Tue" FontSize="12" FontAttributes="Bold" TextColor="#64748B" HorizontalTextAlignment="Center" />
                    <Label Grid.Column="2" Text="Wed" FontSize="12" FontAttributes="Bold" TextColor="#64748B" HorizontalTextAlignment="Center" />
                    <Label Grid.Column="3" Text="Thu" FontSize="12" FontAttributes="Bold" TextColor="#64748B" HorizontalTextAlignment="Center" />
                    <Label Grid.Column="4" Text="Fri" FontSize="12" FontAttributes="Bold" TextColor="#64748B" HorizontalTextAlignment="Center" />
                    <Label Grid.Column="5" Text="Sat" FontSize="12" FontAttributes="Bold" TextColor="#64748B" HorizontalTextAlignment="Center" />
                    <Label Grid.Column="6" Text="Sun" FontSize="12" FontAttributes="Bold" TextColor="#64748B" HorizontalTextAlignment="Center" />
                </Grid>

                <CollectionView x:Name="CalendarCollectionView"
                                ItemsSource="{Binding CalendarDays}"
                                SelectionMode="Single"
                                SelectionChanged="OnCalendarDaySelected"
                                HeightRequest="430">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="7" HorizontalItemSpacing="4" VerticalItemSpacing="4" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{Binding BackgroundColor}"
                                    Stroke="{Binding BorderColor}"
                                    StrokeThickness="1"
                                    Padding="6"
                                    HeightRequest="66"
                                    StrokeShape="RoundRectangle 10">
                                <Grid RowDefinitions="Auto,*,Auto">
                                    <Label Text="{Binding DayText}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{Binding TextColor}"
                                           HorizontalTextAlignment="Center" />
                                    <Label Grid.Row="2"
                                           Text="{Binding CountText}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{Binding CountColor}"
                                           HorizontalTextAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="14">
            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    Padding="16"
                    StrokeShape="RoundRectangle 18">
                <Border.Shadow>
                    <Shadow Brush="#CBD5E1" Radius="12" Opacity="0.08" Offset="0,2" />
                </Border.Shadow>
                <Grid>
                    <Border BackgroundColor="#F8FAFC"
                            Stroke="#CBD5E1"
                            StrokeThickness="1"
                            Padding="12,8"
                            StrokeShape="RoundRectangle 10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSearchBoxTapped" />
                        </Border.GestureRecognizers>
                        <Entry x:Name="SearchEntry"
                               Placeholder="Search name or phone"
                               BackgroundColor="Transparent"
                               TextColor="#0F172A"
                               PlaceholderColor="#94A3B8"
                               FontSize="14"
                               Keyboard="Text"
                               TextChanged="OnSearchTextChanged" />
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    Padding="0"
                    StrokeShape="RoundRectangle 18">
                <Border.Shadow>
                    <Shadow Brush="#CBD5E1" Radius="12" Opacity="0.08" Offset="0,2" />
                </Border.Shadow>
                <Grid RowDefinitions="Auto,*">
                    <Grid Padding="18,16"
                          ColumnDefinitions="110,*,150,110,110,130"
                          ColumnSpacing="12"
                          BackgroundColor="#F8FAFC">
                        <Label Text="Time" FontSize="12" FontAttributes="Bold" TextColor="#475569" />
                        <Label Grid.Column="1" Text="Name" FontSize="12" FontAttributes="Bold" TextColor="#475569" />
                        <Label Grid.Column="2" Text="Phone" FontSize="12" FontAttributes="Bold" TextColor="#475569" />
                        <Label Grid.Column="3" Text="Guests" FontSize="12" FontAttributes="Bold" TextColor="#475569" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="4" Text="Table" FontSize="12" FontAttributes="Bold" TextColor="#475569" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="5" Text="Status" FontSize="12" FontAttributes="Bold" TextColor="#475569" HorizontalTextAlignment="Center" />
                    </Grid>

                    <CollectionView Grid.Row="1"
                                    ItemsSource="{Binding Reservations}"
                                    SelectionMode="None"
                                    ItemSizingStrategy="MeasureAllItems">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="40" Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="No reservations for this date"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#0F172A"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="Website reservations will appear here when synced."
                                       FontSize="14"
                                       TextColor="#64748B"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="18,14"
                                      ColumnDefinitions="110,*,150,110,110,130"
                                      ColumnSpacing="12"
                                      RowDefinitions="Auto,Auto">
                                    <Label Text="{Binding TimeText}" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" />
                                        <Label Text="{Binding Note}" FontSize="12" TextColor="#64748B" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding Phone}" FontSize="14" TextColor="#334155" VerticalOptions="Center" />
                                    <Label Grid.Column="3" Text="{Binding Guests}" FontSize="15" FontAttributes="Bold" TextColor="#0F766E" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                    <Label Grid.Column="4" Text="{Binding Table}" FontSize="15" FontAttributes="Bold" TextColor="#1D4ED8" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                    <Border Grid.Column="5"
                                            BackgroundColor="{Binding StatusBackground}"
                                            Stroke="{Binding StatusBorder}"
                                            StrokeThickness="1"
                                            Padding="10,6"
                                            StrokeShape="RoundRectangle 10"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding Status}" FontSize="12" FontAttributes="Bold" TextColor="{Binding StatusTextColor}" HorizontalTextAlignment="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</ContentPage>

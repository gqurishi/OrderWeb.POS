<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_in_NET.Views.AddTableDialog"
             BackgroundColor="{StaticResource DialogOverlayColor}"
             VerticalOptions="Fill"
             HorizontalOptions="Fill">
    
    <Grid VerticalOptions="Fill" 
          HorizontalOptions="Fill"
          Padding="24,12">
        <Border BackgroundColor="White"
                Stroke="{StaticResource DialogShellStrokeColor}"
                StrokeThickness="1"
                Padding="0"
                WidthRequest="520"
                MaximumWidthRequest="560"
                MaximumHeightRequest="560"
                VerticalOptions="Center"
                HorizontalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#0F172A" Opacity="0.16" Radius="20" Offset="0,8"/>
            </Border.Shadow>
            <Grid RowDefinitions="Auto,*"
                  RowSpacing="18"
                  Padding="28">
                
                <!-- Title -->
                <Label Text="Add New Table"
                       Grid.Row="0"
                       FontSize="24"
                       FontFamily="OpenSansSemibold"
                       FontAttributes="Bold"
                       TextColor="#1F2937"
                       HorizontalOptions="Center" />

                <ScrollView Grid.Row="1"
                            VerticalScrollBarVisibility="Always">
                    <VerticalStackLayout Spacing="20"
                                         Padding="0,0,4,0">
                        
                        <!-- Floor Selection -->
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Select Floor"
                                   FontSize="14"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="#374151"
                                   HorizontalOptions="Start" />
                            
                            <!-- Custom Floor Selection Cards -->
                            <ScrollView MaximumHeightRequest="170"
                                       VerticalScrollBarVisibility="Always">
                                <VerticalStackLayout x:Name="FloorSelectionStack"
                                                   Spacing="8">
                                    <!-- Floor cards will be added dynamically -->
                                </VerticalStackLayout>
                            </ScrollView>
                        </VerticalStackLayout>
                        
                        <!-- Table Number Input -->
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Table Number"
                                   FontSize="14"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="#374151"
                                   HorizontalOptions="Start" />
                            
                            <Border BackgroundColor="#F9FAFB"
                                    Stroke="#E5E7EB"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="14">
                                <Entry x:Name="TableNumberEntry"
                                       FontSize="16"
                                       FontFamily="OpenSansRegular"
                                       TextColor="#1F2937"
                                       PlaceholderColor="#9CA3AF"
                                       Placeholder="e.g., Table 1, T1, 10"
                                       BackgroundColor="Transparent"
                                       HeightRequest="40" />
                            </Border>
                        </VerticalStackLayout>
                        
                        <!-- Table Design Selection -->
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Table Design"
                                   FontSize="14"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="#374151"
                                   HorizontalOptions="Start" />
                            
                            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                                <!-- Design 1 -->
                                <Border x:Name="Design1Border"
                                        BackgroundColor="#F0F9FF"
                                        Stroke="#3B82F6"
                                        StrokeThickness="3"
                                        Padding="10"
                                        WidthRequest="72"
                                        HeightRequest="72">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDesign1Clicked" />
                                    </Border.GestureRecognizers>
                                    <Image Source="table_1.png"
                                           WidthRequest="48"
                                           HeightRequest="48"
                                           Aspect="AspectFit" />
                                </Border>
                                
                                <!-- Design 2 -->
                                <Border x:Name="Design2Border"
                                        BackgroundColor="White"
                                        Stroke="#E5E7EB"
                                        StrokeThickness="2"
                                        Padding="10"
                                        WidthRequest="72"
                                        HeightRequest="72">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDesign2Clicked" />
                                    </Border.GestureRecognizers>
                                    <Image Source="table_2.png"
                                           WidthRequest="48"
                                           HeightRequest="48"
                                           Aspect="AspectFit" />
                                </Border>
                                
                                <!-- Design 3 -->
                                <Border x:Name="Design3Border"
                                        BackgroundColor="White"
                                        Stroke="#E5E7EB"
                                        StrokeThickness="2"
                                        Padding="10"
                                        WidthRequest="72"
                                        HeightRequest="72">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDesign3Clicked" />
                                    </Border.GestureRecognizers>
                                    <Image Source="table_3.png"
                                           WidthRequest="48"
                                           HeightRequest="48"
                                           Aspect="AspectFit" />
                                </Border>
                                
                                <!-- Design 4 -->
                                <Border x:Name="Design4Border"
                                        BackgroundColor="White"
                                        Stroke="#E5E7EB"
                                        StrokeThickness="2"
                                        Padding="10"
                                        WidthRequest="72"
                                        HeightRequest="72">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDesign4Clicked" />
                                    </Border.GestureRecognizers>
                                    <Image Source="table_4.png"
                                           WidthRequest="48"
                                           HeightRequest="48"
                                           Aspect="AspectFit" />
                                </Border>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                        
                        <!-- Buttons -->
                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="12"
                              Margin="0,4,0,0">
                            <Button Grid.Column="0"
                                    x:Name="CancelButton"
                                    Text="Cancel"
                                    BackgroundColor="#F3F4F6"
                                    TextColor="#6B7280"
                                    FontFamily="OpenSansSemibold"
                                    CornerRadius="12"
                                    HeightRequest="48"
                                    FontSize="15"
                                    Clicked="OnCancelClicked" />
                            
                            <Button Grid.Column="1"
                                    x:Name="CreateButton"
                                    Text="Create Table"
                                    BackgroundColor="#3B82F6"
                                    TextColor="White"
                                    FontFamily="OpenSansSemibold"
                                    CornerRadius="12"
                                    HeightRequest="48"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    Clicked="OnCreateClicked" />
                        </Grid>
                        
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Border>
    </Grid>
    
</ContentView>

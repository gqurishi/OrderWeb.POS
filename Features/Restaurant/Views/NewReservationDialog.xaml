<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_in_NET.Views.NewReservationDialog"
             BackgroundColor="{StaticResource DialogOverlayColor}"
             VerticalOptions="Fill"
             HorizontalOptions="Fill">

    <Grid VerticalOptions="Center"
          HorizontalOptions="Center"
          Padding="32">
        <Border BackgroundColor="White"
                Stroke="{StaticResource DialogShellStrokeColor}"
                StrokeThickness="1"
                Padding="28"
                WidthRequest="620"
                VerticalOptions="Center"
                HorizontalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="18"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#0F172A" Opacity="0.14" Radius="18" Offset="0,6"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="16">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="New Reservation"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#0F172A"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            Text="✕"
                            WidthRequest="40"
                            HeightRequest="40"
                            CornerRadius="20"
                            BackgroundColor="#FEE2E2"
                            TextColor="#DC2626"
                            FontSize="18"
                            Padding="0"
                            Clicked="OnCancelClicked" />
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="14" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="6">
                        <Label Text="Date" FontSize="13" FontAttributes="Bold" TextColor="#475569" />
                        <DatePicker x:Name="DatePickerControl" FontSize="16" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6">
                        <Label Text="Time" FontSize="13" FontAttributes="Bold" TextColor="#475569" />
                        <TimePicker x:Name="TimePickerControl" FontSize="16" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="6">
                        <Label Text="Covers" FontSize="13" FontAttributes="Bold" TextColor="#475569" />
                        <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeShape="RoundRectangle 10" Padding="12,4">
                            <Entry x:Name="CoversEntry" Keyboard="Numeric" Text="2" FontSize="16" BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="6">
                        <Label Text="Table (optional)" FontSize="13" FontAttributes="Bold" TextColor="#475569" />
                        <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeShape="RoundRectangle 10" Padding="12,4">
                            <Entry x:Name="TableEntry" Placeholder="e.g. T4" FontSize="16" BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="6">
                        <Label Text="Customer name" FontSize="13" FontAttributes="Bold" TextColor="#475569" />
                        <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeShape="RoundRectangle 10" Padding="12,4">
                            <Entry x:Name="NameEntry" Placeholder="Guest name" FontSize="16" BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="3" Grid.ColumnSpan="2" Spacing="6">
                        <Label Text="Phone" FontSize="13" FontAttributes="Bold" TextColor="#475569" />
                        <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeShape="RoundRectangle 10" Padding="12,4">
                            <Entry x:Name="PhoneEntry" Keyboard="Telephone" Placeholder="07..." FontSize="16" BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="4" Grid.ColumnSpan="2" Spacing="6">
                        <Label Text="Notes / allergies" FontSize="13" FontAttributes="Bold" TextColor="#475569" />
                        <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeShape="RoundRectangle 10" Padding="12,4">
                            <Editor x:Name="NotesEditor" AutoSize="TextChanges" MinimumHeightRequest="72" FontSize="15" BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="5" Grid.ColumnSpan="2" Spacing="6">
                        <Label Text="Source" FontSize="13" FontAttributes="Bold" TextColor="#475569" />
                        <HorizontalStackLayout Spacing="10">
                            <Button x:Name="WalkInButton" Text="Walk-in" Clicked="OnWalkInClicked"
                                    BackgroundColor="#2563EB" TextColor="White" CornerRadius="10" HeightRequest="42" />
                            <Button x:Name="PhoneButton" Text="Phone" Clicked="OnPhoneClicked"
                                    BackgroundColor="#E2E8F0" TextColor="#334155" CornerRadius="10" HeightRequest="42" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                    <Button Grid.Column="0"
                            Text="Cancel"
                            BackgroundColor="#F1F5F9"
                            TextColor="#64748B"
                            CornerRadius="12"
                            HeightRequest="48"
                            Clicked="OnCancelClicked" />
                    <Button Grid.Column="1"
                            Text="Save Booking"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="48"
                            Clicked="OnSaveClicked" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>

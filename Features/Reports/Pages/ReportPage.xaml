<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                      xmlns:views="clr-namespace:POS_in_NET.Views"
                      xmlns:dataGrid="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
                      xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
                      x:Class="POS_in_NET.Pages.ReportPage"
                      Title="Reports"
                                                                             BackgroundColor="#F8F9FA">

       <ContentPage.Resources>
              <ResourceDictionary>
                     <Style x:Key="FilterChipButtonStyle" TargetType="Button">
                            <Setter Property="BackgroundColor" Value="#E2E8F0" />
                            <Setter Property="TextColor" Value="#0F172A" />
                            <Setter Property="CornerRadius" Value="12" />
                            <Setter Property="Padding" Value="16,10" />
                            <Setter Property="FontFamily" Value="OpenSansSemibold" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="BorderColor" Value="#D8E1EC" />
                            <Setter Property="BorderWidth" Value="1" />
                     </Style>

                     <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
                            <Setter Property="BackgroundColor" Value="#0284C7" />
                            <Setter Property="TextColor" Value="White" />
                            <Setter Property="CornerRadius" Value="12" />
                            <Setter Property="Padding" Value="16,10" />
                            <Setter Property="FontFamily" Value="OpenSansSemibold" />
                            <Setter Property="FontSize" Value="12" />
                     </Style>

                     <Style x:Key="ExportGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource FilterChipButtonStyle}">
                            <Setter Property="Padding" Value="12,9" />
                     </Style>
              </ResourceDictionary>
       </ContentPage.Resources>

       <Grid>
              <Grid RowDefinitions="Auto,*"
                    Padding="0"
                    RowSpacing="0">

              <views:TopBar x:Name="TopBar" Grid.Row="0" />

              <ScrollView Grid.Row="1"
                          Orientation="Both"
                          VerticalScrollBarVisibility="Always">
                     <VerticalStackLayout Spacing="0"
                                          Padding="0,0,0,20">

              <Border Grid.Row="1"
                            Margin="20,14,20,0"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            BackgroundColor="#FFFFFF"
                            StrokeShape="RoundRectangle 20"
                            Padding="16">
                     <VerticalStackLayout Spacing="10">
                            <VerticalStackLayout>
                                   <Label Text="Date Range"
                                          FontFamily="OpenSansSemibold"
                                          FontSize="13"
                                          TextColor="#0F172A" />
                                   <Label Text="{Binding LastUpdatedText}"
                                          FontFamily="OpenSansRegular"
                                          FontSize="12"
                                          TextColor="#64748B" />
                            </VerticalStackLayout>

                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="8" RowSpacing="8">
                                   <Button x:Name="TodayPresetButton" Grid.Row="0" Text="Today" Clicked="OnPresetClicked" Style="{StaticResource FilterChipButtonStyle}" Padding="16,12" />
                                   <Button x:Name="SevenDaysPresetButton" Grid.Row="0" Grid.Column="1" Text="7 Days" Clicked="OnPresetClicked" Style="{StaticResource FilterChipButtonStyle}" Padding="16,12" />
                                   <Button x:Name="ThirtyDaysPresetButton" Grid.Row="0" Grid.Column="2" Text="30 Days" Clicked="OnPresetClicked" Style="{StaticResource FilterChipButtonStyle}" Padding="16,12" />
                                   <Button x:Name="CustomPresetButton" Grid.Row="0" Grid.Column="3" Text="Custom" Clicked="OnPresetClicked" Style="{StaticResource FilterChipButtonStyle}" Padding="16,12" />
                                   <Button x:Name="TopSellItemButton" Grid.Row="0" Grid.Column="4" Text="Top Sell Item" Clicked="OnPresetClicked" Style="{StaticResource FilterChipButtonStyle}" Padding="16,12" />
                                   <Button x:Name="CashDrawerButton" Grid.Row="0" Grid.Column="5" Text="Cash Drawer" Clicked="OnPresetClicked" Style="{StaticResource FilterChipButtonStyle}" Padding="16,12" />
                                   <Button x:Name="DiscountAuditButton" Grid.Row="0" Grid.Column="6" Text="Discount Audit" Clicked="OnPresetClicked" Style="{StaticResource FilterChipButtonStyle}" Padding="16,12" />
                                   <Button x:Name="StaffHoursButton" Grid.Row="1" Grid.ColumnSpan="2" Text="Staff Hours" Clicked="OnPresetClicked" Style="{StaticResource FilterChipButtonStyle}" Padding="16,12" />
                                   <Button x:Name="VoidCancelledButton" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Text="Void / Cancelled" Clicked="OnPresetClicked" Style="{StaticResource FilterChipButtonStyle}" Padding="16,12" />
                                   <Button x:Name="HistoricalReportsButton" Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2" Text="Historical Reports" Clicked="OnPresetClicked" Style="{StaticResource FilterChipButtonStyle}" Padding="16,12" />
                            </Grid>

                            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="12" IsVisible="{Binding IsCustomRangeVisible, FallbackValue=False}" RowSpacing="8">
                                   <VerticalStackLayout>
                                          <Label Text="Start Date" FontFamily="OpenSansSemibold" FontSize="11" TextColor="#0F172A" Margin="0,0,0,6" />
                                          <Border BackgroundColor="#FFFFFF" Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                                                 <Button x:Name="StartDateButton"
                                                         Text="{Binding StartDateDisplay}"
                                                         Clicked="OnStartDateClicked"
                                                         BackgroundColor="Transparent"
                                                         TextColor="#0F172A"
                                                         FontFamily="OpenSansRegular"
                                                         FontSize="13"
                                                         CornerRadius="8"
                                                         Padding="12,8"
                                                         HorizontalOptions="FillAndExpand"
                                                         VerticalOptions="Center"
                                                         Margin="0" />
                                          </Border>
                                   </VerticalStackLayout>
                                   <VerticalStackLayout Grid.Column="1">
                                          <Label Text="End Date" FontFamily="OpenSansSemibold" FontSize="11" TextColor="#0F172A" Margin="0,0,0,6" />
                                          <Border BackgroundColor="#FFFFFF" Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                                                 <Button x:Name="EndDateButton"
                                                         Text="{Binding EndDateDisplay}"
                                                         Clicked="OnEndDateClicked"
                                                         BackgroundColor="Transparent"
                                                         TextColor="#0F172A"
                                                         FontFamily="OpenSansRegular"
                                                         FontSize="13"
                                                         CornerRadius="8"
                                                         Padding="12,8"
                                                         HorizontalOptions="FillAndExpand"
                                                         VerticalOptions="Center"
                                                         Margin="0" />
                                          </Border>
                                   </VerticalStackLayout>
                                   <VerticalStackLayout Grid.Column="2">
                                          <Label Text=" " FontFamily="OpenSansSemibold" FontSize="11" TextColor="#0F172A" Margin="0,0,0,6" />
                                          <Button Text="Submit"
                                                  Clicked="OnSubmitCustomRangeClicked"
                                                  IsEnabled="{Binding CanSubmitCustomRange}"
                                                  BackgroundColor="#0284C7"
                                                  TextColor="White"
                                                  CornerRadius="8"
                                                  Padding="18,10"
                                                  HeightRequest="40"
                                                  FontFamily="OpenSansSemibold"
                                                  VerticalOptions="Center" />
                                   </VerticalStackLayout>
                            </Grid>

                            <Label Text="Choose a range to refresh KPI and order results"
                                   FontFamily="OpenSansRegular"
                                   FontSize="11"
                                   TextColor="#94A3B8" />
                     </VerticalStackLayout>
              </Border>

              <Border Margin="20,10,20,0"
                      IsVisible="{Binding IsOrderWebUploadBannerVisible}"
                      Stroke="#99F6E4"
                      StrokeThickness="1"
                      BackgroundColor="#F0FDFA"
                      StrokeShape="RoundRectangle 16"
                      Padding="14">
                     <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                   <Label Text="OrderWeb Daily Upload"
                                          FontFamily="OpenSansSemibold"
                                          FontSize="14"
                                          TextColor="#0F766E" />
                                   <Label Text="{Binding OrderWebUploadBannerText}"
                                          FontFamily="OpenSansRegular"
                                          FontSize="12"
                                          TextColor="#115E59"
                                          LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="Upload to OrderWeb"
                                    CommandParameter="Upload to OrderWeb"
                                    Clicked="OnUploadOrderWebReportClicked"
                                    IsEnabled="{Binding CanUploadOrderWebReport}"
                                    BackgroundColor="#0F766E"
                                    TextColor="White"
                                    FontFamily="OpenSansSemibold"
                                    CornerRadius="10"
                                    Padding="16,10"
                                    VerticalOptions="Center" />
                     </Grid>
              </Border>

              <Border Grid.Row="2"
                            IsVisible="{Binding IsOrdersReportVisible}"
                            Margin="20,14,20,0"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            BackgroundColor="#FFFFFF"
                            StrokeShape="RoundRectangle 20"
                            Padding="16">
                     <VerticalStackLayout Spacing="14">
                            <VerticalStackLayout Spacing="4">
                                   <Label Text="Sales Summary"
                                          FontFamily="AlegreyaBold"
                                          FontSize="28"
                                          TextColor="#0F172A" />
                                   <Label Text="Order totals for the selected report period."
                                          FontFamily="OpenSansRegular"
                                          FontSize="12"
                                          TextColor="#64748B" />
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="10">
                                   <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 14" Padding="12">
                                          <VerticalStackLayout Spacing="4">
                                                 <Label Text="Orders" FontFamily="OpenSansSemibold" FontSize="11" TextColor="#64748B" />
                                                 <Label Text="{Binding SummaryOrdersText}" FontFamily="AlegreyaBold" FontSize="20" TextColor="{Binding SummaryOrdersColor}" />
                                          </VerticalStackLayout>
                                   </Border>
                                   <Border Grid.Column="1" Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 14" Padding="12">
                                          <VerticalStackLayout Spacing="4">
                                                 <Label Text="Gross" FontFamily="OpenSansSemibold" FontSize="11" TextColor="#64748B" />
                                                 <Label Text="{Binding SummaryGrossText}" FontFamily="AlegreyaBold" FontSize="20" TextColor="{Binding SummaryGrossColor}" />
                                          </VerticalStackLayout>
                                   </Border>
                                   <Border Grid.Column="2" Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 14" Padding="12">
                                          <VerticalStackLayout Spacing="4">
                                                 <Label Text="Net" FontFamily="OpenSansSemibold" FontSize="11" TextColor="#64748B" />
                                                 <Label Text="{Binding SummaryNetText}" FontFamily="AlegreyaBold" FontSize="20" TextColor="{Binding SummaryNetColor}" />
                                          </VerticalStackLayout>
                                   </Border>
                                   <Border Grid.Column="3" Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 14" Padding="12">
                                          <VerticalStackLayout Spacing="4">
                                                 <Label Text="VAT" FontFamily="OpenSansSemibold" FontSize="11" TextColor="#64748B" />
                                                 <Label Text="{Binding SummaryVatText}" FontFamily="AlegreyaBold" FontSize="20" TextColor="{Binding SummaryVatColor}" />
                                          </VerticalStackLayout>
                                   </Border>
                                   <Border Grid.Column="4" Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 14" Padding="12">
                                          <VerticalStackLayout Spacing="4">
                                                 <Label Text="Delivery" FontFamily="OpenSansSemibold" FontSize="11" TextColor="#64748B" />
                                                 <Label Text="{Binding SummaryDeliveryText}" FontFamily="AlegreyaBold" FontSize="20" TextColor="{Binding SummaryDeliveryColor}" />
                                          </VerticalStackLayout>
                                   </Border>
                                   <Border Grid.Column="5" Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 14" Padding="12">
                                          <VerticalStackLayout Spacing="4">
                                                 <Label Text="Avg" FontFamily="OpenSansSemibold" FontSize="11" TextColor="#64748B" />
                                                 <Label Text="{Binding SummaryAverageText}" FontFamily="AlegreyaBold" FontSize="20" TextColor="{Binding SummaryAverageColor}" />
                                          </VerticalStackLayout>
                                   </Border>
                            </Grid>

                            <Border Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    BackgroundColor="#F8FAFC"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="12">
                                   <VerticalStackLayout Spacing="10">
                                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                 <Label Text="Sales trend"
                                                        FontFamily="OpenSansSemibold"
                                                        FontSize="14"
                                                        TextColor="#0F172A" />
                                                 <Label Grid.Column="1"
                                                        Text="{Binding TrendInsightText}"
                                                        FontFamily="OpenSansRegular"
                                                        FontSize="12"
                                                        TextColor="{Binding TrendInsightColor}"
                                                        HorizontalTextAlignment="End"
                                                        LineBreakMode="TailTruncation" />
                                          </Grid>

                                          <chart:SfCartesianChart HeightRequest="210">
                                                 <chart:SfCartesianChart.XAxes>
                                                        <chart:DateTimeAxis x:Name="SalesTrendXAxis"
                                                                            IntervalType="Days"
                                                                            EdgeLabelsDrawingMode="Shift" />
                                                 </chart:SfCartesianChart.XAxes>
                                                 <chart:SfCartesianChart.YAxes>
                                                        <chart:NumericalAxis />
                                                 </chart:SfCartesianChart.YAxes>
                                                 <chart:LineSeries ItemsSource="{Binding DailyTrend}"
                                                                   XBindingPath="BusinessDate"
                                                                   YBindingPath="GrossSales"
                                                                   ShowDataLabels="False"
                                                                   EnableTooltip="True"
                                                                   StrokeWidth="3" />
                                          </chart:SfCartesianChart>
                                   </VerticalStackLayout>
                            </Border>
                     </VerticalStackLayout>
              </Border>

              <Border Grid.Row="3"
                            IsVisible="{Binding IsHistoricalReportsVisible}"
                            Margin="20,14,20,0"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            BackgroundColor="#FFFFFF"
                            StrokeShape="RoundRectangle 20"
                            Padding="16">
                     <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                   <VerticalStackLayout Spacing="4">
                                          <Label Text="Historical Reports"
                                                 FontFamily="AlegreyaBold"
                                                 FontSize="28"
                                                 TextColor="#0F172A" />
                                          <Label Text="Quick access to older snapshots and a selectable report browser for period-over-period comparison."
                                                 FontFamily="OpenSansRegular"
                                                 FontSize="12"
                                                 TextColor="#64748B"
                                                 LineBreakMode="WordWrap" />
                                   </VerticalStackLayout>

                                   <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                          <Button Text="6 Months Ago"
                                                  Clicked="OnLoadSixMonthsAgoClicked"
                                                  Style="{StaticResource FilterChipButtonStyle}" />
                                          <Button Text="1 Year Ago"
                                                  Clicked="OnLoadOneYearAgoClicked"
                                                  Style="{StaticResource FilterChipButtonStyle}" />
                                          <Button Text="Load Browser"
                                                  Clicked="OnLoadHistoricalReportsClicked"
                                                  Style="{StaticResource PrimaryActionButtonStyle}" />
                                   </HorizontalStackLayout>
                            </Grid>

                            <Border Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    BackgroundColor="#F8FAFC"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="12">
                                   <VerticalStackLayout Spacing="8">
                                          <Label Text="Select a snapshot to open it with prior-period and year-ago comparisons."
                                                 FontFamily="OpenSansRegular"
                                                 FontSize="12"
                                                 TextColor="#475569" />
                                          <CollectionView ItemsSource="{Binding HistoricalReports}"
                                                          HeightRequest="180"
                                                          SelectionMode="Single"
                                                          SelectionChanged="OnHistoricalReportSelectionChanged">
                                                 <CollectionView.EmptyView>
                                                        <Label Text="Loading snapshots..."
                                                               FontFamily="OpenSansRegular"
                                                               FontSize="12"
                                                               TextColor="#64748B" />
                                                 </CollectionView.EmptyView>
                                                 <CollectionView.ItemTemplate>
                                                        <DataTemplate>
                                                               <Border Stroke="#CBD5E1"
                                                                       StrokeThickness="1"
                                                                       BackgroundColor="#FFFFFF"
                                                                       StrokeShape="RoundRectangle 12"
                                                                       Padding="12"
                                                                       Margin="0,0,0,8">
                                                                      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                                                             <VerticalStackLayout Spacing="2">
                                                                                    <Label Text="{Binding DisplayName}"
                                                                                           FontFamily="OpenSansSemibold"
                                                                                           FontSize="13"
                                                                                           TextColor="#0F172A" />
                                                                                    <Label Text="{Binding GeneratedAt, StringFormat='Generated {0:dd MMM yyyy HH:mm}'}"
                                                                                           FontFamily="OpenSansRegular"
                                                                                           FontSize="11"
                                                                                           TextColor="#64748B" />
                                                                             </VerticalStackLayout>
                                                                             <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                                                                                    <Label Text="{Binding TotalRevenue, StringFormat='£{0:F2}'}"
                                                                                           FontFamily="OpenSansSemibold"
                                                                                           FontSize="13"
                                                                                           TextColor="#0F172A"
                                                                                           HorizontalTextAlignment="End" />
                                                                                    <Label Text="Tap to compare"
                                                                                           FontFamily="OpenSansRegular"
                                                                                           FontSize="11"
                                                                                           TextColor="#64748B"
                                                                                           HorizontalTextAlignment="End" />
                                                                             </VerticalStackLayout>
                                                                      </Grid>
                                                               </Border>
                                                        </DataTemplate>
                                                 </CollectionView.ItemTemplate>
                                          </CollectionView>
                                   </VerticalStackLayout>
                            </Border>

                            <Border Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    BackgroundColor="#EEF6FF"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="14"
                                    IsVisible="{Binding IsComparisonPanelVisible}">
                                   <VerticalStackLayout Spacing="10">
                                          <Label Text="Historical Comparison"
                                                 FontFamily="OpenSansSemibold"
                                                 FontSize="14"
                                                 TextColor="#0F172A" />
                                          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                 <Border Stroke="#BFDBFE"
                                                         StrokeThickness="1"
                                                         BackgroundColor="#FFFFFF"
                                                         StrokeShape="RoundRectangle 12"
                                                         Padding="12">
                                                        <VerticalStackLayout Spacing="4">
                                                               <Label Text="Prior Period"
                                                                      FontFamily="OpenSansSemibold"
                                                                      FontSize="11"
                                                                      TextColor="#1E3A8A" />
                                                               <Label Text="{Binding ComparisonPriorText}"
                                                                      FontFamily="OpenSansRegular"
                                                                      FontSize="12"
                                                                      TextColor="#0F172A"
                                                                      LineBreakMode="WordWrap" />
                                                        </VerticalStackLayout>
                                                 </Border>

                                                 <Border Grid.Column="1"
                                                         Stroke="#BFDBFE"
                                                         StrokeThickness="1"
                                                         BackgroundColor="#FFFFFF"
                                                         StrokeShape="RoundRectangle 12"
                                                         Padding="12">
                                                        <VerticalStackLayout Spacing="4">
                                                               <Label Text="Year Ago"
                                                                      FontFamily="OpenSansSemibold"
                                                                      FontSize="11"
                                                                      TextColor="#1E3A8A" />
                                                               <Label Text="{Binding ComparisonYearAgoText}"
                                                                      FontFamily="OpenSansRegular"
                                                                      FontSize="12"
                                                                      TextColor="#0F172A"
                                                                      LineBreakMode="WordWrap" />
                                                        </VerticalStackLayout>
                                                 </Border>
                                          </Grid>
                                   </VerticalStackLayout>
                            </Border>
                     </VerticalStackLayout>
              </Border>

              <Border Grid.Row="4"
                            IsVisible="{Binding IsOrdersReportVisible}"
                            Margin="20,14,20,0"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            BackgroundColor="#FFFFFF"
                            StrokeShape="RoundRectangle 20"
                            Padding="16">
                     <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14">
                            <Grid ColumnDefinitions="*,420" ColumnSpacing="16">
                                   <VerticalStackLayout Spacing="6">
                                          <Label Text="Detailed All Orders Report"
                                                 FontFamily="AlegreyaBold"
                                                 FontSize="40"
                                                 TextColor="#0F172A" />
                                          <Label Text="Complete order listing with corrected VAT breakdown for HMRC compliance. Menu prices shown as net amounts (VAT exclusive) with VAT added separately."
                                                 FontFamily="OpenSansRegular"
                                                 FontSize="12"
                                                 TextColor="#64748B"
                                                 LineBreakMode="WordWrap" />
                                   </VerticalStackLayout>

                                   <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                          <Border Stroke="#CBD5E1"
                                                 StrokeThickness="1"
                                                 StrokeShape="RoundRectangle 14"
                                                 Padding="12,8"
                                                 BackgroundColor="#FFFFFF">
                                                 <Entry Placeholder="Search orders..."
                                                        Text="{Binding SearchText}"
                                                        Completed="OnSearchCompleted"
                                                        FontFamily="OpenSansRegular"
                                                        FontSize="13"
                                                        TextColor="#0F172A"
                                                        PlaceholderColor="#94A3B8"
                                                        BackgroundColor="Transparent" />
                                          </Border>
                                          <Button Grid.Column="1"
                                                 Text="Search"
                                                 Clicked="OnSearchClicked"
                                                 Style="{StaticResource PrimaryActionButtonStyle}" />
                                   </Grid>
                            </Grid>

                            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="10">
                                   <Button Text="CSV"
                                          Clicked="OnExportCsvClicked"
                                          Style="{StaticResource ExportGhostButtonStyle}" />

                                   <Button Grid.Column="1"
                                          Text="PDF"
                                          Clicked="OnExportPdfClicked"
                                          Style="{StaticResource ExportGhostButtonStyle}" />

                                   <Button Grid.Column="2"
                                          Text="Upload OrderWeb"
                                          CommandParameter="Upload OrderWeb"
                                          Clicked="OnUploadOrderWebReportClicked"
                                          IsVisible="{Binding CanUploadOrderWebReport}"
                                          BackgroundColor="#0F766E"
                                          TextColor="White"
                                          FontFamily="OpenSansSemibold"
                                          CornerRadius="10"
                                          Padding="14,8" />
                            </Grid>

                            <Grid Grid.Row="2"
                                  ColumnDefinitions="1.1*,1.1*,0.8*,1.1*,0.9*,0.9*,0.9*,0.7*"
                                  ColumnSpacing="10"
                                  Padding="8,0,8,8">
                                   <Label Text="Order Number" FontFamily="OpenSansSemibold" FontSize="13" TextColor="#64748B" />
                                   <Label Grid.Column="1" Text="Date &amp; Time" FontFamily="OpenSansSemibold" FontSize="13" TextColor="#64748B" />
                                   <Label Grid.Column="2" Text="Source" FontFamily="OpenSansSemibold" FontSize="13" TextColor="#64748B" />
                                   <Label Grid.Column="3" Text="Customer" FontFamily="OpenSansSemibold" FontSize="13" TextColor="#64748B" />
                                   <Label Grid.Column="4" Text="Net Amount" FontFamily="OpenSansSemibold" FontSize="13" TextColor="#64748B" HorizontalTextAlignment="End" />
                                   <Label Grid.Column="5" Text="VAT Amount" FontFamily="OpenSansSemibold" FontSize="13" TextColor="#64748B" HorizontalTextAlignment="End" />
                                   <Label Grid.Column="6" Text="Gross Amount" FontFamily="OpenSansSemibold" FontSize="13" TextColor="#64748B" HorizontalTextAlignment="End" />
                                   <Label Grid.Column="7"
                                          Text="Action"
                                          FontFamily="OpenSansSemibold"
                                          FontSize="13"
                                          TextColor="#64748B"
                                          HorizontalTextAlignment="Center"
                                          IsVisible="{Binding CanUseFullReportTools}" />
                            </Grid>

                            <CollectionView x:Name="OrdersCollection"
                                            Grid.Row="3"
                                            ItemsSource="{Binding Orders}"
                                            HeightRequest="560"
                                            SelectionMode="Single"
                                            SelectionChanged="OnOrderSelectionChanged">
                                   <CollectionView.EmptyView>
                                          <VerticalStackLayout Padding="24" HorizontalOptions="Center" VerticalOptions="Center">
                                                 <Label Text="No orders found for the selected period."
                                                        TextColor="#64748B"
                                                        FontFamily="OpenSansRegular"
                                                        FontSize="14" />
                                          </VerticalStackLayout>
                                   </CollectionView.EmptyView>
                                   <CollectionView.ItemTemplate>
                                          <DataTemplate>
                                                 <Border Stroke="#E2E8F0"
                                                        StrokeThickness="1"
                                                        BackgroundColor="#FFFFFF"
                                                        StrokeShape="RoundRectangle 10"
                                                        Padding="8,10"
                                                        Margin="0,0,0,8">
                                                        <Grid ColumnDefinitions="1.1*,1.1*,0.8*,1.1*,0.9*,0.9*,0.9*,0.7*" ColumnSpacing="10">
                                                               <Label Text="{Binding OrderNumber}" FontFamily="OpenSansSemibold" FontSize="13" TextColor="#0F172A" />
                                                               <Label Grid.Column="1" Text="{Binding CreatedAtDisplay}" FontFamily="OpenSansRegular" FontSize="12" TextColor="#334155" />
                                                               <Label Grid.Column="2" Text="{Binding SourceChannel}" FontFamily="OpenSansRegular" FontSize="12" TextColor="#334155" />
                                                               <Label Grid.Column="3" Text="{Binding CustomerName}" FontFamily="OpenSansRegular" FontSize="12" TextColor="#334155" LineBreakMode="TailTruncation" />
                                                               <Label Grid.Column="4" Text="{Binding NetSales, StringFormat='£{0:F2}'}" FontFamily="OpenSansSemibold" FontSize="12" TextColor="#0F172A" HorizontalTextAlignment="End" />
                                                               <Label Grid.Column="5" Text="{Binding VatAmount, StringFormat='£{0:F2}'}" FontFamily="OpenSansRegular" FontSize="12" TextColor="#334155" HorizontalTextAlignment="End" />
                                                               <Label Grid.Column="6" Text="{Binding GrossSales, StringFormat='£{0:F2}'}" FontFamily="OpenSansSemibold" FontSize="12" TextColor="#0F172A" HorizontalTextAlignment="End" />
                                                               <Button Grid.Column="7"
                                                                       Text="Void"
                                                                       Clicked="OnHardDeleteOrderClicked"
                                                                       CommandParameter="{Binding .}"

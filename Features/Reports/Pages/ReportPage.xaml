                     </VerticalStackLayout>
              </Border>

              <Border Grid.Row="4"
                      IsVisible="{Binding IsStaffHoursReportVisible}"
                      Margin="20,14,20,0"
                      Stroke="#E2E8F0"
                      StrokeThickness="1"
                      BackgroundColor="#FFFFFF"
                      StrokeShape="RoundRectangle 20"
                      Padding="16">
                     <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                   <VerticalStackLayout Spacing="6">
                                          <Label Text="Staff Hours"
                                                 FontFamily="AlegreyaBold"
                                                 FontSize="40"
                                                 TextColor="#0F172A" />
                                          <Label Text="Payroll-ready labour report with clock in/out times, hours worked, and cloud sync status."
                                                 FontFamily="OpenSansRegular"
                                                 FontSize="12"
                                                 TextColor="#64748B"
                                                 LineBreakMode="WordWrap" />
                                   </VerticalStackLayout>

                                   <Border Grid.Column="1"
                                           BackgroundColor="#EEF2FF"
                                           Stroke="#C7D2FE"
                                           StrokeThickness="1"
                                           StrokeShape="RoundRectangle 14"
                                           Padding="14,10"
                                           VerticalOptions="Center">
                                          <Label Text="Labour / Payroll"
                                                 FontFamily="OpenSansSemibold"
                                                 FontSize="13"
                                                 TextColor="#4338CA" />
                                   </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                   <Border Stroke="#C7D2FE" StrokeThickness="1" BackgroundColor="#EEF2FF" StrokeShape="RoundRectangle 12" Padding="12">
                                          <VerticalStackLayout Spacing="4">
                                                 <Label Text="Total Hours"
                                                        FontFamily="OpenSansSemibold"
                                                        FontSize="11"
                                                        TextColor="#4338CA" />
                                                 <Label Text="{Binding StaffHoursTotalText}"
                                                        FontFamily="AlegreyaBold"
                                                        FontSize="18"
                                                        TextColor="#312E81" />
                                          </VerticalStackLayout>
                                   </Border>
                                   <Border Grid.Column="1" Stroke="#BBF7D0" StrokeThickness="1" BackgroundColor="#F0FDF4" StrokeShape="RoundRectangle 12" Padding="12">
                                          <VerticalStackLayout Spacing="4">
                                                 <Label Text="Staff"
                                                        FontFamily="OpenSansSemibold"
                                                        FontSize="11"
                                                        TextColor="#166534" />
                                                 <Label Text="{Binding StaffHoursStaffCountText}"
                                                        FontFamily="AlegreyaBold"
                                                        FontSize="18"
                                                        TextColor="#14532D" />
                                          </VerticalStackLayout>
                                   </Border>
                                   <Border Grid.Column="2" Stroke="#FDE68A" StrokeThickness="1" BackgroundColor="#FFFBEB" StrokeShape="RoundRectangle 12" Padding="12">
                                          <VerticalStackLayout Spacing="4">
                                                 <Label Text="Open Shifts"
                                                        FontFamily="OpenSansSemibold"
                                                        FontSize="11"
                                                        TextColor="#92400E" />
                                                 <Label Text="{Binding StaffHoursOpenText}"
                                                        FontFamily="AlegreyaBold"
                                                        FontSize="18"
                                                        TextColor="#78350F" />
                                          </VerticalStackLayout>
                                   </Border>
                            </Grid>

                            <CollectionView ItemsSource="{Binding StaffHoursRows}" SelectionMode="None" HeightRequest="520">
                                   <CollectionView.EmptyView>
                                          <Label Text="No staff clock sessions in the selected date range."
                                                 FontFamily="OpenSansRegular"
                                                 FontSize="12"
                                                 TextColor="#64748B" />
                                   </CollectionView.EmptyView>
                                   <CollectionView.ItemTemplate>
                                          <DataTemplate>
                                                 <Border Stroke="#E2E8F0"
                                                         StrokeThickness="1"
                                                         BackgroundColor="#FFFFFF"
                                                         StrokeShape="RoundRectangle 12"
                                                         Padding="10"
                                                         Margin="0,0,0,8">
                                                        <Grid ColumnDefinitions="1.3*,1*,1*,Auto,Auto" ColumnSpacing="10">
                                                               <VerticalStackLayout Spacing="2">
                                                                      <Label Text="{Binding StaffName}"
                                                                             FontFamily="OpenSansSemibold"
                                                                             FontSize="12"
                                                                             TextColor="#0F172A" />
                                                                      <Label Text="{Binding Username}"
                                                                             FontFamily="OpenSansRegular"
                                                                             FontSize="11"
                                                                             TextColor="#64748B" />
                                                               </VerticalStackLayout>
                                                               <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                                      <Label Text="{Binding ClockInDisplay}"
                                                                             FontFamily="OpenSansSemibold"
                                                                             FontSize="12"
                                                                             TextColor="#334155" />
                                                                      <Label Text="{Binding TerminalIn}"
                                                                             FontFamily="OpenSansRegular"
                                                                             FontSize="11"
                                                                             TextColor="#64748B" />
                                                               </VerticalStackLayout>
                                                               <VerticalStackLayout Grid.Column="2" Spacing="2">
                                                                      <Label Text="{Binding ClockOutDisplay}"
                                                                             FontFamily="OpenSansSemibold"
                                                                             FontSize="12"
                                                                             TextColor="#334155" />
                                                                      <Label Text="{Binding TerminalOut}"
                                                                             FontFamily="OpenSansRegular"
                                                                             FontSize="11"
                                                                             TextColor="#64748B" />
                                                               </VerticalStackLayout>
                                                               <Label Grid.Column="3"
                                                                      Text="{Binding HoursDisplay}"
                                                                      FontFamily="OpenSansSemibold"
                                                                      FontSize="12"
                                                                      TextColor="#4338CA"
                                                                      VerticalTextAlignment="Center"
                                                                      HorizontalTextAlignment="End" />
                                                               <Label Grid.Column="4"
                                                                      Text="{Binding SyncDisplay}"
                                                                      FontFamily="OpenSansSemibold"
                                                                      FontSize="11"
                                                                      TextColor="#64748B"
                                                                      VerticalTextAlignment="Center"
                                                                      HorizontalTextAlignment="End" />
                                                        </Grid>
                                                 </Border>
                                          </DataTemplate>
                                   </CollectionView.ItemTemplate>
                            </CollectionView>
                     </VerticalStackLayout>
              </Border>

              <Border Grid.Row="4"
                            IsVisible="{Binding IsTopSellReportVisible}"
                            Margin="20,14,20,0"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            BackgroundColor="#FFFFFF"
                            StrokeShape="RoundRectangle 20"
                            Padding="16">
                     <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="14">
                            <Grid ColumnDefinitions="*,420" ColumnSpacing="16">
                                   <VerticalStackLayout Spacing="6">
                                          <Label Text="Top Sell Item Report"
                                                 FontFamily="AlegreyaBold"
                                                 FontSize="40"
                                                 TextColor="#0F172A" />
                                          <Label Text="Top selling category and item performance for the selected trading period. Use the 30, 60, or 90 day window to review trends."
                                                 FontFamily="OpenSansRegular"
                                                 FontSize="12"
                                                 TextColor="#64748B"
                                                 LineBreakMode="WordWrap" />
                                   </VerticalStackLayout>

                                   <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                          <Border Stroke="#CBD5E1"
                                                 StrokeThickness="1"
                                                 StrokeShape="RoundRectangle 14"
                                                 Padding="12,8"
                                                 BackgroundColor="#FFFFFF">
                                                 <Entry Placeholder="Search item or category..."
                                                        Text="{Binding SearchText}"
                                                        Completed="OnSearchCompleted"
                                                        FontFamily="OpenSansRegular"
                                                        FontSize="13"
                                                        TextColor="#0F172A"
                                                        PlaceholderColor="#94A3B8"
                                                        BackgroundColor="Transparent" />
                                          </Border>
                                          <Button Grid.Column="1"
                                                 Text="Search"
                                                 Clicked="OnSearchClicked"
                                                 Style="{StaticResource PrimaryActionButtonStyle}" />
                                   </Grid>
                            </Grid>

                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="14" VerticalOptions="Center">
                                   <Grid ColumnDefinitions="Auto,Auto,24,Auto,Auto,Auto,24,Auto"
                                         ColumnSpacing="8"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Start">
                                          <Button x:Name="TopSellFoodButton"
                                                 Text="Food"
                                                 Clicked="OnTopSellSectionClicked"
                                                 Style="{StaticResource FilterChipButtonStyle}" />
                                          <Button x:Name="TopSellDrinkButton"
                                                 Grid.Column="1"
                                                 Text="Drink"
                                                 Clicked="OnTopSellSectionClicked"
                                                 Style="{StaticResource FilterChipButtonStyle}" />

                                          <BoxView Grid.Column="2"
                                                  WidthRequest="1"
                                                  HeightRequest="28"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                                  Color="#D1D9E6" />

                                          <Button x:Name="TopSellThirtyDaysButton"
                                                 Grid.Column="3"
                                                 Text="30 Days"
                                                 Clicked="OnTopSellRangeClicked"
                                                 Style="{StaticResource FilterChipButtonStyle}" />
                                          <Button x:Name="TopSellSixtyDaysButton"
                                                 Grid.Column="4"
                                                 Text="60 Days"
                                                 Clicked="OnTopSellRangeClicked"
                                                 Style="{StaticResource FilterChipButtonStyle}" />
                                          <Button x:Name="TopSellNinetyDaysButton"
                                                 Grid.Column="5"
                                                 Text="90 Days"
                                                 Clicked="OnTopSellRangeClicked"
                                                 Style="{StaticResource FilterChipButtonStyle}" />

                                          <BoxView Grid.Column="6"
                                                  WidthRequest="1"
                                                  HeightRequest="28"
                                                  HorizontalOptions="Center"
                                                  VerticalOptions="Center"
                                                  Color="#D1D9E6" />

                                          <Button x:Name="TopSellCustomRangeButton"
                                                 Grid.Column="7"
                                                 Text="Custom"
                                                 Clicked="OnTopSellRangeClicked"
                                                 Style="{StaticResource FilterChipButtonStyle}" />
                                   </Grid>

                                   <HorizontalStackLayout Grid.Column="1" Spacing="8" HorizontalOptions="End" VerticalOptions="Center">
                                          <Button Text="CSV"
                                                 Clicked="OnExportCsvClicked"
                                                 Style="{StaticResource ExportGhostButtonStyle}" />
                                          <Button Text="PDF"
                                                 Clicked="OnExportPdfClicked"
                                                 Style="{StaticResource ExportGhostButtonStyle}" />
                                   </HorizontalStackLayout>
                            </Grid>

                            <Grid Grid.Row="2"
                                  Margin="0,12,0,0"
                                  IsVisible="{Binding IsTopSellCustomRangeVisible}"
                                  ColumnDefinitions="*,*,Auto"
                                  ColumnSpacing="10">
                                   <Button Text="{Binding StartDateDisplay}"
                                          Clicked="OnStartDateClicked"
                                          BackgroundColor="#FFFFFF"
                                          TextColor="#0F172A"
                                          BorderColor="#CBD5E1"
                                          BorderWidth="1"
                                          CornerRadius="10"
                                          Padding="14,10"
                                          FontFamily="OpenSansSemibold" />
                                   <Button Grid.Column="1"
                                          Text="{Binding EndDateDisplay}"
                                          Clicked="OnEndDateClicked"
                                          BackgroundColor="#FFFFFF"
                                          TextColor="#0F172A"
                                          BorderColor="#CBD5E1"
                                          BorderWidth="1"
                                          CornerRadius="10"
                                          Padding="14,10"
                                          FontFamily="OpenSansSemibold" />
                                   <Button Grid.Column="2"
                                          Text="Submit"
                                          Clicked="OnTopSellCustomSubmitClicked"
                                          IsEnabled="{Binding CanSubmitTopSellCustomRange}"
                                          Style="{StaticResource PrimaryActionButtonStyle}" />
                            </Grid>

                                <Border Grid.Row="3"
                                       BackgroundColor="#F8FAFC"
                                       Stroke="#E2E8F0"
                                       StrokeThickness="1"
                                       StrokeShape="RoundRectangle 10"
                                       Padding="12,8">
                                        <Label Text="{Binding TopSellInsightText}"
                                                 FontFamily="OpenSansSemibold"
                                                 FontSize="12"
                                                 TextColor="#334155" />
                                </Border>

                            <Grid Grid.Row="4">
                                   <dataGrid:SfDataGrid x:Name="TopSellDataGrid"
                                                        ItemsSource="{Binding TopItems}"
                                                        SortingMode="Multiple"
                                                        AllowTriStateSorting="True"
                                                        FilterRowPosition="None"
                                                        SelectionMode="None"
                                                        NavigationMode="Cell"
                                                        AutoGenerateColumnsMode="None"
                                                        ColumnWidthMode="Fill"
                                                        HeaderRowHeight="46"
                                                        RowHeight="42"
                                                        GridLinesVisibility="Horizontal"
                                                        HeaderGridLinesVisibility="Both"
                                                        VerticalOptions="FillAndExpand">
                                          <dataGrid:SfDataGrid.Columns>
                                                 <dataGrid:DataGridTextColumn MappingName="CategoryName" HeaderText="Category" MinimumWidth="160" />
                                                 <dataGrid:DataGridTextColumn MappingName="ItemName" HeaderText="Item" MinimumWidth="220" />
                                                 <dataGrid:DataGridNumericColumn MappingName="TotalQuantity" HeaderText="Qty" MinimumWidth="80" />
                                                 <dataGrid:DataGridTextColumn MappingName="GrossDisplay" HeaderText="Gross" MinimumWidth="110" />
                                                 <dataGrid:DataGridTextColumn MappingName="NetDisplay" HeaderText="Net" MinimumWidth="110" />
                                                 <dataGrid:DataGridTextColumn MappingName="VatDisplay" HeaderText="VAT" MinimumWidth="110" />
                                          </dataGrid:SfDataGrid.Columns>
                                   </dataGrid:SfDataGrid>

                                   <Border IsVisible="{Binding IsTopItemsEmpty}"
                                          BackgroundColor="#CCFFFFFF"
                                          Stroke="#E2E8F0"
                                          StrokeThickness="0"
                                          StrokeShape="RoundRectangle 10"
                                          HorizontalOptions="Fill"
                                          VerticalOptions="Fill">
                                          <Label Text="No top item data found for the selected period."
                                                 FontFamily="OpenSansRegular"
                                                 FontSize="14"
                                                 TextColor="#64748B"
                                                 HorizontalTextAlignment="Center"
                                                 VerticalTextAlignment="Center" />
                                   </Border>
                            </Grid>
                     </Grid>
              </Border>

                     </VerticalStackLayout>
              </ScrollView>

              </Grid>

              <Grid IsVisible="{Binding IsCalendarPopupVisible}"
                    BackgroundColor="#7F0F172A"
                    ZIndex="100">
                     <Border HorizontalOptions="Center"
                            VerticalOptions="Center"
                            WidthRequest="520"
                            MaximumWidthRequest="620"
                            Stroke="#D1D5DB"
                            StrokeThickness="1"
                            BackgroundColor="#FFFFFF"
                            StrokeShape="RoundRectangle 18"
                            Padding="0">
                            <VerticalStackLayout Spacing="0">
                                   <Border BackgroundColor="#10B981"
                                          StrokeThickness="0"
                                          StrokeShape="RoundRectangle 18,18,0,0"
                                          Padding="24,18">
                                          <VerticalStackLayout Spacing="4">
                                                 <Label Text="{Binding CalendarPopupTitle}"
                                                        FontFamily="OpenSansSemibold"
                                                        FontSize="38"
                                                        TextColor="White" />
                                                 <Label Text="Choose a trading date"
                                                        FontFamily="OpenSansRegular"
                                                        FontSize="14"
                                                        TextColor="#D1FAE5" />
                                          </VerticalStackLayout>
                                   </Border>

                                   <VerticalStackLayout Padding="20" Spacing="14">
                                          <Grid ColumnDefinitions="Auto,*,Auto"
                                                VerticalOptions="Center">
                                                 <Button Text="&#x2039;"
                                                         Clicked="OnPrevCalendarMonthClicked"
                                                         BackgroundColor="Transparent"
                                                         TextColor="#0F172A"
                                                         FontSize="24"
                                                         FontFamily="OpenSansSemibold"
                                                         Padding="6,0" />
                                                 <Label Grid.Column="1"
                                                        Text="{Binding CalendarMonthLabel}"
                                                        HorizontalTextAlignment="Center"
                                                        VerticalTextAlignment="Center"
                                                        FontFamily="OpenSansSemibold"
                                                        FontSize="22"
                                                        TextColor="#0F172A" />
                                                 <Button Grid.Column="2"
                                                         Text="&#x203A;"
                                                         Clicked="OnNextCalendarMonthClicked"
                                                         BackgroundColor="Transparent"
                                                         TextColor="#0F172A"
                                                         FontSize="24"
                                                         FontFamily="OpenSansSemibold"
                                                         Padding="6,0" />
                                          </Grid>

                                          <ContentView x:Name="CalendarDaysHost" />

                                          <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                                                 <Button Text="Cancel"
                                                         Clicked="OnCancelCalendarPopupClicked"
                                                         BackgroundColor="#FFFFFF"
                                                         TextColor="#475569"
                                                         BorderColor="#CBD5E1"
                                                         BorderWidth="1"
                                                         CornerRadius="10"
                                                         HeightRequest="46"
                                                         FontFamily="OpenSansSemibold" />
                                                 <Button Grid.Column="1"
                                                         Text="Apply"
                                                         Clicked="OnApplyCalendarPopupClicked"
                                                         BackgroundColor="#10B981"
                                                         TextColor="White"
                                                         CornerRadius="10"
                                                         HeightRequest="46"
                                                         FontFamily="OpenSansSemibold" />
                                          </Grid>
                                   </VerticalStackLayout>
                            </VerticalStackLayout>
                     </Border>
              </Grid>

       </Grid>
</ContentPage>

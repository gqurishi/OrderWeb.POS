<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_in_NET.Pages.TerminalSetupPage"
             BackgroundColor="#F8FAFC"
             Shell.NavBarIsVisible="False">

    <Grid Padding="24">
        <Button
                Text="-"
                WidthRequest="44"
                HeightRequest="44"
                Padding="0"
                CornerRadius="0"
                BackgroundColor="Transparent"
                BorderColor="Transparent"
                BorderWidth="0"
                TextColor="#111827"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="0,0,0,0"
                ZIndex="10"
                Clicked="OnMinimizeClicked"
                ToolTipProperties.Text="Minimize POS" />

        <ScrollView Margin="0,48,0,12"
                    VerticalScrollBarVisibility="Default">
        <Border WidthRequest="760"
                MaximumWidthRequest="760"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 28"
                Padding="40"
                HorizontalOptions="Center">
            <VerticalStackLayout Spacing="24">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Terminal Setup"
                           FontFamily="OpenSansSemibold"
                           FontSize="42"
                           TextColor="#0F172A" />
                    <Label Text="Choose how this POS terminal connects to your restaurant network."
                           FontFamily="OpenSansRegular"
                           FontSize="18"
                           TextColor="#64748B" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                    <Border x:Name="MotherCard"
                            Stroke="#10B981"
                            StrokeThickness="3"
                            StrokeShape="RoundRectangle 20"
                            BackgroundColor="#ECFDF5"
                            Padding="22">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMotherTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Mother Terminal"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="24"
                                   TextColor="#065F46" />
                            <Label Text="Main POS. Runs database, online orders, reports, and cloud sync."
                                   FontFamily="OpenSansRegular"
                                   FontSize="15"
                                   TextColor="#475569" />
                        </VerticalStackLayout>
                    </Border>

                    <Border x:Name="ChildCard"
                            Grid.Column="1"
                            Stroke="#CBD5E1"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 20"
                            BackgroundColor="#F8FAFC"
                            Padding="22">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnChildTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Child Terminal"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="24"
                                   TextColor="#1E3A8A" />
                            <Label Text="Floor/bar POS. Connects to the mother terminal database over LAN."
                                   FontFamily="OpenSansRegular"
                                   FontSize="15"
                                   TextColor="#475569" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Terminal Name"
                           FontFamily="OpenSansSemibold"
                           FontSize="16"
                           TextColor="#334155" />
                    <Entry x:Name="TerminalNameEntry"
                           Placeholder="Main, Floor 1, Bar, Counter 2"
                           Text="Main"
                           FontSize="18"
                           HeightRequest="58"
                           BackgroundColor="#F8FAFC" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="MotherDatabaseSection" Spacing="12" IsVisible="True">
                    <Label Text="Database Connection"
                           FontFamily="OpenSansSemibold"
                           FontSize="18"
                           TextColor="#0F172A" />
                    <Label x:Name="InstallerConfigLabel"
                           Text=""
                           FontFamily="OpenSansRegular"
                           FontSize="14"
                           TextColor="#059669"
                           IsVisible="False" />

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Database Name"
                               FontFamily="OpenSansSemibold"
                               FontSize="16"
                               TextColor="#334155" />
                        <Entry x:Name="DatabaseNameEntry"
                               FontSize="18"
                               HeightRequest="58"
                               BackgroundColor="#F8FAFC" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Database Port"
                               FontFamily="OpenSansSemibold"
                               FontSize="16"
                               TextColor="#334155" />
                        <Entry x:Name="DatabasePortEntry"
                               Text="3306"
                               Keyboard="Numeric"
                               FontSize="18"
                               HeightRequest="58"
                               BackgroundColor="#F8FAFC" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Database User"
                               FontFamily="OpenSansSemibold"
                               FontSize="16"
                               TextColor="#334155" />
                        <Entry x:Name="DatabaseUserEntry"
                               FontSize="18"
                               HeightRequest="58"
                               BackgroundColor="#F8FAFC" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Database Password"
                               FontFamily="OpenSansSemibold"
                               FontSize="16"
                               TextColor="#334155" />
                        <Border Stroke="#CBD5E1"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 6"
                                BackgroundColor="#F8FAFC"
                                HeightRequest="58"
                                Padding="10,0">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Entry x:Name="DatabasePasswordEntry"
                                       IsPassword="True"
                                       Placeholder="Enter database password"
                                       FontSize="18"
                                       BackgroundColor="Transparent"
                                       VerticalOptions="Center" />
                                <Button x:Name="ToggleDatabasePasswordButton"
                                        Grid.Column="1"
                                        Text="⌾ Show"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="13"
                                        HeightRequest="38"
                                        MinimumWidthRequest="88"
                                        Padding="10,0"
                                        CornerRadius="8"
                                        BackgroundColor="#E2E8F0"
                                        TextColor="#334155"
                                        VerticalOptions="Center"
                                        Clicked="OnToggleDatabasePasswordClicked" />
                            </Grid>
                        </Border>
                        <Label Text="Use at least 8 characters, or generate a secure password automatically."
                               FontFamily="OpenSansRegular"
                               FontSize="13"
                               TextColor="#64748B" />
                        <Button x:Name="GenerateDatabaseCredentialsButton"
                                Text="Generate Credentials"
                                FontFamily="OpenSansSemibold"
                                FontSize="15"
                                HeightRequest="48"
                                CornerRadius="12"
                                BackgroundColor="#0F766E"
                                TextColor="White"
                                Clicked="OnGenerateDatabaseCredentialsClicked" />
                        <Label Text="Inno Setup writes orderweb-database.json with these credentials before first launch."
                               FontFamily="OpenSansRegular"
                               FontSize="14"
                               TextColor="#64748B" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="MotherIpSection" Spacing="8" IsVisible="False">
                    <Label Text="Mother Terminal IP Address"
                           FontFamily="OpenSansSemibold"
                           FontSize="16"
                           TextColor="#334155" />
                    <Entry x:Name="MotherIpEntry"
                           Placeholder="Example: 192.168.1.50"
                           Keyboard="Url"
                           FontSize="18"
                           HeightRequest="58"
                           BackgroundColor="#F8FAFC" />
                    <Label Text="Tip: set the mother terminal to a fixed/static IP on your router."
                           FontFamily="OpenSansRegular"
                           FontSize="14"
                           TextColor="#64748B" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="PairingCodeSection" Spacing="8" IsVisible="False">
                    <Label Text="Pairing Code"
                           FontFamily="OpenSansSemibold"
                           FontSize="16"
                           TextColor="#334155" />
                    <Entry x:Name="PairingCodeEntry"
                           Placeholder="6-digit code from mother Terminal Health"
                           Keyboard="Numeric"
                           MaxLength="6"
                           FontSize="18"
                           HeightRequest="58"
                           BackgroundColor="#F8FAFC" />
                    <Label Text="Ask the admin to create this child terminal on the mother terminal first."
                           FontFamily="OpenSansRegular"
                           FontSize="14"
                           TextColor="#64748B" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <Label x:Name="StatusLabel"
                           Text=""
                           FontFamily="OpenSansRegular"
                           FontSize="15"
                           TextColor="#64748B"
                           VerticalOptions="Center" />
                    <Button x:Name="ContinueButton"
                            Grid.Column="1"
                            Text="Save &amp; Continue"
                            FontFamily="OpenSansSemibold"
                            FontSize="18"
                            HeightRequest="58"
                            Padding="28,0"
                            CornerRadius="16"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            Clicked="OnContinueClicked" />
                </Grid>
            </VerticalStackLayout>
        </Border>
        </ScrollView>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:POS_in_NET.Views"
             xmlns:controls="clr-namespace:POS_in_NET.Controls"
             x:Class="POS_in_NET.Pages.LiveOrderPage"
             Title=""
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,Auto,*">
        <views:TopBar x:Name="TopBar" Grid.Row="0"/>

        <controls:ToastNotification x:Name="ToastNotification"
                                   Grid.RowSpan="3"
                                   ZIndex="2000"
                                   InputTransparent="True"/>

        <Frame Grid.Row="1"
               BackgroundColor="White"
               Padding="0"
               CornerRadius="0"
               HasShadow="False"
               BorderColor="#E5E7EB">
            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center" Padding="24,16">
                <Border x:Name="CollectionTabBorder"
                        BackgroundColor="#F5F5F5"
                        StrokeThickness="0"
                        Padding="32,14"
                        HeightRequest="50">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCollectionTabClicked"/>
                    </Border.GestureRecognizers>
                    <Label x:Name="CollectionTabLabel"
                           Text="Collection"
                           TextColor="#6B7280"
                           FontSize="15"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"/>
                </Border>

                <Border x:Name="DeliveryTabBorder"
                        BackgroundColor="#F5F5F5"
                        StrokeThickness="0"
                        Padding="32,14"
                        HeightRequest="50">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDeliveryTabClicked"/>
                    </Border.GestureRecognizers>
                    <Label x:Name="DeliveryTabLabel"
                           Text="Delivery"
                           TextColor="#6B7280"
                           FontSize="15"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"/>
                </Border>

                <Border x:Name="TableTabBorder"
                        BackgroundColor="#10B981"
                        StrokeThickness="0"
                        Padding="32,14"
                        HeightRequest="50">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8"/>
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTableTabClicked"/>
                    </Border.GestureRecognizers>
                    <Label x:Name="TableTabLabel"
                           Text="Table"
                           TextColor="White"
                           FontSize="15"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"/>
                </Border>
            </HorizontalStackLayout>
        </Frame>

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="24" Spacing="16">
                <VerticalStackLayout x:Name="CollectionOrdersLayout" IsVisible="False" Spacing="12">
                    <FlexLayout x:Name="CollectionOrdersGrid"
                                Direction="Row"
                                Wrap="Wrap"
                                AlignItems="Start"
                                JustifyContent="Start"/>
                    <Label x:Name="CollectionEmptyLabel"
                           Text="No unpaid collection orders"
                           FontSize="16"
                           TextColor="#9CA3AF"
                           HorizontalOptions="Center"
                           Margin="0,40,0,0"/>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="DeliveryOrdersLayout" IsVisible="False" Spacing="12">
                    <FlexLayout x:Name="DeliveryOrdersGrid"
                                Direction="Row"
                                Wrap="Wrap"
                                AlignItems="Start"
                                JustifyContent="Start"/>
                    <Label x:Name="DeliveryEmptyLabel"
                           Text="No unpaid delivery orders"
                           FontSize="16"
                           TextColor="#9CA3AF"
                           HorizontalOptions="Center"
                           Margin="0,40,0,0"/>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="TableOrdersLayout" IsVisible="True" Spacing="12">
                    <FlexLayout x:Name="TableOrdersGrid"
                                Direction="Row"
                                Wrap="Wrap"
                                AlignItems="Start"
                                JustifyContent="Start"/>
                    <Label x:Name="TableEmptyLabel"
                           Text="No active table sessions"
                           FontSize="16"
                           TextColor="#9CA3AF"
                           HorizontalOptions="Center"
                           Margin="0,40,0,0"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

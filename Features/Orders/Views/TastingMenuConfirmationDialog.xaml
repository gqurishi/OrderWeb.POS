<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_in_NET.Views.TastingMenuConfirmationDialog"
             BackgroundColor="{StaticResource DialogOverlayColor}"
             HorizontalOptions="Fill"
             VerticalOptions="Fill">
    <Grid Padding="16,12">
        <Border x:Name="DialogCard"
                StyleId="DialogCard"
                BackgroundColor="White"
                Stroke="{StaticResource DialogShellStrokeColor}"
                StrokeThickness="1"
                Padding="20"
                MaximumWidthRequest="680"
                MaximumHeightRequest="720"
                HorizontalOptions="Fill"
                VerticalOptions="Center">
            <Border.StrokeShape><RoundRectangle CornerRadius="22" /></Border.StrokeShape>
            <Border.Shadow><Shadow Brush="#0F172A" Opacity="0.18" Radius="22" Offset="0,8" /></Border.Shadow>

            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
                <Grid ColumnDefinitions="58,*" ColumnSpacing="14">
                    <Border WidthRequest="58" HeightRequest="58" BackgroundColor="#0EA5E9" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="29" /></Border.StrokeShape>
                        <Label Text="T" FontSize="26" FontAttributes="Bold" TextColor="White"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="Add Tasting Menu" FontSize="23" FontFamily="OpenSansSemibold" TextColor="#0F172A" />
                        <Label x:Name="MenuNameLabel" FontSize="15" FontFamily="OpenSansSemibold" TextColor="#0369A1"
                               LineBreakMode="TailTruncation" />
                        <Label Text="Check the package and courses before adding it to the order."
                               FontSize="12" TextColor="#64748B" />
                    </VerticalStackLayout>
                </Grid>

                <Border Grid.Row="1" BackgroundColor="#F0F9FF" Stroke="#BAE6FD" StrokeThickness="1"
                        StrokeShape="RoundRectangle 14" Padding="14">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
                        <Label Text="Package price" FontSize="12" TextColor="#475569" />
                        <Label Grid.Column="1" x:Name="PriceLabel" FontSize="22" FontAttributes="Bold" TextColor="#059669" />
                        <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="8">
                            <Border BackgroundColor="#DBEAFE" StrokeThickness="0" Padding="10,5"
                                    StrokeShape="RoundRectangle 10">
                                <Label x:Name="CourseCountLabel" FontSize="12" FontAttributes="Bold" TextColor="#1D4ED8" />
                            </Border>
                            <Border x:Name="WineBadge" BackgroundColor="#F3E8FF" StrokeThickness="0" Padding="10,5"
                                    StrokeShape="RoundRectangle 10">
                                <Label x:Name="WineLabel" FontSize="12" FontAttributes="Bold" TextColor="#7E22CE" />
                            </Border>
                            <Border BackgroundColor="#ECFDF5" StrokeThickness="0" Padding="10,5"
                                    StrokeShape="RoundRectangle 10">
                                <Label x:Name="VatLabel" FontSize="12" FontAttributes="Bold" TextColor="#047857" />
                            </Border>
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <CollectionView x:Name="CoursesList" Grid.Row="2" SelectionMode="None"
                                VerticalScrollBarVisibility="Always">
                    <CollectionView.Header>
                        <Label Text="Serving order" FontSize="15" FontAttributes="Bold" TextColor="#334155"
                               Margin="0,0,0,10" />
                    </CollectionView.Header>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12" Padding="12" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Border WidthRequest="40" HeightRequest="40" BackgroundColor="#0EA5E9" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 11">
                                        <Label Text="{Binding Number}" FontSize="15" FontAttributes="Bold" TextColor="White"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" />
                                        <Label Text="{Binding WineDisplay}" IsVisible="{Binding HasWine}"
                                               FontSize="12" TextColor="#7E22CE" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Text="Cancel" Clicked="OnCancelClicked" HeightRequest="50" CornerRadius="12"
                            BackgroundColor="#E2E8F0" TextColor="#334155" FontAttributes="Bold" />
                    <Button Grid.Column="1" Text="Add to Order" Clicked="OnAddClicked" HeightRequest="50" CornerRadius="12"
                            BackgroundColor="#10B981" TextColor="White" FontAttributes="Bold" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentView>

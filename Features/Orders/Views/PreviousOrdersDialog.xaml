<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_in_NET.Views.PreviousOrdersDialog"
             BackgroundColor="{StaticResource DialogOverlayColor}"
             VerticalOptions="Fill"
             HorizontalOptions="Fill">

    <Grid Padding="16,12">
        <Border x:Name="DialogCard"
                BackgroundColor="White"
                Stroke="{StaticResource DialogShellStrokeColor}"
                StrokeThickness="1"
                Padding="20"
                MaximumWidthRequest="760"
                MaximumHeightRequest="760"
                HorizontalOptions="Fill"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="22" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#0F172A" Opacity="0.16" Radius="20" Offset="0,8" />
            </Border.Shadow>

            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
                <Grid Grid.Row="0" ColumnDefinitions="58,*" ColumnSpacing="14">
                    <Border WidthRequest="58"
                            HeightRequest="58"
                            BackgroundColor="#2563EB"
                            StrokeThickness="0"
                            VerticalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="29" />
                        </Border.StrokeShape>
                        <Label Text="↶"
                               FontSize="30"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Previous Orders"
                               FontFamily="OpenSansSemibold"
                               FontSize="24"
                               TextColor="#0F172A" />
                        <Label x:Name="CustomerLabel"
                               FontFamily="OpenSansSemibold"
                               FontSize="14"
                               TextColor="#334155"
                               LineBreakMode="TailTruncation" />
                        <Label Text="Latest 3 Collection or Delivery orders from the past 12 months"
                               FontSize="12"
                               TextColor="#64748B"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>

                <Grid Grid.Row="1">
                    <CollectionView x:Name="OrdersList"
                                    SelectionMode="None"
                                    VerticalScrollBarVisibility="Always">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#F8FAFC"
                                        Stroke="#DCE5F0"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="14"
                                        Margin="0,0,0,10">
                                    <VerticalStackLayout Spacing="9">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <VerticalStackLayout Spacing="3">
                                                <Label Text="LAST ORDER"
                                                       IsVisible="{Binding IsMostRecent}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="10"
                                                       TextColor="#1D4ED8" />
                                                <Label Text="{Binding OrderReferenceDisplay}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="16"
                                                       TextColor="#0F172A" />
                                                <Label Text="{Binding DateDisplay}"
                                                       FontSize="12"
                                                       TextColor="#64748B" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1"
                                                   Text="{Binding TotalDisplay}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="19"
                                                   TextColor="#047857"
                                                   VerticalOptions="Center" />
                                        </Grid>

                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                            <Border BackgroundColor="#DBEAFE" StrokeThickness="0" Padding="9,4">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                                <Label Text="{Binding OrderTypeDisplay}" FontSize="11" TextColor="#1D4ED8" />
                                            </Border>
                                            <Border Grid.Column="1" BackgroundColor="#ECFDF5" StrokeThickness="0" Padding="9,4">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                                <Label Text="{Binding StatusDisplay}" FontSize="11" TextColor="{Binding StatusColor}" />
                                            </Border>
                                        </Grid>

                                        <BoxView HeightRequest="1" Color="#E2E8F0" />

                                        <Label Text="{Binding ItemsText}"
                                               FontSize="13"
                                               TextColor="#1E293B"
                                               LineBreakMode="WordWrap" />

                                        <Border IsVisible="{Binding HasOrderNotes}"
                                                BackgroundColor="#FFF7ED"
                                                Stroke="#FED7AA"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 8"
                                                Padding="9,6">
                                            <Label Text="{Binding OrderNotesDisplay}"
                                                   FontSize="11"
                                                   TextColor="#9A3412"
                                                   LineBreakMode="WordWrap" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <VerticalStackLayout x:Name="EmptyState"
                                         IsVisible="False"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Spacing="8">
                        <Label Text="No previous orders"
                               FontFamily="OpenSansSemibold"
                               FontSize="18"
                               TextColor="#334155"
                               HorizontalTextAlignment="Center" />
                        <Label Text="No completed Collection or Delivery orders were found for this customer in the past 12 months."
                               FontSize="13"
                               TextColor="#64748B"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"
                               MaximumWidthRequest="460" />
                    </VerticalStackLayout>
                </Grid>

                <Button Grid.Row="2"
                        Text="Close"
                        BackgroundColor="#E2E8F0"
                        TextColor="#334155"
                        FontFamily="OpenSansSemibold"
                        FontSize="14"
                        HeightRequest="48"
                        CornerRadius="12"
                        Clicked="OnCloseClicked" />
            </Grid>
        </Border>
    </Grid>
</ContentView>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_in_NET.Views.AddonSelectionDialog"
             BackgroundColor="{StaticResource DialogOverlayColor}"
             VerticalOptions="Fill"
             HorizontalOptions="Fill">

    <Grid VerticalOptions="Center"
          HorizontalOptions="Center"
          Padding="36">
        <Border BackgroundColor="White"
                Stroke="#DCE3EE"
                StrokeThickness="1"
                Padding="28"
                WidthRequest="520"
                VerticalOptions="Center"
                HorizontalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="22"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#0F172A" Opacity="0.16" Radius="20" Offset="0,8"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="18">
                <Border BackgroundColor="#FFF7ED"
                        Stroke="#FED7AA"
                        StrokeThickness="1"
                        WidthRequest="74"
                        HeightRequest="74"
                        HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="37"/>
                    </Border.StrokeShape>
                    <Label Text="+"
                           FontSize="36"
                           FontAttributes="Bold"
                           TextColor="#EA580C"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

                <VerticalStackLayout Spacing="6">
                    <Label x:Name="TitleLabel"
                           Text="Choose Add-ons"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#0F172A"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>

                    <Label x:Name="SubtitleLabel"
                           Text="Select optional extras for this item."
                           FontSize="14"
                           TextColor="#64748B"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <Border BackgroundColor="#F8FAFC"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        Padding="10"
                        Margin="0,2,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>

                    <VerticalStackLayout x:Name="AddonsContainer"
                                         Spacing="10"/>
                </Border>

                <Border x:Name="SelectionSummaryBorder"
                        BackgroundColor="#ECFDF5"
                        Stroke="#A7F3D0"
                        StrokeThickness="1"
                        Padding="12,10"
                        IsVisible="False">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Label x:Name="SelectionSummaryLabel"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#047857"
                           HorizontalTextAlignment="Center"/>
                </Border>

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="14"
                      Margin="0,4,0,0">
                    <Button Grid.Column="0"
                            Text="Cancel"
                            BackgroundColor="#E2E8F0"
                            TextColor="#334155"
                            FontAttributes="Bold"
                            CornerRadius="14"
                            HeightRequest="52"
                            FontSize="16"
                            Clicked="OnCancelClicked"/>

                    <Button Grid.Column="1"
                            x:Name="DoneButton"
                            Text="No Add-ons"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="14"
                            HeightRequest="52"
                            FontSize="16"
                            Clicked="OnDoneClicked"/>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>

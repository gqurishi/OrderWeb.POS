<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_in_NET.Views.CardPaymentDialog"
             BackgroundColor="{StaticResource DialogOverlayColor}"
             VerticalOptions="Fill"
             HorizontalOptions="Fill">
    
    <Grid VerticalOptions="Fill" HorizontalOptions="Fill">
        <Border x:Name="DialogCard" BackgroundColor="White"
               Stroke="{StaticResource DialogShellStrokeColor}"
               StrokeThickness="1"
               Padding="30"
               MaximumWidthRequest="600"
               MaximumHeightRequest="760"
               Margin="16"
               HorizontalOptions="Fill"
               VerticalOptions="Center"
               >
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="22"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#0F172A" Opacity="0.16" Radius="20" Offset="0,8"/>
            </Border.Shadow>
            
            <Grid RowDefinitions="*,Auto" RowSpacing="12">
            <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Default">
            <VerticalStackLayout Spacing="25">
                
                <!-- Header with Close Button -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="CARD PAYMENT"
                           FontSize="30"
                           FontAttributes="Bold"
                           TextColor="#111827"
                           VerticalOptions="Center"/>
                    <!-- Close Button - Rectangle -->
                    <Button Grid.Column="1"
                            Text="CLOSE"
                            BackgroundColor="#DC2626"
                            TextColor="White"
                            FontSize="14"
                            FontAttributes="Bold"
                            WidthRequest="90"
                            HeightRequest="45"
                            CornerRadius="14"
                            Clicked="OnCancelClicked"/>
                </Grid>
                
                <!-- Card Icon -->
                <Border BackgroundColor="#DBEAFE"
                        StrokeThickness="2"
                        Stroke="#3B82F6"
                        WidthRequest="140"
                        HeightRequest="80"
                        HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <Label Text="CARD"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#1E40AF"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>
                
                <!-- Divider -->
                <BoxView HeightRequest="2" Color="#E5E7EB"/>
                
                <!-- Amount -->
                <Border BackgroundColor="#EFF6FF" Stroke="#3B82F6" StrokeThickness="2" Padding="25">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="CHARGE AMOUNT"
                               FontSize="18"
                               TextColor="#1E40AF"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"/>
                        <Label x:Name="AmountLabel"
                               Text="£0.00"
                               FontSize="44"
                               FontAttributes="Bold"
                               TextColor="#1E3A8A"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
                
                <!-- Manual terminal confirmation -->
                <Border BackgroundColor="#FFF7ED" Stroke="#F97316" StrokeThickness="2" Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="10">
                        <Label x:Name="StatusLabel"
                               Text="Enter this exact amount on the card terminal. Press YES only after the terminal shows APPROVED."
                               FontSize="18"
                               TextColor="#9A3412"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"/>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <CheckBox x:Name="ApprovalCheckBox" Grid.Column="0" Color="#059669"
                                      CheckedChanged="OnConfirmationChanged"/>
                            <Label Grid.Column="1"
                                   Text="Terminal amount matches and payment is APPROVED"
                                   FontSize="17" FontAttributes="Bold" TextColor="#374151"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="8">
                    <Label Text="CARD RECEIPT / TERMINAL REFERENCE (REQUIRED)"
                           FontSize="14" FontAttributes="Bold" TextColor="#374151"/>
                    <Entry x:Name="TerminalReferenceEntry"
                           Placeholder="Enter reference from approved card receipt"
                           MaxLength="100" TextChanged="OnConfirmationChanged"
                           BackgroundColor="#F8FAFC" TextColor="#111827"/>
                    <Label Text="Keep the printed card receipt for end-of-day reconciliation."
                           FontSize="13" TextColor="#64748B"/>
                </VerticalStackLayout>
                
            </VerticalStackLayout>
            </ScrollView>
                <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Grid.Column="0" Text="NO" BackgroundColor="#FEE2E2"
                            TextColor="#DC2626" FontSize="22" FontAttributes="Bold"
                            CornerRadius="14" HeightRequest="58" Clicked="OnNoClicked"/>
                    <Button x:Name="YesButton" Grid.Column="1" Text="YES"
                            BackgroundColor="#059669" TextColor="White" FontSize="22"
                            FontAttributes="Bold" CornerRadius="14" HeightRequest="58"
                            IsEnabled="False" Clicked="OnYesClicked"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
    
</ContentView>

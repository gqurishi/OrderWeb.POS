<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="POS_in_NET.Pages.GiftCardPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:POS_in_NET.Views"
             xmlns:controls="clr-namespace:POS_in_NET.Controls"
             Title=""
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto,*">
        <views:TopBar x:Name="TopBar" Grid.Row="0"/>

        <controls:ToastNotification x:Name="ToastNotification"
                                    Grid.RowSpan="2"
                                    ZIndex="2000"
                                    InputTransparent="True"/>

        <Button Grid.Row="1"
                Text="X"
                BackgroundColor="#FEF2F2"
                BorderColor="#FCA5A5"
                BorderWidth="1"
                TextColor="#DC2626"
                FontAttributes="Bold"
                FontSize="18"
                WidthRequest="48"
                HeightRequest="48"
                CornerRadius="24"
                Padding="0"
                Margin="0,20,32,0"
                HorizontalOptions="End"
                VerticalOptions="Start"
                ZIndex="10"
                ToolTipProperties.Text="Close"
                Clicked="OnCloseClicked" />

        <Grid Grid.Row="1"
              RowDefinitions="Auto,*"
              Padding="40,32"
              MaximumWidthRequest="1500"
              HorizontalOptions="Center">

            <Grid Grid.Row="0"
                  ColumnDefinitions="*,*,*,*"
                  ColumnSpacing="12"
                  Margin="0,0,0,22">
                <Button x:Name="ActivateFlowButton"
                        Grid.Column="0"
                        Text="Activate Stock Card"
                        HeightRequest="58"
                        CornerRadius="10"
                        FontAttributes="Bold"
                        FontSize="15"
                        Clicked="OnActivateFlowClicked" />
                <Button x:Name="SellFlowButton"
                        Grid.Column="1"
                        Text="Sell New Gift Card"
                        HeightRequest="58"
                        CornerRadius="10"
                        FontAttributes="Bold"
                        FontSize="15"
                        Clicked="OnSellFlowClicked" />
                <Button x:Name="TopUpFlowButton"
                        Grid.Column="2"
                        Text="Top-up Gift Card"
                        HeightRequest="58"
                        CornerRadius="10"
                        FontAttributes="Bold"
                        FontSize="15"
                        Clicked="OnTopUpFlowClicked" />
                <Button x:Name="RedeemFlowButton"
                        Grid.Column="3"
                        Text="Redeem Gift Card"
                        HeightRequest="58"
                        CornerRadius="10"
                        FontAttributes="Bold"
                        FontSize="15"
                        Clicked="OnRedeemFlowClicked" />
            </Grid>

            <ScrollView Grid.Row="1">
                <Grid>
                    <Border x:Name="ActivateScreen"
                            BackgroundColor="White"
                            Stroke="#D1FAE5"
                            StrokeThickness="1"
                            Padding="32"
                            StrokeShape="RoundRectangle 14"
                            Shadow="{StaticResource CardShadow}"
                            VerticalOptions="Start">
                        <Grid ColumnDefinitions="1*,1*"
                              ColumnSpacing="28">
                            <VerticalStackLayout Grid.Column="0" Spacing="18">
                                <Label Text="Activate Stock Card"
                                       FontSize="28"
                                       FontAttributes="Bold"
                                       TextColor="#111827" />

                                <Entry x:Name="ActivateCardEntry"
                                       Placeholder="Stock card number"
                                       FontSize="18"
                                       HeightRequest="54"
                                       BackgroundColor="#F8FAFC"
                                       Completed="OnActivateLookupClicked" />

                                <Button x:Name="ActivateLookupButton"
                                        Text="Lookup For Activation"
                                        BackgroundColor="#2563EB"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        HeightRequest="52"
                                        CornerRadius="10"
                                        Clicked="OnActivateLookupClicked" />

                                <Label x:Name="ActivateStatusLabel"
                                       FontSize="15"
                                       TextColor="#64748B"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="16">
                                <Label Text="Activation Payment"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="#111827" />

                                <Entry x:Name="ActivateAmountEntry"
                                       Placeholder="Amount"
                                       Keyboard="Numeric"
                                       FontSize="18"
                                       HeightRequest="54"
                                       BackgroundColor="#F8FAFC" />

                                <Picker x:Name="ActivatePaymentMethodPicker"
                                        Title="Payment method"
                                        FontSize="17"
                                        HeightRequest="54"
                                        BackgroundColor="#F8FAFC" />

                                <Entry x:Name="ActivateOrderIdEntry"
                                       Placeholder="Till order ID"
                                       FontSize="17"
                                       HeightRequest="54"
                                       BackgroundColor="#F8FAFC" />

                                <Button x:Name="ActivateActionButton"
                                        Text="Take Payment &amp; Activate"
                                        BackgroundColor="#10B981"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        HeightRequest="52"
                                        CornerRadius="10"
                                        IsEnabled="False"
                                        Clicked="OnActivateCardClicked" />

                                <Label x:Name="ActivateReceiptLabel"
                                       FontSize="14"
                                       TextColor="#475569"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border x:Name="SellScreen"
                            BackgroundColor="White"
                            Stroke="#DBEAFE"
                            StrokeThickness="1"
                            Padding="32"
                            StrokeShape="RoundRectangle 14"
                            Shadow="{StaticResource CardShadow}"
                            IsVisible="False"
                            VerticalOptions="Start">
                        <Grid ColumnDefinitions="1*,1*"
                              ColumnSpacing="28">
                            <VerticalStackLayout Grid.Column="0" Spacing="18">
                                <Label Text="Sell New Gift Card"
                                       FontSize="28"
                                       FontAttributes="Bold"
                                       TextColor="#111827" />

                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="12">
                                    <Entry x:Name="SellCardEntry"
                                           Placeholder="New card number"
                                           FontSize="18"
                                           HeightRequest="54"
                                           BackgroundColor="#F8FAFC" />
                                    <Button Grid.Column="1"
                                            Text="Generate"
                                            BackgroundColor="#EFF6FF"
                                            BorderColor="#BFDBFE"
                                            BorderWidth="1"
                                            TextColor="#2563EB"
                                            FontAttributes="Bold"
                                            HeightRequest="54"
                                            CornerRadius="10"
                                            Clicked="OnGenerateSellCardClicked" />
                                </Grid>

                                <Entry x:Name="SellAmountEntry"
                                       Placeholder="Amount"
                                       Keyboard="Numeric"
                                       FontSize="18"
                                       HeightRequest="54"
                                       BackgroundColor="#F8FAFC" />

                                <Picker x:Name="SellPaymentMethodPicker"
                                        Title="Payment method"
                                        FontSize="17"
                                        HeightRequest="54"
                                        BackgroundColor="#F8FAFC" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="16">
                                <Label Text="Sale Details"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="#111827" />

                                <Entry x:Name="SellOrderIdEntry"
                                       Placeholder="Till order ID"
                                       FontSize="17"
                                       HeightRequest="54"
                                       BackgroundColor="#F8FAFC" />

                                <Button x:Name="SellActionButton"
                                        Text="Take Payment &amp; Sell"
                                        BackgroundColor="#2563EB"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        HeightRequest="52"
                                        CornerRadius="10"
                                        Clicked="OnSellCardClicked" />

                                <Label x:Name="SellStatusLabel"
                                       FontSize="15"
                                       TextColor="#64748B"
                                       LineBreakMode="WordWrap" />

                                <Label x:Name="SellReceiptLabel"
                                       FontSize="14"
                                       TextColor="#475569"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border x:Name="TopUpScreen"
                            BackgroundColor="White"
                            Stroke="#FDE68A"
                            StrokeThickness="1"
                            Padding="32"
                            StrokeShape="RoundRectangle 14"
                            Shadow="{StaticResource CardShadow}"
                            IsVisible="False"
                            VerticalOptions="Start">
                        <Grid ColumnDefinitions="1*,1*"
                              ColumnSpacing="28">
                            <VerticalStackLayout Grid.Column="0" Spacing="18">
                                <Label Text="Top-up Gift Card"
                                       FontSize="28"
                                       FontAttributes="Bold"
                                       TextColor="#111827" />

                                <Entry x:Name="TopUpCardEntry"
                                       Placeholder="Gift card number"
                                       FontSize="18"
                                       HeightRequest="54"
                                       BackgroundColor="#F8FAFC"
                                       Completed="OnTopUpLookupClicked" />

                                <Button x:Name="TopUpLookupButton"
                                        Text="Lookup For Top-up"
                                        BackgroundColor="#D97706"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        HeightRequest="52"
                                        CornerRadius="10"
                                        Clicked="OnTopUpLookupClicked" />

                                <Label x:Name="TopUpStatusLabel"
                                       FontSize="15"
                                       TextColor="#64748B"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="16">
                                <Label Text="Top-up Payment"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="#111827" />

                                <Entry x:Name="TopUpAmountEntry"
                                       Placeholder="Amount"
                                       Keyboard="Numeric"
                                       FontSize="18"
                                       HeightRequest="54"
                                       BackgroundColor="#F8FAFC" />

                                <Picker x:Name="TopUpPaymentMethodPicker"
                                        Title="Payment method"
                                        FontSize="17"
                                        HeightRequest="54"
                                        BackgroundColor="#F8FAFC" />

                                <Entry x:Name="TopUpOrderIdEntry"
                                       Placeholder="Till order ID"
                                       FontSize="17"
                                       HeightRequest="54"
                                       BackgroundColor="#F8FAFC" />

                                <Button x:Name="TopUpActionButton"
                                        Text="Take Payment &amp; Top-up"
                                        BackgroundColor="#D97706"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        HeightRequest="52"
                                        CornerRadius="10"
                                        IsEnabled="False"
                                        Clicked="OnTopUpCardClicked" />

                                <Label x:Name="TopUpReceiptLabel"
                                       FontSize="14"
                                       TextColor="#475569"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border x:Name="RedeemScreen"
                            BackgroundColor="White"
                            Stroke="#BFDBFE"
                            StrokeThickness="1"
                            Padding="32"
                            StrokeShape="RoundRectangle 14"
                            Shadow="{StaticResource CardShadow}"
                            IsVisible="False"
                            VerticalOptions="Start">
                        <Grid ColumnDefinitions="1*,1*"
                              ColumnSpacing="28">
                            <VerticalStackLayout Grid.Column="0" Spacing="18">
                                <Label Text="Redeem Gift Card"
                                       FontSize="28"
                                       FontAttributes="Bold"
                                       TextColor="#111827" />

                                <Entry x:Name="RedeemCardEntry"
                                       Placeholder="Gift card number"
                                       FontSize="18"
                                       HeightRequest="54"
                                       BackgroundColor="#F8FAFC"
                                       Completed="OnRedeemLookupClicked" />

                                <Button x:Name="RedeemLookupButton"
                                        Text="Lookup For Redemption"
                                        BackgroundColor="#2563EB"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        HeightRequest="52"
                                        CornerRadius="10"
                                        Clicked="OnRedeemLookupClicked" />

                                <Border BackgroundColor="#EFF6FF"
                                        Stroke="#BFDBFE"
                                        StrokeThickness="1"
                                        Padding="18"
                                        StrokeShape="RoundRectangle 12">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="Current Balance"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#1E40AF" />
                                        <Label x:Name="RedeemBalanceLabel"
                                               Text="GBP 0.00"
                                               FontSize="34"
                                               FontAttributes="Bold"
                                               TextColor="#1D4ED8" />
                                        <Label x:Name="RedeemCardStatusLabel"
                                               Text="No card selected"
                                               FontSize="15"
                                               TextColor="#475569" />
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="16">
                                <Label Text="Redemption"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="#111827" />

                                <Entry x:Name="RedeemAmountEntry"
                                       Placeholder="Amount"
                                       Keyboard="Numeric"
                                       FontSize="18"
                                       HeightRequest="54"
                                       BackgroundColor="#F8FAFC" />

                                <Entry x:Name="RedeemOrderIdEntry"
                                       Placeholder="Till order ID"
                                       FontSize="17"
                                       HeightRequest="54"
                                       BackgroundColor="#F8FAFC" />

                                <Button x:Name="RedeemActionButton"
                                        Text="Redeem Card"
                                        BackgroundColor="#10B981"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        HeightRequest="52"
                                        CornerRadius="10"
                                        IsEnabled="False"
                                        Clicked="OnRedeemCardClicked" />

                                <Label x:Name="RedeemStatusLabel"
                                       FontSize="15"
                                       TextColor="#64748B"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>

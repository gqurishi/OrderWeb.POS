<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:POS_in_NET.Views"
             x:Class="POS_in_NET.Pages.PrintTemplatesPage"
             BackgroundColor="#F1F5F9"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <views:TopBar x:Name="TopBar" Grid.Row="0"/>

        <ScrollView Grid.Row="1"
                    Orientation="Vertical"
                    VerticalScrollBarVisibility="Always">
            <Grid Padding="32"
                  ColumnDefinitions="*,420"
                  ColumnSpacing="28">

                <VerticalStackLayout Grid.Column="0" Spacing="18">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="4">
                            <Label x:Name="PageHeadingLabel"
                                   Text="Kitchen Template"
                                   FontSize="30"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A"/>
                            <Label x:Name="PageSubheadingLabel"
                                   Text="80mm kitchen ticket preview"
                                   FontSize="15"
                                   TextColor="#64748B"/>
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Text="Back"
                                BackgroundColor="#E2E8F0"
                                TextColor="#334155"
                                CornerRadius="8"
                                Padding="18,10"
                                FontAttributes="Bold"
                                Clicked="OnBackClicked"/>
                    </Grid>

                    <HorizontalStackLayout Spacing="10">
                        <Button x:Name="KitchenTemplateButton"
                                Text="Kitchen Ticket"
                                CornerRadius="8"
                                Padding="18,10"
                                FontAttributes="Bold"
                                Clicked="OnKitchenTemplateClicked"/>
                        <Button x:Name="CollectionReceiptTemplateButton"
                                Text="Collection Receipt"
                                CornerRadius="8"
                                Padding="18,10"
                                FontAttributes="Bold"
                                Clicked="OnCollectionReceiptTemplateClicked"/>
                        <Button x:Name="DeliveryReceiptTemplateButton"
                                Text="Delivery Receipt"
                                CornerRadius="8"
                                Padding="18,10"
                                FontAttributes="Bold"
                                Clicked="OnDeliveryReceiptTemplateClicked"/>
                        <Button x:Name="TableBillTemplateButton"
                                Text="Table Bill"
                                CornerRadius="8"
                                Padding="18,10"
                                FontAttributes="Bold"
                                Clicked="OnTableBillTemplateClicked"/>
                        <Button x:Name="TablePaymentTemplateButton"
                                Text="Table Payment"
                                CornerRadius="8"
                                Padding="18,10"
                                FontAttributes="Bold"
                                Clicked="OnTablePaymentTemplateClicked"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout x:Name="KitchenPreviewModes" Spacing="10">
                        <Button x:Name="TablePreviewButton"
                                Text="Table"
                                CornerRadius="8"
                                Padding="18,10"
                                FontAttributes="Bold"
                                Clicked="OnTablePreviewClicked"/>
                        <Button x:Name="CollectionPreviewButton"
                                Text="Collection"
                                CornerRadius="8"
                                Padding="18,10"
                                FontAttributes="Bold"
                                Clicked="OnCollectionPreviewClicked"/>
                        <Button x:Name="DeliveryPreviewButton"
                                Text="Delivery"
                                CornerRadius="8"
                                Padding="18,10"
                                FontAttributes="Bold"
                                Clicked="OnDeliveryPreviewClicked"/>
                    </HorizontalStackLayout>

                    <Border BackgroundColor="#E2E8F0"
                            Padding="24"
                            StrokeThickness="0"
                            HorizontalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>

                        <Border BackgroundColor="White"
                                Stroke="#CBD5E1"
                                StrokeThickness="1"
                                Padding="20"
                                WidthRequest="420"
                                HorizontalOptions="Start">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="4"/>
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#22000000" Offset="0,4" Radius="16" Opacity="0.18"/>
                            </Border.Shadow>

                            <ScrollView Orientation="Both"
                                        HeightRequest="620"
                                        HorizontalScrollBarVisibility="Always"
                                        VerticalScrollBarVisibility="Always">
                                <Grid WidthRequest="380">
                                    <VerticalStackLayout x:Name="KitchenPreviewLines"
                                                         Spacing="0"
                                                         IsVisible="True"/>
                                    <Label x:Name="PreviewTextLabel"
                                           FontFamily="Consolas"
                                           FontSize="14"
                                           LineBreakMode="NoWrap"
                                           TextColor="#111827"
                                           IsVisible="False"/>
                                </Grid>
                            </ScrollView>
                        </Border>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="16">
                    <Border BackgroundColor="White" Padding="22" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="14">
                            <Label x:Name="PreviewTitleLabel"
                                   Text="Table kitchen ticket"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A"/>
                            <Label Text="Paper"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#64748B"
                                   CharacterSpacing="1"/>
                            <Label Text="80mm fixed"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border x:Name="KitchenControlsPanel"
                            BackgroundColor="White"
                            Padding="22"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="14">
                            <Label Text="Kitchen Customise"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A"/>

                            <Grid ColumnDefinitions="*,*"
                                  RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                  ColumnSpacing="14"
                                  RowSpacing="12">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Main heading"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#475569"/>
                                    <Picker x:Name="HeadingSizePicker"
                                            BackgroundColor="#F8FAFC"
                                            TextColor="#0F172A"
                                            SelectedIndexChanged="OnKitchenSettingChanged">
                                        <Picker.Items>
                                            <x:String>Normal</x:String>
                                            <x:String>Large</x:String>
                                            <x:String>Extra Large</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </VerticalStackLayout>

                                <HorizontalStackLayout Grid.Column="1"
                                                       Spacing="10"
                                                       VerticalOptions="End"
                                                       Padding="0,0,0,8">
                                    <Switch x:Name="HeadingBoldSwitch"
                                            Toggled="OnKitchenSettingChanged"/>
                                    <Label Text="Bold"
                                           FontAttributes="Bold"
                                           TextColor="#334155"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>

                                <VerticalStackLayout Grid.Row="1" Spacing="6">
                                    <Label Text="Order info"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#475569"/>
                                    <Picker x:Name="OrderInfoSizePicker"
                                            BackgroundColor="#F8FAFC"
                                            TextColor="#0F172A"
                                            SelectedIndexChanged="OnKitchenSettingChanged">
                                        <Picker.Items>
                                            <x:String>Normal</x:String>
                                            <x:String>Large</x:String>
                                            <x:String>Extra Large</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </VerticalStackLayout>

                                <HorizontalStackLayout Grid.Row="1"
                                                       Grid.Column="1"
                                                       Spacing="10"
                                                       VerticalOptions="End"
                                                       Padding="0,0,0,8">
                                    <Switch x:Name="OrderInfoBoldSwitch"
                                            Toggled="OnKitchenSettingChanged"/>
                                    <Label Text="Bold"
                                           FontAttributes="Bold"
                                           TextColor="#334155"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>

                                <VerticalStackLayout Grid.Row="2" Spacing="6">
                                    <Label Text="Section heading"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#475569"/>
                                    <Picker x:Name="SectionSizePicker"
                                            BackgroundColor="#F8FAFC"
                                            TextColor="#0F172A"
                                            SelectedIndexChanged="OnKitchenSettingChanged">
                                        <Picker.Items>
                                            <x:String>Normal</x:String>
                                            <x:String>Large</x:String>
                                            <x:String>Extra Large</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </VerticalStackLayout>

                                <HorizontalStackLayout Grid.Row="2"
                                                       Grid.Column="1"
                                                       Spacing="10"
                                                       VerticalOptions="End"
                                                       Padding="0,0,0,8">
                                    <Switch x:Name="SectionBoldSwitch"
                                            Toggled="OnKitchenSettingChanged"/>
                                    <Label Text="Bold"
                                           FontAttributes="Bold"
                                           TextColor="#334155"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Grid.Row="3"
                                                       Grid.ColumnSpan="2"
                                                       Spacing="10">
                                    <Switch x:Name="CheckedBySwitch"
                                            Toggled="OnKitchenSettingChanged"/>
                                    <Label Text="Show checked-by line"
                                           FontAttributes="Bold"
                                           TextColor="#334155"
                                           VerticalOptions="Center"/>
                                </HorizontalStackLayout>

                                <VerticalStackLayout Grid.Row="4"
                                                     Grid.ColumnSpan="2"
                                                     Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Footer text"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="#475569"/>
                                        <Label x:Name="FooterCounterLabel"
                                               Grid.Column="1"
                                               Text="0 / 60"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#64748B"/>
                                    </Grid>
                                    <Entry x:Name="FooterTextEntry"
                                           MaxLength="60"
                                           BackgroundColor="#F8FAFC"
                                           TextColor="#0F172A"
                                           Placeholder="Thank you for your order"
                                           TextChanged="OnKitchenFooterTextChanged"/>
                                    <Label x:Name="FooterWarningLabel"
                                           Text="Keep footer short: max 2 centered receipt lines."
                                           FontSize="12"
                                           TextColor="#64748B"/>
                                </VerticalStackLayout>
                            </Grid>

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="10"
                                  Margin="0,4,0,0">
                                <Button Text="Reset"
                                        BackgroundColor="#E2E8F0"
                                        TextColor="#334155"
                                        CornerRadius="8"
                                        Padding="16,10"
                                        FontAttributes="Bold"
                                        Clicked="OnResetKitchenSettingsClicked"/>
                                <Button Grid.Column="1"
                                        x:Name="SaveKitchenSettingsButton"
                                        Text="Save"
                                        BackgroundColor="#0F172A"
                                        TextColor="White"
                                        CornerRadius="8"
                                        Padding="16,10"
                                        FontAttributes="Bold"
                                        Clicked="OnSaveKitchenSettingsClicked"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border x:Name="CollectionControlsPanel"
                            BackgroundColor="White"
                            Padding="22"
                            StrokeThickness="0"
                            IsVisible="False">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="14">
                            <Label x:Name="CustomerReceiptControlsTitleLabel"
                                   Text="Collection Customise"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A"/>

                            <Grid ColumnDefinitions="*,*"
                                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                  ColumnSpacing="14"
                                  RowSpacing="12">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Business name" FontSize="13" FontAttributes="Bold" TextColor="#475569"/>
                                    <Picker x:Name="CollectionBusinessNameSizePicker" BackgroundColor="#F8FAFC" TextColor="#0F172A" SelectedIndexChanged="OnCollectionSettingChanged">
                                        <Picker.Items>
                                            <x:String>Normal</x:String>
                                            <x:String>Large</x:String>
                                            <x:String>Extra Large</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </VerticalStackLayout>
                                <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="End" Padding="0,0,0,8">
                                    <Switch x:Name="CollectionBusinessNameBoldSwitch" Toggled="OnCollectionSettingChanged"/>
                                    <Label Text="Bold" FontAttributes="Bold" TextColor="#334155" VerticalOptions="Center"/>
                                </HorizontalStackLayout>

                                <VerticalStackLayout Grid.Row="1" Spacing="6">
                                    <Label Text="Address" FontSize="13" FontAttributes="Bold" TextColor="#475569"/>
                                    <Picker x:Name="CollectionAddressSizePicker" BackgroundColor="#F8FAFC" TextColor="#0F172A" SelectedIndexChanged="OnCollectionSettingChanged">
                                        <Picker.Items>
                                            <x:String>Normal</x:String>
                                            <x:String>Large</x:String>
                                            <x:String>Extra Large</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </VerticalStackLayout>
                                <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="10" VerticalOptions="End" Padding="0,0,0,8">
                                    <Switch x:Name="CollectionAddressBoldSwitch" Toggled="OnCollectionSettingChanged"/>
                                    <Label Text="Bold" FontAttributes="Bold" TextColor="#334155" VerticalOptions="Center"/>
                                </HorizontalStackLayout>

                                <VerticalStackLayout Grid.Row="2" Spacing="6">
                                    <Label Text="Telephone" FontSize="13" FontAttributes="Bold" TextColor="#475569"/>
                                    <Picker x:Name="CollectionPhoneSizePicker" BackgroundColor="#F8FAFC" TextColor="#0F172A" SelectedIndexChanged="OnCollectionSettingChanged">
                                        <Picker.Items>
                                            <x:String>Normal</x:String>
                                            <x:String>Large</x:String>
                                            <x:String>Extra Large</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </VerticalStackLayout>
                                <HorizontalStackLayout Grid.Row="2" Grid.Column="1" Spacing="10" VerticalOptions="End" Padding="0,0,0,8">
                                    <Switch x:Name="CollectionPhoneBoldSwitch" Toggled="OnCollectionSettingChanged"/>
                                    <Label Text="Bold" FontAttributes="Bold" TextColor="#334155" VerticalOptions="Center"/>
                                </HorizontalStackLayout>

                                <VerticalStackLayout Grid.Row="3" Spacing="6">
                                    <Label Text="VAT number" FontSize="13" FontAttributes="Bold" TextColor="#475569"/>
                                    <Picker x:Name="CollectionVatSizePicker" BackgroundColor="#F8FAFC" TextColor="#0F172A" SelectedIndexChanged="OnCollectionSettingChanged">
                                        <Picker.Items>
                                            <x:String>Normal</x:String>
                                            <x:String>Large</x:String>
                                            <x:String>Extra Large</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </VerticalStackLayout>
                                <HorizontalStackLayout Grid.Row="3" Grid.Column="1" Spacing="10" VerticalOptions="End" Padding="0,0,0,8">
                                    <Switch x:Name="CollectionVatBoldSwitch" Toggled="OnCollectionSettingChanged"/>
                                    <Label Text="Bold" FontAttributes="Bold" TextColor="#334155" VerticalOptions="Center"/>
                                </HorizontalStackLayout>

                                <VerticalStackLayout Grid.Row="4" Spacing="6">
                                    <Label Text="Receipt heading" FontSize="13" FontAttributes="Bold" TextColor="#475569"/>
                                    <Picker x:Name="CollectionHeadingSizePicker" BackgroundColor="#F8FAFC" TextColor="#0F172A" SelectedIndexChanged="OnCollectionSettingChanged">
                                        <Picker.Items>
                                            <x:String>Normal</x:String>
                                            <x:String>Large</x:String>
                                            <x:String>Extra Large</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </VerticalStackLayout>
                                <HorizontalStackLayout Grid.Row="4" Grid.Column="1" Spacing="10" VerticalOptions="End" Padding="0,0,0,8">
                                    <Switch x:Name="CollectionHeadingBoldSwitch" Toggled="OnCollectionSettingChanged"/>
                                    <Label Text="Bold" FontAttributes="Bold" TextColor="#334155" VerticalOptions="Center"/>
                                </HorizontalStackLayout>

                                <VerticalStackLayout Grid.Row="5" Spacing="6">
                                    <Label Text="Order info" FontSize="13" FontAttributes="Bold" TextColor="#475569"/>
                                    <Picker x:Name="CollectionOrderInfoSizePicker" BackgroundColor="#F8FAFC" TextColor="#0F172A" SelectedIndexChanged="OnCollectionSettingChanged">
                                        <Picker.Items>
                                            <x:String>Normal</x:String>
                                            <x:String>Large</x:String>
                                            <x:String>Extra Large</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </VerticalStackLayout>
                                <HorizontalStackLayout Grid.Row="5" Grid.Column="1" Spacing="10" VerticalOptions="End" Padding="0,0,0,8">
                                    <Switch x:Name="CollectionOrderInfoBoldSwitch" Toggled="OnCollectionSettingChanged"/>
                                    <Label Text="Bold" FontAttributes="Bold" TextColor="#334155" VerticalOptions="Center"/>
                                </HorizontalStackLayout>

                                <VerticalStackLayout x:Name="CustomerNameSizeControls" Grid.Row="6" Spacing="6">
                                    <Label Text="Customer name" FontSize="13" FontAttributes="Bold" TextColor="#475569"/>
                                    <Picker x:Name="CollectionCustomerNameSizePicker" BackgroundColor="#F8FAFC" TextColor="#0F172A" SelectedIndexChanged="OnCollectionSettingChanged">
                                        <Picker.Items>
                                            <x:String>Normal</x:String>
                                            <x:String>Large</x:String>
                                            <x:String>Extra Large</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </VerticalStackLayout>
                                <HorizontalStackLayout x:Name="CustomerNameBoldControls" Grid.Row="6" Grid.Column="1" Spacing="10" VerticalOptions="End" Padding="0,0,0,8">
                                    <Switch x:Name="CollectionCustomerNameBoldSwitch" Toggled="OnCollectionSettingChanged"/>
                                    <Label Text="Bold" FontAttributes="Bold" TextColor="#334155" VerticalOptions="Center"/>
                                </HorizontalStackLayout>

                                <VerticalStackLayout x:Name="TableNumberSizeControls" Grid.Row="6" Spacing="6" IsVisible="False">
                                    <Label Text="Table number" FontSize="13" FontAttributes="Bold" TextColor="#475569"/>
                                    <Picker x:Name="TableNumberSizePicker" BackgroundColor="#F8FAFC" TextColor="#0F172A" SelectedIndexChanged="OnCollectionSettingChanged">
                                        <Picker.Items>
                                            <x:String>Normal</x:String>
                                            <x:String>Large</x:String>
                                            <x:String>Extra Large</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </VerticalStackLayout>
                                <HorizontalStackLayout x:Name="TableNumberBoldControls" Grid.Row="6" Grid.Column="1" Spacing="10" VerticalOptions="End" Padding="0,0,0,8" IsVisible="False">
                                    <Switch x:Name="TableNumberBoldSwitch" Toggled="OnCollectionSettingChanged"/>
                                    <Label Text="Bold" FontAttributes="Bold" TextColor="#334155" VerticalOptions="Center"/>
                                </HorizontalStackLayout>

                                <VerticalStackLayout x:Name="CustomerPhoneSizeControls" Grid.Row="7" Spacing="6">
                                    <Label Text="Customer phone" FontSize="13" FontAttributes="Bold" TextColor="#475569"/>
                                    <Picker x:Name="CollectionCustomerPhoneSizePicker" BackgroundColor="#F8FAFC" TextColor="#0F172A" SelectedIndexChanged="OnCollectionSettingChanged">
                                        <Picker.Items>
                                            <x:String>Normal</x:String>
                                            <x:String>Large</x:String>
                                            <x:String>Extra Large</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </VerticalStackLayout>
                                <HorizontalStackLayout x:Name="CustomerPhoneBoldControls" Grid.Row="7" Grid.Column="1" Spacing="10" VerticalOptions="End" Padding="0,0,0,8">
                                    <Switch x:Name="CollectionCustomerPhoneBoldSwitch" Toggled="OnCollectionSettingChanged"/>
                                    <Label Text="Bold" FontAttributes="Bold" TextColor="#334155" VerticalOptions="Center"/>
                                </HorizontalStackLayout>

                                <VerticalStackLayout x:Name="PaidStatusSizeControls" Grid.Row="7" Spacing="6" IsVisible="False">
                                    <Label Text="Paid status" FontSize="13" FontAttributes="Bold" TextColor="#475569"/>
                                    <Picker x:Name="PaidStatusSizePicker" BackgroundColor="#F8FAFC" TextColor="#0F172A" SelectedIndexChanged="OnCollectionSettingChanged">
                                        <Picker.Items>
                                            <x:String>Normal</x:String>
                                            <x:String>Large</x:String>
                                            <x:String>Extra Large</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </VerticalStackLayout>
                                <HorizontalStackLayout x:Name="PaidStatusBoldControls" Grid.Row="7" Grid.Column="1" Spacing="10" VerticalOptions="End" Padding="0,0,0,8" IsVisible="False">
                                    <Switch x:Name="PaidStatusBoldSwitch" Toggled="OnCollectionSettingChanged"/>
                                    <Label Text="Bold" FontAttributes="Bold" TextColor="#334155" VerticalOptions="Center"/>
                                </HorizontalStackLayout>

                                <VerticalStackLayout x:Name="DeliveryAddressSizeControls" Grid.Row="8" Spacing="6" IsVisible="False">
                                    <Label Text="Delivery address" FontSize="13" FontAttributes="Bold" TextColor="#475569"/>
                                    <Picker x:Name="DeliveryAddressSizePicker" BackgroundColor="#F8FAFC" TextColor="#0F172A" SelectedIndexChanged="OnCollectionSettingChanged">
                                        <Picker.Items>
                                            <x:String>Normal</x:String>
                                            <x:String>Large</x:String>
                                            <x:String>Extra Large</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </VerticalStackLayout>
                                <HorizontalStackLayout x:Name="DeliveryAddressBoldControls" Grid.Row="8" Grid.Column="1" Spacing="10" VerticalOptions="End" Padding="0,0,0,8" IsVisible="False">
                                    <Switch x:Name="DeliveryAddressBoldSwitch" Toggled="OnCollectionSettingChanged"/>
                                    <Label Text="Bold" FontAttributes="Bold" TextColor="#334155" VerticalOptions="Center"/>
                                </HorizontalStackLayout>

                                <VerticalStackLayout x:Name="ServiceChargeSizeControls" Grid.Row="8" Spacing="6" IsVisible="False">
                                    <Label Text="Service charge" FontSize="13" FontAttributes="Bold" TextColor="#475569"/>
                                    <Picker x:Name="ServiceChargeSizePicker" BackgroundColor="#F8FAFC" TextColor="#0F172A" SelectedIndexChanged="OnCollectionSettingChanged">
                                        <Picker.Items>
                                            <x:String>Normal</x:String>
                                            <x:String>Large</x:String>
                                            <x:String>Extra Large</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </VerticalStackLayout>
                                <HorizontalStackLayout x:Name="ServiceChargeBoldControls" Grid.Row="8" Grid.Column="1" Spacing="10" VerticalOptions="End" Padding="0,0,0,8" IsVisible="False">
                                    <Switch x:Name="ServiceChargeBoldSwitch" Toggled="OnCollectionSettingChanged"/>
                                    <Label Text="Bold" FontAttributes="Bold" TextColor="#334155" VerticalOptions="Center"/>
                                </HorizontalStackLayout>

                                <VerticalStackLayout x:Name="PaymentSizeControls" Grid.Row="9" Spacing="6">
                                    <Label x:Name="PaymentControlsLabel" Text="Payment" FontSize="13" FontAttributes="Bold" TextColor="#475569"/>
                                    <Picker x:Name="CollectionPaymentSizePicker" BackgroundColor="#F8FAFC" TextColor="#0F172A" SelectedIndexChanged="OnCollectionSettingChanged">
                                        <Picker.Items>
                                            <x:String>Normal</x:String>
                                            <x:String>Large</x:String>
                                            <x:String>Extra Large</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </VerticalStackLayout>
                                <HorizontalStackLayout x:Name="PaymentBoldControls" Grid.Row="9" Grid.Column="1" Spacing="10" VerticalOptions="End" Padding="0,0,0,8">
                                    <Switch x:Name="CollectionPaymentBoldSwitch" Toggled="OnCollectionSettingChanged"/>
                                    <Label Text="Bold" FontAttributes="Bold" TextColor="#334155" VerticalOptions="Center"/>
                                </HorizontalStackLayout>

                                <VerticalStackLayout Grid.Row="10" Grid.ColumnSpan="2" Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Footer text" FontSize="13" FontAttributes="Bold" TextColor="#475569"/>
                                        <Label x:Name="CollectionFooterCounterLabel" Grid.Column="1" Text="0 / 60" FontSize="12" FontAttributes="Bold" TextColor="#64748B"/>
                                    </Grid>
                                    <Entry x:Name="CollectionFooterTextEntry"
                                           MaxLength="60"
                                           BackgroundColor="#F8FAFC"
                                           TextColor="#0F172A"
                                           Placeholder="Thank you for your order"
                                           TextChanged="OnCollectionFooterTextChanged"/>
                                    <Label x:Name="CollectionFooterWarningLabel"
                                           Text="Keep footer short: max 2 centered receipt lines."
                                           FontSize="12"
                                           TextColor="#64748B"/>
                                </VerticalStackLayout>
                            </Grid>

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="10"
                                  Margin="0,4,0,0">
                                <Button Text="Reset"
                                        BackgroundColor="#E2E8F0"
                                        TextColor="#334155"
                                        CornerRadius="8"
                                        Padding="16,10"
                                        FontAttributes="Bold"
                                        Clicked="OnResetCollectionSettingsClicked"/>
                                <Button Grid.Column="1"
                                        x:Name="SaveCollectionSettingsButton"
                                        Text="Save"
                                        BackgroundColor="#0F172A"
                                        TextColor="White"
                                        CornerRadius="8"
                                        Padding="16,10"
                                        FontAttributes="Bold"
                                        Clicked="OnSaveCollectionSettingsClicked"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_in_NET.Views.PrintQueueManagementDialog"
             BackgroundColor="#990F172A"
             HorizontalOptions="Fill"
             VerticalOptions="Fill">
    <Grid Padding="16" HorizontalOptions="Fill" VerticalOptions="Center">
        <Border MaximumWidthRequest="640"
                HorizontalOptions="Fill"
                BackgroundColor="White"
                Stroke="#CBD5E1"
                StrokeThickness="1"
                Padding="26">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8"/>
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="20">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Manage Print Queue" FontSize="24" FontAttributes="Bold" TextColor="#0F172A"/>
                        <Label Text="Physical print jobs only" FontSize="13" TextColor="#64748B"/>
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="X" WidthRequest="42" HeightRequest="42"
                            BackgroundColor="#E2E8F0" TextColor="#334155" CornerRadius="6"
                            Clicked="OnCloseClicked"/>
                </Grid>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Scope" FontSize="12" FontAttributes="Bold" TextColor="#475569"/>
                    <Picker x:Name="ScopePicker" BackgroundColor="#F8FAFC" TextColor="#0F172A"
                            ItemDisplayBinding="{Binding DisplayName}"
                            SelectedIndexChanged="OnScopeChanged"/>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="18">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="WAITING" FontSize="11" FontAttributes="Bold" TextColor="#64748B"/>
                        <Label x:Name="WaitingCountLabel" Text="0" FontSize="28" FontAttributes="Bold" TextColor="#0F172A"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                        <Label Text="FAILED" FontSize="11" FontAttributes="Bold" TextColor="#64748B"/>
                        <Label x:Name="FailedCountLabel" Text="0" FontSize="28" FontAttributes="Bold" TextColor="#DC2626"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="3">
                        <Label Text="PRINTING" FontSize="11" FontAttributes="Bold" TextColor="#64748B"/>
                        <Label x:Name="PrintingCountLabel" Text="0" FontSize="28" FontAttributes="Bold" TextColor="#2563EB"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="3" Spacing="3">
                        <Label Text="PREVIOUS DAYS" FontSize="11" FontAttributes="Bold" TextColor="#64748B"/>
                        <Label x:Name="PreviousDayCountLabel" Text="0" FontSize="28" FontAttributes="Bold" TextColor="#D97706"/>
                    </VerticalStackLayout>
                </Grid>

                <BoxView HeightRequest="1" BackgroundColor="#E2E8F0"/>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Oldest waiting job" FontSize="12" TextColor="#64748B"/>
                        <Label x:Name="OldestJobLabel" Text="None" FontSize="14" FontAttributes="Bold" TextColor="#334155"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                        <Label Text="Last cancellation" FontSize="12" TextColor="#64748B"/>
                        <Label x:Name="LastCancellationLabel" Text="None" FontSize="14" FontAttributes="Bold" TextColor="#334155"/>
                    </VerticalStackLayout>
                </Grid>

                <Label x:Name="LoadingLabel" Text="Refreshing..." FontSize="13" TextColor="#64748B"
                       HorizontalOptions="Center" IsVisible="False"/>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="12">
                    <Button x:Name="CancelOldButton" Text="Cancel Previous Days"
                            BackgroundColor="#D97706" TextColor="White" CornerRadius="8" HeightRequest="48"
                            Clicked="OnCancelOldClicked"/>
                    <Button x:Name="CancelAllButton" Grid.Column="1" Text="Cancel All Waiting"
                            BackgroundColor="#DC2626" TextColor="White" CornerRadius="8" HeightRequest="48"
                            Clicked="OnCancelAllClicked"/>
                    <Button x:Name="RetryFailedButton" Grid.Row="1" Grid.ColumnSpan="2" Text="Retry Failed Jobs"
                            BackgroundColor="#2563EB" TextColor="White" CornerRadius="8" HeightRequest="48"
                            Clicked="OnRetryFailedClicked"/>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>

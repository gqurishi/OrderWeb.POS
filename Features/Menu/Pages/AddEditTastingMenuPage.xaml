<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_in_NET.Pages.AddEditTastingMenuPage"
             Title="Tasting Menu"
             BackgroundColor="#F1F5F9">

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" BackgroundColor="White" StrokeThickness="0" Padding="24,20">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                <Button Text="Back"
                        BackgroundColor="#E2E8F0"
                        TextColor="#334155"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        Clicked="OnBackClicked"/>
                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label x:Name="PageTitle" Text="Create Tasting Menu" FontSize="24" FontAttributes="Bold" TextColor="#0F172A"/>
                    <Label Text="Build package prices, courses, and dish choices" FontSize="13" TextColor="#64748B"/>
                </VerticalStackLayout>
                <Button Grid.Column="2"
                        x:Name="SaveButton"
                        Text="Save"
                        BackgroundColor="#0EA5E9"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        Padding="22,12"
                        Clicked="OnSaveClicked"/>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="18">
                <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="22">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Menu Details" FontSize="18" FontAttributes="Bold" TextColor="#0F172A"/>
                        <Entry x:Name="NameEntry" Placeholder="e.g., Chef's Signature Tasting Menu" FontSize="16"/>
                        <Editor x:Name="DescriptionEditor" Placeholder="Short description" AutoSize="TextChanges" MinimumHeightRequest="70"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <Entry x:Name="ColorEntry" Text="#0EA5E9" Placeholder="Color hex"/>
                            <Entry Grid.Column="1" x:Name="VatCategoryEntry" Text="HotFood" Placeholder="VAT category"/>
                        </Grid>
                        <HorizontalStackLayout Spacing="10">
                            <Switch x:Name="ActiveSwitch" IsToggled="True"/>
                            <Label Text="Active" VerticalOptions="Center" FontSize="14" TextColor="#334155"/>
                            <Switch x:Name="ManualCallSwitch" IsToggled="True" Margin="24,0,0,0"/>
                            <Label Text="Manual course calling" VerticalOptions="Center" FontSize="14" TextColor="#334155"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="22">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Price Options" FontSize="18" FontAttributes="Bold" TextColor="#0F172A"/>
                                <Label Text="Examples: 4 Course Without Wine, 4 Course With Wine" FontSize="13" TextColor="#64748B"/>
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="+ Add Option" BackgroundColor="#0EA5E9" TextColor="White" CornerRadius="10" Clicked="OnAddOptionClicked"/>
                        </Grid>
                        <VerticalStackLayout x:Name="OptionsContainer" Spacing="10"/>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="22">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Courses" FontSize="18" FontAttributes="Bold" TextColor="#0F172A"/>
                                <Label Text="Add course names and dish choices separated by commas" FontSize="13" TextColor="#64748B"/>
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="+ Add Course" BackgroundColor="#10B981" TextColor="White" CornerRadius="10" Clicked="OnAddCourseClicked"/>
                        </Grid>
                        <VerticalStackLayout x:Name="CoursesContainer" Spacing="10"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

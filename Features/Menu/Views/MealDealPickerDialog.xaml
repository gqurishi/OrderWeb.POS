<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_in_NET.Views.MealDealPickerDialog"
             BackgroundColor="{StaticResource DialogOverlayColor}"
             VerticalOptions="Fill"
             HorizontalOptions="Fill">

    <Grid VerticalOptions="Center"
          HorizontalOptions="Center"
          Padding="36">
        <Border BackgroundColor="White"
                Stroke="{StaticResource DialogShellStrokeColor}"
                StrokeThickness="1"
                Padding="0"
                MaximumWidthRequest="720"
                WidthRequest="680"
                VerticalOptions="Center"
                HorizontalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="22"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#0F172A" Opacity="0.16" Radius="20" Offset="0,8"/>
            </Border.Shadow>

            <Grid RowDefinitions="Auto,*,Auto">
                <VerticalStackLayout Grid.Row="0" Padding="30,30,30,12" Spacing="6">
                    <Border BackgroundColor="{StaticResource DialogPrimaryColor}"
                            Stroke="#FFFFFF"
                            StrokeThickness="2"
                            WidthRequest="74"
                            HeightRequest="74"
                            HorizontalOptions="Center"
                            Margin="0,0,0,8">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="37"/>
                        </Border.StrokeShape>
                        <Label Text="MD"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                    <Label x:Name="TitleLabel"
                           Text="Meal Deal"
                           Style="{StaticResource DialogTitleStyle}"/>
                    <Label x:Name="SubtitleLabel"
                           Text="Choose 2 items"
                           Style="{StaticResource DialogMessageStyle}"/>
                    <Label x:Name="SelectionStatusLabel"
                           Text="0/2 selected"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#F59E0B"
                           HorizontalOptions="Center"
                           Margin="0,8,0,0"/>
                </VerticalStackLayout>

                <ScrollView Grid.Row="1" Padding="30,0">
                    <FlexLayout x:Name="ChoicesLayout"
                                Direction="Row"
                                Wrap="Wrap"
                                JustifyContent="Start"
                                AlignItems="Start"/>
                </ScrollView>

                <Grid Grid.Row="2"
                      Padding="30"
                      ColumnDefinitions="*,*"
                      ColumnSpacing="14">
                    <Button Grid.Column="0"
                            Text="Cancel"
                            Style="{StaticResource DialogCancelButtonStyle}"
                            Clicked="OnCancelClicked"/>
                    <Button Grid.Column="1"
                            x:Name="ConfirmButton"
                            Text="Add to order"
                            Style="{StaticResource DialogPrimaryButtonStyle}"
                            IsEnabled="False"
                            Clicked="OnConfirmClicked"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentView>

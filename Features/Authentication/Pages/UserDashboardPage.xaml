<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_in_NET.Pages.UserDashboardPage"
             Title="Dashboard"
             BackgroundColor="White"
             SizeChanged="OnPageSizeChanged">

    <Grid BackgroundColor="White">
        <!-- Header -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" 
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="0">
            <Border.Shadow>
                <Shadow Brush="#E5E7EB" Radius="4" Opacity="0.1" Offset="0,2"/>
            </Border.Shadow>
            
            <Grid Padding="20" 
                  HeightRequest="90">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="mian.png"
                       WidthRequest="36"
                       HeightRequest="36"
                       Margin="0,0,18,0"
                       HorizontalOptions="Start"
                       VerticalOptions="Center">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMenuClicked"/>
                    </Image.GestureRecognizers>
                </Image>
                
                <!-- Welcome Message -->
                <StackLayout Grid.Column="1" 
                             VerticalOptions="Center">
                    <Label x:Name="WelcomeLabel"
                          Text="Welcome to" 
                           FontFamily="InterMedium" 
                           FontSize="14" 
                           TextColor="#6B7280"/>
                      <Label Text="Restaurant Name" 
                          FontFamily="InterBold" 
                          x:Name="HeaderTitleLabel"
                          FontSize="24" 
                          TextColor="#1F2937"/>
                </StackLayout>
                
                <!-- Date Time -->
                <StackLayout Grid.Column="2" 
                             VerticalOptions="Center" 
                             HorizontalOptions="End"
                             Margin="0,0,20,0">
                    <Label x:Name="DateLabel" 
                           Text="Monday, December 29, 2025" 
                           FontFamily="InterMedium" 
                           FontSize="13" 
                           TextColor="#374151"
                           HorizontalOptions="End"/>
                    <Label x:Name="TimeLabel" 
                           Text="12:43 AM" 
                           FontFamily="InterBold" 
                           FontSize="18" 
                           TextColor="#3B82F6"
                           HorizontalOptions="End"/>
                </StackLayout>
                
                <!-- Logout Button -->
                <Image Grid.Column="3"
                       Source="outred.png"
                      WidthRequest="42"
                      HeightRequest="42"
                      Margin="0,0,6,0"
                       HorizontalOptions="End"
                       VerticalOptions="Center">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLogoutClicked"/>
                    </Image.GestureRecognizers>
                </Image>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <ScrollView Grid.Row="1" 
                x:Name="MainScrollView"
                BackgroundColor="White">
            <StackLayout Spacing="0" 
                         VerticalOptions="Center"
                         x:Name="MainStackLayout"
                         Padding="30"
                         HorizontalOptions="Center"
                         MaximumWidthRequest="900">
                
                <!-- Title Removed -->
                
                <!-- Main Action Buttons - Icon Only Grid -->
                <Grid RowSpacing="80" 
                      ColumnSpacing="150"
                      x:Name="ButtonGrid"
                      Padding="0"
                      HorizontalOptions="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Restaurant Button -->
                    <Border Grid.Row="0" Grid.Column="0"
                            BackgroundColor="#EFF6FF"
                            Stroke="#BFDBFE"
                            StrokeThickness="1"
                            Padding="24"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="28"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#3B82F6" Offset="0,8" Radius="18" Opacity="0.12"/>
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRestaurantClicked"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                            <Image Source="restaurant.png" 
                                   x:Name="RestaurantIcon"
                                   WidthRequest="190" 
                                   HeightRequest="190"
                                   HorizontalOptions="Center"/>
                            <Label Text="Restaurant" 
                                   FontFamily="InterBold" 
                                   x:Name="RestaurantLabel"
                                   FontSize="18" 
                                   TextColor="#1D4ED8"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                    
                    <!-- Delivery Button -->
                    <Border Grid.Row="0" Grid.Column="1"
                            BackgroundColor="#EFF6FF"
                            Stroke="#BFDBFE"
                            StrokeThickness="1"
                            Padding="24"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="28"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#3B82F6" Offset="0,8" Radius="18" Opacity="0.12"/>
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDeliveryClicked"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                            <Image Source="delivery.png" 
                                   x:Name="DeliveryIcon"
                                   WidthRequest="190" 
                                   HeightRequest="190"
                                   HorizontalOptions="Center"/>
                            <Label Text="Delivery" 
                                   FontFamily="InterBold" 
                                   x:Name="DeliveryLabel"
                                   FontSize="18" 
                                   TextColor="#1D4ED8"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                    
                    <!-- Collection Button -->
                    <Border Grid.Row="0" Grid.Column="2"
                            BackgroundColor="#EFF6FF"
                            Stroke="#BFDBFE"
                            StrokeThickness="1"
                            Padding="24"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="28"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#3B82F6" Offset="0,8" Radius="18" Opacity="0.12"/>
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCollectionClicked"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                            <Image Source="collection.png" 
                                   x:Name="CollectionIcon"
                                   WidthRequest="190" 
                                   HeightRequest="190"
                                   HorizontalOptions="Center"/>
                            <Label Text="Collection" 
                                   FontFamily="InterBold" 
                                   x:Name="CollectionLabel"
                                   FontSize="18" 
                                   TextColor="#1D4ED8"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Live Order Button -->
                    <Border Grid.Row="1" Grid.Column="1"
                            BackgroundColor="#EFF6FF"
                            Stroke="#BFDBFE"
                            StrokeThickness="1"
                            Padding="24"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="28"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#3B82F6" Offset="0,8" Radius="18" Opacity="0.12"/>
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLiveOrderClicked"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                            <Image Source="liveorder.png"
                                   x:Name="LiveOrderIcon"
                                   WidthRequest="190"
                                   HeightRequest="190"
                                   HorizontalOptions="Center"/>
                            <Label Text="Live Order"
                                   FontFamily="InterBold"
                                   x:Name="LiveOrderLabel"
                                   FontSize="18"
                                   TextColor="#1D4ED8"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </StackLayout>
        </ScrollView>

    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:POS_in_NET.Views"
             xmlns:controls="clr-namespace:POS_in_NET.Controls"
             x:Class="POS_in_NET.Pages.UserManagementPage"
             Title=""
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,Auto,*">
        
        <!-- Top Bar -->
        <views:TopBar x:Name="TopBar" Grid.Row="0"/>
        
        <!-- Toast Notification Overlay -->
        <controls:ToastNotification x:Name="ToastNotification" 
                                   Grid.RowSpan="3"
                                   ZIndex="1000"
                                   InputTransparent="True"/>
        
        <!-- Modern Tab Bar -->
        <Frame Grid.Row="1" 
               BackgroundColor="White"
               Padding="0"
               CornerRadius="0"
               HasShadow="False"
               BorderColor="#E5E7EB">
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Padding="20,16">
                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                    <!-- Business Info Tab -->
                    <Border x:Name="BusinessTabBorder"
                            BackgroundColor="White"
                            StrokeThickness="1"
                            Stroke="#E5E7EB"
                            Padding="24,12"
                            MinimumWidthRequest="140"
                            HeightRequest="48">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBusinessTabClicked"/>
                        </Border.GestureRecognizers>
                        <Label Text="Business Info" 
                               TextColor="#6B7280"
                               FontSize="14"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"/>
                    </Border>

                    <!-- User Tab (Active) -->
                    <Border x:Name="UserTabBorder"
                            BackgroundColor="#DCFCE7"
                            StrokeThickness="2"
                            Stroke="#10B981"
                            Padding="24,12"
                            MinimumWidthRequest="100"
                            HeightRequest="48">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#10B981" Radius="8" Opacity="0.2" Offset="0,2"/>
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnUserTabClicked"/>
                        </Border.GestureRecognizers>
                        <Label Text="User" 
                               TextColor="#10B981"
                               FontSize="14"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"/>
                    </Border>

                    <!-- OrderWeb Connect Tab -->
                    <Border x:Name="CloudTabBorder"
                            BackgroundColor="White"
                            StrokeThickness="1"
                            Stroke="#E5E7EB"
                            Padding="24,12"
                            MinimumWidthRequest="160"
                            HeightRequest="48">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCloudTabClicked"/>
                        </Border.GestureRecognizers>
                        <Label Text="OrderWeb Connect" 
                               TextColor="#6B7280"
                               FontSize="14"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"/>
                    </Border>

                    <!-- Postcode Lookup Tab -->
                    <Border x:Name="PostcodeTabBorder"
                            BackgroundColor="White"
                            StrokeThickness="1"
                            Stroke="#E5E7EB"
                            Padding="24,12"
                            MinimumWidthRequest="150"
                            HeightRequest="48">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPostcodeTabClicked"/>
                        </Border.GestureRecognizers>
                        <Label Text="Postcode Lookup" 
                               TextColor="#6B7280"
                               FontSize="14"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"/>
                    </Border>
                </HorizontalStackLayout>
            </ScrollView>
        </Frame>
        
        <!-- Main Content -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="40" Spacing="28" MaximumWidthRequest="1400" HorizontalOptions="Center">

                <VerticalStackLayout Spacing="12" Margin="0,8,0,0">
                    <Label Text="User Management"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#1F2937"
                           HorizontalOptions="Start"/>
                    <Label Text="Manage your team members and their access levels"
                           FontSize="15"
                           TextColor="#6B7280"
                           HorizontalOptions="Start"/>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="1.1*,0.9*" ColumnSpacing="24" RowSpacing="24">
                    <Border Grid.Column="0"
                            BackgroundColor="White"
                            Stroke="#E5E7EB"
                            StrokeThickness="1"
                            Padding="32"
                            StrokeShape="RoundRectangle 16">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="16" Opacity="0.06" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="20">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Create User"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="#1F2937" />
                                <Label Text="Add a new employee account and assign a role"
                                       FontSize="14"
                                       TextColor="#6B7280" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="10">
                                <Label Text="Name" FontSize="14" FontAttributes="Bold" TextColor="#374151" />
                                <Border BackgroundColor="#F9FAFB" Stroke="#D1D5DB" StrokeThickness="1" Padding="14,12" StrokeShape="RoundRectangle 8">
                                    <Entry x:Name="NameEntry"
                                           Placeholder="Employee name"
                                           FontSize="15"
                                           BackgroundColor="Transparent"
                                           TextColor="#1F2937" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="10">
                                <Label Text="PIN" FontSize="14" FontAttributes="Bold" TextColor="#374151" />
                                <Border BackgroundColor="#F9FAFB" Stroke="#D1D5DB" StrokeThickness="1" Padding="14,12" StrokeShape="RoundRectangle 8">
                                    <Entry x:Name="PINEntry"
                                           Placeholder="4-digit PIN"
                                           MaxLength="4"
                                           Keyboard="Numeric"
                                           FontSize="15"
                                           BackgroundColor="Transparent"
                                           TextColor="#1F2937"
                                           TextChanged="OnPINTextChanged" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="10">
                                <Label Text="Role" FontSize="14" FontAttributes="Bold" TextColor="#374151" />
                                <Picker x:Name="RolePicker" IsVisible="False" />
                                <Button x:Name="RoleButton"
                                        Text="User"
                                        Clicked="OnRoleButtonClicked"
                                        BackgroundColor="#F3F4F6"
                                        TextColor="#111827"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        CornerRadius="10"
                                        HorizontalOptions="Start"
                                        Padding="18,12" />
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Button x:Name="CreateUserButton"
                                        Grid.Column="0"
                                        Text="Create User"
                                        Clicked="OnCreateUserClicked"
                                        BackgroundColor="#10B981"
                                        TextColor="White"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        CornerRadius="10"
                                        Padding="18,14" />
                                <Button Grid.Column="1"
                                        Text="Refresh"
                                        Clicked="OnRefreshUsersClicked"
                                        BackgroundColor="#F3F4F6"
                                        TextColor="#6B7280"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        CornerRadius="10"
                                        Padding="18,14" />
                            </Grid>

                            <Label x:Name="StatusLabel"
                                   Text=""
                                   IsVisible="False"
                                   FontSize="14"
                                   HorizontalOptions="Start" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1"
                            BackgroundColor="White"
                            Stroke="#E5E7EB"
                            StrokeThickness="1"
                            Padding="32"
                            StrokeShape="RoundRectangle 16">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="16" Opacity="0.06" />
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="18">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Team Members"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="#1F2937" />
                                <Label Text="Tap a user to edit details or manage permissions"
                                       FontSize="14"
                                       TextColor="#6B7280" />
                            </VerticalStackLayout>

                            <CollectionView x:Name="UsersCollectionView"
                                            EmptyView=""
                                            SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BackgroundColor="#F9FAFB"
                                                Stroke="#E5E7EB"
                                                StrokeThickness="1"
                                                Padding="16"
                                                Margin="0,0,0,12"
                                                StrokeShape="RoundRectangle 12">
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                                <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                                    <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="#111827" />
                                                    <Label Text="{Binding Username}" FontSize="13" TextColor="#6B7280" />
                                                </VerticalStackLayout>

                                                <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#E0F2FE" StrokeThickness="0" Padding="10,6" StrokeShape="RoundRectangle 999">
                                                    <Label Text="{Binding Role}" FontSize="12" FontAttributes="Bold" TextColor="#0284C7" />
                                                </Border>

                                                <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding CreatedAt, StringFormat='Created {0:dd MMM yyyy HH:mm}'}" FontSize="12" TextColor="#9CA3AF" />

                                                <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="10">
                                                    <Button Text="Edit"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=EditUserCommand}"
                                                            CommandParameter="{Binding .}"
                                                            BackgroundColor="#3B82F6"
                                                            TextColor="White"
                                                            FontSize="13"
                                                            CornerRadius="8"
                                                            Padding="14,10" />
                                                    <Button Text="Permissions"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=ManagePermissionsCommand}"
                                                            CommandParameter="{Binding .}"
                                                            BackgroundColor="#8B5CF6"
                                                            TextColor="White"
                                                            FontSize="13"
                                                            CornerRadius="8"
                                                            Padding="14,10" />
                                                    <Button Text="Delete"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=DeleteUserCommand}"
                                                            CommandParameter="{Binding .}"
                                                            BackgroundColor="#FEE2E2"
                                                            TextColor="#B91C1C"
                                                            FontSize="13"
                                                            CornerRadius="8"
                                                            Padding="14,10" />
                                                </HorizontalStackLayout>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <VerticalStackLayout x:Name="EmptyStateView"
                                                 IsVisible="False"
                                                 Spacing="12"
                                                 HorizontalOptions="Center"
                                                 Margin="0,32,0,0">
                                <Label Text="No users yet"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#6B7280"
                                       HorizontalOptions="Center" />
                                <Label Text="Create your first user to get started"
                                       FontSize="15"
                                       TextColor="#9CA3AF"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <ActivityIndicator x:Name="LoadingIndicator"
                                   IsVisible="False"
                                   IsRunning="False"
                                   Color="{StaticResource Primary}"
                                   HeightRequest="40"
                                   WidthRequest="40"
                                   HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
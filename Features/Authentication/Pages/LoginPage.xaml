<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_in_NET.Pages.LoginPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

    <ContentPage.Resources>
        <Style x:Key="PinKeyButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="TextColor" Value="#1A1A1A" />
            <Setter Property="BorderColor" Value="#252525" />
            <Setter Property="BorderWidth" Value="3" />
            <Setter Property="CornerRadius" Value="50" />
            <Setter Property="WidthRequest" Value="100" />
            <Setter Property="HeightRequest" Value="100" />
            <Setter Property="MinimumWidthRequest" Value="100" />
            <Setter Property="MinimumHeightRequest" Value="100" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="36" />
            <Setter Property="FontAttributes" Value="None" />
            <Setter Property="Shadow">
                <Shadow Brush="Black"
                        Radius="8"
                        Opacity="0.16"
                        Offset="0,4" />
            </Setter>
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="0.96" />
                                <Setter Property="BackgroundColor" Value="#F8FAFC" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="0.55" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <Style x:Key="PinActionButton" TargetType="Button" BasedOn="{StaticResource PinKeyButton}">
            <Setter Property="FontSize" Value="18" />
        </Style>

        <Style x:Key="PinBackspaceButton" TargetType="Button" BasedOn="{StaticResource PinKeyButton}">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="TextColor" Value="#EF4444" />
        </Style>
    </ContentPage.Resources>

    <!-- 2-Column Layout: Welcome Side + Login Side -->
    <Grid ColumnDefinitions="*,*">
        
        <!-- LEFT SIDE: Welcome/Branding Panel -->
        <Grid Grid.Column="0" 
              BackgroundColor="#F8F9FA"
              Padding="48,40">
            
            <VerticalStackLayout Spacing="58" 
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center">
                
                <!-- Logo/Brand Name -->
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Label Text="POS" 
                           FontSize="58"
                           TextColor="{StaticResource Primary}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Welcome Message -->
                <VerticalStackLayout Spacing="10" 
                                     HorizontalOptions="Center"
                                     Margin="0,20,0,0">
                    <Label Text="Welcome Back!" 
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalOptions="Center" />
                    <Label x:Name="WelcomeSubtitleLabel"
                           Text="Restaurant Name" 
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           Opacity="0.72"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           MaximumWidthRequest="300" />
                </VerticalStackLayout>

                <!-- Optional: Restaurant Info -->
                <VerticalStackLayout Spacing="8" 
                                     HorizontalOptions="Center"
                                     Margin="0,40,0,0">
                    <Label x:Name="RestaurantNameLabel"
                           Text="Restaurant Name" 
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalOptions="Center"
                           IsVisible="False" />
                    <Label x:Name="RestaurantDescriptionLabel"
                           Text="Default Location" 
                           FontSize="14"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalOptions="Center"
                           IsVisible="False" />
                </VerticalStackLayout>
                
            </VerticalStackLayout>
            
        </Grid>

        <!-- RIGHT SIDE: PIN Login Panel -->
        <Grid Grid.Column="1" 
              BackgroundColor="White"
              Padding="44,34">
            
            <ScrollView VerticalOptions="Center"
                        VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="46" 
                                     HorizontalOptions="Center"
                                     MaximumWidthRequest="430">

                    <!-- PIN Display Card -->
                    <VerticalStackLayout Spacing="28" HorizontalOptions="Center">
                        
                        <!-- Title -->
                        <Label Text="Enter your PIN or swipe employee card" 
                               FontSize="18"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />

                        <Border x:Name="TerminalStatusFrame"
                                IsVisible="False"
                                BackgroundColor="#FEF2F2"
                                Stroke="#EF4444"
                                StrokeThickness="1"
                                Padding="12,10"
                                StrokeShape="RoundRectangle 10">
                            <Label x:Name="TerminalStatusLabel"
                                   Text=""
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#B91C1C"
                                   HorizontalTextAlignment="Center"/>
                        </Border>
                        
                        <!-- PIN Dots Display -->
                        <HorizontalStackLayout Spacing="22" 
                                               HorizontalOptions="Center"
                                               Margin="0">
                            <Border x:Name="Dot1"
                                    WidthRequest="18"
                                    HeightRequest="18"
                                    BackgroundColor="#E5E7EB"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 9" />
                            <Border x:Name="Dot2"
                                    WidthRequest="18"
                                    HeightRequest="18"
                                    BackgroundColor="#E5E7EB"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 9" />
                            <Border x:Name="Dot3"
                                    WidthRequest="18"
                                    HeightRequest="18"
                                    BackgroundColor="#E5E7EB"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 9" />
                            <Border x:Name="Dot4"
                                    WidthRequest="18"
                                    HeightRequest="18"
                                    BackgroundColor="#E5E7EB"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 9" />
                        </HorizontalStackLayout>

                        <!-- Error Message -->
                        <Border x:Name="ErrorFrame"
                                IsVisible="False"
                                BackgroundColor="#FEE2E2"
                                Stroke="#EF4444"
                                StrokeThickness="1"
                                Padding="16,10"
                                StrokeShape="RoundRectangle 12"
                                HorizontalOptions="Center">
                            <Label x:Name="ErrorLabel"
                                   Text="Wrong PIN. Try again."
                                   TextColor="#DC2626"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   HorizontalTextAlignment="Center"
                                   HorizontalOptions="Center" />
                        </Border>

                        <Label x:Name="LoginStatusLabel"
                               IsVisible="False"
                               Text="Logging in..."
                               TextColor="#6366F1"
                               FontAttributes="Bold"
                               FontSize="16"
                               HorizontalTextAlignment="Center"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Hidden Entries for PIN storage -->
                    <Entry x:Name="UsernameEntry"
                           IsVisible="False"
                           Text="" />
                    <Entry x:Name="PasswordEntry"
                           IsVisible="False"
                           Text=""
                           MaxLength="4"
                           Keyboard="Numeric"
                           IsPassword="True"
                           Completed="OnPasswordCompleted" />

                    <!-- Loading Indicator -->
                    <ActivityIndicator x:Name="LoadingIndicator" 
                                       IsVisible="False" 
                                       Color="{StaticResource Primary}"
                                       HeightRequest="48"
                                       WidthRequest="48"
                                       HorizontalOptions="Center" />

                    <!-- Classic 3x4 Keypad (Like Picture 2) -->
                    <VerticalStackLayout Spacing="36"
                                         HorizontalOptions="Center">
                        
                        <!-- Classic 3x4 Keypad Grid -->
                        <Grid ColumnDefinitions="100,100,100"
                              RowDefinitions="100,100,100,100"
                              ColumnSpacing="18"
                              RowSpacing="18"
                              HorizontalOptions="Center">
                            
                            <!-- Row 1: 1, 2, 3 -->
                            <Button Grid.Row="0" Grid.Column="0"
                                    Text="1"
                                    Clicked="OnKeyClicked"
                                    Style="{StaticResource PinKeyButton}" />
                            <Button Grid.Row="0" Grid.Column="1"
                                    Text="2"
                                    Clicked="OnKeyClicked"
                                    Style="{StaticResource PinKeyButton}" />
                            <Button Grid.Row="0" Grid.Column="2"
                                    Text="3"
                                    Clicked="OnKeyClicked"
                                    Style="{StaticResource PinKeyButton}" />
                            
                            <!-- Row 2: 4, 5, 6 -->
                            <Button Grid.Row="1" Grid.Column="0"
                                    Text="4"
                                    Clicked="OnKeyClicked"
                                    Style="{StaticResource PinKeyButton}" />
                            <Button Grid.Row="1" Grid.Column="1"
                                    Text="5"
                                    Clicked="OnKeyClicked"
                                    Style="{StaticResource PinKeyButton}" />
                            <Button Grid.Row="1" Grid.Column="2"
                                    Text="6"
                                    Clicked="OnKeyClicked"
                                    Style="{StaticResource PinKeyButton}" />
                            
                            <!-- Row 3: 7, 8, 9 -->
                            <Button Grid.Row="2" Grid.Column="0"
                                    Text="7"
                                    Clicked="OnKeyClicked"
                                    Style="{StaticResource PinKeyButton}" />
                            <Button Grid.Row="2" Grid.Column="1"
                                    Text="8"
                                    Clicked="OnKeyClicked"
                                    Style="{StaticResource PinKeyButton}" />
                            <Button Grid.Row="2" Grid.Column="2"
                                    Text="9"
                                    Clicked="OnKeyClicked"
                                    Style="{StaticResource PinKeyButton}" />
                            
                            <!-- Row 4: Clear, 0, X (Backspace) -->
                            <Button Grid.Row="3" Grid.Column="0"
                                    Text="Clear"
                                    Clicked="OnClearClicked"
                                    Style="{StaticResource PinActionButton}" />
                            <Button Grid.Row="3" Grid.Column="1"
                                    Text="0"
                                    Clicked="OnKeyClicked"
                                    Style="{StaticResource PinKeyButton}" />
                            <Button Grid.Row="3" Grid.Column="2"
                                    Text="X"
                                    Clicked="OnBackspaceClicked"
                                    Style="{StaticResource PinBackspaceButton}" />
                        </Grid>
                        
                        <!-- Clock In/Out - full width (Sign In removed; PIN auto-logs in) -->
                        <Button x:Name="ClockInOutButton"
                                Text="Clock In/Out"
                                Clicked="OnClockInOutClicked"
                                BackgroundColor="#6366F1"
                                TextColor="White"
                                FontSize="22"
                                FontAttributes="None"
                                WidthRequest="334"
                                HeightRequest="58"
                                CornerRadius="29"
                                Padding="0"
                                Shadow="{Shadow Brush=#6366F1, Radius=16, Opacity=0.32, Offset='0,7'}" />
                        
                    </VerticalStackLayout>
                    
                </VerticalStackLayout>
            </ScrollView>
            
            <!-- Date & Time Display (Top Right) -->
            <VerticalStackLayout HorizontalOptions="End" 
                                 VerticalOptions="Start"
                                 Spacing="4"
                                 Margin="0,20,0,0">
                <Label x:Name="CurrentTimeLabel" 
                       Text="12:29 pm"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       HorizontalTextAlignment="End" />
                <Label x:Name="CurrentDateLabel" 
                       Text="Wednesday, Oct 22, 2025" 
                       FontSize="13"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalTextAlignment="End" />
            </VerticalStackLayout>
            
        </Grid>

    </Grid>

</ContentPage>

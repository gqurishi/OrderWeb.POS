<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_in_NET.Pages.ManagerDashboardPage"
             Title="Manager Dashboard"
             BackgroundColor="White"
             SizeChanged="OnPageSizeChanged">

    <Grid BackgroundColor="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="0">
            <Border.Shadow>
                <Shadow Brush="#E5E7EB" Radius="4" Opacity="0.1" Offset="0,2"/>
            </Border.Shadow>
            
            <Grid Padding="20" 
                  HeightRequest="98">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackLayout Grid.Column="0" 
                             VerticalOptions="Center">
                    <Label Text="Manager Dashboard" 
                           FontFamily="InterBold" 
                           FontSize="28" 
                           TextColor="#1F2937"/>
                    <Label x:Name="WelcomeLabel"
                           Text="Control Center" 
                           FontFamily="InterMedium" 
                           FontSize="14" 
                           TextColor="#6B7280"/>
                </StackLayout>
                
                <StackLayout Grid.Column="1" 
                             VerticalOptions="Center" 
                             HorizontalOptions="End"
                             Margin="0,0,20,0">
                    <Label x:Name="DateLabel" 
                           Text="Monday, December 29, 2025" 
                           FontFamily="InterMedium" 
                           FontSize="13" 
                           TextColor="#374151"
                           HorizontalOptions="End"/>
                    <Label x:Name="TimeLabel" 
                           Text="12:43 AM" 
                           FontFamily="InterBold" 
                           FontSize="18" 
                           TextColor="#3B82F6"
                           HorizontalOptions="End"/>
                </StackLayout>
                
                <Image Grid.Column="2"
                       Source="outred.png"
                       WidthRequest="42"
                       HeightRequest="42"
                       Margin="0,0,6,0"
                       HorizontalOptions="End"
                       VerticalOptions="Center">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLogoutClicked"/>
                    </Image.GestureRecognizers>
                </Image>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" 
                    x:Name="MainScrollView"
                    BackgroundColor="White">
            <StackLayout Spacing="0" 
                         VerticalOptions="Start"
                         x:Name="MainStackLayout"
                         Padding="30,26,30,30"
                         HorizontalOptions="Center"
                         MaximumWidthRequest="1200">
                <Border Stroke="#E5E7EB"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="#FCFCFD"
                        Padding="18,10"
                        Margin="0,0,0,26">
                    <Label x:Name="SummaryLabel"
                           Text="Quick access to all manager modules"
                           FontFamily="InterMedium"
                           FontSize="14"
                           TextColor="#4B5563"/>
                </Border>
                
                <Grid RowSpacing="80" 
                      ColumnSpacing="70"
                      x:Name="ButtonGrid"
                      Padding="0"
                      HorizontalOptions="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackLayout Grid.Row="0" Grid.Column="0"
                                 Padding="20"
                                 HorizontalOptions="Center">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRestaurantClicked"/>
                        </StackLayout.GestureRecognizers>
                        <Image Source="restaurant.png" 
                               x:Name="RestaurantIcon"
                               WidthRequest="220" 
                               HeightRequest="220"
                               HorizontalOptions="Center"/>
                        <Label Text="Restaurant" 
                               FontFamily="InterBold" 
                               x:Name="RestaurantLabel"
                               FontSize="16" 
                               TextColor="#1F2937"
                               HorizontalOptions="Center"
                               Margin="0,12,0,0"/>
                    </StackLayout>
                    
                    <StackLayout Grid.Row="0" Grid.Column="1"
                                 Padding="20"
                                 HorizontalOptions="Center">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDeliveryClicked"/>
                        </StackLayout.GestureRecognizers>
                        <Image Source="delivery.png" 
                               x:Name="DeliveryIcon"
                               WidthRequest="220" 
                               HeightRequest="220"
                               HorizontalOptions="Center"/>
                        <Label Text="Delivery" 
                               FontFamily="InterBold" 
                               x:Name="DeliveryLabel"
                               FontSize="16" 
                               TextColor="#1F2937"
                               HorizontalOptions="Center"
                               Margin="0,12,0,0"/>
                    </StackLayout>
                    
                    <StackLayout Grid.Row="0" Grid.Column="2"
                                 Padding="20"
                                 HorizontalOptions="Center">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCollectionClicked"/>
                        </StackLayout.GestureRecognizers>
                        <Image Source="collection.png" 
                               x:Name="CollectionIcon"
                               WidthRequest="220" 
                               HeightRequest="220"
                               HorizontalOptions="Center"/>
                        <Label Text="Collection" 
                               FontFamily="InterBold" 
                               x:Name="CollectionLabel"
                               FontSize="16" 
                               TextColor="#1F2937"
                               HorizontalOptions="Center"
                               Margin="0,12,0,0"/>
                    </StackLayout>

                    <StackLayout Grid.Row="1" Grid.Column="0"
                                 Padding="20"
                                 HorizontalOptions="Center">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLiveOrderClicked"/>
                        </StackLayout.GestureRecognizers>
                        <Image Source="liveorder.png"
                               x:Name="LiveOrderIcon"
                               WidthRequest="220"
                               HeightRequest="220"
                               HorizontalOptions="Center"/>
                        <Label Text="Live Order"
                               FontFamily="InterBold"
                               x:Name="LiveOrderLabel"
                               FontSize="16"
                               TextColor="#1F2937"
                               HorizontalOptions="Center"
                               Margin="0,12,0,0"/>
                    </StackLayout>

                    <StackLayout Grid.Row="1" Grid.Column="1"
                                 Padding="20"
                                 HorizontalOptions="Center">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnWebOrdersClicked"/>
                        </StackLayout.GestureRecognizers>
                        <Image Source="weborders.png"
                               x:Name="WebOrdersIcon"
                               WidthRequest="160"
                               HeightRequest="160"
                               HorizontalOptions="Center"/>
                        <Label Text="Web Orders"
                               FontFamily="InterBold"
                               x:Name="WebOrdersLabel"
                               FontSize="16"
                               TextColor="#1F2937"
                               HorizontalOptions="Center"
                               Margin="0,12,0,0"/>
                    </StackLayout>

                    <StackLayout Grid.Row="1" Grid.Column="2"
                                 Padding="20"
                                 HorizontalOptions="Center">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGiftCardsClicked"/>
                        </StackLayout.GestureRecognizers>
                        <Image Source="giftcards.png"
                               x:Name="GiftCardsIcon"
                               WidthRequest="160"
                               HeightRequest="160"
                               HorizontalOptions="Center"/>
                        <Label Text="Gift Cards"
                               FontFamily="InterBold"
                               x:Name="GiftCardsLabel"
                               FontSize="16"
                               TextColor="#1F2937"
                               HorizontalOptions="Center"
                               Margin="0,12,0,0"/>
                    </StackLayout>

                    <StackLayout Grid.Row="2" Grid.Column="0"
                                 Padding="20"
                                 HorizontalOptions="Center">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLoyaltyClicked"/>
                        </StackLayout.GestureRecognizers>
                        <Image Source="loyalty.png"
                               x:Name="LoyaltyIcon"
                               WidthRequest="160"
                               HeightRequest="160"
                               HorizontalOptions="Center"/>
                        <Label Text="Loyalty"
                               FontFamily="InterBold"
                               x:Name="LoyaltyLabel"
                               FontSize="16"
                               TextColor="#1F2937"
                               HorizontalOptions="Center"
                               Margin="0,12,0,0"/>
                    </StackLayout>

                    <StackLayout Grid.Row="2" Grid.Column="1"
                                 Padding="20"
                                 HorizontalOptions="Center">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnReservationClicked"/>
                        </StackLayout.GestureRecognizers>
                        <Image Source="reservation.png"
                               x:Name="ReservationIcon"
                               WidthRequest="160"
                               HeightRequest="160"
                               HorizontalOptions="Center"/>
                        <Label Text="Reservation"
                               FontFamily="InterBold"
                               x:Name="ReservationLabel"
                               FontSize="16"
                               TextColor="#1F2937"
                               HorizontalOptions="Center"
                               Margin="0,12,0,0"/>
                    </StackLayout>

                    <StackLayout Grid.Row="2" Grid.Column="2"
                                 Padding="20"
                                 HorizontalOptions="Center">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOrderHistoryClicked"/>
                        </StackLayout.GestureRecognizers>
                        <Image Source="orderhistory.png"
                               x:Name="OrderHistoryIcon"
                               WidthRequest="160"
                               HeightRequest="160"
                               HorizontalOptions="Center"/>
                        <Label Text="Order History"
                               FontFamily="InterBold"
                               x:Name="OrderHistoryLabel"
                               FontSize="16"
                               TextColor="#1F2937"
                               HorizontalOptions="Center"
                               Margin="0,12,0,0"/>
                    </StackLayout>
                </Grid>
            </StackLayout>
        </ScrollView>

    </Grid>
</ContentPage>

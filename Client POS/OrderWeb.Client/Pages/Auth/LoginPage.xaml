<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:layout="clr-namespace:OrderWeb.Client.Views.Layout"
             x:Class="OrderWeb.Client.Pages.Auth.LoginPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#FFFFFF"
             Title="Login">
    <Grid ColumnDefinitions="*,*"
          BackgroundColor="#FFFFFF">
        <Grid BackgroundColor="#F6F9FC"
              Padding="60,40">
            <VerticalStackLayout Spacing="40"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <Label Text="POS"
                       FontSize="56"
                       FontAttributes="Bold"
                       TextColor="#6366F1"
                       HorizontalTextAlignment="Center" />
                <Label Text="Welcome Back!"
                       FontFamily="InterBold"
                       FontSize="32"
                       TextColor="#1F2937"
                       HorizontalTextAlignment="Center" />
                <Label x:Name="RestaurantNameLabel"
                       Text="Restaurant POS"
                       FontFamily="InterBold"
                       FontSize="24"
                       TextColor="#1F2937"
                       Opacity="0.72"
                       HorizontalTextAlignment="Center" />
                <layout:ConnectionStatusView x:Name="ConnectionStatus"
                                             Status="Connected"
                                             IsVisible="False"
                                             HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Column="1"
              RowDefinitions="100,*"
              Padding="50,62,70,70"
              BackgroundColor="#FFFFFF">
            <VerticalStackLayout HorizontalOptions="End"
                                 Spacing="4">
                <Label x:Name="LoginDateLabel"
                       Text="Tuesday, August 18, 2026"
                       FontFamily="InterMedium"
                       FontSize="13"
                       TextColor="#374151"
                       HorizontalTextAlignment="End" />
                <Label x:Name="LoginTimeLabel"
                       Text="10:43:04"
                       FontFamily="InterBold"
                       FontSize="18"
                       TextColor="#3B82F6"
                       HorizontalTextAlignment="End" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="1"
                                 Spacing="34"
                                 MaximumWidthRequest="500"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <Label Text="Enter your PIN or swipe employee card"
                       FontFamily="OpenSansRegular"
                       FontSize="18"
                       TextColor="#374151"
                       HorizontalTextAlignment="Center" />
                <Label x:Name="StatusLabel"
                       IsVisible="False"
                       FontFamily="OpenSansSemibold"
                       FontSize="16"
                       TextColor="#DC2626"
                       HorizontalTextAlignment="Center" />
                <HorizontalStackLayout x:Name="PinDots"
                                       Spacing="24"
                                       Margin="0,16,0,0"
                                       HorizontalOptions="Center" />
                <Grid x:Name="KeypadGrid"
                      ColumnDefinitions="100,100,100"
                      RowDefinitions="100,100,100,100"
                      ColumnSpacing="18"
                      RowSpacing="18"
                      HorizontalOptions="Center" />
                <Button Text="Clock In/Out"
                        BackgroundColor="#6366F1"
                        TextColor="#FFFFFF"
                        FontFamily="OpenSansSemibold"
                        FontSize="22"
                        CornerRadius="32"
                        HeightRequest="64"
                        WidthRequest="420"
                        HorizontalOptions="Center"
                        Clicked="OnClockInOutClicked" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>

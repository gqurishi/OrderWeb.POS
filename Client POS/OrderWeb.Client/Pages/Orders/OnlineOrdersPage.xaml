<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:layout="clr-namespace:OrderWeb.Client.Views.Layout"
             xmlns:online="clr-namespace:OrderWeb.Client.Views.OnlineOrders"
             x:Class="OrderWeb.Client.Pages.Orders.OnlineOrdersPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#FFFFFF"
             Title="Online Orders">
    <Grid RowDefinitions="90,*"
          BackgroundColor="#FFFFFF">
        <layout:ClientTopBar x:Name="TopBar"
                             RestaurantName="Restaurant POS" />

        <Grid Grid.Row="1"
              RowDefinitions="Auto,*"
              Padding="32,28,32,80"
              RowSpacing="22">
            <VerticalStackLayout MaximumWidthRequest="1240"
                                 HorizontalOptions="Center"
                                 Spacing="4">
                <Label Text="Online Orders"
                       FontFamily="InterBold"
                       FontSize="28"
                       TextColor="#1F2937" />
                <Label x:Name="StatusLabel"
                       Text="Web and app orders from cache"
                       FontFamily="OpenSansRegular"
                       FontSize="14"
                       TextColor="#6B7280" />
            </VerticalStackLayout>

            <online:OnlineOrderDetailsView x:Name="OrderDetails"
                                           Grid.Row="1"
                                           MaximumWidthRequest="1240"
                                           HorizontalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>

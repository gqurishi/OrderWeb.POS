<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:layout="clr-namespace:OrderWeb.Client.Views.Layout"
             x:Class="OrderWeb.Client.Pages.Orders.CollectionOrderPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC"
             Title="Collection Order">

    <Grid RowDefinitions="90,*" BackgroundColor="#F8FAFC">
        <layout:ClientTopBar x:Name="TopBar" RestaurantName="Restaurant POS" />

        <Grid Grid.Row="1"
              Padding="44"
              RowDefinitions="Auto,*,Auto">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="0,1">
                <GradientStop Color="#FBFCFE"
                              Offset="0" />
                <GradientStop Color="#F3F6FA"
                              Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <VerticalStackLayout Grid.Row="0"
                             Spacing="12"
                             HorizontalOptions="Center"
                             Margin="0,24,0,34">
            <Label Text="Collection Order"
                   FontFamily="AlegreyaBold"
                   FontSize="40"
                   HorizontalOptions="Center"
                   TextColor="#111827" />
            <Label Text="Customer Information"
                   FontFamily="OpenSansSemibold"
                   FontSize="17"
                   HorizontalOptions="Center"
                   TextColor="#64748B" />
            <BoxView HeightRequest="3"
                     WidthRequest="66"
                     BackgroundColor="#10B981"
                     HorizontalOptions="Center"
                     CornerRadius="2" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="26"
                                 WidthRequest="560"
                                 HorizontalOptions="Center">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Customer Name"
                           FontFamily="OpenSansSemibold"
                           FontSize="15"
                           TextColor="#475569" />
                    <Border BackgroundColor="White"
                            Stroke="#CBD5E1"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14"
                            Padding="0">
                        <Entry x:Name="CustomerNameEntry"
                               Placeholder="e.g., John Smith"
                               FontFamily="OpenSansRegular"
                               FontSize="16"
                               TextColor="#111827"
                               PlaceholderColor="#94A3B8"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="Never"
                               HeightRequest="58"
                               Margin="18,0" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Phone Number"
                           FontFamily="OpenSansSemibold"
                           FontSize="15"
                           TextColor="#475569" />
                    <Border BackgroundColor="White"
                            Stroke="#CBD5E1"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14"
                            Padding="0">
                        <Entry x:Name="PhoneNumberEntry"
                               Placeholder="e.g., 07123 456789"
                               Keyboard="Telephone"
                               FontFamily="OpenSansRegular"
                               FontSize="16"
                               TextColor="#111827"
                               PlaceholderColor="#94A3B8"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="Never"
                               HeightRequest="58"
                               Margin="18,0" />
                    </Border>
                </VerticalStackLayout>

                <Button x:Name="SearchButton"
                        Text="Search Existing Customer"
                        Clicked="OnSearchClicked"
                        BackgroundColor="#3B82F6"
                        TextColor="White"
                        FontFamily="OpenSansSemibold"
                        FontSize="16"
                        HeightRequest="58"
                        CornerRadius="14">
                    <Button.Shadow>
                        <Shadow Brush="#2563EB"
                                Opacity="0.22"
                                Radius="12"
                                Offset="0,6" />
                    </Button.Shadow>
                </Button>

                <Label x:Name="NoResultsLabel"
                       Text="No existing customer found. You can continue to create a new collection customer."
                       IsVisible="False"
                       FontFamily="OpenSansRegular"
                       FontSize="14"
                       TextColor="#64748B"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap" />

                <Border x:Name="SearchResultsBorder"
                        IsVisible="False"
                        BackgroundColor="White"
                        Stroke="#D8E1EC"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="0">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="Select Existing Customer"
                               FontFamily="OpenSansSemibold"
                               FontSize="14"
                               TextColor="#334155"
                               Padding="16,14,16,10" />

                        <CollectionView x:Name="SearchResultsCollection"
                                        SelectionMode="Single"
                                        SelectionChanged="OnCustomerSelected"
                                        MaximumHeightRequest="240">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="16,12"
                                          ColumnDefinitions="*,Auto"
                                          BackgroundColor="White">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="{Binding Name}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="15"
                                                   TextColor="#111827" />
                                            <Label Text="{Binding Phone}"
                                                   FontFamily="OpenSansRegular"
                                                   FontSize="13"
                                                   TextColor="#64748B" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1"
                                                Text="Use"
                                                Clicked="OnCustomerTapped"
                                                BackgroundColor="#ECFDF5"
                                                TextColor="#047857"
                                                FontFamily="OpenSansSemibold"
                                                FontSize="13"
                                                HeightRequest="38"
                                                WidthRequest="72"
                                                CornerRadius="14"
                                                VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <Label x:Name="StatusLabel"
                       Text=""
                       IsVisible="False"
                       FontFamily="OpenSansRegular"
                       FontSize="14"
                       TextColor="#64748B"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2"
              ColumnDefinitions="*,*"
              ColumnSpacing="18"
              WidthRequest="560"
              HorizontalOptions="Center"
              Margin="0,26,0,16">
            <Button Text="Cancel"
                    Clicked="OnCancelClicked"
                    BackgroundColor="White"
                    BorderColor="#CBD5E1"
                    BorderWidth="1"
                    TextColor="#334155"
                    FontFamily="OpenSansRegular"
                    FontSize="16"
                    HeightRequest="58"
                    CornerRadius="14" />

            <Button Grid.Column="1"
                    Text="Continue to Order"
                    Clicked="OnContinueClicked"
                    BackgroundColor="#10B981"
                    TextColor="White"
                    FontFamily="OpenSansSemibold"
                    FontSize="16"
                    HeightRequest="58"
                    CornerRadius="14">
                <Button.Shadow>
                    <Shadow Brush="#059669"
                            Opacity="0.2"
                            Radius="12"
                            Offset="0,6" />
                </Button.Shadow>
            </Button>
        </Grid>
        </Grid>

        <Grid x:Name="SidebarLayer"
              Grid.RowSpan="2"
              IsVisible="False"
              BackgroundColor="Transparent">
            <BoxView BackgroundColor="#01FFFFFF">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackdropTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <layout:ClientSidebar x:Name="Sidebar"
                                  Role="Manager"
                                  SelectedMenu="Collection"
                                  ShowFooter="True"
                                  TranslationX="-280"
                                  HorizontalOptions="Start" />
        </Grid>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:layout="clr-namespace:OrderWeb.Client.Views.Layout"
             x:Class="OrderWeb.Client.Pages.Manager.CashDrawerPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F6F8FB"
             Title="Cash Drawer">
    <Grid RowDefinitions="90,*"
          BackgroundColor="#F6F8FB">
        <layout:ClientTopBar x:Name="TopBar"
                             RestaurantName="Restaurant POS" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="32,34,32,60"
                                 Spacing="22"
                                 MaximumWidthRequest="1120"
                                 HorizontalOptions="Center">
                <Label Text="Cash Drawer"
                       FontFamily="InterBold"
                       FontSize="32"
                       TextColor="#0F172A"
                       HorizontalTextAlignment="Center" />

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="22"
                      Margin="0,18,0,0">
                    <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14"
                            Padding="22">
                        <VerticalStackLayout Spacing="18">
                            <Label Text="Drawer Control"
                                   FontFamily="OpenSansBold"
                                   FontSize="22"
                                   TextColor="#1E293B" />

                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="14">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Mother POS drawer"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="15"
                                           TextColor="#1E293B" />
                                    <Label x:Name="ConnectionLabel"
                                           Text="Connected"
                                           FontSize="13"
                                           TextColor="#64748B" />
                                </VerticalStackLayout>

                                <Border x:Name="StatusPill"
                                        Grid.Column="1"
                                        BackgroundColor="#ECFDF5"
                                        StrokeThickness="0"
                                        Padding="16,8"
                                        VerticalOptions="Center"
                                        StrokeShape="RoundRectangle 18">
                                    <Label x:Name="StatusLabel"
                                           Text="Ready"
                                           FontFamily="OpenSansBold"
                                           FontSize="13"
                                           TextColor="#059669" />
                                </Border>
                            </Grid>

                            <Label Text="Request Mother POS to open the configured receipt-printer cash drawer."
                                   FontSize="15"
                                   TextColor="#64748B"
                                   LineBreakMode="WordWrap" />

                            <Button x:Name="OpenDrawerButton"
                                    Text="Open Cash Drawer"
                                    BackgroundColor="#10B981"
                                    TextColor="White"
                                    FontFamily="OpenSansBold"
                                    FontSize="18"
                                    CornerRadius="10"
                                    HeightRequest="62"
                                    Clicked="OnOpenDrawerClicked" />

                            <Button Text="Refresh"
                                    BackgroundColor="#F1F5F9"
                                    TextColor="#1E293B"
                                    FontFamily="OpenSansBold"
                                    FontSize="16"
                                    CornerRadius="10"
                                    HeightRequest="52"
                                    Clicked="OnRefreshClicked" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1"
                            BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14"
                            Padding="22">
                        <VerticalStackLayout Spacing="16">
                            <Label Text="Recent Activity"
                                   FontFamily="OpenSansBold"
                                   FontSize="22"
                                   TextColor="#1E293B" />

                            <Label x:Name="EmptyActivityLabel"
                                   Text="No cash drawer requests yet."
                                   FontSize="15"
                                   TextColor="#94A3B8"
                                   Margin="0,12,0,0" />

                            <CollectionView x:Name="ActivityCollection"
                                            SelectionMode="None"
                                            MaximumHeightRequest="420">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BackgroundColor="#F8FAFC"
                                                Stroke="#E5E7EB"
                                                StrokeThickness="1"
                                                StrokeShape="RoundRectangle 8"
                                                Padding="14,12"
                                                Margin="0,0,0,10">
                                            <Grid ColumnDefinitions="*,118"
                                                  ColumnSpacing="12">
                                                <VerticalStackLayout Spacing="4">
                                                    <Label Text="{Binding TimeText}"
                                                           FontFamily="OpenSansBold"
                                                           FontSize="15"
                                                           TextColor="#1E293B" />
                                                    <Label Text="{Binding Message}"
                                                           FontSize="12"
                                                           TextColor="#64748B"
                                                           LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                                <Border Grid.Column="1"
                                                        BackgroundColor="{Binding BadgeBackground}"
                                                        StrokeThickness="0"
                                                        Padding="12,7"
                                                        StrokeShape="RoundRectangle 16"
                                                        VerticalOptions="Center">
                                                    <Label Text="{Binding Status}"
                                                           FontFamily="OpenSansBold"
                                                           FontSize="12"
                                                           TextColor="{Binding BadgeText}"
                                                           HorizontalTextAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <Grid x:Name="SidebarLayer"
              Grid.RowSpan="2"
              IsVisible="False"
              BackgroundColor="Transparent">
            <BoxView BackgroundColor="#01FFFFFF">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackdropTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <layout:ClientSidebar x:Name="Sidebar"
                                  Role="Manager"
                                  SelectedMenu="Cash Drawer"
                                  ShowFooter="True"
                                  TranslationX="-280"
                                  HorizontalOptions="Start" />
        </Grid>
    </Grid>
</ContentPage>

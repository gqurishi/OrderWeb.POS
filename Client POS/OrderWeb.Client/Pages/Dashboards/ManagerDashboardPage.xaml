<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:layout="clr-namespace:OrderWeb.Client.Views.Layout"
             x:Class="OrderWeb.Client.Pages.Dashboards.ManagerDashboardPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#FFFFFF"
             Title="Manager Dashboard">
    <Grid x:Name="Root"
          BackgroundColor="#FFFFFF">
        <Grid RowDefinitions="90,*"
              BackgroundColor="#FFFFFF">
            <layout:ClientTopBar x:Name="TopBar"
                                 RestaurantName="Restaurant POS" />

            <ScrollView Grid.Row="1">
                <VerticalStackLayout x:Name="DashboardContent"
                                     Padding="30"
                                     Spacing="0"
                                     MaximumWidthRequest="900"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <Grid x:Name="MainActionsGrid"
                          ColumnDefinitions="Auto,Auto,Auto"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="150"
                          RowSpacing="80"
                          HorizontalOptions="Center">
                        <Border BackgroundColor="Transparent"
                                Stroke="Transparent"
                                StrokeThickness="0"
                                Padding="24"
                                HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="28" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRestaurantTapped" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="14"
                                                 HorizontalOptions="Center">
                                <Image x:Name="RestaurantIcon"
                                       Source="restaurant.png"
                                       WidthRequest="190"
                                       HeightRequest="190"
                                       Aspect="AspectFit" />
                                <Label Text="Restaurant"
                                       FontFamily="InterBold"
                                       FontSize="18"
                                       TextColor="#1D4ED8"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1"
                                BackgroundColor="Transparent"
                                Stroke="Transparent"
                                StrokeThickness="0"
                                Padding="24"
                                HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="28" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDeliveryTapped" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="14"
                                                 HorizontalOptions="Center">
                                <Image x:Name="DeliveryIcon"
                                       Source="delivery.png"
                                       WidthRequest="190"
                                       HeightRequest="190"
                                       Aspect="AspectFit" />
                                <Label Text="Delivery"
                                       FontFamily="InterBold"
                                       FontSize="18"
                                       TextColor="#1D4ED8"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="2"
                                BackgroundColor="Transparent"
                                Stroke="Transparent"
                                StrokeThickness="0"
                                Padding="24"
                                HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="28" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCollectionTapped" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="14"
                                                 HorizontalOptions="Center">
                                <Image x:Name="CollectionIcon"
                                       Source="collection.png"
                                       WidthRequest="190"
                                       HeightRequest="190"
                                       Aspect="AspectFit" />
                                <Label Text="Collection"
                                       FontFamily="InterBold"
                                       FontSize="18"
                                       TextColor="#1D4ED8"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1"
                                Grid.Column="1"
                                BackgroundColor="Transparent"
                                Stroke="Transparent"
                                StrokeThickness="0"
                                Padding="24"
                                HorizontalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="28" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLiveOrderTapped" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="14"
                                                 HorizontalOptions="Center">
                                <Image x:Name="LiveOrderIcon"
                                       Source="liveorder.png"
                                       WidthRequest="190"
                                       HeightRequest="190"
                                       Aspect="AspectFit" />
                                <Label Text="Live Order"
                                       FontFamily="InterBold"
                                       FontSize="18"
                                       TextColor="#1D4ED8"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <Grid x:Name="SidebarLayer"
              IsVisible="False"
              BackgroundColor="Transparent">
            <BoxView BackgroundColor="#01FFFFFF"
                     Margin="280,0,0,0">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSidebarBackdropTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <layout:ClientSidebar x:Name="Sidebar"
                                  Role="Manager"
                                  SelectedMenu="Dashboard"
                                  ShowFooter="True"
                                  TranslationX="-280"
                                  HorizontalOptions="Start" />
        </Grid>
    </Grid>
</ContentPage>

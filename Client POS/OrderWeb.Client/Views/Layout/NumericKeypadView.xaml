<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OrderWeb.Client.Views.Layout.NumericKeypadView">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
          ColumnDefinitions="Auto,Auto,Auto"
          RowSpacing="10"
          ColumnSpacing="10">
        <Button Text="1" />
        <Button Grid.Column="1" Text="2" />
        <Button Grid.Column="2" Text="3" />
        <Button Grid.Row="1" Text="4" />
        <Button Grid.Row="1" Grid.Column="1" Text="5" />
        <Button Grid.Row="1" Grid.Column="2" Text="6" />
        <Button Grid.Row="2" Text="7" />
        <Button Grid.Row="2" Grid.Column="1" Text="8" />
        <Button Grid.Row="2" Grid.Column="2" Text="9" />
        <Button Grid.Row="3" Grid.Column="1" Text="0" />
    </Grid>
</ContentView>

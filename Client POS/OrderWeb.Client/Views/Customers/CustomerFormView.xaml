<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OrderWeb.Client.Views.Customers.CustomerFormView"
             BackgroundColor="Transparent">
    <Border BackgroundColor="#F8FAFC"
            Stroke="#E5E7EB"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 8"
            Padding="18">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
              RowSpacing="14">
            <Label Text="Customer Details"
                   FontFamily="OpenSansSemibold"
                   FontSize="22"
                   TextColor="#1F2937" />

            <Grid Grid.Row="1"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="14">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Customer Name"
                           FontFamily="OpenSansRegular"
                           FontSize="14"
                           TextColor="#374151" />
                    <Border BackgroundColor="#FFFFFF"
                            Stroke="#CBD5E1"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="12,0">
                        <Entry x:Name="NameEntry"
                               Placeholder="Customer name"
                               BackgroundColor="Transparent"
                               FontFamily="OpenSansRegular"
                               FontSize="15"
                               HeightRequest="50" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="6">
                    <Label Text="Phone Number"
                           FontFamily="OpenSansRegular"
                           FontSize="14"
                           TextColor="#374151" />
                    <Border BackgroundColor="#FFFFFF"
                            Stroke="#CBD5E1"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="12,0">
                        <Entry x:Name="PhoneEntry"
                               Placeholder="Phone number"
                               BackgroundColor="Transparent"
                               FontFamily="OpenSansRegular"
                               FontSize="15"
                               HeightRequest="50"
                               Keyboard="Telephone" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Grid.Row="2"
                                 Spacing="6">
                <Label Text="Pickup Time"
                       FontFamily="OpenSansRegular"
                       FontSize="14"
                       TextColor="#374151" />
                <Border BackgroundColor="#FFFFFF"
                        Stroke="#CBD5E1"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="12,0">
                    <Entry x:Name="PickupTimeEntry"
                           Placeholder="ASAP / 19:30"
                           BackgroundColor="Transparent"
                           FontFamily="OpenSansRegular"
                           FontSize="15"
                           HeightRequest="50" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="3"
                                 Spacing="6">
                <Label Text="Order Notes"
                       FontFamily="OpenSansRegular"
                       FontSize="14"
                       TextColor="#374151" />
                <Border BackgroundColor="#FFFFFF"
                        Stroke="#CBD5E1"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="12,6">
                    <Editor x:Name="NotesEditor"
                            Placeholder="Customer/order notes"
                            BackgroundColor="Transparent"
                            FontFamily="OpenSansRegular"
                            FontSize="15"
                            AutoSize="TextChanges"
                            HeightRequest="90" />
                </Border>
            </VerticalStackLayout>

            <Button Grid.Row="4"
                    Text="Continue to Order"
                    BackgroundColor="#6366F1"
                    TextColor="#FFFFFF"
                    FontFamily="OpenSansSemibold"
                    FontSize="16"
                    CornerRadius="8"
                    HeightRequest="52"
                    Clicked="OnContinueClicked" />
        </Grid>
    </Border>
</ContentView>

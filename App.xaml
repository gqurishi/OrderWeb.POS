<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:POS_in_NET"
             xmlns:converters="clr-namespace:POS_in_NET.Converters"
             xmlns:helpers="clr-namespace:POS_in_NET.Helpers"
             x:Class="POS_in_NET.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                
                <!-- OrderWeb.net Design System -->
                <ResourceDictionary Source="Resources/Styles/OrderWebColors.xaml" />
                <ResourceDictionary Source="Resources/Styles/OrderWebStyles.xaml" />
                
                <!-- Syncfusion Modern Theme (NEW!) -->
                <ResourceDictionary Source="Resources/Styles/SyncfusionTheme.xaml" />
                <ResourceDictionary Source="Resources/Styles/DialogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- App-wide responsive values; ResponsiveLayout updates these per window size. -->
            <Thickness x:Key="ResponsivePagePadding">16</Thickness>
            <Thickness x:Key="ResponsiveCompactPadding">16,14</Thickness>
            <Thickness x:Key="ResponsiveCardMargin">16,10,16,0</Thickness>
            <Thickness x:Key="ResponsiveDialogMargin">12</Thickness>
            <Thickness x:Key="ResponsiveDialogPadding">20</Thickness>
            <x:Double x:Key="ResponsiveSafeBottom">14</x:Double>
            <x:Double x:Key="ResponsiveSectionSpacing">14</x:Double>
            <x:Double x:Key="ResponsiveTextScale">1</x:Double>
            <x:Double x:Key="ResponsiveLongListHeight">520</x:Double>
            <x:Double x:Key="ResponsiveDialogBodyHeight">540</x:Double>

            <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
                <Setter Property="helpers:ResponsiveLayout.Enabled" Value="True" />
            </Style>
            
            <!-- Global Font Family - Modern Sans-Serif (OpenSans) -->
            <Style TargetType="Label" ApplyToDerivedTypes="True">
                <Setter Property="FontFamily" Value="OpenSansRegular" />
            </Style>
            <Style TargetType="Button" ApplyToDerivedTypes="True">
                <Setter Property="FontFamily" Value="OpenSansRegular" />
            </Style>
            <Style TargetType="Entry" ApplyToDerivedTypes="True">
                <Setter Property="FontFamily" Value="OpenSansRegular" />
            </Style>
            <Style TargetType="Editor" ApplyToDerivedTypes="True">
                <Setter Property="FontFamily" Value="OpenSansRegular" />
            </Style>
            <Style TargetType="Picker" ApplyToDerivedTypes="True">
                <Setter Property="FontFamily" Value="OpenSansRegular" />
            </Style>
            
            <!-- Value Converters -->
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

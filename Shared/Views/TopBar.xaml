<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_in_NET.Views.TopBar"
             MinimumHeightRequest="82">

    <Grid RowDefinitions="Auto,*">
        <Border x:Name="MotherDisconnectedBanner"
                Grid.Row="0"
                BackgroundColor="#FEF2F2"
                Stroke="#FECACA"
                StrokeThickness="1"
                Padding="12,8"
                IsVisible="False">
            <Label x:Name="MotherDisconnectedLabel"
                   Text="Mother terminal disconnected"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="#B91C1C"
                   HorizontalOptions="Center"/>
        </Border>

    <Border x:Name="HeaderBorder"
            Grid.Row="1"
            BackgroundColor="#F6F9FC"
            StrokeThickness="0"
            HeightRequest="88">
        
        <Grid x:Name="HeaderGrid"
              Padding="16,0"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="12">
            
            <!-- Left Side - Hamburger Menu (Z-Index on top) -->
            <HorizontalStackLayout Grid.Column="0" 
                                   VerticalOptions="Center"
                                   HorizontalOptions="Start"
                                   Spacing="15"
                                   ZIndex="2">
                <!-- Hamburger Menu Button -->
                <ImageButton Source="mian.png"
                             WidthRequest="32"
                             HeightRequest="32"
                             BackgroundColor="Transparent"
                             Clicked="OnMenuClicked"
                             ToolTipProperties.Text="Open Menu"/>
            </HorizontalStackLayout>
            
            <!-- Center Section - Page Title (Absolutely Centered) -->
            <VerticalStackLayout Grid.Column="1"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 ZIndex="1">
                <Label x:Name="PageTitleLabel"
                       Text=""
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#1F2937"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="TailTruncation"
                       MaxLines="1"/>
            </VerticalStackLayout>
            
            <!-- Right Side - Date/Time (Z-Index on top) -->
            <HorizontalStackLayout Grid.Column="2"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center"
                                   Spacing="10"
                                   ZIndex="2">
                
                <!-- Custom Content Placeholder (for Web Orders page) -->
                <ContentPresenter x:Name="CustomContentPresenter" 
                                  VerticalOptions="Center"
                                  IsVisible="False" />
                
                <VerticalStackLayout x:Name="ClockLayout" Spacing="1">
                    <!-- Date and Time -->
                    <Label x:Name="DateTimeLabel"
                           Text="Wednesday, October 15, 2025"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#1F2937"
                           HorizontalOptions="End"/>
                    
                    <Label x:Name="TimeLabel"
                           Text="23:47:54"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#0369A1"
                           HorizontalOptions="End"/>
                    
                    <HorizontalStackLayout HorizontalOptions="End"
                                           Spacing="8"
                                           Margin="0,4,0,0">
                        <Button Text="-"
                                WidthRequest="34"
                                HeightRequest="34"
                                MinimumWidthRequest="34"
                                Padding="0"
                                CornerRadius="0"
                                BackgroundColor="Transparent"
                                BorderColor="Transparent"
                                BorderWidth="0"
                                TextColor="#111827"
                                FontSize="22"
                                FontAttributes="Bold"
                                Clicked="OnMinimizeClicked"
                                ToolTipProperties.Text="Minimize POS"/>

                        <!-- Logout Icon Button -->
                        <ImageButton Source="outred.png"
                                     WidthRequest="36"
                                     HeightRequest="36"
                                     BackgroundColor="Transparent"
                                     HorizontalOptions="End"
                                     Clicked="OnLogoutClicked"
                                     ToolTipProperties.Text="Logout"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </HorizontalStackLayout>
            
        </Grid>
    </Border>
    </Grid>
</ContentView>

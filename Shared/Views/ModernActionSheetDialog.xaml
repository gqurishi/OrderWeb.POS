<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_in_NET.Views.ModernActionSheetDialog"
             BackgroundColor="#80000000"
             VerticalOptions="Fill"
             HorizontalOptions="Fill">
    
    <Grid VerticalOptions="Center"
          HorizontalOptions="Center"
          Padding="40">
        <Border x:Name="DialogBorder"
                BackgroundColor="White"
                Stroke="#DCE3EE"
                StrokeThickness="1"
                Padding="30"
                WidthRequest="450"
                VerticalOptions="Center"
                HorizontalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="22"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#0F172A" Opacity="0.16" Radius="20" Offset="0,8"/>
            </Border.Shadow>
            <VerticalStackLayout Spacing="20">
                
                <!-- Icon -->
                <Border x:Name="IconBorder"
                    BackgroundColor="#2563EB"
                    Stroke="#FFFFFF"
                    StrokeThickness="2"
                        WidthRequest="80"
                        HeightRequest="80"
                        HorizontalOptions="Center"
                        Margin="0,0,0,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="40"/>
                    </Border.StrokeShape>
                    <Label x:Name="IconLabel"
                              Text="i"
                              FontSize="30"
                              FontAttributes="Bold"
                              TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>
                
                <!-- Title -->
                <Label x:Name="TitleLabel"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#1F2937"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>
                
                <!-- Options Container -->
                <VerticalStackLayout x:Name="OptionsContainer"
                                   Spacing="10"
                                   Margin="0,10,0,10"/>

                <Grid x:Name="GridOptionsContainer"
                      IsVisible="False"
                      ColumnDefinitions="*,*"
                      RowSpacing="12"
                      ColumnSpacing="12"
                      Margin="0,10,0,10"/>
                
                <!-- Cancel Button -->
                <Button x:Name="CancelButton"
                        Text="Cancel"
                        BackgroundColor="#E2E8F0"
                        TextColor="#334155"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="50"
                        FontSize="16"
                        Clicked="OnCancelClicked" />
                
            </VerticalStackLayout>
        </Border>
    </Grid>
    
</ContentView>

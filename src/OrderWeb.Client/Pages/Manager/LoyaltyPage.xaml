<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:layout="clr-namespace:OrderWeb.Client.Views.Layout"
             xmlns:sharedViews="clr-namespace:OrderWeb.SharedUI.Views;assembly=OrderWeb.SharedUI"
             x:Class="OrderWeb.Client.Pages.Manager.LoyaltyPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             NavigationPage.HasBackButton="False"
             BackgroundColor="#F8FAFC"
             Title="Loyalty Points">
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False" />
    </Shell.BackButtonBehavior>
    <Grid RowDefinitions="Auto,*" BackgroundColor="#F8FAFC">
        <!-- Same PosHeader page-title chrome as Mother Loyalty Points. -->
        <layout:ClientTopBar x:Name="TopBar" />

        <!-- Mother Close (top-right) — return to dashboard. -->
        <Button Grid.Row="1"
                Text="Close"
                BackgroundColor="#FEF2F2"
                BorderColor="#FCA5A5"
                BorderWidth="1"
                TextColor="#DC2626"
                FontAttributes="None"
                FontSize="14"
                WidthRequest="72"
                HeightRequest="40"
                CornerRadius="12"
                Padding="0"
                Margin="0,20,32,0"
                HorizontalOptions="End"
                VerticalOptions="Start"
                ZIndex="10"
                ToolTipProperties.Text="Close"
                Clicked="OnCloseClicked" />

        <sharedViews:LoyaltyView x:Name="Loyalty" Grid.Row="1" />

        <Grid x:Name="SidebarLayer" Grid.RowSpan="2" IsVisible="False" BackgroundColor="Transparent">
            <BoxView BackgroundColor="Transparent">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackdropTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <layout:ClientSidebar x:Name="Sidebar" HorizontalOptions="Start" TranslationX="-280" Role="Manager" SelectedMenu="Loyalty Points" ShowFooter="True" />
        </Grid>
    </Grid>
</ContentPage>

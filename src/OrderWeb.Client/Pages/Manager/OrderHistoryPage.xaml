<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:layout="clr-namespace:OrderWeb.Client.Views.Layout"
             x:Class="OrderWeb.Client.Pages.Manager.OrderHistoryPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#FFFFFF"
             Title="Order History">
    <Grid RowDefinitions="90,*" BackgroundColor="#FFFFFF">
        <layout:ClientTopBar x:Name="TopBar" RestaurantName="Restaurant POS" />
        <ContentView x:Name="ContentHost" Grid.Row="1" />

        <Grid x:Name="SidebarLayer" Grid.RowSpan="2" IsVisible="False" BackgroundColor="Transparent">
            <BoxView BackgroundColor="Transparent">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackdropTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <layout:ClientSidebar x:Name="Sidebar" HorizontalOptions="Start" TranslationX="-280" Role="Manager" SelectedMenu="Order History" ShowFooter="True" />
        </Grid>
    </Grid>
</ContentPage>

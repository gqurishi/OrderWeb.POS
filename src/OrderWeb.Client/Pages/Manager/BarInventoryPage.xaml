<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:layout="clr-namespace:OrderWeb.Client.Views.Layout"
             xmlns:sharedViews="clr-namespace:OrderWeb.SharedUI.Views;assembly=OrderWeb.SharedUI"
             x:Class="OrderWeb.Client.Pages.Manager.BarInventoryPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC"
             Title="Bar Inventory">
    <Grid RowDefinitions="Auto,*" BackgroundColor="#F8FAFC">
        <layout:ClientTopBar x:Name="TopBar" ZIndex="5" />

        <sharedViews:BarInventoryView x:Name="Inventory" Grid.Row="1" ZIndex="0" />

        <Grid x:Name="SidebarLayer" Grid.RowSpan="2" ZIndex="6" IsVisible="False" BackgroundColor="Transparent">
            <BoxView BackgroundColor="Transparent">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackdropTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <layout:ClientSidebar x:Name="Sidebar"
                                  HorizontalOptions="Start"
                                  TranslationX="-280"
                                  Role="BarManager"
                                  SelectedMenu="Bar Inventory"
                                  ShowFooter="True" />
        </Grid>
    </Grid>
</ContentPage>

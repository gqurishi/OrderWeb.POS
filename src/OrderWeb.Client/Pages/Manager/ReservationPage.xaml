<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:layout="clr-namespace:OrderWeb.Client.Views.Layout"
             xmlns:sharedViews="clr-namespace:OrderWeb.SharedUI.Views;assembly=OrderWeb.SharedUI"
             x:Class="OrderWeb.Client.Pages.Manager.ReservationPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             NavigationPage.HasBackButton="False"
             BackgroundColor="#F8FAFC"
             Title="Reservation">
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False" />
    </Shell.BackButtonBehavior>
    <Grid x:Name="RootGrid" RowDefinitions="Auto,*" BackgroundColor="#F8FAFC">
        <layout:ClientTopBar x:Name="TopBar"
                             Grid.Row="0"
                             ZIndex="30"
                             RestaurantName="Reservation"
                             ShowConnectionStatus="True"
                             ConnectionStatus="Connected" />

        <sharedViews:ReservationView x:Name="Reservation"
                                     Grid.Row="1"
                                     VerticalOptions="Fill"
                                     HorizontalOptions="Fill" />

        <Grid x:Name="SidebarLayer"
              Grid.RowSpan="2"
              ZIndex="10"
              IsVisible="False"
              InputTransparent="True"
              BackgroundColor="Transparent">
            <BoxView BackgroundColor="Transparent">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackdropTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <layout:ClientSidebar x:Name="Sidebar"
                                  HorizontalOptions="Start"
                                  TranslationX="-280"
                                  Role="Manager"
                                  SelectedMenu="Reservation"
                                  ShowFooter="True" />
        </Grid>
    </Grid>
</ContentPage>

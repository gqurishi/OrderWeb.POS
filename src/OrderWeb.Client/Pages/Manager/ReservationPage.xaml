<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:layout="clr-namespace:OrderWeb.Client.Views.Layout"
             x:Class="OrderWeb.Client.Pages.Manager.ReservationPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F6F8FB"
             Title="Reservation">
    <Grid x:Name="RootGrid" RowDefinitions="150,*" BackgroundColor="#F6F8FB">
        <Border Grid.Row="0" BackgroundColor="#F6F9FC" StrokeThickness="0">
            <Grid Padding="20,0" ColumnDefinitions="120,*,270">
                <ImageButton x:Name="MenuButton"
                             Source="mian.png"
                             WidthRequest="35"
                             HeightRequest="35"
                             Padding="0"
                             BackgroundColor="Transparent"
                             Aspect="AspectFit"
                             HorizontalOptions="Start"
                             VerticalOptions="Center"
                             Clicked="OnMenuClicked" />

                <Label Grid.Column="1"
                       Text="Reservation"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="#1F2937"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />

                <VerticalStackLayout Grid.Column="2"
                                     Spacing="5"
                                     VerticalOptions="Center"
                                     HorizontalOptions="End">
                    <Label x:Name="DateLabel"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#1F2937"
                           HorizontalTextAlignment="End"
                           HorizontalOptions="End" />
                    <Label x:Name="TimeLabel"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#0369A1"
                           HorizontalTextAlignment="End"
                           HorizontalOptions="End" />
                    <ImageButton Source="outred.png"
                                 WidthRequest="40"
                                 HeightRequest="40"
                                 Padding="0"
                                 Margin="0,10,0,0"
                                 BackgroundColor="Transparent"
                                 Aspect="AspectFit"
                                 HorizontalOptions="End"
                                 Clicked="OnLogoutClicked" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Padding="22"
              ColumnDefinitions="390,*"
              RowDefinitions="Auto,*"
              ColumnSpacing="20"
              RowSpacing="16">

            <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="*,*,*,Auto" ColumnSpacing="12">
                <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" Padding="18,16" StrokeShape="RoundRectangle 12">
                    <Border.Shadow>
                        <Shadow Brush="#CBD5E1" Radius="8" Opacity="0.06" Offset="0,2" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Bookings Today" FontSize="12" FontAttributes="Bold" TextColor="#64748B" />
                        <Label Text="{Binding TodayCountText}" FontSize="26" FontAttributes="Bold" TextColor="#0F172A" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" Padding="18,16" StrokeShape="RoundRectangle 12">
                    <Border.Shadow>
                        <Shadow Brush="#CBD5E1" Radius="8" Opacity="0.06" Offset="0,2" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="People Today" FontSize="12" FontAttributes="Bold" TextColor="#64748B" />
                        <Label Text="{Binding GuestCountText}" FontSize="26" FontAttributes="Bold" TextColor="#0F766E" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="2" BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" Padding="18,16" StrokeShape="RoundRectangle 12">
                    <Border.Shadow>
                        <Shadow Brush="#CBD5E1" Radius="8" Opacity="0.06" Offset="0,2" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Next Booking" FontSize="12" FontAttributes="Bold" TextColor="#64748B" />
                        <Label Text="{Binding NextReservationText}" FontSize="26" FontAttributes="Bold" TextColor="#1D4ED8" />
                    </VerticalStackLayout>
                </Border>

                <HorizontalStackLayout Grid.Column="3" Spacing="10" VerticalOptions="Center">
                    <Button Text="Update"
                            BackgroundColor="#EEF2FF"
                            TextColor="#3730A3"
                            FontAttributes="Bold"
                            FontSize="16"
                            CornerRadius="12"
                            HeightRequest="56"
                            WidthRequest="118"
                            Clicked="OnUpdateClicked" />
                    <Button Text="+ New"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="16"
                            CornerRadius="12"
                            HeightRequest="56"
                            WidthRequest="118"
                            Clicked="OnNewReservationClicked" />
                </HorizontalStackLayout>
            </Grid>

            <Border Grid.Row="1"
                    Grid.Column="0"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    Padding="18"
                    StrokeShape="RoundRectangle 18">
                <Border.Shadow>
                    <Shadow Brush="#CBD5E1" Radius="10" Opacity="0.06" Offset="0,2" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Button Text="‹"
                                WidthRequest="42"
                                HeightRequest="38"
                                BackgroundColor="#F1F5F9"
                                TextColor="#0F172A"
                                CornerRadius="10"
                                Clicked="OnPreviousMonthClicked" />
                        <Label Grid.Column="1"
                               Text="{Binding CalendarMonthText}"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#0F172A"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        <Button Grid.Column="2"
                                Text="›"
                                WidthRequest="42"
                                HeightRequest="38"
                                BackgroundColor="#F1F5F9"
                                TextColor="#0F172A"
                                CornerRadius="10"
                                Clicked="OnNextMonthClicked" />
                    </Grid>

                    <Button Text="Today"
                            BackgroundColor="#EFF6FF"
                            TextColor="#1D4ED8"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="38"
                            Clicked="OnTodayClicked" />

                    <Grid ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="4">
                        <Label Text="Mon" FontSize="12" FontAttributes="Bold" TextColor="#64748B" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="1" Text="Tue" FontSize="12" FontAttributes="Bold" TextColor="#64748B" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="2" Text="Wed" FontSize="12" FontAttributes="Bold" TextColor="#64748B" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="3" Text="Thu" FontSize="12" FontAttributes="Bold" TextColor="#64748B" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="4" Text="Fri" FontSize="12" FontAttributes="Bold" TextColor="#64748B" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="5" Text="Sat" FontSize="12" FontAttributes="Bold" TextColor="#64748B" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="6" Text="Sun" FontSize="12" FontAttributes="Bold" TextColor="#64748B" HorizontalTextAlignment="Center" />
                    </Grid>

                    <CollectionView x:Name="CalendarCollectionView"
                                    ItemsSource="{Binding CalendarDays}"
                                    SelectionMode="Single"
                                    SelectionChanged="OnCalendarDaySelected"
                                    HeightRequest="398"
                                    ItemSizingStrategy="MeasureFirstItem">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="7" HorizontalItemSpacing="4" VerticalItemSpacing="4" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{Binding BackgroundColor}"
                                        Stroke="{Binding BorderColor}"
                                        StrokeThickness="1"
                                        Padding="6"
                                        HeightRequest="61"
                                        StrokeShape="RoundRectangle 10">
                                    <Label Text="{Binding DayText}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{Binding TextColor}"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="14">
                <Border BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        Padding="16,14"
                        StrokeShape="RoundRectangle 18">
                    <Border.Shadow>
                        <Shadow Brush="#CBD5E1" Radius="10" Opacity="0.06" Offset="0,2" />
                    </Border.Shadow>
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding SelectedDateDisplay}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#0F172A" />
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="{Binding SyncStatusText}"
                                           FontSize="12"
                                           TextColor="#64748B" />
                                    <Label Text="{Binding LastUpdatedText}"
                                           FontSize="12"
                                           TextColor="#94A3B8" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <ActivityIndicator Grid.Column="1"
                                               WidthRequest="24"
                                               HeightRequest="24"
                                               IsRunning="{Binding IsLoading}"
                                               IsVisible="{Binding IsLoading}"
                                               Color="#2563EB"
                                               VerticalOptions="Center" />
                            <Button Grid.Column="2"
                                    Text="Today"
                                    BackgroundColor="#F1F5F9"
                                    TextColor="#0F172A"
                                    FontAttributes="Bold"
                                    CornerRadius="10"
                                    HeightRequest="40"
                                    WidthRequest="90"
                                    Clicked="OnTodayClicked" />
                        </Grid>

                        <Border Grid.Row="1"
                                BackgroundColor="#F8FAFC"
                                Stroke="#CBD5E1"
                                StrokeThickness="1"
                                Padding="12,8"
                                StrokeShape="RoundRectangle 10">
                            <Entry x:Name="SearchEntry"
                                   Placeholder="Search name or phone"
                                   BackgroundColor="Transparent"
                                   TextColor="#0F172A"
                                   PlaceholderColor="#94A3B8"
                                   FontSize="14"
                                   Keyboard="Text"
                                   TextChanged="OnSearchTextChanged" />
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        Padding="0"
                        StrokeShape="RoundRectangle 18">
                    <Border.Shadow>
                        <Shadow Brush="#CBD5E1" Radius="10" Opacity="0.06" Offset="0,2" />
                    </Border.Shadow>
                    <Grid>
                        <CollectionView ItemsSource="{Binding Reservations}"
                                        SelectionMode="None"
                                        ItemSizingStrategy="MeasureAllItems">
                            <CollectionView.EmptyView>
                                <VerticalStackLayout Padding="40" Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="No reservations for this date"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#0F172A"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="Website reservations will appear here when Mother POS syncs."
                                           FontSize="14"
                                           TextColor="#64748B"
                                           HorizontalTextAlignment="Center" />
                                    <Button Text="Update Reservations"
                                            BackgroundColor="#EEF2FF"
                                            TextColor="#3730A3"
                                            FontAttributes="Bold"
                                            CornerRadius="12"
                                            HeightRequest="44"
                                            WidthRequest="190"
                                            Clicked="OnUpdateClicked" />
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="8,4"
                                            BackgroundColor="White"
                                            Stroke="#E2E8F0"
                                            StrokeThickness="1"
                                            Padding="10"
                                            StrokeShape="RoundRectangle 12">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnReservationRowTapped" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="76,*,310"
                                              ColumnSpacing="12">
                                            <Border BackgroundColor="#EFF6FF"
                                                    Stroke="#BFDBFE"
                                                    StrokeThickness="1"
                                                    Padding="6"
                                                    HeightRequest="56"
                                                    StrokeShape="RoundRectangle 10"
                                                    VerticalOptions="Center">
                                                <VerticalStackLayout Spacing="1" HorizontalOptions="Center" VerticalOptions="Center">
                                                    <Label Text="{Binding TimeText}"
                                                           FontSize="18"
                                                           FontAttributes="Bold"
                                                           TextColor="#1D4ED8"
                                                           HorizontalTextAlignment="Center" />
                                                    <Label Text="{Binding SourceDisplay}"
                                                           FontSize="10"
                                                           FontAttributes="Bold"
                                                           TextColor="#64748B"
                                                           HorizontalTextAlignment="Center"
                                                           LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                                <Label Text="{Binding Name}"
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       TextColor="#0F172A"
                                                       LineBreakMode="TailTruncation"
                                                       VerticalOptions="Center" />
                                                <FlexLayout Wrap="Wrap"
                                                            Direction="Row"
                                                            AlignItems="Start"
                                                            JustifyContent="Start">
                                                    <Border BackgroundColor="#ECFDF5"
                                                            Stroke="#BBF7D0"
                                                            StrokeThickness="1"
                                                            Padding="6,2"
                                                            Margin="0,0,4,2"
                                                            StrokeShape="RoundRectangle 8">
                                                        <Label Text="{Binding GuestsText}" FontSize="11" FontAttributes="Bold" TextColor="#047857" />
                                                    </Border>
                                                    <Border BackgroundColor="#EEF2FF"
                                                            Stroke="#C7D2FE"
                                                            StrokeThickness="1"
                                                            Padding="6,2"
                                                            Margin="0,0,4,2"
                                                            StrokeShape="RoundRectangle 8">
                                                        <Label Text="{Binding TableDisplay}" FontSize="11" FontAttributes="Bold" TextColor="#3730A3" />
                                                    </Border>
                                                    <Border BackgroundColor="#F8FAFC"
                                                            Stroke="#E2E8F0"
                                                            StrokeThickness="1"
                                                            Padding="6,2"
                                                            Margin="0,0,4,2"
                                                            StrokeShape="RoundRectangle 8">
                                                        <Label Text="{Binding PhoneDisplay}" FontSize="11" TextColor="#334155" WidthRequest="112" LineBreakMode="TailTruncation" />
                                                    </Border>
                                                    <Border BackgroundColor="#EFF6FF"
                                                            Stroke="#BFDBFE"
                                                            StrokeThickness="1"
                                                            Padding="6,2"
                                                            Margin="0,0,4,2"
                                                            StrokeShape="RoundRectangle 8"
                                                            IsVisible="{Binding HasPromoCode}">
                                                        <Label Text="{Binding PromoBadgeText}" FontSize="11" FontAttributes="Bold" TextColor="#1D4ED8" />
                                                    </Border>
                                                    <Border BackgroundColor="#FFF7ED"
                                                            Stroke="#FED7AA"
                                                            StrokeThickness="1"
                                                            Padding="6,2"
                                                            Margin="0,0,4,2"
                                                            StrokeShape="RoundRectangle 8"
                                                            IsVisible="{Binding HasAllergies}">
                                                        <Label Text="Allergies" FontSize="10" FontAttributes="Bold" TextColor="#C2410C" />
                                                    </Border>
                                                    <Border BackgroundColor="#F0FDF4"
                                                            Stroke="#BBF7D0"
                                                            StrokeThickness="1"
                                                            Padding="6,2"
                                                            Margin="0,0,4,2"
                                                            StrokeShape="RoundRectangle 8"
                                                            IsVisible="{Binding HasSpecialRequests}">
                                                        <Label Text="Special" FontSize="10" FontAttributes="Bold" TextColor="#047857" />
                                                    </Border>
                                                </FlexLayout>
                                            </VerticalStackLayout>

                                            <HorizontalStackLayout Grid.Column="2"
                                                                   Spacing="4"
                                                                   HorizontalOptions="End"
                                                                   VerticalOptions="Center">
                                                <Border BackgroundColor="{Binding StatusBadgeBackground}"
                                                        Stroke="{Binding StatusBadgeBorder}"
                                                        StrokeThickness="1"
                                                        Padding="7,2"
                                                        HeightRequest="30"
                                                        WidthRequest="82"
                                                        StrokeShape="RoundRectangle 8"
                                                        VerticalOptions="Center">
                                                    <Label Text="{Binding Status}"
                                                           FontSize="10"
                                                           FontAttributes="Bold"
                                                           TextColor="{Binding StatusBadgeTextColor}"
                                                           HorizontalTextAlignment="Center"
                                                           VerticalTextAlignment="Center"
                                                           LineBreakMode="TailTruncation" />
                                                </Border>
                                                <Button Text="{Binding ShowButtonText}"
                                                        BackgroundColor="{Binding ShowButtonBackground}"
                                                        TextColor="{Binding ShowButtonTextColor}"
                                                        BorderColor="{Binding ShowButtonBorderColor}"
                                                        BorderWidth="1"
                                                        FontAttributes="Bold"
                                                        FontSize="11"
                                                        CornerRadius="8"
                                                        HeightRequest="30"
                                                        WidthRequest="64"
                                                        Padding="0"
                                                        IsVisible="{Binding IsShowButtonVisible}"
                                                        IsEnabled="{Binding IsShowButtonEnabled}"
                                                        Clicked="OnReservationShowClicked" />
                                                <Button Text="Details"
                                                        BackgroundColor="#EFF6FF"
                                                        TextColor="#1D4ED8"
                                                        BorderColor="#BFDBFE"
                                                        BorderWidth="1"
                                                        FontAttributes="Bold"
                                                        FontSize="11"
                                                        CornerRadius="8"
                                                        HeightRequest="30"
                                                        WidthRequest="66"
                                                        Padding="0"
                                                        Clicked="OnReservationDetailsClicked" />
                                                <Button Text="{Binding NoShowButtonText}"
                                                        BackgroundColor="{Binding NoShowButtonBackground}"
                                                        TextColor="{Binding NoShowButtonTextColor}"
                                                        BorderColor="{Binding NoShowButtonBorderColor}"
                                                        BorderWidth="1"
                                                        FontAttributes="Bold"
                                                        FontSize="11"
                                                        CornerRadius="8"
                                                        HeightRequest="30"
                                                        WidthRequest="76"
                                                        Padding="0"
                                                        IsVisible="{Binding IsNoShowButtonVisible}"
                                                        IsEnabled="{Binding IsNoShowButtonEnabled}"
                                                        Clicked="OnReservationNoShowClicked" />
                                                <Button Text="{Binding CancelButtonText}"
                                                        BackgroundColor="{Binding CancelButtonBackground}"
                                                        TextColor="{Binding CancelButtonTextColor}"
                                                        BorderColor="{Binding CancelButtonBorderColor}"
                                                        BorderWidth="1"
                                                        FontAttributes="Bold"
                                                        FontSize="11"
                                                        CornerRadius="8"
                                                        HeightRequest="30"
                                                        WidthRequest="66"
                                                        Padding="0"
                                                        IsVisible="{Binding IsCancelButtonVisible}"
                                                        IsEnabled="{Binding IsCancelButtonEnabled}"
                                                        Clicked="OnReservationCancelClicked" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="SidebarLayer" Grid.RowSpan="2" IsVisible="False" BackgroundColor="Transparent">
            <BoxView BackgroundColor="Transparent">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackdropTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <layout:ClientSidebar x:Name="Sidebar" HorizontalOptions="Start" TranslationX="-280" Role="Manager" SelectedMenu="Reservation" ShowFooter="True" />
        </Grid>

        <Grid Grid.RowSpan="2"
              BackgroundColor="#990F172A"
              IsVisible="{Binding IsDetailsVisible}"
              InputTransparent="False">
            <Border BackgroundColor="White"
                    Stroke="#CBD5E1"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="24"
                    WidthRequest="620"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="#0F172A" Radius="18" Opacity="0.18" Offset="0,8" />
                </Border.Shadow>
                <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                      RowSpacing="18">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Reservation Details"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A" />
                            <Label Text="{Binding SelectedReservation.DateTimeText}"
                                   FontSize="15"
                                   TextColor="#64748B" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="X"
                                BackgroundColor="#FEE2E2"
                                TextColor="#DC2626"
                                BorderColor="#FECACA"
                                BorderWidth="1"
                                FontAttributes="Bold"
                                FontSize="18"
                                CornerRadius="24"
                                HeightRequest="48"
                                WidthRequest="48"
                                Padding="0"
                                Clicked="OnCloseDetailsClicked" />
                    </Grid>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="*,*"
                          ColumnSpacing="14">
                        <Border BackgroundColor="#F8FAFC"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                Padding="18"
                                StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Guest" FontSize="13" FontAttributes="Bold" TextColor="#64748B" />
                                <Label Text="{Binding SelectedReservation.Name}" FontSize="22" FontAttributes="Bold" TextColor="#0F172A" />
                                <Label Text="{Binding SelectedReservation.PhoneDisplay}" FontSize="15" TextColor="#334155" />
                                <Label Text="{Binding SelectedReservation.EmailDisplay}" FontSize="15" TextColor="#334155" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1"
                                BackgroundColor="#F0FDF4"
                                Stroke="#86EFAC"
                                StrokeThickness="1"
                                Padding="18"
                                StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Booking" FontSize="13" FontAttributes="Bold" TextColor="#047857" />
                                <Label Text="{Binding SelectedReservation.GuestsText}" FontSize="18" FontAttributes="Bold" TextColor="#0F766E" />
                                <Label Text="{Binding SelectedReservation.TableDisplay}" FontSize="16" TextColor="#334155" />
                                <Label Text="{Binding SelectedReservation.StatusDisplay}" FontSize="16" TextColor="#334155" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2"
                          ColumnDefinitions="*,*"
                          ColumnSpacing="14">
                        <Border BackgroundColor="#EFF6FF"
                                Stroke="#BFDBFE"
                                StrokeThickness="1"
                                Padding="18"
                                StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Promocode" FontSize="13" FontAttributes="Bold" TextColor="#1D4ED8" />
                                <Label Text="{Binding SelectedReservation.PromoCodeDisplay}" FontSize="18" FontAttributes="Bold" TextColor="#1E3A8A" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1"
                                BackgroundColor="#FFF7ED"
                                Stroke="#FED7AA"
                                StrokeThickness="1"
                                Padding="18"
                                StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Allergies / dietary" FontSize="13" FontAttributes="Bold" TextColor="#C2410C" />
                                <Label Text="{Binding SelectedReservation.AllergiesDisplay}" FontSize="16" TextColor="#0F172A" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Border Grid.Row="3"
                            BackgroundColor="#F8FAFC"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="18"
                            StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Special requests" FontSize="13" FontAttributes="Bold" TextColor="#64748B" />
                            <Label Text="{Binding SelectedReservation.SpecialRequestsDisplay}"
                                   FontSize="16"
                                   TextColor="#0F172A"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:layout="clr-namespace:OrderWeb.Client.Views.Layout"
             x:Class="OrderWeb.Client.Pages.Orders.OrderPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             NavigationPage.HasBackButton="False"
             BackgroundColor="#F1F5F9"
             Title="Order">
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False" />
    </Shell.BackButtonBehavior>
    <Grid BackgroundColor="#F1F5F9">
        <layout:ClientTopBar x:Name="TopBar"
                             IsVisible="False"
                             HeightRequest="0"
                             InputTransparent="True"
                             ShowConnectionStatus="True" />
        <Grid ColumnDefinitions="Auto,*"
              ColumnSpacing="6"
              Padding="8">
            <ImageButton x:Name="OrderPlaceMenuButton"
                         Source="mian.png"
                         WidthRequest="40"
                         HeightRequest="40"
                         BackgroundColor="Transparent"
                         VerticalOptions="Start"
                         Margin="0,4,0,0"
                         Clicked="OnOrderPlaceMenuClicked"/>
            <!-- SharedUI Order Place shell (Phase 8) -->
            <ContentView x:Name="ShellHost"
                         Grid.Column="1" />
        </Grid>
    </Grid>
</ContentPage>

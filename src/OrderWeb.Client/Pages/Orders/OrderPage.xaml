<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:layout="clr-namespace:OrderWeb.Client.Views.Layout"
             x:Class="OrderWeb.Client.Pages.Orders.OrderPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             NavigationPage.HasBackButton="False"
             BackgroundColor="#F1F5F9"
             Title="Order">
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False" />
    </Shell.BackButtonBehavior>
    <!-- Full-bleed Order Place; flyout menu lives inside SharedUI category toolbar (Mother parity). -->
    <Grid BackgroundColor="#F1F5F9"
          SizeChanged="OnOrderPageSizeChanged">
        <layout:ClientTopBar x:Name="TopBar"
                             IsVisible="False"
                             HeightRequest="0"
                             InputTransparent="True"
                             ShowConnectionStatus="True" />

        <Grid x:Name="MainContentGrid" Padding="4">
            <ContentView x:Name="ShellHost" />
        </Grid>

        <!-- Same Client POS sidebar as Gift Cards / Live Order (not empty Shell flyout). -->
        <Grid x:Name="SidebarLayer"
              IsVisible="False"
              InputTransparent="True"
              ZIndex="80"
              BackgroundColor="Transparent">
            <BoxView x:Name="SidebarBackdrop"
                     BackgroundColor="#66000000"
                     InputTransparent="False">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSidebarBackdropTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <layout:ClientSidebar x:Name="Sidebar"
                                  HorizontalOptions="Start"
                                  TranslationX="-280"
                                  Role="User"
                                  SelectedMenu="Restaurant"
                                  ShowFooter="True" />
        </Grid>
    </Grid>
</ContentPage>

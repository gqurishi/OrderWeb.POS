<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:layout="clr-namespace:OrderWeb.Client.Views.Layout"
             x:Class="OrderWeb.Client.Pages.Orders.DeliveryOrderPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8F9FA"
             Title="Delivery Order">

    <Grid RowDefinitions="90,*" BackgroundColor="#F8F9FA">
        <layout:ClientTopBar x:Name="TopBar" RestaurantName="Restaurant POS" />
        <ContentView x:Name="ContentHost" Grid.Row="1" />

        <Grid x:Name="SidebarLayer"
              Grid.RowSpan="2"
              IsVisible="False"
              BackgroundColor="Transparent">
            <BoxView BackgroundColor="#01FFFFFF">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackdropTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <layout:ClientSidebar x:Name="Sidebar"
                                  Role="Manager"
                                  SelectedMenu="Delivery"
                                  ShowFooter="True"
                                  TranslationX="-280"
                                  HorizontalOptions="Start" />
        </Grid>
    </Grid>
</ContentPage>

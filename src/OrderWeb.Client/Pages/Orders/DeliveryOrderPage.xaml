<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:layout="clr-namespace:OrderWeb.Client.Views.Layout"
             xmlns:models="clr-namespace:OrderWeb.Client.Models"
             x:Class="OrderWeb.Client.Pages.Orders.DeliveryOrderPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8F9FA"
             Title="Delivery Order">

    <Grid RowDefinitions="90,*" BackgroundColor="#F8F9FA">
        <layout:ClientTopBar x:Name="TopBar" RestaurantName="Restaurant POS" />

        <Grid Grid.Row="1"
              Padding="50"
              RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Grid.Row="0"
                             Spacing="12"
                             Margin="0,0,0,40">
            <Label Text="Delivery Order"
                   FontSize="36"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#1A202C" />
            <Label Text="Customer Information"
                   FontSize="16"
                   HorizontalOptions="Center"
                   TextColor="#718096"
                   Margin="0,5,0,0" />
            <BoxView HeightRequest="3"
                     WidthRequest="60"
                     BackgroundColor="#3B82F6"
                     HorizontalOptions="Center"
                     CornerRadius="2"
                     Margin="0,10,0,0" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="30"
                                 HorizontalOptions="Center"
                                 WidthRequest="550">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Customer Name"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#4A5568" />
                    <Border BackgroundColor="White"
                            StrokeThickness="2"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 12"
                            Padding="0">
                        <Entry x:Name="CustomerNameEntry"
                               Placeholder="e.g., John Smith"
                               FontSize="16"
                               TextColor="#1A202C"
                               PlaceholderColor="#A0AEC0"
                               HeightRequest="56"
                               Margin="16,0"
                               BackgroundColor="Transparent" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12">
                    <Label Text="Phone Number"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#4A5568" />
                    <Border BackgroundColor="White"
                            StrokeThickness="2"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 12"
                            Padding="0">
                        <Entry x:Name="PhoneNumberEntry"
                               Placeholder="e.g., 07123 456789"
                               Keyboard="Telephone"
                               FontSize="16"
                               TextColor="#1A202C"
                               PlaceholderColor="#A0AEC0"
                               HeightRequest="56"
                               Margin="16,0"
                               BackgroundColor="Transparent" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12">
                    <Label Text="Delivery Address"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#4A5568" />

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                        <Border BackgroundColor="White"
                                StrokeThickness="2"
                                Stroke="#E2E8F0"
                                StrokeShape="RoundRectangle 12"
                                Padding="0">
                            <Entry x:Name="AddressLookupEntry"
                                   Placeholder="Enter address or postcode..."
                                   FontSize="16"
                                   TextColor="#1A202C"
                                   PlaceholderColor="#A0AEC0"
                                   HeightRequest="56"
                                   Margin="16,0"
                                   BackgroundColor="Transparent" />
                        </Border>

                        <Button x:Name="SearchPostcodeButton"
                                Grid.Column="1"
                                Text="Search"
                                BackgroundColor="#10B981"
                                TextColor="White"
                                FontSize="15"
                                FontAttributes="Bold"
                                HeightRequest="56"
                                WidthRequest="120"
                                CornerRadius="14"
                                Clicked="OnSearchPostcodeClicked" />
                    </Grid>

                    <Border x:Name="AddressResultsBorder"
                            IsVisible="False"
                            BackgroundColor="White"
                            StrokeThickness="2"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 12"
                            Padding="0"
                            MaximumHeightRequest="200"
                            Margin="0,8,0,0">
                        <CollectionView x:Name="AddressResultsCollection"
                                        SelectionMode="Single"
                                        SelectionChanged="OnAddressSelected">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:AddressSuggestion">
                                    <Border Padding="16,12"
                                            BackgroundColor="Transparent">
                                        <Label Text="{Binding DisplayText}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="#1A202C"
                                               LineBreakMode="WordWrap" />
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>

                    <VerticalStackLayout Spacing="16"
                                         Margin="0,16,0,0">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Address"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#1A202C" />
                            <Border BackgroundColor="White"
                                    StrokeThickness="2"
                                    Stroke="#E2E8F0"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="0">
                                <Entry x:Name="AddressLine1Entry"
                                       Placeholder="Street address"
                                       FontSize="16"
                                       TextColor="#1A202C"
                                       PlaceholderColor="#A0AEC0"
                                       HeightRequest="56"
                                       Margin="16,0"
                                       BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="City"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#1A202C" />
                            <Border BackgroundColor="White"
                                    StrokeThickness="2"
                                    Stroke="#E2E8F0"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="0">
                                <Entry x:Name="CityEntry"
                                       Placeholder="City"
                                       FontSize="16"
                                       TextColor="#1A202C"
                                       PlaceholderColor="#A0AEC0"
                                       HeightRequest="56"
                                       Margin="16,0"
                                       BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="12">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="County"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#1A202C" />
                                <Border BackgroundColor="White"
                                        StrokeThickness="2"
                                        Stroke="#E2E8F0"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="0">
                                    <Entry x:Name="CountyEntry"
                                           Placeholder="County"
                                           FontSize="16"
                                           TextColor="#1A202C"
                                           PlaceholderColor="#A0AEC0"
                                           HeightRequest="56"
                                           Margin="16,0"
                                           BackgroundColor="Transparent" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="8">
                                <Label Text="Postcode"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#1A202C" />
                                <Border BackgroundColor="White"
                                        StrokeThickness="2"
                                        Stroke="#E2E8F0"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="0">
                                    <Entry x:Name="PostcodeResultEntry"
                                           Placeholder="Postcode"
                                           FontSize="16"
                                           TextColor="#1A202C"
                                           PlaceholderColor="#A0AEC0"
                                           HeightRequest="56"
                                           Margin="16,0"
                                           BackgroundColor="Transparent" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <Border x:Name="ZoneBorder"
                        BackgroundColor="#EFF6FF"
                        StrokeThickness="2"
                        Stroke="#BFDBFE"
                        StrokeShape="RoundRectangle 12"
                        Padding="16"
                        IsVisible="False">
                    <Label x:Name="ZoneLabel"
                           Text="Delivery zone not checked"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#1D4ED8"
                           HorizontalTextAlignment="Center" />
                </Border>

                <VerticalStackLayout Spacing="12">
                    <Label Text="Delivery Time"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#4A5568" />
                    <Border BackgroundColor="White"
                            StrokeThickness="2"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 12"
                            Padding="0">
                        <Entry x:Name="ScheduledTimeEntry"
                               Placeholder="ASAP / 20:15"
                               FontSize="16"
                               TextColor="#1A202C"
                               PlaceholderColor="#A0AEC0"
                               HeightRequest="56"
                               Margin="16,0"
                               BackgroundColor="Transparent" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12">
                    <Label Text="Order Notes"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#4A5568" />
                    <Border BackgroundColor="White"
                            StrokeThickness="2"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,6">
                        <Editor x:Name="NotesEditor"
                                Placeholder="Customer/order notes"
                                FontSize="16"
                                TextColor="#1A202C"
                                PlaceholderColor="#A0AEC0"
                                HeightRequest="88"
                                BackgroundColor="Transparent" />
                    </Border>
                </VerticalStackLayout>

                <Button Text="Search Existing Customer"
                        BackgroundColor="#3B82F6"
                        TextColor="White"
                        FontSize="16"
                        HeightRequest="54"
                        CornerRadius="14"
                        Clicked="OnSearchCustomerClicked"
                        Margin="0,5,0,0" />

                <Border x:Name="SearchResultsBorder"
                        IsVisible="False"
                        BackgroundColor="White"
                        StrokeThickness="2"
                        Stroke="#E2E8F0"
                        StrokeShape="RoundRectangle 12"
                        Padding="0"
                        MaximumHeightRequest="320"
                        Margin="0,5,0,0">
                    <CollectionView x:Name="SearchResultsCollection"
                                    SelectionMode="Single"
                                    SelectionChanged="OnCustomerSelected">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:CachedCustomer">
                                <Border Padding="18,16"
                                        BackgroundColor="Transparent">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="12">
                                        <VerticalStackLayout Spacing="6">
                                            <Label Text="{Binding Name}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="#1A202C" />
                                            <Label Text="{Binding Phone}"
                                                   FontSize="14"
                                                   TextColor="#718096" />
                                            <Label Text="{Binding Address}"
                                                   FontSize="13"
                                                   TextColor="#94A3B8"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1"
                                               Text=">"
                                               FontSize="22"
                                               TextColor="#3B82F6"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>

                <Border x:Name="NoResultsPanel"
                        IsVisible="False"
                        BackgroundColor="#FEF2F2"
                        StrokeThickness="2"
                        Stroke="#FEE2E2"
                        StrokeShape="RoundRectangle 12"
                        Padding="20"
                        Margin="0,5,0,0">
                    <Label Text="No customers found matching your search"
                           FontSize="15"
                           TextColor="#DC2626"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </Border>

                <Label x:Name="StatusLabel"
                       Text="Connected"
                       FontSize="14"
                       TextColor="#718096"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2"
              ColumnDefinitions="*,1.2*"
              ColumnSpacing="16"
              Margin="0,40,0,0"
              HorizontalOptions="Center"
              WidthRequest="550">
            <Button Text="Cancel"
                    BackgroundColor="White"
                    TextColor="#64748B"
                    FontSize="16"
                    HeightRequest="56"
                    CornerRadius="14"
                    BorderColor="#E2E8F0"
                    BorderWidth="2"
                    Clicked="OnCancelClicked" />

            <Button Grid.Column="1"
                    Text="Continue to Order"
                    BackgroundColor="#3B82F6"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="56"
                    CornerRadius="14"
                    Clicked="OnContinueClicked" />
        </Grid>
        </Grid>

        <Grid x:Name="SidebarLayer"
              Grid.RowSpan="2"
              IsVisible="False"
              BackgroundColor="Transparent">
            <BoxView BackgroundColor="#01FFFFFF">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackdropTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <layout:ClientSidebar x:Name="Sidebar"
                                  Role="Manager"
                                  SelectedMenu="Delivery"
                                  ShowFooter="True"
                                  TranslationX="-280"
                                  HorizontalOptions="Start" />
        </Grid>
    </Grid>
</ContentPage>

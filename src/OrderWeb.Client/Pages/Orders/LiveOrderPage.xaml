<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:layout="clr-namespace:OrderWeb.Client.Views.Layout"
             x:Class="OrderWeb.Client.Pages.Orders.LiveOrderPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F6F8FB"
             Title="Live Order">
    <Grid RowDefinitions="150,98,*"
          BackgroundColor="#F6F8FB">
        <Border Grid.Row="0" BackgroundColor="#F6F9FC" StrokeThickness="0">
            <Grid Padding="20,0" ColumnDefinitions="120,*,270">
                <ImageButton x:Name="MenuButton"
                             Source="mian.png"
                             WidthRequest="35"
                             HeightRequest="35"
                             Padding="0"
                             BackgroundColor="Transparent"
                             Aspect="AspectFit"
                             HorizontalOptions="Start"
                             VerticalOptions="Center"
                             Clicked="OnMenuClicked" />

                <Label Grid.Column="1"
                       Text="Live Order"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="#1F2937"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />

                <VerticalStackLayout Grid.Column="2"
                                     Spacing="5"
                                     VerticalOptions="Center"
                                     HorizontalOptions="End">
                    <Label x:Name="DateLabel"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#1F2937"
                           HorizontalTextAlignment="End"
                           HorizontalOptions="End" />
                    <Label x:Name="TimeLabel"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#0369A1"
                           HorizontalTextAlignment="End"
                           HorizontalOptions="End" />
                    <ImageButton Source="outred.png"
                                 WidthRequest="40"
                                 HeightRequest="40"
                                 Padding="0"
                                 Margin="0,10,0,0"
                                 BackgroundColor="Transparent"
                                 Aspect="AspectFit"
                                 HorizontalOptions="End"
                                 Clicked="OnLogoutClicked" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                BackgroundColor="White"
                Stroke="#E5E7EB"
                StrokeThickness="1">
            <HorizontalStackLayout Spacing="12"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center">
                <Button x:Name="AllFilterButton"
                        Text="All"
                        Clicked="OnFilterClicked" />
                <Button x:Name="CollectionFilterButton"
                        Text="Collection"
                        Clicked="OnFilterClicked" />
                <Button x:Name="DeliveryFilterButton"
                        Text="Delivery"
                        Clicked="OnFilterClicked" />
                <Button x:Name="TableFilterButton"
                        Text="Table"
                        Clicked="OnFilterClicked" />
                <Button Text="Refresh"
                        BackgroundColor="#6366F1"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="16"
                        CornerRadius="8"
                        HeightRequest="54"
                        WidthRequest="150"
                        Padding="0"
                        BorderWidth="0"
                        Clicked="OnRefreshClicked" />
            </HorizontalStackLayout>
        </Border>

        <Grid Grid.Row="2" BackgroundColor="#F6F8FB">
            <ScrollView>
                <FlexLayout x:Name="OrderCards"
                            Direction="Row"
                            Wrap="Wrap"
                            AlignItems="Start"
                            JustifyContent="Start"
                            Padding="24,36,24,24" />
            </ScrollView>

            <Label x:Name="EmptyStateLabel"
                   Text="No open local orders"
                   FontSize="16"
                   TextColor="#9CA3AF"
                   HorizontalOptions="Center"
                   VerticalOptions="Start"
                   Margin="0,220,0,0"
                   IsVisible="False" />
        </Grid>

        <Grid x:Name="SidebarLayer"
              Grid.RowSpan="3"
              IsVisible="False"
              BackgroundColor="Transparent">
            <BoxView BackgroundColor="Transparent">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackdropTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <layout:ClientSidebar x:Name="Sidebar"
                                  HorizontalOptions="Start"
                                  TranslationX="-280"
                                  Role="Manager"
                                  SelectedMenu="Live Order"
                                  ShowFooter="True" />
        </Grid>
    </Grid>
</ContentPage>

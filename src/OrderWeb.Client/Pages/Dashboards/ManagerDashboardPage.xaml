<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:layout="clr-namespace:OrderWeb.Client.Views.Layout"
             x:Class="OrderWeb.Client.Pages.Dashboards.ManagerDashboardPage"
             Title="Manager Dashboard"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">

    <Grid BackgroundColor="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <layout:ClientTopBar x:Name="TopBar"
                            RestaurantName="Restaurant POS" />

        <ScrollView Grid.Row="1"
                    x:Name="MainScrollView"
                    BackgroundColor="White">
            <StackLayout x:Name="DashboardContent"
                         Spacing="0"
                         VerticalOptions="Center"
                         Padding="18,30,18,30"
                         HorizontalOptions="Center"
                         MaximumWidthRequest="900">

                <Grid x:Name="MainActionsGrid"
                      RowSpacing="38"
                      ColumnSpacing="80"
                      Padding="0"
                      HorizontalOptions="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                        <Border x:Name="RestaurantServiceButton"
                            Grid.Row="0"
                            Grid.Column="0"
                            BackgroundColor="Transparent"
                            Stroke="Transparent"
                            StrokeThickness="0"
                            Padding="14"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="28"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRestaurantTapped"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Image Source="restaurant.png"
                                   x:Name="RestaurantIcon"
                                   WidthRequest="150"
                                   HeightRequest="150"
                                   HorizontalOptions="Center"/>
                            <Label Text="Restaurant"
                                   FontFamily="InterBold"
                                   x:Name="RestaurantLabel"
                                   FontSize="21"
                                   FontAttributes="Bold"
                                   TextColor="#111827"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>

                        <Border x:Name="DeliveryServiceButton"
                            Grid.Row="0"
                            Grid.Column="1"
                            BackgroundColor="Transparent"
                            Stroke="Transparent"
                            StrokeThickness="0"
                            Padding="14"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="28"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDeliveryTapped"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Image Source="delivery.png"
                                   x:Name="DeliveryIcon"
                                   WidthRequest="150"
                                   HeightRequest="150"
                                   HorizontalOptions="Center"/>
                            <Label Text="Delivery"
                                   FontFamily="InterBold"
                                   x:Name="DeliveryLabel"
                                   FontSize="21"
                                   FontAttributes="Bold"
                                   TextColor="#111827"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>

                        <Border x:Name="CollectionServiceButton"
                            Grid.Row="0"
                            Grid.Column="2"
                            BackgroundColor="Transparent"
                            Stroke="Transparent"
                            StrokeThickness="0"
                            Padding="14"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="28"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCollectionTapped"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Image Source="collection.png"
                                   x:Name="CollectionIcon"
                                   WidthRequest="150"
                                   HeightRequest="150"
                                   HorizontalOptions="Center"/>
                            <Label Text="Collection"
                                   FontFamily="InterBold"
                                   x:Name="CollectionLabel"
                                   FontSize="21"
                                   FontAttributes="Bold"
                                   TextColor="#111827"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>

                        <Border x:Name="LiveOrderServiceButton"
                            Grid.Row="1"
                            Grid.Column="1"
                            BackgroundColor="Transparent"
                            Stroke="Transparent"
                            StrokeThickness="0"
                            Padding="24"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="28"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLiveOrderTapped"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                            <Image Source="liveorder.png"
                                   x:Name="LiveOrderIcon"
                                   WidthRequest="190"
                                   HeightRequest="190"
                                   HorizontalOptions="Center"/>
                            <Label Text="Live Order"
                                   FontFamily="InterBold"
                                   x:Name="LiveOrderLabel"
                                   FontSize="21"
                                   FontAttributes="Bold"
                                   TextColor="#111827"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </StackLayout>
        </ScrollView>

        <Grid x:Name="SidebarLayer"
              IsVisible="False"
              BackgroundColor="Transparent">
            <BoxView BackgroundColor="#01FFFFFF"
                     Margin="280,0,0,0">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSidebarBackdropTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <layout:ClientSidebar x:Name="Sidebar"
                                  Role="Manager"
                                  SelectedMenu="Dashboard"
                                  ShowFooter="True"
                                  TranslationX="-280"
                                  HorizontalOptions="Start" />
        </Grid>
    </Grid>
</ContentPage>

<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:OrderWeb.Client"
             xmlns:sharedThemes="clr-namespace:OrderWeb.SharedUI.Themes;assembly=OrderWeb.SharedUI"
             x:Class="OrderWeb.Client.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Temporary local defaults (legacy keys kept until screens migrate) -->
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />

                <!-- Authoritative SharedUI Pos* design system (locked). App.xaml.cs
                     reasserts Client semantic keys onto Pos* after this merge. -->
                <sharedThemes:OrderWebTheme />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

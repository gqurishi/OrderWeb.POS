<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:OrderWeb.Client"
             xmlns:sharedThemes="clr-namespace:OrderWeb.SharedUI.Themes;assembly=OrderWeb.SharedUI"
             x:Class="OrderWeb.Client.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Legacy Client dictionaries kept only for unmigrated screens.
                     Do not add new Client-only colours or styles here. -->
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />

                <!-- Authoritative SharedUI Pos* design system. App.xaml.cs calls
                     DesignSystemBootstrap.LockHostResources so Pos* wins and
                     Client* keys alias onto Pos* for leftover screens. -->
                <sharedThemes:OrderWebTheme />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

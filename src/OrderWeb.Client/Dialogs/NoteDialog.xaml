<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OrderWeb.Client.Dialogs.NoteDialog"
             BackgroundColor="#80000000"
             Title="Note">
    <Grid Padding="32">
        <Border WidthRequest="520"
                BackgroundColor="#FFFFFF"
                Stroke="#E5E7EB"
                StrokeShape="RoundRectangle 18"
                Padding="28"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <VerticalStackLayout Spacing="18">
                <Grid ColumnDefinitions="*,52">
                    <VerticalStackLayout>
                        <Label Text="Order Note"
                               FontFamily="InterBold"
                               FontSize="24"
                               TextColor="#1F2937" />
                        <Label Text="Add kitchen or customer notes"
                               FontFamily="OpenSansRegular"
                               FontSize="14"
                               TextColor="#64748B" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1"
                            Text="X"
                            WidthRequest="48"
                            HeightRequest="48"
                            CornerRadius="24"
                            BackgroundColor="#FEE2E2"
                            TextColor="#DC2626"
                            FontFamily="InterBold"
                            Clicked="OnCloseClicked" />
                </Grid>
                <Editor Placeholder="Type note..."
                        HeightRequest="160"
                        BackgroundColor="#F8FAFC"
                        FontFamily="OpenSansRegular"
                        FontSize="15"
                        TextColor="#1F2937" />
                <Button Text="Save Note"
                        HeightRequest="54"
                        BackgroundColor="#6366F1"
                        TextColor="#FFFFFF"
                        FontFamily="OpenSansSemibold"
                        FontSize="16"
                        CornerRadius="8"
                        Clicked="OnCloseClicked" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>

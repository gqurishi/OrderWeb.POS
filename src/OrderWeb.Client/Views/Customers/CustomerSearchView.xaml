<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OrderWeb.Client.Views.Customers.CustomerSearchView"
             BackgroundColor="Transparent">
    <Border BackgroundColor="#F8FAFC"
            Stroke="#E5E7EB"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 8"
            Padding="18">
        <Grid RowDefinitions="Auto,Auto,Auto"
              RowSpacing="14">
            <Label Text="Customer Search"
                   FontFamily="OpenSansSemibold"
                   FontSize="22"
                   TextColor="#1F2937" />

            <Grid Grid.Row="1"
                  ColumnDefinitions="*,180"
                  ColumnSpacing="12">
                <Border BackgroundColor="#FFFFFF"
                        Stroke="#CBD5E1"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="12,0">
                    <Entry x:Name="SearchEntry"
                           Placeholder="Name, phone, address..."
                           BackgroundColor="Transparent"
                           FontFamily="OpenSansRegular"
                           FontSize="15"
                           TextColor="#1F2937"
                           HeightRequest="50" />
                </Border>
                <Button Grid.Column="1"
                        Text="Search"
                        BackgroundColor="#6366F1"
                        TextColor="#FFFFFF"
                        FontFamily="OpenSansSemibold"
                        FontSize="16"
                        CornerRadius="8"
                        HeightRequest="50"
                        Clicked="OnSearchClicked" />
            </Grid>

            <VerticalStackLayout x:Name="ResultsStack"
                                 Grid.Row="2"
                                 Spacing="10" />
        </Grid>
    </Border>
</ContentView>

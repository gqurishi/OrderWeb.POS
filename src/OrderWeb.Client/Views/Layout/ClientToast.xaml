<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OrderWeb.Client.Views.Layout.ClientToast">
    <!-- Thin host toast. Visual tokens come from SharedUI Pos* design system. -->
    <Border BackgroundColor="{DynamicResource PosTextStrong}"
            StrokeThickness="0"
            Padding="16,12">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="12" />
        </Border.StrokeShape>
        <Label x:Name="MessageLabel"
               Text="Client message"
               FontSize="14"
               FontAttributes="Bold"
               TextColor="{DynamicResource PosTextOnPrimary}" />
    </Border>
</ContentView>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:OrderWeb.SharedUI.Controls;assembly=OrderWeb.SharedUI"
             x:Class="OrderWeb.Client.Views.Layout.ClientTopBar">
    <!-- Match Mother TopBar PosHeader chrome: connection dot + minimize. -->
    <shared:PosHeader x:Name="SharedHeader"
                      ShowIdentity="False"
                      ShowMinimize="True"
                      ShowConnection="True"
                      MenuClicked="OnMenuClicked"
                      MinimizeClicked="OnMinimizeClicked"
                      LogoutClicked="OnLogoutClicked" />
</ContentView>

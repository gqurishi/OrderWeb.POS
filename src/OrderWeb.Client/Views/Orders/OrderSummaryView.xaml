<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OrderWeb.Client.Views.Orders.OrderSummaryView"
             HorizontalOptions="Fill"
             VerticalOptions="Fill"
             BackgroundColor="Transparent">
    <!-- Mother OrderPanel: fills the right column; no fixed WidthRequest (that clipped Client). -->
    <Border BackgroundColor="#FFFFFF"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 12"
            Padding="15"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">
        <Grid RowDefinitions="Auto,*,Auto"
              RowSpacing="10"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">
            <Border BackgroundColor="#F8FAFC"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="15,10">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="12">
                    <VerticalStackLayout Spacing="4"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Fill">
                        <Label x:Name="TitleLabel"
                               Text="Order # New"
                               FontFamily="OpenSansSemibold"
                               FontSize="18"
                               MaxLines="1"
                               LineBreakMode="TailTruncation"
                               TextColor="#0F172A" />
                        <Label x:Name="DetailLabel"
                               Text="Delivery order"
                               FontFamily="OpenSansSemibold"
                               FontSize="14"
                               MaxLines="1"
                               LineBreakMode="TailTruncation"
                               TextColor="#475569" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1"
                            Text="PAYMENT"
                            BackgroundColor="#F59E0B"
                            TextColor="#FFFFFF"
                            FontFamily="OpenSansSemibold"
                            FontSize="16"
                            CornerRadius="8"
                            MinimumWidthRequest="120"
                            HeightRequest="50"
                            Padding="12,0"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Clicked="OnPaymentClicked" />
                </Grid>
            </Border>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout x:Name="LinesStack"
                                     Spacing="8" />
            </ScrollView>

            <Border Grid.Row="2"
                    BackgroundColor="#FFFFFF"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12,12,0,0"
                    Padding="20"
                    Margin="0,15,0,0">
                <VerticalStackLayout Spacing="15">
                    <Border BackgroundColor="#F9FAFB"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="15"
                            Margin="0,0,0,5">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Subtotal"
                                       FontSize="14"
                                       TextColor="#475569" />
                                <Label x:Name="SubtotalLabel"
                                       Grid.Column="1"
                                       Text="£0.00"
                                       FontSize="14"
                                       TextColor="#0F172A" />
                            </Grid>
                            <Grid x:Name="ServiceChargeRow"
                                  ColumnDefinitions="*,Auto"
                                  IsVisible="False">
                                <Label x:Name="ServiceChargeDescriptionLabel"
                                       Text="Service charge"
                                       FontSize="14"
                                       TextColor="#475569" />
                                <Label x:Name="ServiceChargeLabel"
                                       Grid.Column="1"
                                       Text="Not included"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#0F766E" />
                            </Grid>
                            <BoxView HeightRequest="1"
                                     Color="#CBD5E1"
                                     Margin="0,3" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="TOTAL"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#334155"
                                       VerticalOptions="Center" />
                                <Label x:Name="TotalLabel"
                                       Grid.Column="1"
                                       Text="£0.00"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       TextColor="#059669"
                                       VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Grid x:Name="QuickActionsGrid"
                          ColumnDefinitions="*,*,*"
                          ColumnSpacing="12"
                          HeightRequest="55">
                        <Button x:Name="ServiceButton"
                                Text="SERVICE"
                                IsVisible="False"
                                BackgroundColor="#8B5CF6"
                                TextColor="#FFFFFF"
                                FontAttributes="Bold"
                                FontSize="16"
                                CornerRadius="10"
                                Padding="0"
                                Clicked="OnServiceClicked" />
                        <Button x:Name="NotesButton"
                                Text="NOTES"
                                BackgroundColor="#3B82F6"
                                TextColor="#FFFFFF"
                                FontAttributes="Bold"
                                FontSize="16"
                                CornerRadius="10"
                                Padding="0"
                                Clicked="OnNotesClicked" />
                        <Button x:Name="VoidButton"
                                Grid.Column="1"
                                Text="VOID"
                                BackgroundColor="#EF4444"
                                TextColor="#FFFFFF"
                                FontAttributes="Bold"
                                FontSize="16"
                                CornerRadius="10"
                                Padding="0"
                                Clicked="OnVoidClicked" />
                        <Button x:Name="MoreButton"
                                Grid.Column="2"
                                Text="MORE ▼"
                                BackgroundColor="#64748B"
                                TextColor="#FFFFFF"
                                FontAttributes="Bold"
                                FontSize="16"
                                CornerRadius="10"
                                Padding="0"
                                Clicked="OnMoreClicked" />
                    </Grid>

                    <Grid ColumnDefinitions="1.4*,*"
                          ColumnSpacing="12"
                          HeightRequest="60">
                        <Button Text="SEND TO KITCHEN"
                                BackgroundColor="#10B981"
                                TextColor="#FFFFFF"
                                FontAttributes="Bold"
                                FontSize="17"
                                CornerRadius="10"
                                Padding="0"
                                Clicked="OnSendClicked" />
                        <Button Grid.Column="1"
                                Text="PRINT"
                                BackgroundColor="#6366F1"
                                TextColor="#FFFFFF"
                                FontAttributes="Bold"
                                FontSize="17"
                                CornerRadius="10"
                                Padding="0"
                                Clicked="OnPrintClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Border>
</ContentView>

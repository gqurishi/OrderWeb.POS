<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_in_NET.Views.ModernAlertDialog"
             BackgroundColor="{StaticResource DialogOverlayColor}"
             VerticalOptions="Fill"
             HorizontalOptions="Fill">
    
    <Grid VerticalOptions="Center"
          HorizontalOptions="Center"
          Padding="40">
        <Border BackgroundColor="White"
                Stroke="#DCE3EE"
                StrokeThickness="1"
                Padding="30"
                WidthRequest="450"
                VerticalOptions="Center"
                HorizontalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="22"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#0F172A" Opacity="0.16" Radius="20" Offset="0,8"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="20">
                
                <!-- Icon -->
                <Border x:Name="IconBorder"
                        BackgroundColor="#3B82F6"
                        Stroke="#FFFFFF"
                        StrokeThickness="2"
                        WidthRequest="80"
                        HeightRequest="80"
                        HorizontalOptions="Center"
                        Margin="0,0,0,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="40"/>
                    </Border.StrokeShape>
                    <Label x:Name="IconLabel"
                           Text="OK"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>
                
                <!-- Title -->
                <Label x:Name="TitleLabel"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#1F2937"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>
                
                <!-- Message -->
                <Label x:Name="MessageLabel"
                       FontSize="15"
                       TextColor="#6B7280"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"
                       Margin="0,0,0,10"/>
                
                <!-- OK Button -->
                <Button x:Name="OkButton"
                        Text="OK"
                        BackgroundColor="#2563EB"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="50"
                        FontSize="16"
                        Padding="20,0"
                        Clicked="OnOkClicked" />
                
            </VerticalStackLayout>
        </Border>
    </Grid>
    
</ContentView>

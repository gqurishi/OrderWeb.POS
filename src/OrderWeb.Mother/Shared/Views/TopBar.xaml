<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:OrderWeb.SharedUI.Controls;assembly=OrderWeb.SharedUI"
             x:Class="POS_in_NET.Views.TopBar"
             VerticalOptions="Start"
             MinimumHeightRequest="52">

    <VerticalStackLayout Spacing="0">
        <Border x:Name="MotherDisconnectedBanner"
                BackgroundColor="#FEF2F2"
                Stroke="#FECACA"
                StrokeThickness="1"
                Padding="12,8"
                IsVisible="False">
            <Label x:Name="MotherDisconnectedLabel"
                   Text="Mother terminal disconnected"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="#B91C1C"
                   HorizontalOptions="Center"/>
        </Border>

        <shared:PosHeader x:Name="SharedHeader"
                          VerticalOptions="Start"
                          ShowIdentity="False"
                          ShowMinimize="True"
                          MenuClicked="OnMenuClicked"
                          MinimizeClicked="OnMinimizeClicked"
                          LogoutClicked="OnLogoutClicked" />
    </VerticalStackLayout>
</ContentView>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:POS_in_NET.Controls"
             xmlns:sharedViews="clr-namespace:OrderWeb.SharedUI.Views;assembly=OrderWeb.SharedUI"
             x:Class="POS_in_NET.Pages.DeliveryCustomerModal"
             Title="Delivery Order"
             BackgroundColor="#F8F9FA">

    <Grid>
        <!-- Mother-parity Delivery customer entry lives in OrderWeb.SharedUI so Client matches Mother. -->
        <sharedViews:DeliveryCustomerEntryView x:Name="Entry" />

        <controls:ToastNotification x:Name="ToastNotification"
                                    InputTransparent="True"
                                    ZIndex="1000" />
    </Grid>
</ContentPage>

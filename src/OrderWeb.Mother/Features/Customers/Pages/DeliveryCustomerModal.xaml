<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:POS_in_NET.Controls"
             x:Class="POS_in_NET.Pages.DeliveryCustomerModal"
             Title="Delivery Order"
             BackgroundColor="#F8F9FA">

    <Grid RowDefinitions="*,Auto">
        <controls:ToastNotification x:Name="ToastNotification"
                                    InputTransparent="True"
                                    ZIndex="1000"/>

        <ContentView x:Name="DetailsHost" Grid.Row="0" />

        <Grid Grid.Row="1"
              Padding="{DynamicResource ResponsivePagePadding},0,{DynamicResource ResponsivePagePadding},24">
            <Button Text="Cancel"
                    Clicked="OnCancelClicked"
                    BackgroundColor="White"
                    BorderColor="#CBD5E1"
                    BorderWidth="1"
                    TextColor="#334155"
                    HeightRequest="58"
                    CornerRadius="14"
                    MaximumWidthRequest="550"
                    HorizontalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>

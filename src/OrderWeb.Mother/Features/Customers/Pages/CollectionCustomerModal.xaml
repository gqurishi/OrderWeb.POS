<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:POS_in_NET.Controls"
             x:Class="POS_in_NET.Pages.CollectionCustomerModal"
             Title="Collection Order"
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="*,Auto">
        <controls:ToastNotification x:Name="ToastNotification"
                                    InputTransparent="True"
                                    ZIndex="1000" />

        <ContentView x:Name="DetailsHost" Grid.Row="0" />

        <Grid Grid.Row="1"
              ColumnDefinitions="*"
              Padding="44,0,44,24">
            <Button Text="Cancel"
                    Clicked="OnCancelClicked"
                    BackgroundColor="White"
                    BorderColor="#CBD5E1"
                    BorderWidth="1"
                    TextColor="#334155"
                    FontFamily="OpenSansRegular"
                    FontSize="16"
                    HeightRequest="58"
                    CornerRadius="14"
                    WidthRequest="560"
                    HorizontalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_in_NET.Views.AddTableDialog"
             BackgroundColor="{StaticResource DialogOverlayColor}"
             VerticalOptions="Fill"
             HorizontalOptions="Fill">

    <Grid x:Name="DialogRoot"
          VerticalOptions="Fill"
          HorizontalOptions="Fill"
          Padding="20,10">
        <Border BackgroundColor="White"
                Stroke="#E5E7EB"
                StrokeThickness="1"
                Padding="0"
                WidthRequest="380"
                MaximumWidthRequest="400"
                VerticalOptions="Center"
                HorizontalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#0F172A" Opacity="0.10" Radius="14" Offset="0,6"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="14" Padding="18,16">

                <!-- Title -->
                <Label Text="Add table"
                       FontSize="17"
                       FontFamily="OpenSansSemibold"
                       TextColor="#111827"
                       HorizontalOptions="Start" />

                <!-- Floor -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Floor"
                           FontSize="12"
                           FontFamily="OpenSansSemibold"
                           TextColor="#6B7280" />
                    <ScrollView MaximumHeightRequest="96"
                               VerticalScrollBarVisibility="Never">
                        <VerticalStackLayout x:Name="FloorSelectionStack"
                                             Spacing="6" />
                    </ScrollView>
                </VerticalStackLayout>

                <!-- Table number -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Number"
                           FontSize="12"
                           FontFamily="OpenSansSemibold"
                           TextColor="#6B7280" />
                    <Border x:Name="TableNumberField"
                            BackgroundColor="#F8FAFC"
                            Stroke="#E5E7EB"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="12,0"
                            HeightRequest="40">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTableNumberTapped" />
                        </Border.GestureRecognizers>
                        <Entry x:Name="TableNumberEntry"
                               FontSize="14"
                               FontFamily="OpenSansRegular"
                               TextColor="#111827"
                               PlaceholderColor="#9CA3AF"
                               Placeholder="Tap to enter"
                               BackgroundColor="Transparent"
                               IsReadOnly="True"
                               InputTransparent="True"
                               VerticalOptions="Center"
                               HeightRequest="36" />
                    </Border>
                </VerticalStackLayout>

                <!-- Design -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Design"
                           FontSize="12"
                           FontFamily="OpenSansSemibold"
                           TextColor="#6B7280" />
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Start">
                        <Border x:Name="Design1Border"
                                BackgroundColor="#EFF6FF"
                                Stroke="#3B82F6"
                                StrokeThickness="1.5"
                                Padding="6"
                                WidthRequest="52"
                                HeightRequest="52">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDesign1Clicked" />
                            </Border.GestureRecognizers>
                            <Image Source="table_1.png"
                                   WidthRequest="34"
                                   HeightRequest="34"
                                   Aspect="AspectFit" />
                        </Border>

                        <Border x:Name="Design2Border"
                                BackgroundColor="White"
                                Stroke="#E5E7EB"
                                StrokeThickness="1"
                                Padding="6"
                                WidthRequest="52"
                                HeightRequest="52">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDesign2Clicked" />
                            </Border.GestureRecognizers>
                            <Image Source="table_2.png"
                                   WidthRequest="34"
                                   HeightRequest="34"
                                   Aspect="AspectFit" />
                        </Border>

                        <Border x:Name="Design3Border"
                                BackgroundColor="White"
                                Stroke="#E5E7EB"
                                StrokeThickness="1"
                                Padding="6"
                                WidthRequest="52"
                                HeightRequest="52">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDesign3Clicked" />
                            </Border.GestureRecognizers>
                            <Image Source="table_3.png"
                                   WidthRequest="34"
                                   HeightRequest="34"
                                   Aspect="AspectFit" />
                        </Border>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Actions -->
                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="8"
                      Margin="0,2,0,0">
                    <Button Grid.Column="0"
                            x:Name="CancelButton"
                            Text="Cancel"
                            BackgroundColor="#F3F4F6"
                            TextColor="#4B5563"
                            FontFamily="OpenSansSemibold"
                            CornerRadius="8"
                            HeightRequest="40"
                            FontSize="13"
                            Clicked="OnCancelClicked" />

                    <Button Grid.Column="1"
                            x:Name="CreateButton"
                            Text="Create"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            FontFamily="OpenSansSemibold"
                            CornerRadius="8"
                            HeightRequest="40"
                            FontSize="13"
                            Clicked="OnCreateClicked" />
                </Grid>

            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentView>

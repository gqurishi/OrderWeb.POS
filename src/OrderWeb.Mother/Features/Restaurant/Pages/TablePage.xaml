<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:POS_in_NET.Views"
             xmlns:controls="clr-namespace:POS_in_NET.Controls"
             xmlns:shared="clr-namespace:OrderWeb.SharedUI.Controls;assembly=OrderWeb.SharedUI"
             x:Class="POS_in_NET.Pages.TablePage"
             Title=""
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto,*">

        <views:TopBar x:Name="TopBar" Grid.Row="0"/>

        <Grid Grid.Row="1">
            <controls:ToastNotification x:Name="ToastNotification"
                                       ZIndex="1000"
                                       InputTransparent="True"/>

            <Grid RowDefinitions="Auto,*" Padding="20,12">

                <VerticalStackLayout Grid.Row="0" Spacing="10" Margin="0,0,0,12">

                    <Border x:Name="NoFloorsWarning"
                           IsVisible="False"
                           BackgroundColor="#FEF2F2"
                           Stroke="#FECACA"
                           StrokeThickness="1"
                           Padding="14,12"
                           StrokeShape="RoundRectangle 10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="No floors yet"
                                       FontSize="14"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="#991B1B"/>
                                <Label Text="Create a floor before adding tables"
                                       FontSize="12"
                                       FontFamily="OpenSansRegular"
                                       TextColor="#B91C1C"/>
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="Floors"
                                    BackgroundColor="#0F172A"
                                    TextColor="White"
                                    FontSize="12"
                                    FontFamily="OpenSansSemibold"
                                    HeightRequest="34"
                                    Padding="14,0"
                                    CornerRadius="8"
                                    VerticalOptions="Center"
                                    Clicked="OnGoToFloorManagementClicked"/>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="Tables"
                               FontSize="18"
                               FontFamily="OpenSansSemibold"
                               TextColor="#0F172A"
                               VerticalOptions="Center"/>

                        <Button Grid.Column="1"
                                x:Name="AddTableButton"
                                Text="+ Add table"
                                BackgroundColor="#0F172A"
                                TextColor="White"
                                FontSize="13"
                                FontFamily="OpenSansSemibold"
                                HeightRequest="36"
                                Padding="14,0"
                                CornerRadius="8"
                                Clicked="OnAddTableClicked"/>
                    </Grid>

                    <shared:ChefLoaderView x:Name="LoadingIndicator"
                                           Mode="Inline"
                                           Size="Sm"
                                           Message="Loading tables"
                                           DelayMilliseconds="0"
                                           IsLoading="False"
                                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <CollectionView Grid.Row="1"
                                x:Name="TablesCollectionView"
                                SelectionMode="None"
                                VerticalScrollBarVisibility="Never">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="6"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="White"
                                    Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    Padding="10,8"
                                    StrokeShape="RoundRectangle 8">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                      ColumnSpacing="10"
                                      HeightRequest="44">

                                    <Border Grid.Column="0"
                                            BackgroundColor="#F1F5F9"
                                            StrokeThickness="0"
                                            WidthRequest="32"
                                            HeightRequest="32"
                                            VerticalOptions="Center"
                                            StrokeShape="RoundRectangle 6">
                                        <Image Source="{Binding TableDesignIcon}"
                                               Aspect="AspectFit"
                                               Margin="5"/>
                                    </Border>

                                    <HorizontalStackLayout Grid.Column="1"
                                                           Spacing="8"
                                                           VerticalOptions="Center">
                                        <Label Text="{Binding TableNumber}"
                                               FontSize="15"
                                               FontFamily="OpenSansSemibold"
                                               TextColor="#0F172A"
                                               VerticalOptions="Center"/>
                                        <Label Text="·"
                                               FontSize="13"
                                               TextColor="#CBD5E1"
                                               VerticalOptions="Center"/>
                                        <Label Text="{Binding FloorName}"
                                               FontSize="12"
                                               FontFamily="OpenSansRegular"
                                               TextColor="#64748B"
                                               VerticalOptions="Center"/>
                                    </HorizontalStackLayout>

                                    <Button Grid.Column="2"
                                            Text="Edit"
                                            BackgroundColor="Transparent"
                                            TextColor="#334155"
                                            FontSize="12"
                                            FontFamily="OpenSansSemibold"
                                            HeightRequest="32"
                                            MinimumWidthRequest="52"
                                            Padding="8,0"
                                            CornerRadius="6"
                                            BorderColor="#E2E8F0"
                                            BorderWidth="1"
                                            VerticalOptions="Center"
                                            Clicked="OnEditTableClicked"
                                            CommandParameter="{Binding .}"/>

                                    <Button Grid.Column="3"
                                            Text="Delete"
                                            BackgroundColor="Transparent"
                                            TextColor="#DC2626"
                                            FontSize="12"
                                            FontFamily="OpenSansSemibold"
                                            HeightRequest="32"
                                            MinimumWidthRequest="58"
                                            Padding="8,0"
                                            CornerRadius="6"
                                            BorderColor="#FECACA"
                                            BorderWidth="1"
                                            VerticalOptions="Center"
                                            Clicked="OnDeleteTableClicked"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="32"
                                             Spacing="10"
                                             VerticalOptions="Center"
                                             HorizontalOptions="Center">
                            <Label Text="No tables yet"
                                   FontSize="16"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="#64748B"
                                   HorizontalOptions="Center"/>
                            <Label Text="Add a table to place it on Visual Layout"
                                   FontSize="13"
                                   FontFamily="OpenSansRegular"
                                   TextColor="#94A3B8"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </Grid>

            <views:StyledPromptDialog x:Name="DialogOverlay" IsVisible="False"/>
            <views:AddTableDialog x:Name="AddTableDialogOverlay" IsVisible="False"/>
            <views:EditTableDialog x:Name="EditTableDialogOverlay" IsVisible="False"/>
        </Grid>
    </Grid>
</ContentPage>

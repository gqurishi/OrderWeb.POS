<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:POS_in_NET.Views"
             xmlns:sharedViews="clr-namespace:OrderWeb.SharedUI.Views;assembly=OrderWeb.SharedUI"
             x:Class="POS_in_NET.Pages.VisualTablePage"
             Title=""
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <views:TopBar x:Name="TopBar" Grid.Row="0" />
        <sharedViews:FloorPlanView x:Name="FloorPlan"
                                   Grid.Row="1"
                                   FloorSelected="OnFloorSelected"
                                   TableActionRequested="OnTableActionRequested"
                                   TableMoved="OnTableMoved"
                                   FloorManagementRequested="OnFloorManagementRequested"
                                   TableManagementRequested="OnTableManagementRequested"
                                   SetBackgroundRequested="OnSetBackgroundRequested"
                                   RemoveBackgroundRequested="OnRemoveBackgroundRequested"
                                   SaveLayoutRequested="OnSaveLayoutRequested" />
    </Grid>
</ContentPage>

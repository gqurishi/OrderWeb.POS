<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:POS_in_NET.Views"
             x:Class="POS_in_NET.Pages.RestaurantPage"
             Title=""
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto,Auto,*">

        <views:TopBar x:Name="TopBar" Grid.Row="0"/>

        <Border Grid.Row="1"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeThickness="0,0,0,1"
                Padding="16,10">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Border x:Name="FloorTab"
                        Grid.Column="0"
                        BackgroundColor="#F1F5F9"
                        Stroke="#94A3B8"
                        StrokeThickness="1"
                        Padding="12,10"
                        StrokeShape="RoundRectangle 10">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFloorTabTapped"/>
                    </Border.GestureRecognizers>
                    <Label x:Name="FloorTabLabel"
                           Text="Floor Management"
                           FontSize="14"
                           FontFamily="OpenSansSemibold"
                           TextColor="#0F172A"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center"/>
                </Border>

                <Border x:Name="TableTab"
                        Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        Padding="12,10"
                        StrokeShape="RoundRectangle 10">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTableTabTapped"/>
                    </Border.GestureRecognizers>
                    <Label x:Name="TableTabLabel"
                           Text="Table Management"
                           FontSize="14"
                           FontFamily="OpenSansSemibold"
                           TextColor="#64748B"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center"/>
                </Border>

                <Border x:Name="VisualTab"
                        Grid.Column="2"
                        BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        Padding="12,10"
                        StrokeShape="RoundRectangle 10">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVisualTabTapped"/>
                    </Border.GestureRecognizers>
                    <Label x:Name="VisualTabLabel"
                           Text="Visual Layout"
                           FontSize="14"
                           FontFamily="OpenSansSemibold"
                           TextColor="#64748B"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- Must Fill so Visual Layout AbsoluteLayout canvas gets height -->
        <Grid x:Name="TabContentHost"
              Grid.Row="2"
              VerticalOptions="Fill"
              HorizontalOptions="Fill" />
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_in_NET.Views.TillShoppingTakeDialog"
             BackgroundColor="{StaticResource DialogOverlayColor}"
             VerticalOptions="Fill"
             HorizontalOptions="Fill">

    <Grid VerticalOptions="Center"
          HorizontalOptions="Center"
          Padding="36">
        <Border BackgroundColor="White"
                Stroke="#DCE3EE"
                StrokeThickness="1"
                Padding="30"
                WidthRequest="460"
                VerticalOptions="Center"
                HorizontalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="22"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#0F172A" Opacity="0.16" Radius="20" Offset="0,8"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="18">
                <Border BackgroundColor="#0F766E"
                        Stroke="#FFFFFF"
                        StrokeThickness="2"
                        WidthRequest="74"
                        HeightRequest="74"
                        HorizontalOptions="Center"
                        Margin="0,0,0,4">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="37"/>
                    </Border.StrokeShape>
                    <Label Text="£"
                           FontSize="30"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

                <Label Text="Shopping — Take from till"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#1F2937"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>

                <Label Text="Record cash taken before opening the drawer."
                       FontSize="15"
                       TextColor="#6B7280"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"
                       Margin="0,-2,0,2"/>

                <Label Text="Item / reason"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="#64748B"
                       Margin="2,0,0,0"/>

                <Border BackgroundColor="#F8FAFC"
                        Stroke="#D8E1ED"
                        StrokeThickness="1"
                        Padding="14,12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Entry x:Name="ItemEntry"
                           Placeholder="e.g. Milk"
                           IsReadOnly="True"
                           FontSize="16"
                           TextColor="#1F2937"
                           PlaceholderColor="#9CA3AF"
                           BackgroundColor="Transparent"
                           HeightRequest="42">
                        <Entry.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnItemTapped"/>
                        </Entry.GestureRecognizers>
                    </Entry>
                </Border>

                <Label Text="Amount taken (£)"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="#64748B"
                       Margin="2,0,0,0"/>

                <Border BackgroundColor="#F8FAFC"
                        Stroke="#D8E1ED"
                        StrokeThickness="1"
                        Padding="14,12"
                        Margin="0,0,0,2">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Entry x:Name="AmountEntry"
                           Placeholder="0.00"
                           Keyboard="Numeric"
                           IsReadOnly="True"
                           FontSize="16"
                           TextColor="#1F2937"
                           PlaceholderColor="#9CA3AF"
                           BackgroundColor="Transparent"
                           HeightRequest="42">
                        <Entry.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAmountTapped"/>
                        </Entry.GestureRecognizers>
                    </Entry>
                </Border>

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="14"
                      Margin="0,8,0,0">
                    <Button Text="Cancel"
                            Clicked="OnCancelClicked"
                            BackgroundColor="#E2E8F0"
                            TextColor="#334155"
                            FontAttributes="Bold"
                            CornerRadius="14"
                            HeightRequest="48"
                            FontSize="16"/>
                    <Button Grid.Column="1"
                            Text="Take &amp; Open"
                            Clicked="OnConfirmClicked"
                            BackgroundColor="#0F766E"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="14"
                            HeightRequest="48"
                            FontSize="16"/>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>

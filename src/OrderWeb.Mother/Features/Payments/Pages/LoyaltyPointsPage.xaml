<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="POS_in_NET.Pages.LoyaltyPointsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:POS_in_NET.Views"
             xmlns:controls="clr-namespace:POS_in_NET.Controls"
             Title=""
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto,*">
        
        <!-- Top Bar -->
        <views:TopBar x:Name="TopBar" Grid.Row="0"/>
        
        <!-- Toast Notification Overlay -->
        <controls:ToastNotification x:Name="ToastNotification" 
                                   Grid.RowSpan="2"
                                   ZIndex="2000"
                                   InputTransparent="True"/>

        <Button Grid.Row="1"
                Text="X"
                BackgroundColor="#FEF2F2"
                BorderColor="#FCA5A5"
                BorderWidth="1"
                TextColor="#DC2626"
                FontAttributes="Bold"
                FontSize="18"
                WidthRequest="48"
                HeightRequest="48"
                CornerRadius="24"
                Padding="0"
                Margin="0,20,32,0"
                HorizontalOptions="End"
                VerticalOptions="Start"
                ZIndex="10"
                ToolTipProperties.Text="Close"
                Clicked="OnCloseClicked" />
        
        <!-- Modern Main Content -->
        <ScrollView Grid.Row="1">
            <Grid Padding="40,32" 
                  ColumnDefinitions="0.9*,1.1*" 
                  ColumnSpacing="28"
                  MaximumWidthRequest="1600" 
                  HorizontalOptions="Center">

                <!-- LEFT COLUMN: Search Customer -->
                <Border Grid.Column="0"
                        BackgroundColor="White"
                        Stroke="#E5E7EB"
                        StrokeThickness="1"
                        Padding="32"
                        StrokeShape="RoundRectangle 14"
                        Shadow="{StaticResource CardShadow}"
                        VerticalOptions="Start">
                    <VerticalStackLayout Spacing="20">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Customer Loyalty"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="#111827" />
                            <Label Text="Search by phone number, then add or redeem points."
                                   FontSize="15"
                                   TextColor="#64748B" />
                        </VerticalStackLayout>

                        <!-- Clean Entry Field -->
                        <Border Stroke="#D1D5DB"
                                StrokeThickness="1"
                                BackgroundColor="#F8FAFC"
                                StrokeShape="RoundRectangle 10"
                                Padding="16,10">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Grid.Column="0"
                                        BackgroundColor="#DBEAFE"
                                        StrokeThickness="0"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        StrokeShape="RoundRectangle 20"
                                        VerticalOptions="Center">
                                    <Label Text="☎"
                                           FontSize="18"
                                           TextColor="#2563EB"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                <Entry Grid.Column="1"
                                       x:Name="PhoneSearchEntry"
                                       Placeholder="Phone number"
                                       FontSize="18"
                                       TextColor="#111827"
                                       PlaceholderColor="#94A3B8"
                                       BackgroundColor="Transparent"
                                       Keyboard="Telephone"
                                       HeightRequest="52"
                                       Completed="OnSearchCustomerClicked" />
                            </Grid>
                        </Border>

                        <!-- Action Buttons -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Button Grid.Column="0"
                                    Text="Search"
                                    BackgroundColor="#3B82F6"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    HeightRequest="56"
                                    CornerRadius="10"
                                    Clicked="OnSearchCustomerClicked" />
                            
                            <Button Grid.Column="1"
                                    Text="New Customer"
                                    BackgroundColor="#10B981"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    FontSize="17"
                                    HeightRequest="56"
                                    CornerRadius="10"
                                    Clicked="OnAddNewCustomerClicked" />
                        </Grid>
                        
                        <!-- Debug Test Connection Button -->
                        <Button Text="Test API Connection"
                                BackgroundColor="#FFF7ED"
                                BorderColor="#FDBA74"
                                BorderWidth="1"
                                TextColor="#C2410C"
                                FontAttributes="Bold"
                                FontSize="15"
                                HeightRequest="48"
                                CornerRadius="10"
                                Clicked="OnTestConnectionClicked" />
                        
                        <!-- Information Box -->
                        <Border Stroke="#BFDBFE"
                                StrokeThickness="1"
                                BackgroundColor="#EFF6FF"
                                StrokeShape="RoundRectangle 10"
                                Padding="20,16">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Grid.Column="0"
                                        BackgroundColor="#DBEAFE"
                                        StrokeThickness="0"
                                        WidthRequest="34"
                                        HeightRequest="34"
                                        StrokeShape="RoundRectangle 17">
                                    <Label Text="i"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="#2563EB"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="Information" 
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#1E40AF" />
                                <Label Text="Customer data syncs from OrderWeb.net. 100 points equals £1 discount." 
                                       FontSize="14"
                                       TextColor="#1E3A8A"
                                       LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- RIGHT COLUMN: Customer Details & Points Management -->
                <Border x:Name="CustomerDetailsFrame"
                        Grid.Column="1"
                        BackgroundColor="White"
                        Stroke="#D1FAE5"
                        StrokeThickness="1"
                        Padding="32"
                        StrokeShape="RoundRectangle 14"
                        Shadow="{StaticResource CardShadow}"
                        IsVisible="False"
                        VerticalOptions="Start">
                    <VerticalStackLayout Spacing="22">
                        <!-- Header -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Customer Details"
                                       FontSize="28"
                                       FontAttributes="Bold"
                                       TextColor="#111827" />
                                <Label x:Name="CustomerLastVisitLabel"
                                       Text="Last Visit: Never"
                                       FontSize="14"
                                       TextColor="#64748B" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1"
                                    BackgroundColor="#ECFDF5"
                                    Stroke="#A7F3D0"
                                    StrokeThickness="1"
                                    Padding="14,8"
                                    StrokeShape="RoundRectangle 18"
                                    VerticalOptions="Center">
                                <Label Text="Active"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#059669" />
                            </Border>
                        </Grid>

                        <!-- Customer Info -->
                        <Grid ColumnDefinitions="1.05*,0.95*" ColumnSpacing="18">
                            <Border Grid.Column="0"
                                    BackgroundColor="#F8FAFC"
                                    Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    Padding="20"
                                    StrokeShape="RoundRectangle 12">
                                <VerticalStackLayout Spacing="12">
                                    <Label Text="Customer Information"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#64748B" />
                                    <Label x:Name="CustomerNameLabel"
                                           Text="No name saved"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           TextColor="#111827" />
                                    <Label x:Name="CustomerPhoneLabel"
                                           Text="Phone not saved"
                                           FontSize="16"
                                           TextColor="#475569" />
                                    <Label x:Name="CustomerEmailLabel"
                                           Text="Email not saved"
                                           FontSize="16"
                                           TextColor="#475569"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Current Points Display -->
                            <Border Grid.Column="1"
                                    Stroke="#10B981"
                                    StrokeThickness="2"
                                    BackgroundColor="#ECFDF5"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="22,18">
                                <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="Current Points"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="#059669"
                                           HorizontalOptions="Center" />
                                    <Label x:Name="CustomerPointsLabel"
                                           Text="0 Points"
                                           FontSize="42"
                                           FontAttributes="Bold"
                                           TextColor="#10B981"
                                           HorizontalOptions="Center"
                                           LineBreakMode="NoWrap" />
                                    <Label x:Name="RedemptionValueLabel"
                                           Text="Worth: £0.00"
                                           FontSize="15"
                                           TextColor="#047857"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <!-- Points Management -->
                        <Border BackgroundColor="#F8FAFC"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                Padding="20"
                                StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="14">
                                <Label Text="Adjust Points"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#111827" />

                                <Grid ColumnDefinitions="0.9*,1.1*" ColumnSpacing="12">
                                    <Border Grid.Column="0"
                                            Stroke="#D1D5DB"
                                            StrokeThickness="1"
                                            BackgroundColor="White"
                                            StrokeShape="RoundRectangle 10"
                                            Padding="14,8">
                                        <Entry x:Name="PointsEntry"
                                               Placeholder="Points"
                                               FontSize="17"
                                               TextColor="#111827"
                                               PlaceholderColor="#94A3B8"
                                               BackgroundColor="Transparent"
                                               Keyboard="Numeric"
                                               HeightRequest="44" />
                                    </Border>

                                    <Border Grid.Column="1"
                                            Stroke="#D1D5DB"
                                            StrokeThickness="1"
                                            BackgroundColor="White"
                                            StrokeShape="RoundRectangle 10"
                                            Padding="14,8">
                                        <Entry x:Name="NotesEntry"
                                               Placeholder="Reason / note"
                                               FontSize="17"
                                               TextColor="#111827"
                                               PlaceholderColor="#94A3B8"
                                               BackgroundColor="Transparent"
                                               HeightRequest="44" />
                                    </Border>
                                </Grid>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Button Grid.Column="0"
                                        Text="Add Points"
                                        BackgroundColor="#10B981"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        HeightRequest="50"
                                        CornerRadius="10"
                                        Clicked="OnAddPointsClicked" />

                                <Button Grid.Column="1"
                                        Text="Redeem Points"
                                        BackgroundColor="#EF4444"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        HeightRequest="50"
                                        CornerRadius="10"
                                        Clicked="OnRedeemPointsClicked" />
                            </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Additional Info & Actions -->
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Button Grid.Column="0"
                                        Text="View History"
                                        BackgroundColor="#EFF6FF"
                                        BorderColor="#BFDBFE"
                                        BorderWidth="1"
                                        TextColor="#2563EB"
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        HeightRequest="48"
                                        CornerRadius="10"
                                        Clicked="OnViewHistoryClicked" />

                                <Button Grid.Column="1"
                                        Text="Send Statement"
                                        BackgroundColor="#F1F5F9"
                                        BorderColor="#CBD5E1"
                                        BorderWidth="1"
                                        TextColor="#334155"
                                        FontAttributes="Bold"
                                        FontSize="15"
                                        HeightRequest="48"
                                        CornerRadius="10"
                                        Clicked="OnSendStatementClicked" />
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

            </Grid>
        </ScrollView>

        <!-- Points History Modal (Full Width Overlay) -->
        <Grid x:Name="HistoryOverlay"
              Grid.RowSpan="2"
              BackgroundColor="#80000000"
              IsVisible="False"
              ZIndex="1000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCloseHistoryClicked" />
            </Grid.GestureRecognizers>

            <Border BackgroundColor="White"
                    Stroke="#E5E7EB"
                    StrokeThickness="1"
                    Padding="48,40"
                    StrokeShape="RoundRectangle 16"
                    Shadow="{StaticResource CardShadow}"
                    MaximumWidthRequest="900"
                    MaximumHeightRequest="700"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>

                <VerticalStackLayout Spacing="24">
                    <!-- Header with Close Button -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="Points History" 
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="#1F2937" />
                        
                        <Button Grid.Column="1"
                                Text="X"
                                FontSize="24"
                                TextColor="#6B7280"
                                BackgroundColor="Transparent"
                                Padding="8"
                                WidthRequest="40"
                                HeightRequest="40"
                                CornerRadius="20"
                                Clicked="OnCloseHistoryClicked" />
                    </Grid>

                    <BoxView HeightRequest="1" 
                             BackgroundColor="#E5E7EB" />

                    <!-- History List -->
                    <ScrollView MaximumHeightRequest="500">
                        <CollectionView x:Name="HistoryCollectionView">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Stroke="#E5E7EB"
                                            StrokeThickness="1"
                                            BackgroundColor="#F9FAFB"
                                            StrokeShape="RoundRectangle 10"
                                            Padding="20,16"
                                            Margin="0,4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                                <Label Text="{Binding Description}" 
                                                       FontSize="16"
                                                       FontAttributes="Bold"
                                                       TextColor="#111827" />
                                                <Label Text="{Binding Date}" 
                                                       FontSize="14"
                                                       TextColor="#6B7280" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" 
                                                   Text="{Binding Points}" 
                                                   FontSize="22" 
                                                   FontAttributes="Bold"
                                                   TextColor="{Binding PointsColor}" 
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </ScrollView>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Add New Customer Modal (Full Width Overlay) -->
        <Grid x:Name="NewCustomerOverlay"
              Grid.RowSpan="2"
              BackgroundColor="#80000000"
              IsVisible="False"
              ZIndex="1500">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCancelNewCustomerClicked" />
            </Grid.GestureRecognizers>

            <Border BackgroundColor="White"
                    Stroke="#10B981"
                    StrokeThickness="2"
                    Padding="48,40"
                    StrokeShape="RoundRectangle 16"
                    Shadow="{StaticResource CardShadow}"
                    MaximumWidthRequest="600"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>

                <VerticalStackLayout Spacing="28">
                    <!-- Header with Close Button -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="Add New Customer" 
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="#10B981" />
                        
                        <Button Grid.Column="1"
                                Text="X"
                                FontSize="24"
                                TextColor="#6B7280"
                                BackgroundColor="Transparent"
                                Padding="8"
                                WidthRequest="40"
                                HeightRequest="40"
                                CornerRadius="20"
                                Clicked="OnCancelNewCustomerClicked" />
                    </Grid>

                    <BoxView HeightRequest="1" 
                             BackgroundColor="#E5E7EB" />

                    <!-- Form Fields -->
                    <VerticalStackLayout Spacing="20">
                        <!-- Phone Number -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Phone Number *" 
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#374151" />
                            <Border Stroke="#D1D5DB"
                                    StrokeThickness="1"
                                    BackgroundColor="#F9FAFB"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="20,16">
                                <Entry x:Name="NewCustomerPhoneEntry"
                                       Placeholder="e.g., 07306506797"
                                       FontSize="17"
                                       TextColor="#1F2937"
                                       PlaceholderColor="#9CA3AF"
                                       BackgroundColor="Transparent"
                                       Keyboard="Telephone"
                                       HeightRequest="48" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Customer Name -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Customer Name *" 
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#374151" />
                            <Border Stroke="#D1D5DB"
                                    StrokeThickness="1"
                                    BackgroundColor="#F9FAFB"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="20,16">
                                <Entry x:Name="NewCustomerNameEntry"
                                       Placeholder="e.g., John Smith"
                                       FontSize="17"
                                       TextColor="#1F2937"
                                       PlaceholderColor="#9CA3AF"
                                       BackgroundColor="Transparent"
                                       HeightRequest="48" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Email (Optional) -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Email Address (Optional)" 
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#374151" />
                            <Border Stroke="#D1D5DB"
                                    StrokeThickness="1"
                                    BackgroundColor="#F9FAFB"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="20,16">
                                <Entry x:Name="NewCustomerEmailEntry"
                                       Placeholder="e.g., customer@email.com"
                                       FontSize="17"
                                       TextColor="#1F2937"
                                       PlaceholderColor="#9CA3AF"
                                       BackgroundColor="Transparent"
                                       Keyboard="Email"
                                       HeightRequest="48" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" 
                             BackgroundColor="#E5E7EB" />

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Grid.Column="0"
                                Text="Cancel"
                                BackgroundColor="#6B7280"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="16"
                                HeightRequest="52"
                                CornerRadius="10"
                                Clicked="OnCancelNewCustomerClicked">
                            <Button.Shadow>
                                <Shadow Brush="#6B7280"
                                        Offset="0,4"
                                        Radius="12"
                                        Opacity="0.3" />
                            </Button.Shadow>
                        </Button>

                        <Button Grid.Column="1"
                                Text="Create Customer"
                                BackgroundColor="#10B981"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="16"
                                HeightRequest="52"
                                CornerRadius="10"
                                Clicked="OnSaveNewCustomerClicked">
                            <Button.Shadow>
                                <Shadow Brush="#10B981"
                                        Offset="0,4"
                                        Radius="12"
                                        Opacity="0.3" />
                            </Button.Shadow>
                        </Button>
                    </Grid>

                    <!-- Info Note -->
                    <Border Stroke="#BFDBFE"
                            StrokeThickness="1"
                            BackgroundColor="#EFF6FF"
                            StrokeShape="RoundRectangle 8"
                            Padding="16,12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Customer Information" 
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#1E40AF" />
                            <Label Text="A loyalty card number will be automatically assigned" 
                                   FontSize="13"
                                   TextColor="#1E3A8A" />
                            <Label Text="Customer can start earning points immediately" 
                                   FontSize="13"
                                   TextColor="#1E3A8A" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>
        </Grid>
    
    </Grid>

</ContentPage>

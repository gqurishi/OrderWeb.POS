<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="POS_in_NET.Pages.LoyaltyPointsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:POS_in_NET.Views"
             xmlns:controls="clr-namespace:POS_in_NET.Controls"
             xmlns:sharedViews="clr-namespace:OrderWeb.SharedUI.Views;assembly=OrderWeb.SharedUI"
             Title=""
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto,*">
        <views:TopBar x:Name="TopBar" Grid.Row="0"/>

        <controls:ToastNotification x:Name="ToastNotification"
                                   Grid.RowSpan="2"
                                   ZIndex="2000"
                                   InputTransparent="True"/>

        <Button Grid.Row="1"
                Text="Close"
                BackgroundColor="#FEF2F2"
                BorderColor="#FCA5A5"
                BorderWidth="1"
                TextColor="#DC2626"
                FontSize="14"
                WidthRequest="72"
                HeightRequest="40"
                CornerRadius="12"
                Padding="0"
                Margin="0,20,32,0"
                HorizontalOptions="End"
                VerticalOptions="Start"
                ZIndex="10"
                ToolTipProperties.Text="Close"
                Clicked="OnCloseClicked" />

        <sharedViews:LoyaltyView x:Name="Loyalty"
                                 Grid.Row="1" />
    </Grid>

</ContentPage>

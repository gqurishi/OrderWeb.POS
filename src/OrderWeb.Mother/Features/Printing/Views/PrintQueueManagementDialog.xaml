<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_in_NET.Views.PrintQueueManagementDialog"
             BackgroundColor="#990F172A"
             HorizontalOptions="Fill"
             VerticalOptions="Fill">
    <Grid Padding="16" HorizontalOptions="Fill" VerticalOptions="Center">
        <Border MaximumWidthRequest="820"
                MaximumHeightRequest="720"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                BackgroundColor="White"
                Stroke="#CBD5E1"
                StrokeThickness="1"
                Padding="22">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8"/>
            </Border.StrokeShape>
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="14">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Print problems" FontSize="24" FontAttributes="Bold" TextColor="#0F172A"/>
                        <Label Text="Failed / Needs attention — fix here without opening every order"
                               FontSize="13" TextColor="#64748B"/>
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="X" WidthRequest="42" HeightRequest="42"
                            BackgroundColor="#E2E8F0" TextColor="#334155" CornerRadius="6"
                            Clicked="OnCloseClicked"/>
                </Grid>

                <VerticalStackLayout Grid.Row="1" Spacing="6">
                    <Label Text="Scope" FontSize="12" FontAttributes="Bold" TextColor="#475569"/>
                    <Picker x:Name="ScopePicker" BackgroundColor="#F8FAFC" TextColor="#0F172A"
                            ItemDisplayBinding="{Binding DisplayName}"
                            SelectedIndexChanged="OnScopeChanged"/>
                </VerticalStackLayout>

                <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="WAITING" FontSize="11" FontAttributes="Bold" TextColor="#64748B"/>
                        <Label x:Name="WaitingCountLabel" Text="0" FontSize="24" FontAttributes="Bold" TextColor="#0F172A"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="FAILED / ATTENTION" FontSize="11" FontAttributes="Bold" TextColor="#64748B"/>
                        <Label x:Name="FailedCountLabel" Text="0" FontSize="24" FontAttributes="Bold" TextColor="#DC2626"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="2">
                        <Label Text="PRINTING" FontSize="11" FontAttributes="Bold" TextColor="#64748B"/>
                        <Label x:Name="PrintingCountLabel" Text="0" FontSize="24" FontAttributes="Bold" TextColor="#2563EB"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="3" Spacing="2">
                        <Label Text="PREVIOUS DAYS" FontSize="11" FontAttributes="Bold" TextColor="#64748B"/>
                        <Label x:Name="PreviousDayCountLabel" Text="0" FontSize="24" FontAttributes="Bold" TextColor="#D97706"/>
                    </VerticalStackLayout>
                </Grid>

                <Grid Grid.Row="3" RowDefinitions="Auto,*,Auto" RowSpacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Failed / Needs attention" FontSize="14" FontAttributes="Bold" TextColor="#0F172A"/>
                        <Label x:Name="LoadingLabel" Grid.Column="1" Text="Refreshing…" FontSize="12"
                               TextColor="#64748B" IsVisible="False"/>
                    </Grid>

                    <CollectionView x:Name="JobsList" Grid.Row="1"
                                    SelectionMode="None"
                                    EmptyView="No failed or needs-attention tickets for this scope.">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC"
                                        Padding="12" Margin="0,0,0,8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="6"/>
                                    </Border.StrokeShape>
                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding TitleDisplay}" FontSize="15" FontAttributes="Bold" TextColor="#0F172A"/>
                                                <Label Text="{Binding MetaDisplay}" FontSize="12" TextColor="#64748B"/>
                                            </VerticalStackLayout>
                                            <Border Grid.Column="1" Padding="8,4" BackgroundColor="#FEF2F2"
                                                    Stroke="#FECACA" StrokeThickness="1"
                                                    VerticalOptions="Start">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="4"/>
                                                </Border.StrokeShape>
                                                <Label Text="{Binding StatusDisplay}" FontSize="11"
                                                       FontAttributes="Bold" TextColor="#B91C1C"/>
                                            </Border>
                                        </Grid>
                                        <Label Grid.Row="1" Text="{Binding ErrorMessage}" FontSize="12"
                                               TextColor="#94A3B8" LineBreakMode="TailTruncation" MaxLines="2"/>
                                        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                            <Button Text="Retry" HeightRequest="40" CornerRadius="6"
                                                    BackgroundColor="#2563EB" TextColor="White"
                                                    CommandParameter="{Binding Id}"
                                                    Clicked="OnRetryJobClicked"/>
                                            <Button Grid.Column="1" Text="Reprint" HeightRequest="40" CornerRadius="6"
                                                    BackgroundColor="#0F766E" TextColor="White"
                                                    CommandParameter="{Binding Id}"
                                                    Clicked="OnReprintJobClicked"/>
                                            <Button Grid.Column="2" Text="Dismiss" HeightRequest="40" CornerRadius="6"
                                                    BackgroundColor="#E2E8F0" TextColor="#334155"
                                                    CommandParameter="{Binding Id}"
                                                    Clicked="OnDismissJobClicked"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label Grid.Row="2" Text="Reprint may print a duplicate ticket. Dismiss needs a reason."
                           FontSize="12" TextColor="#94A3B8"/>
                </Grid>

                <Grid Grid.Row="4" ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Button x:Name="CancelOldButton" Text="Cancel previous days"
                            BackgroundColor="#D97706" TextColor="White" CornerRadius="8" HeightRequest="46"
                            Clicked="OnCancelOldClicked"/>
                    <Button x:Name="CancelAllButton" Grid.Column="1" Text="Cancel all waiting"
                            BackgroundColor="#DC2626" TextColor="White" CornerRadius="8" HeightRequest="46"
                            Clicked="OnCancelAllClicked"/>
                    <Button x:Name="RetryFailedButton" Grid.Column="2" Text="Retry all failed"
                            BackgroundColor="#2563EB" TextColor="White" CornerRadius="8" HeightRequest="46"
                            Clicked="OnRetryFailedClicked"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentView>

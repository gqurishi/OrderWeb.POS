<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:POS_in_NET.Views"
             x:Class="POS_in_NET.Pages.PrintTemplatesPage"
             BackgroundColor="#F1F5F9"
             SizeChanged="OnPrintTemplatesPageSizeChanged"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,96">
        <views:TopBar x:Name="TopBar" Grid.Row="0"/>

        <ScrollView Grid.Row="1"
                    Orientation="Vertical"
                    HorizontalScrollBarVisibility="Never"
                    VerticalScrollBarVisibility="Always">
            <Grid x:Name="TemplateLayoutGrid"
                  Padding="16,12,16,28"
                  ColumnDefinitions="380,*"
                  RowDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="10">

                <VerticalStackLayout x:Name="TemplateHeaderPanel"
                                     Grid.Row="0"
                                     Grid.Column="0"
                                     Grid.ColumnSpan="2"
                                     Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                            <Label x:Name="PageHeadingLabel"
                                   Text="Kitchen Template"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A"/>
                            <Label x:Name="PageSubheadingLabel"
                                   Text="80mm kitchen ticket preview"
                                   FontSize="12"
                                   TextColor="#64748B"/>
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Text="Back"
                                BackgroundColor="#2563EB"
                                TextColor="White"
                                BorderColor="#2563EB"
                                BorderWidth="1"
                                CornerRadius="8"
                                HeightRequest="36"
                                MinimumHeightRequest="36"
                                Padding="14,0"
                                FontSize="13"
                                FontAttributes="Bold"
                                Style="{x:Null}"
                                Clicked="OnBackClicked"/>
                    </Grid>

                    <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="10,8"
                            StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Template"
                                   FontSize="12"
                                   TextColor="#64748B"/>
                            <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start"
                                        AlignItems="Center" AlignContent="Start">
                                <Button x:Name="KitchenTemplateButton"
                                        Margin="0,0,8,0"
                                        Text="Kitchen Ticket"
                                        BackgroundColor="#2563EB"
                                        TextColor="White"
                                        BorderColor="#2563EB"
                                        BorderWidth="1"
                                        CornerRadius="8"
                                        HeightRequest="36"
                                        MinimumHeightRequest="36"
                                        Padding="14,0"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        Style="{x:Null}"
                                        Clicked="OnKitchenTemplateClicked"/>
                                <Button x:Name="CollectionReceiptTemplateButton"
                                        Margin="0,0,8,0"
                                        Text="Collection Receipt"
                                        BackgroundColor="White"
                                        TextColor="#334155"
                                        BorderColor="#E2E8F0"
                                        BorderWidth="1"
                                        CornerRadius="8"
                                        HeightRequest="36"
                                        MinimumHeightRequest="36"
                                        Padding="14,0"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        Style="{x:Null}"
                                        Clicked="OnCollectionReceiptTemplateClicked"/>
                                <Button x:Name="DeliveryReceiptTemplateButton"
                                        Margin="0,0,8,0"
                                        Text="Delivery Receipt"
                                        BackgroundColor="White"
                                        TextColor="#334155"
                                        BorderColor="#E2E8F0"
                                        BorderWidth="1"
                                        CornerRadius="8"
                                        HeightRequest="36"
                                        MinimumHeightRequest="36"
                                        Padding="14,0"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        Style="{x:Null}"
                                        Clicked="OnDeliveryReceiptTemplateClicked"/>
                                <Button x:Name="TableBillTemplateButton"
                                        Margin="0,0,8,0"
                                        Text="Table Bill"
                                        BackgroundColor="White"
                                        TextColor="#334155"
                                        BorderColor="#E2E8F0"
                                        BorderWidth="1"
                                        CornerRadius="8"
                                        HeightRequest="36"
                                        MinimumHeightRequest="36"
                                        Padding="14,0"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        Style="{x:Null}"
                                        Clicked="OnTableBillTemplateClicked"/>
                                <Button x:Name="TablePaymentTemplateButton"
                                        Margin="0,0,8,0"
                                        Text="Table Payment"
                                        BackgroundColor="White"
                                        TextColor="#334155"
                                        BorderColor="#E2E8F0"
                                        BorderWidth="1"
                                        CornerRadius="8"
                                        HeightRequest="36"
                                        MinimumHeightRequest="36"
                                        Padding="14,0"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        Style="{x:Null}"
                                        Clicked="OnTablePaymentTemplateClicked"/>
                                <Button x:Name="OnlineReceiptTemplateButton"
                                        Text="Online Receipt"
                                        BackgroundColor="White"
                                        TextColor="#334155"
                                        BorderColor="#E2E8F0"
                                        BorderWidth="1"
                                        CornerRadius="8"
                                        HeightRequest="36"
                                        MinimumHeightRequest="36"
                                        Padding="14,0"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        Style="{x:Null}"
                                        Clicked="OnOnlineReceiptTemplateClicked"/>
                            </FlexLayout>

                            <FlexLayout x:Name="KitchenPreviewModes" Direction="Row" Wrap="Wrap"
                                        JustifyContent="Start" AlignItems="Center" AlignContent="Start">
                                <Button x:Name="TablePreviewButton"
                                        Margin="0,0,8,0"
                                        Text="Table"
                                        BackgroundColor="#2563EB"
                                        TextColor="White"
                                        BorderColor="#2563EB"
                                        BorderWidth="1"
                                        CornerRadius="8"
                                        HeightRequest="32"
                                        MinimumHeightRequest="32"
                                        Padding="14,0"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        Style="{x:Null}"
                                        Clicked="OnTablePreviewClicked"/>
                                <Button x:Name="CollectionPreviewButton"
                                        Margin="0,0,8,0"
                                        Text="Collection"
                                        BackgroundColor="White"
                                        TextColor="#334155"
                                        BorderColor="#E2E8F0"
                                        BorderWidth="1"
                                        CornerRadius="8"
                                        HeightRequest="32"
                                        MinimumHeightRequest="32"
                                        Padding="14,0"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        Style="{x:Null}"
                                        Clicked="OnCollectionPreviewClicked"/>
                                <Button x:Name="DeliveryPreviewButton"
                                        Text="Delivery"
                                        BackgroundColor="White"
                                        TextColor="#334155"
                                        BorderColor="#E2E8F0"
                                        BorderWidth="1"
                                        CornerRadius="8"
                                        HeightRequest="32"
                                        MinimumHeightRequest="32"
                                        Padding="14,0"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        Style="{x:Null}"
                                        Clicked="OnDeliveryPreviewClicked"/>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="TemplatePreviewPanel"
                                     Grid.Row="1"
                                     Grid.Column="0"
                                     Spacing="0"
                                     VerticalOptions="Start">
                    <Border BackgroundColor="#E2E8F0"
                            Padding="12"
                            StrokeThickness="0"
                            HorizontalOptions="Start"
                            VerticalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>

                        <Border BackgroundColor="White"
                                Stroke="#CBD5E1"
                                StrokeThickness="1"
                                Padding="14,10"
                                WidthRequest="340"
                                HorizontalOptions="Start"
                                VerticalOptions="Start">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="4"/>
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#22000000" Offset="0,4" Radius="16" Opacity="0.18"/>
                            </Border.Shadow>

                            <ScrollView Orientation="Vertical"
                                        HeightRequest="480"
                                        HorizontalScrollBarVisibility="Never"
                                        VerticalScrollBarVisibility="Default">
                                <Grid WidthRequest="312">
                                    <VerticalStackLayout x:Name="KitchenPreviewLines"
                                                         Spacing="0"
                                                         IsVisible="True"/>
                                    <Label x:Name="PreviewTextLabel"
                                           FontFamily="Consolas"
                                           FontSize="14"
                                           LineBreakMode="NoWrap"
                                           TextColor="#111827"
                                           IsVisible="False"/>
                                </Grid>
                            </ScrollView>
                        </Border>
                    </Border>
                </VerticalStackLayout>

                <Grid x:Name="TemplateSettingsPanel"
                      Grid.Row="1"
                      Grid.Column="1"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="8"
                      VerticalOptions="Start">
                    <Border BackgroundColor="White"
                            Padding="12,10"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label x:Name="PreviewTitleLabel"
                                   Text="Table kitchen ticket"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A"
                                   VerticalOptions="Center"/>
                            <Border Grid.Column="1"
                                    BackgroundColor="#F8FAFC"
                                    Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    Padding="10,4"
                                    StrokeShape="RoundRectangle 8"
                                    VerticalOptions="Center">
                                <Label Text="80mm fixed"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#334155"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border x:Name="KitchenControlsPanel"
                            Grid.Row="1"
                            BackgroundColor="White"
                            Padding="14,12"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            VerticalOptions="Start"
                            Margin="0,0,0,8">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Kitchen Customise"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A"/>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="Main heading" FontSize="12" TextColor="#64748B"/>
                                            <Picker x:Name="HeadingSizePicker"
                                                    BackgroundColor="#F8FAFC"
                                                    TextColor="#0F172A"
                                                    FontSize="13"
                                                    HeightRequest="36"
                                                    HorizontalOptions="Fill"
                                                    SelectedIndexChanged="OnKitchenSettingChanged">
                                                <Picker.Items>
                                                    <x:String>Normal</x:String>
                                                    <x:String>Large</x:String>
                                                    <x:String>Extra Large</x:String>
                                                </Picker.Items>
                                            </Picker>
                                        </VerticalStackLayout>
                                        <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="End" Margin="0,0,0,4">
                                            <Switch x:Name="HeadingBoldSwitch" Toggled="OnKitchenSettingChanged"/>
                                            <Label Text="Bold" FontSize="12" TextColor="#334155" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="Section heading" FontSize="12" TextColor="#64748B"/>
                                            <Picker x:Name="SectionSizePicker"
                                                    BackgroundColor="#F8FAFC"
                                                    TextColor="#0F172A"
                                                    FontSize="13"
                                                    HeightRequest="36"
                                                    HorizontalOptions="Fill"
                                                    SelectedIndexChanged="OnKitchenSettingChanged">
                                                <Picker.Items>
                                                    <x:String>Normal</x:String>
                                                    <x:String>Large</x:String>
                                                    <x:String>Extra Large</x:String>
                                                </Picker.Items>
                                            </Picker>
                                        </VerticalStackLayout>
                                        <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="End" Margin="0,0,0,4">
                                            <Switch x:Name="SectionBoldSwitch" Toggled="OnKitchenSettingChanged"/>
                                            <Label Text="Bold" FontSize="12" TextColor="#334155" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="Order info" FontSize="12" TextColor="#64748B"/>
                                            <Picker x:Name="OrderInfoSizePicker"
                                                    BackgroundColor="#F8FAFC"
                                                    TextColor="#0F172A"
                                                    FontSize="13"
                                                    HeightRequest="36"
                                                    HorizontalOptions="Fill"
                                                    SelectedIndexChanged="OnKitchenSettingChanged">
                                                <Picker.Items>
                                                    <x:String>Normal</x:String>
                                                    <x:String>Large</x:String>
                                                    <x:String>Extra Large</x:String>
                                                </Picker.Items>
                                            </Picker>
                                        </VerticalStackLayout>
                                        <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="End" Margin="0,0,0,4">
                                            <Switch x:Name="OrderInfoBoldSwitch" Toggled="OnKitchenSettingChanged"/>
                                            <Label Text="Bold" FontSize="12" TextColor="#334155" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </Grid>

                                    <HorizontalStackLayout Spacing="8" VerticalOptions="End" Margin="0,18,0,4">
                                        <Switch x:Name="CheckedBySwitch" Toggled="OnKitchenSettingChanged"/>
                                        <Label Text="Show checked-by line"
                                               FontSize="13"
                                               TextColor="#334155"
                                               VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>

                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Footer text" FontSize="12" TextColor="#64748B"/>
                                    <Label x:Name="FooterCounterLabel"
                                           Grid.Column="1"
                                           Text="0 / 60"
                                           FontSize="12"
                                           TextColor="#64748B"/>
                                </Grid>
                                <Entry x:Name="FooterTextEntry"
                                       MaxLength="60"
                                       HeightRequest="40"
                                       BackgroundColor="#F8FAFC"
                                       TextColor="#0F172A"
                                       Placeholder="Thank you for your order"
                                       TextChanged="OnKitchenFooterTextChanged"/>
                                <Label x:Name="FooterWarningLabel"
                                       Text="Keep footer short: max 2 centered receipt lines."
                                       FontSize="11"
                                       TextColor="#94A3B8"/>
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="8"
                                  Margin="0,8,0,16">
                                <Button Text="Reset"
                                        BackgroundColor="#F8FAFC"
                                        TextColor="#334155"
                                        BorderColor="#E2E8F0"
                                        BorderWidth="1"
                                        CornerRadius="8"
                                        HeightRequest="44"
                                        MinimumHeightRequest="44"
                                        Padding="12,0"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        Style="{x:Null}"
                                        Clicked="OnResetKitchenSettingsClicked"/>
                                <Button Grid.Column="1"
                                        x:Name="SaveKitchenSettingsButton"
                                        Text="Save"
                                        BackgroundColor="#0F172A"
                                        TextColor="White"
                                        CornerRadius="8"
                                        HeightRequest="44"
                                        MinimumHeightRequest="44"
                                        Padding="12,0"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        Style="{x:Null}"
                                        Clicked="OnSaveKitchenSettingsClicked"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border x:Name="CollectionControlsPanel"
                            Grid.Row="1"
                            BackgroundColor="White"
                            Padding="12,10"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            IsVisible="False"
                            VerticalOptions="Start"
                            Margin="0,0,0,8">
                        <VerticalStackLayout Spacing="8">
                            <Label x:Name="CustomerReceiptControlsTitleLabel"
                                   Text="Collection Customise"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A"/>
                            <Grid ColumnDefinitions="*,*"
                                      ColumnSpacing="10"
                                      HorizontalOptions="Fill">
                                    <VerticalStackLayout Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <VerticalStackLayout Spacing="1">
                                                <Label Text="Business name" FontSize="11" TextColor="#64748B"/>
                                                <Picker x:Name="CollectionBusinessNameSizePicker" BackgroundColor="#F8FAFC" TextColor="#0F172A" FontSize="12" HeightRequest="32" HorizontalOptions="Fill" MinimumWidthRequest="0" SelectedIndexChanged="OnCollectionSettingChanged">
                                                    <Picker.Items>
                                                        <x:String>Normal</x:String>
                                                        <x:String>Large</x:String>
                                                        <x:String>Extra Large</x:String>
                                                    </Picker.Items>
                                                </Picker>
                                            </VerticalStackLayout>
                                            <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="End" Margin="0,0,0,2">
                                                <Switch x:Name="CollectionBusinessNameBoldSwitch" Scale="0.8" Toggled="OnCollectionSettingChanged"/>
                                                <Label Text="Bold" FontSize="11" TextColor="#334155" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                        </Grid>

                                        <Grid x:Name="TableNumberField" ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="False">
                                            <VerticalStackLayout x:Name="TableNumberSizeControls" Spacing="1">
                                                <Label Text="Table number" FontSize="11" TextColor="#64748B"/>
                                                <Picker x:Name="TableNumberSizePicker" BackgroundColor="#F8FAFC" TextColor="#0F172A" FontSize="12" HeightRequest="32" HorizontalOptions="Fill" MinimumWidthRequest="0" SelectedIndexChanged="OnCollectionSettingChanged">
                                                    <Picker.Items>
                                                        <x:String>Normal</x:String>
                                                        <x:String>Large</x:String>
                                                        <x:String>Extra Large</x:String>
                                                    </Picker.Items>
                                                </Picker>
                                            </VerticalStackLayout>
                                            <HorizontalStackLayout x:Name="TableNumberBoldControls" Grid.Column="1" Spacing="4" VerticalOptions="End" Margin="0,0,0,2">
                                                <Switch x:Name="TableNumberBoldSwitch" Scale="0.8" Toggled="OnCollectionSettingChanged"/>
                                                <Label Text="Bold" FontSize="11" TextColor="#334155" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                        </Grid>

                                        <Grid x:Name="PaidStatusField" ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="False">
                                            <VerticalStackLayout x:Name="PaidStatusSizeControls" Spacing="1">
                                                <Label Text="Paid status" FontSize="11" TextColor="#64748B"/>
                                                <Picker x:Name="PaidStatusSizePicker" BackgroundColor="#F8FAFC" TextColor="#0F172A" FontSize="12" HeightRequest="32" HorizontalOptions="Fill" MinimumWidthRequest="0" SelectedIndexChanged="OnCollectionSettingChanged">
                                                    <Picker.Items>
                                                        <x:String>Normal</x:String>
                                                        <x:String>Large</x:String>
                                                        <x:String>Extra Large</x:String>
                                                    </Picker.Items>
                                                </Picker>
                                            </VerticalStackLayout>
                                            <HorizontalStackLayout x:Name="PaidStatusBoldControls" Grid.Column="1" Spacing="4" VerticalOptions="End" Margin="0,0,0,2">
                                                <Switch x:Name="PaidStatusBoldSwitch" Scale="0.8" Toggled="OnCollectionSettingChanged"/>
                                                <Label Text="Bold" FontSize="11" TextColor="#334155" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <VerticalStackLayout Spacing="1">
                                                <Label Text="Telephone" FontSize="11" TextColor="#64748B"/>
                                                <Picker x:Name="CollectionPhoneSizePicker" BackgroundColor="#F8FAFC" TextColor="#0F172A" FontSize="12" HeightRequest="32" HorizontalOptions="Fill" MinimumWidthRequest="0" SelectedIndexChanged="OnCollectionSettingChanged">
                                                    <Picker.Items>
                                                        <x:String>Normal</x:String>
                                                        <x:String>Large</x:String>
                                                        <x:String>Extra Large</x:String>
                                                    </Picker.Items>
                                                </Picker>
                                            </VerticalStackLayout>
                                            <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="End" Margin="0,0,0,2">
                                                <Switch x:Name="CollectionPhoneBoldSwitch" Scale="0.8" Toggled="OnCollectionSettingChanged"/>
                                                <Label Text="Bold" FontSize="11" TextColor="#334155" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <VerticalStackLayout Spacing="1">
                                                <Label Text="Receipt heading" FontSize="11" TextColor="#64748B"/>
                                                <Picker x:Name="CollectionHeadingSizePicker" BackgroundColor="#F8FAFC" TextColor="#0F172A" FontSize="12" HeightRequest="32" HorizontalOptions="Fill" MinimumWidthRequest="0" SelectedIndexChanged="OnCollectionSettingChanged">
                                                    <Picker.Items>
                                                        <x:String>Normal</x:String>
                                                        <x:String>Large</x:String>
                                                        <x:String>Extra Large</x:String>
                                                    </Picker.Items>
                                                </Picker>
                                            </VerticalStackLayout>
                                            <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="End" Margin="0,0,0,2">
                                                <Switch x:Name="CollectionHeadingBoldSwitch" Scale="0.8" Toggled="OnCollectionSettingChanged"/>
                                                <Label Text="Bold" FontSize="11" TextColor="#334155" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                        </Grid>

                                        <Grid x:Name="CustomerNameField" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <VerticalStackLayout x:Name="CustomerNameSizeControls" Spacing="1">
                                                <Label Text="Customer name" FontSize="11" TextColor="#64748B"/>
                                                <Picker x:Name="CollectionCustomerNameSizePicker" BackgroundColor="#F8FAFC" TextColor="#0F172A" FontSize="12" HeightRequest="32" HorizontalOptions="Fill" MinimumWidthRequest="0" SelectedIndexChanged="OnCollectionSettingChanged">
                                                    <Picker.Items>
                                                        <x:String>Normal</x:String>
                                                        <x:String>Large</x:String>
                                                        <x:String>Extra Large</x:String>
                                                    </Picker.Items>
                                                </Picker>
                                            </VerticalStackLayout>
                                            <HorizontalStackLayout x:Name="CustomerNameBoldControls" Grid.Column="1" Spacing="4" VerticalOptions="End" Margin="0,0,0,2">
                                                <Switch x:Name="CollectionCustomerNameBoldSwitch" Scale="0.8" Toggled="OnCollectionSettingChanged"/>
                                                <Label Text="Bold" FontSize="11" TextColor="#334155" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                        </Grid>

                                        <Grid x:Name="DeliveryAddressField" ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="False">
                                            <VerticalStackLayout x:Name="DeliveryAddressSizeControls" Spacing="1">
                                                <Label Text="Delivery address" FontSize="11" TextColor="#64748B"/>
                                                <Picker x:Name="DeliveryAddressSizePicker" BackgroundColor="#F8FAFC" TextColor="#0F172A" FontSize="12" HeightRequest="32" HorizontalOptions="Fill" MinimumWidthRequest="0" SelectedIndexChanged="OnCollectionSettingChanged">
                                                    <Picker.Items>
                                                        <x:String>Normal</x:String>
                                                        <x:String>Large</x:String>
                                                        <x:String>Extra Large</x:String>
                                                    </Picker.Items>
                                                </Picker>
                                            </VerticalStackLayout>
                                            <HorizontalStackLayout x:Name="DeliveryAddressBoldControls" Grid.Column="1" Spacing="4" VerticalOptions="End" Margin="0,0,0,2">
                                                <Switch x:Name="DeliveryAddressBoldSwitch" Scale="0.8" Toggled="OnCollectionSettingChanged"/>
                                                <Label Text="Bold" FontSize="11" TextColor="#334155" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <VerticalStackLayout Spacing="1">
                                                <Label Text="Address" FontSize="11" TextColor="#64748B"/>
                                                <Picker x:Name="CollectionAddressSizePicker" BackgroundColor="#F8FAFC" TextColor="#0F172A" FontSize="12" HeightRequest="32" HorizontalOptions="Fill" MinimumWidthRequest="0" SelectedIndexChanged="OnCollectionSettingChanged">
                                                    <Picker.Items>
                                                        <x:String>Normal</x:String>
                                                        <x:String>Large</x:String>
                                                        <x:String>Extra Large</x:String>
                                                    </Picker.Items>
                                                </Picker>
                                            </VerticalStackLayout>
                                            <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="End" Margin="0,0,0,2">
                                                <Switch x:Name="CollectionAddressBoldSwitch" Scale="0.8" Toggled="OnCollectionSettingChanged"/>
                                                <Label Text="Bold" FontSize="11" TextColor="#334155" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                        </Grid>

                                        <Grid x:Name="ServiceChargeField" ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="False">
                                            <VerticalStackLayout x:Name="ServiceChargeSizeControls" Spacing="1">
                                                <Label Text="Service charge" FontSize="11" TextColor="#64748B"/>
                                                <Picker x:Name="ServiceChargeSizePicker" BackgroundColor="#F8FAFC" TextColor="#0F172A" FontSize="12" HeightRequest="32" HorizontalOptions="Fill" MinimumWidthRequest="0" SelectedIndexChanged="OnCollectionSettingChanged">
                                                    <Picker.Items>
                                                        <x:String>Normal</x:String>
                                                        <x:String>Large</x:String>
                                                        <x:String>Extra Large</x:String>
                                                    </Picker.Items>
                                                </Picker>
                                            </VerticalStackLayout>
                                            <HorizontalStackLayout x:Name="ServiceChargeBoldControls" Grid.Column="1" Spacing="4" VerticalOptions="End" Margin="0,0,0,2">
                                                <Switch x:Name="ServiceChargeBoldSwitch" Scale="0.8" Toggled="OnCollectionSettingChanged"/>
                                                <Label Text="Bold" FontSize="11" TextColor="#334155" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <VerticalStackLayout Spacing="1">
                                                <Label Text="VAT number" FontSize="11" TextColor="#64748B"/>
                                                <Picker x:Name="CollectionVatSizePicker" BackgroundColor="#F8FAFC" TextColor="#0F172A" FontSize="12" HeightRequest="32" HorizontalOptions="Fill" MinimumWidthRequest="0" SelectedIndexChanged="OnCollectionSettingChanged">
                                                    <Picker.Items>
                                                        <x:String>Normal</x:String>
                                                        <x:String>Large</x:String>
                                                        <x:String>Extra Large</x:String>
                                                    </Picker.Items>
                                                </Picker>
                                            </VerticalStackLayout>
                                            <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="End" Margin="0,0,0,2">
                                                <Switch x:Name="CollectionVatBoldSwitch" Scale="0.8" Toggled="OnCollectionSettingChanged"/>
                                                <Label Text="Bold" FontSize="11" TextColor="#334155" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <VerticalStackLayout Spacing="1">
                                                <Label Text="Order info" FontSize="11" TextColor="#64748B"/>
                                                <Picker x:Name="CollectionOrderInfoSizePicker" BackgroundColor="#F8FAFC" TextColor="#0F172A" FontSize="12" HeightRequest="32" HorizontalOptions="Fill" MinimumWidthRequest="0" SelectedIndexChanged="OnCollectionSettingChanged">
                                                    <Picker.Items>
                                                        <x:String>Normal</x:String>
                                                        <x:String>Large</x:String>
                                                        <x:String>Extra Large</x:String>
                                                    </Picker.Items>
                                                </Picker>
                                            </VerticalStackLayout>
                                            <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="End" Margin="0,0,0,2">
                                                <Switch x:Name="CollectionOrderInfoBoldSwitch" Scale="0.8" Toggled="OnCollectionSettingChanged"/>
                                                <Label Text="Bold" FontSize="11" TextColor="#334155" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                        </Grid>

                                        <Grid x:Name="CustomerPhoneField" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <VerticalStackLayout x:Name="CustomerPhoneSizeControls" Spacing="1">
                                                <Label Text="Customer phone" FontSize="11" TextColor="#64748B"/>
                                                <Picker x:Name="CollectionCustomerPhoneSizePicker" BackgroundColor="#F8FAFC" TextColor="#0F172A" FontSize="12" HeightRequest="32" HorizontalOptions="Fill" MinimumWidthRequest="0" SelectedIndexChanged="OnCollectionSettingChanged">
                                                    <Picker.Items>
                                                        <x:String>Normal</x:String>
                                                        <x:String>Large</x:String>
                                                        <x:String>Extra Large</x:String>
                                                    </Picker.Items>
                                                </Picker>
                                            </VerticalStackLayout>
                                            <HorizontalStackLayout x:Name="CustomerPhoneBoldControls" Grid.Column="1" Spacing="4" VerticalOptions="End" Margin="0,0,0,2">
                                                <Switch x:Name="CollectionCustomerPhoneBoldSwitch" Scale="0.8" Toggled="OnCollectionSettingChanged"/>
                                                <Label Text="Bold" FontSize="11" TextColor="#334155" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                        </Grid>

                                        <Grid x:Name="PaymentField" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <VerticalStackLayout x:Name="PaymentSizeControls" Spacing="1">
                                                <Label x:Name="PaymentControlsLabel" Text="Payment" FontSize="11" TextColor="#64748B"/>
                                                <Picker x:Name="CollectionPaymentSizePicker" BackgroundColor="#F8FAFC" TextColor="#0F172A" FontSize="12" HeightRequest="32" HorizontalOptions="Fill" MinimumWidthRequest="0" SelectedIndexChanged="OnCollectionSettingChanged">
                                                    <Picker.Items>
                                                        <x:String>Normal</x:String>
                                                        <x:String>Large</x:String>
                                                        <x:String>Extra Large</x:String>
                                                    </Picker.Items>
                                                </Picker>
                                            </VerticalStackLayout>
                                            <HorizontalStackLayout x:Name="PaymentBoldControls" Grid.Column="1" Spacing="4" VerticalOptions="End" Margin="0,0,0,2">
                                                <Switch x:Name="CollectionPaymentBoldSwitch" Scale="0.8" Toggled="OnCollectionSettingChanged"/>
                                                <Label Text="Bold" FontSize="11" TextColor="#334155" VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Grid>

                            <VerticalStackLayout Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Footer text" FontSize="11" TextColor="#64748B"/>
                                    <Label x:Name="CollectionFooterCounterLabel" Grid.Column="1" Text="0 / 60" FontSize="11" TextColor="#64748B"/>
                                </Grid>
                                <Entry x:Name="CollectionFooterTextEntry"
                                       MaxLength="60"
                                       HeightRequest="34"
                                       BackgroundColor="#F8FAFC"
                                       TextColor="#0F172A"
                                       Placeholder="Thank you for your order"
                                       TextChanged="OnCollectionFooterTextChanged"/>
                                <Label x:Name="CollectionFooterWarningLabel"
                                       Text="Keep footer short: max 2 centered receipt lines."
                                       FontSize="11"
                                       TextColor="#94A3B8"/>
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="8"
                                  Margin="0,8,0,16">
                                <Button Text="Reset"
                                        BackgroundColor="#F8FAFC"
                                        TextColor="#334155"
                                        BorderColor="#E2E8F0"
                                        BorderWidth="1"
                                        CornerRadius="8"
                                        HeightRequest="44"
                                        MinimumHeightRequest="44"
                                        Padding="12,0"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        Style="{x:Null}"
                                        Clicked="OnResetCollectionSettingsClicked"/>
                                <Button Grid.Column="1"
                                        x:Name="SaveCollectionSettingsButton"
                                        Text="Save"
                                        BackgroundColor="#0F172A"
                                        TextColor="White"
                                        CornerRadius="8"
                                        HeightRequest="44"
                                        MinimumHeightRequest="44"
                                        Padding="12,0"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        Style="{x:Null}"
                                        Clicked="OnSaveCollectionSettingsClicked"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                </Grid>

                <BoxView x:Name="PageScrollSpacer"
                         Grid.Row="2"
                         Grid.Column="0"
                         Grid.ColumnSpan="2"
                         HeightRequest="160"
                         BackgroundColor="Transparent"/>
            </Grid>
        </ScrollView>

        <BoxView Grid.Row="2"
                 BackgroundColor="#F1F5F9"
                 HeightRequest="96"/>
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:POS_in_NET.Views"
             x:Class="POS_in_NET.Pages.PrinterSetupPage"
             BackgroundColor="#F1F5F9"
             Shell.NavBarIsVisible="False">

    <AbsoluteLayout>
        <!-- Main Content -->
        <Grid RowDefinitions="Auto,*"
              AbsoluteLayout.LayoutBounds="0,0,1,1"
              AbsoluteLayout.LayoutFlags="All">
        <!-- Top Bar -->
        <views:TopBar x:Name="TopBar" Grid.Row="0"/>
        
        <!-- Content -->
        <ScrollView x:Name="PrinterPageScroll"
                    Grid.Row="1"
                    Orientation="Vertical"
                    VerticalScrollBarVisibility="Always"
                    HorizontalScrollBarVisibility="Never">
            <Grid x:Name="PrinterContentGrid" Padding="16,12" ColumnDefinitions="*">
                
                <!-- Left: Printer List -->
                <VerticalStackLayout x:Name="PrinterListLayout" Grid.Column="0" Spacing="10">
                    
                    <Label x:Name="PrinterCountLabel"
                           Text="0 printers configured"
                           IsVisible="False"/>

                    <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center" JustifyContent="Start">
                        <Button x:Name="RefreshButton"
                                Text="Refresh"
                                BackgroundColor="White"
                                TextColor="#334155"
                                BorderColor="#E2E8F0"
                                BorderWidth="1"
                                CornerRadius="8"
                                HeightRequest="40"
                                MinimumHeightRequest="40"
                                Padding="16,0"
                                FontSize="13"
                                FontAttributes="Bold"
                                Style="{x:Null}"
                                Margin="0,0,8,8"
                                Clicked="OnRefreshClicked"/>
                        <Button x:Name="CheckStatusButton"
                                Text="Check status"
                                BackgroundColor="White"
                                TextColor="#334155"
                                BorderColor="#E2E8F0"
                                BorderWidth="1"
                                CornerRadius="8"
                                HeightRequest="40"
                                MinimumHeightRequest="40"
                                Padding="16,0"
                                FontSize="13"
                                FontAttributes="Bold"
                                Style="{x:Null}"
                                Margin="0,0,8,8"
                                Clicked="OnCheckStatusClicked"/>
                        <Button x:Name="ManageQueueButton"
                                Text="Print problems"
                                BackgroundColor="White"
                                TextColor="#334155"
                                BorderColor="#E2E8F0"
                                BorderWidth="1"
                                CornerRadius="8"
                                HeightRequest="40"
                                MinimumHeightRequest="40"
                                Padding="16,0"
                                FontSize="13"
                                FontAttributes="Bold"
                                Style="{x:Null}"
                                Margin="0,0,8,8"
                                Clicked="OnManageQueueClicked"/>
                        <Button x:Name="OpenDrawerButton"
                                Text="Open drawer"
                                BackgroundColor="White"
                                TextColor="#334155"
                                BorderColor="#E2E8F0"
                                BorderWidth="1"
                                CornerRadius="8"
                                HeightRequest="40"
                                MinimumHeightRequest="40"
                                Padding="16,0"
                                FontSize="13"
                                FontAttributes="Bold"
                                Style="{x:Null}"
                                Margin="0,0,8,8"
                                Clicked="OnOpenDrawerClicked"/>
                        <Button x:Name="LogoUpdateButton"
                                Text="Logo update"
                                BackgroundColor="White"
                                TextColor="#334155"
                                BorderColor="#E2E8F0"
                                BorderWidth="1"
                                CornerRadius="8"
                                HeightRequest="40"
                                MinimumHeightRequest="40"
                                Padding="16,0"
                                FontSize="13"
                                FontAttributes="Bold"
                                Style="{x:Null}"
                                Margin="0,0,8,8"
                                Clicked="OnLogoUpdateClicked"/>
                        <Button x:Name="PrintDesignButton"
                                Text="Print templates"
                                BackgroundColor="White"
                                TextColor="#334155"
                                BorderColor="#E2E8F0"
                                BorderWidth="1"
                                CornerRadius="8"
                                HeightRequest="40"
                                MinimumHeightRequest="40"
                                Padding="16,0"
                                FontSize="13"
                                FontAttributes="Bold"
                                Style="{x:Null}"
                                Margin="0,0,8,8"
                                Clicked="OnPrintDesignClicked"/>
                        <Button x:Name="AddPrinterButton"
                                Text="Add printer"
                                BackgroundColor="White"
                                TextColor="#334155"
                                BorderColor="#E2E8F0"
                                BorderWidth="1"
                                CornerRadius="8"
                                HeightRequest="40"
                                MinimumHeightRequest="40"
                                Padding="16,0"
                                FontSize="13"
                                FontAttributes="Bold"
                                Style="{x:Null}"
                                Margin="0,0,8,8"
                                Clicked="OnAddPrinterClicked"/>
                    </FlexLayout>

                    <!-- Print Routing -->
                    <Border BackgroundColor="White" Padding="12,10" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                        <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                            <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                <Label Text="Print Routing" FontSize="15" FontAttributes="Bold" TextColor="#0F172A"/>
                                <Label x:Name="RoutingStatusLabel" Text="Dedicated printers" FontSize="12" TextColor="#64748B"/>
                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                                    x:Name="TestRoutingPrinterButton"
                                    Text="Test"
                                    BackgroundColor="#F8FAFC"
                                    TextColor="#334155"
                                    BorderColor="#E2E8F0"
                                    BorderWidth="1"
                                    CornerRadius="8"
                                    HeightRequest="32"
                                    MinimumHeightRequest="32"
                                    Padding="14,0"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center"
                                    Clicked="OnTestRoutingPrinterClicked"/>

                            <Button Grid.Column="2"
                                    x:Name="SaveRoutingButton"
                                    Text="Save"
                                    BackgroundColor="#0F172A"
                                    TextColor="White"
                                    CornerRadius="8"
                                    HeightRequest="32"
                                    MinimumHeightRequest="32"
                                    Padding="14,0"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center"
                                    Clicked="OnSaveRoutingClicked"/>

                            <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnDefinitions="220,*" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Mode" FontSize="11" TextColor="#64748B"/>
                                    <Picker x:Name="RoutingModePicker"
                                            BackgroundColor="#F8FAFC"
                                            TextColor="#0F172A"
                                            FontSize="12"
                                            SelectedIndexChanged="OnRoutingModeChanged"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="All-jobs printer" FontSize="11" TextColor="#64748B"/>
                                    <Picker x:Name="AllJobsPrinterPicker"
                                            BackgroundColor="#F8FAFC"
                                            TextColor="#0F172A"
                                            FontSize="12"
                                            ItemDisplayBinding="{Binding Name}"
                                            SelectedIndexChanged="OnAllJobsPrinterChanged"/>
                                </VerticalStackLayout>
                            </Grid>

                        </Grid>
                    </Border>

                    <!-- Status Cards -->
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                        <!-- Online -->
                        <Border BackgroundColor="White" Padding="10,8" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout x:Name="GeneralBrandSection" Spacing="1">
                                <HorizontalStackLayout Spacing="6">
                                    <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" BackgroundColor="#22C55E" VerticalOptions="Center"/>
                                    <Label Text="Online" FontSize="11" TextColor="#64748B" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                                <Label x:Name="OnlineCountLabel" Text="0" FontSize="20" FontAttributes="Bold" TextColor="#0F172A"/>
                            </VerticalStackLayout>
                        </Border>
                        
                        <Border Grid.Column="1" BackgroundColor="White" Padding="10,8" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout Spacing="1">
                                <HorizontalStackLayout Spacing="6">
                                    <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" BackgroundColor="#EF4444" VerticalOptions="Center"/>
                                    <Label Text="Offline" FontSize="11" TextColor="#64748B" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                                <Label x:Name="OfflineCountLabel" Text="0" FontSize="20" FontAttributes="Bold" TextColor="#0F172A"/>
                            </VerticalStackLayout>
                        </Border>
                        
                        <Border Grid.Column="2" BackgroundColor="White" Padding="10,8" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout Spacing="1">
                                <HorizontalStackLayout Spacing="6">
                                    <BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" BackgroundColor="#6366F1" VerticalOptions="Center"/>
                                    <Label Text="In queue" FontSize="11" TextColor="#64748B" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                                <Label x:Name="QueueCountLabel" Text="0" FontSize="20" FontAttributes="Bold" TextColor="#0F172A"/>
                            </VerticalStackLayout>
                        </Border>
                        
                        <Border Grid.Column="3" BackgroundColor="White" Padding="10,8" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="Last check" FontSize="11" TextColor="#64748B"/>
                                <Label x:Name="LastCheckLabel" Text="Never" FontSize="16" FontAttributes="Bold" TextColor="#0F172A"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="10">
                        <Border BackgroundColor="White" Padding="14,12" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Receipt Printers" FontSize="15" FontAttributes="Bold" TextColor="#0F172A"/>
                                <VerticalStackLayout x:Name="ReceiptPrintersContainer" Spacing="8">
                                    <Label x:Name="NoReceiptPrintersLabel"
                                           Text="No receipt printers configured"
                                           TextColor="#94A3B8"
                                           FontSize="13"/>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" BackgroundColor="White" Padding="14,12" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Kitchen Printers" FontSize="15" FontAttributes="Bold" TextColor="#0F172A"/>
                                <VerticalStackLayout x:Name="KitchenPrintersContainer" Spacing="8">
                                    <Label x:Name="NoKitchenPrintersLabel"
                                           Text="No kitchen printers configured"
                                           TextColor="#94A3B8"
                                           FontSize="13"/>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="2" BackgroundColor="White" Padding="14,12" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Bar Printers" FontSize="15" FontAttributes="Bold" TextColor="#0F172A"/>
                                <VerticalStackLayout x:Name="BarPrintersContainer" Spacing="8">
                                    <Label x:Name="NoBarPrintersLabel"
                                           Text="No bar printers configured"
                                           TextColor="#94A3B8"
                                           FontSize="13"/>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" BackgroundColor="White" Padding="14,12" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="Label Printers" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center"/>
                                    <Border BackgroundColor="#22C55E" Padding="8,3" StrokeThickness="0" VerticalOptions="Center" StrokeShape="RoundRectangle 6">
                                        <Label Text="CONTAINER LABELS" FontSize="10" FontAttributes="Bold" TextColor="White"/>
                                    </Border>
                                </HorizontalStackLayout>
                                <VerticalStackLayout x:Name="LabelPrintersContainer" Spacing="8">
                                    <Label x:Name="NoLabelPrintersLabel"
                                           Text="No label printers configured"
                                           TextColor="#94A3B8"
                                           FontSize="13"/>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" BackgroundColor="White" Padding="14,12" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="Online Receipt Printers" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center"/>
                                    <Border BackgroundColor="#2563EB" Padding="8,3" StrokeThickness="0" VerticalOptions="Center" StrokeShape="RoundRectangle 6">
                                        <Label Text="ORDERWEB RECEIPT" FontSize="10" FontAttributes="Bold" TextColor="White"/>
                                    </Border>
                                </HorizontalStackLayout>
                                <VerticalStackLayout x:Name="OnlinePrintersContainer" Spacing="8">
                                    <Label x:Name="NoOnlinePrintersLabel"
                                           Text="No online receipt printers configured"
                                           TextColor="#94A3B8"
                                           FontSize="13"/>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="2" BackgroundColor="White" Padding="14,12" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Takeaway Kitchen Receipt Printers" FontSize="15" FontAttributes="Bold" TextColor="#0F172A"/>
                                <VerticalStackLayout x:Name="TakeawayPrintersContainer" Spacing="8">
                                    <Label x:Name="NoTakeawayPrintersLabel"
                                           Text="No takeaway kitchen receipt printers configured"
                                           TextColor="#94A3B8"
                                           FontSize="13"/>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                </VerticalStackLayout>

                <VerticalStackLayout x:Name="FormPanel" Grid.Column="0" Spacing="10" IsVisible="False" HorizontalOptions="Fill">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="FormTitle"
                               Text="Add Printer"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#0F172A"
                               VerticalOptions="Center"
                               IsVisible="False"/>
                        <Button Grid.Column="1"
                                Text="Back"
                                BackgroundColor="#2563EB"
                                TextColor="White"
                                BorderColor="#2563EB"
                                BorderWidth="1"
                                CornerRadius="8"
                                HeightRequest="32"
                                MinimumHeightRequest="32"
                                Padding="14,0"
                                FontSize="12"
                                FontAttributes="Bold"
                                Style="{x:Null}"
                                HorizontalOptions="End"
                                Clicked="OnCloseFormClicked"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Border BackgroundColor="White" Padding="12,10" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Technology" FontSize="13" FontAttributes="Bold" TextColor="#0F172A"/>
                                <HorizontalStackLayout Spacing="8">
                                        <Border x:Name="TechThermalBorder" BackgroundColor="#0F172A" Padding="14,8" StrokeThickness="0">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTechThermalTapped"/></Border.GestureRecognizers>
                                            <Label x:Name="TechThermalLabel" Text="Thermal" FontSize="13" FontAttributes="Bold" TextColor="White"/>
                                        </Border>
                                        <Border x:Name="TechImpactBorder" BackgroundColor="#F8FAFC" Padding="14,8" Stroke="#E2E8F0" StrokeThickness="1">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTechImpactTapped"/></Border.GestureRecognizers>
                                            <Label x:Name="TechImpactLabel" Text="Dot-matrix" FontSize="13" FontAttributes="Bold" TextColor="#334155"/>
                                        </Border>
                                        <Border x:Name="TechLabelBorder" BackgroundColor="#F8FAFC" Padding="14,8" Stroke="#E2E8F0" StrokeThickness="1">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTechLabelTapped"/></Border.GestureRecognizers>
                                            <Label x:Name="TechLabelLabel" Text="Label" FontSize="13" FontAttributes="Bold" TextColor="#334155"/>
                                        </Border>
                                    </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                        <Border x:Name="BrandCard" Grid.Column="1" BackgroundColor="White" Padding="12,10" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Brand" FontSize="13" FontAttributes="Bold" TextColor="#0F172A"/>
                                    <HorizontalStackLayout Spacing="8">
                                        <Border x:Name="BrandEpsonBorder" BackgroundColor="#0F172A" Padding="14,8" StrokeThickness="0">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBrandEpsonTapped"/></Border.GestureRecognizers>
                                            <Label x:Name="BrandEpsonLabel" Text="EPSON" FontSize="13" FontAttributes="Bold" TextColor="White"/>
                                        </Border>
                                        <Border x:Name="BrandStarBorder" BackgroundColor="#F8FAFC" Padding="14,8" Stroke="#E2E8F0" StrokeThickness="1">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBrandStarTapped"/></Border.GestureRecognizers>
                                            <Label x:Name="BrandStarLabel" Text="STAR" FontSize="13" FontAttributes="Bold" TextColor="#334155"/>
                                        </Border>
                                        <Border x:Name="BrandXprinterBorder" BackgroundColor="#F8FAFC" Padding="14,8" Stroke="#E2E8F0" StrokeThickness="1">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBrandXprinterTapped"/></Border.GestureRecognizers>
                                            <Label x:Name="BrandXprinterLabel" Text="XPRINTER" FontSize="13" FontAttributes="Bold" TextColor="#334155"/>
                                        </Border>
                                        <Border x:Name="BrandToshibaBorder" BackgroundColor="#F8FAFC" Padding="14,8" Stroke="#E2E8F0" StrokeThickness="1" IsVisible="False">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBrandToshibaTapped"/></Border.GestureRecognizers>
                                            <Label x:Name="BrandToshibaLabel" Text="TOSHIBA" FontSize="13" FontAttributes="Bold" TextColor="#334155"/>
                                        </Border>
                                        <Border x:Name="BrandBrotherBorder" BackgroundColor="#F8FAFC" Padding="14,8" Stroke="#E2E8F0" StrokeThickness="1" IsVisible="False">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBrandBrotherTapped"/></Border.GestureRecognizers>
                                            <Label x:Name="BrandBrotherLabel" Text="BROTHER" FontSize="13" FontAttributes="Bold" TextColor="#334155"/>
                                        </Border>
                                        <Border x:Name="BrandOtherBorder" BackgroundColor="#F8FAFC" Padding="14,8" Stroke="#E2E8F0" StrokeThickness="1" IsVisible="False">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBrandOtherTapped"/></Border.GestureRecognizers>
                                            <Label x:Name="BrandOtherLabel" Text="OTHER" FontSize="13" FontAttributes="Bold" TextColor="#334155"/>
                                        </Border>
                                    </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                        <Border x:Name="ModelCard" Grid.Column="2" BackgroundColor="White" Padding="12,10" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="6">
                                <VerticalStackLayout x:Name="EpsonModelSection" Spacing="6" IsVisible="False">
                                    <Label Text="Model" FontSize="13" FontAttributes="Bold" TextColor="#0F172A"/>
                                    <Border BackgroundColor="#F8FAFC" Padding="8,2" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                                        <Picker x:Name="EpsonModelPicker" Title="Select model" BackgroundColor="Transparent" TextColor="#0F172A"/>
                                    </Border>
                                    <Label x:Name="ModelHintLabel"
                                           Text="80mm is fixed for thermal. Mother connects by IP on port 9100. No PC driver."
                                           FontSize="11"
                                           TextColor="#94A3B8"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout x:Name="GeneralPaperWidthSection" Spacing="6" VerticalOptions="Start">
                                    <Label Text="Paper width" FontSize="13" FontAttributes="Bold" TextColor="#0F172A"/>
                                    <HorizontalStackLayout Spacing="8">
                                        <Border x:Name="Width80Border" BackgroundColor="#0F172A" Padding="16,8" StrokeThickness="0">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnWidth80Tapped"/></Border.GestureRecognizers>
                                            <Label x:Name="Width80Label" Text="80mm" FontSize="13" FontAttributes="Bold" TextColor="White"/>
                                        </Border>
                                        <Border x:Name="Width58Border" BackgroundColor="#F8FAFC" Padding="16,8" Stroke="#E2E8F0" StrokeThickness="1">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnWidth58Tapped"/></Border.GestureRecognizers>
                                            <Label x:Name="Width58Label" Text="58mm" FontSize="13" FontAttributes="Bold" TextColor="#334155"/>
                                        </Border>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Border BackgroundColor="White" Padding="12,10" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Connection Settings" FontSize="14" FontAttributes="Bold" TextColor="#0F172A"/>
                            <Grid ColumnDefinitions="*,*,140" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Printer name" FontSize="12" TextColor="#64748B"/>
                                    <Border x:Name="PrinterNameField" BackgroundColor="White" Padding="12,8" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 8" HeightRequest="40">
                                        <Grid>
                                            <Entry x:Name="PrinterNameEntry" IsVisible="False" Text=""/>
                                            <Label x:Name="PrinterNameValueLabel" Text="Kitchen Hot, Front Counter" FontSize="13" TextColor="#94A3B8" VerticalOptions="Center" InputTransparent="True"/>
                                            <Button x:Name="PrinterNameTap" BackgroundColor="Transparent" BorderWidth="0" Text="" Style="{x:Null}" MinimumHeightRequest="0" MinimumWidthRequest="0" HorizontalOptions="Fill" VerticalOptions="Fill" ZIndex="2"/>
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="IP address" FontSize="12" TextColor="#64748B"/>
                                    <Border x:Name="IpAddressField" BackgroundColor="White" Padding="12,8" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 8" HeightRequest="40">
                                        <Grid>
                                            <Entry x:Name="IpAddressEntry" IsVisible="False"/>
                                            <Label x:Name="IpAddressValueLabel" Text="192.168.1.100" FontSize="13" TextColor="#94A3B8" VerticalOptions="Center" InputTransparent="True"/>
                                            <Button x:Name="IpAddressTap" BackgroundColor="Transparent" BorderWidth="0" Text="" Style="{x:Null}" MinimumHeightRequest="0" MinimumWidthRequest="0" HorizontalOptions="Fill" VerticalOptions="Fill" ZIndex="2"/>
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="4">
                                    <Label Text="Port" FontSize="12" TextColor="#64748B"/>
                                    <Border x:Name="PortField" BackgroundColor="White" Padding="12,8" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 8" HeightRequest="40">
                                        <Grid>
                                            <Entry x:Name="PortEntry" IsVisible="False" Text="9100"/>
                                            <Label x:Name="PortValueLabel" Text="9100" FontSize="13" TextColor="#0F172A" VerticalOptions="Center" InputTransparent="True"/>
                                            <Button x:Name="PortTap" BackgroundColor="Transparent" BorderWidth="0" Text="" Style="{x:Null}" MinimumHeightRequest="0" MinimumWidthRequest="0" HorizontalOptions="Fill" VerticalOptions="Fill" ZIndex="2"/>
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>
                            <Label Text="Use a private static IP or DHCP reservation. Public addresses are rejected."
                                   FontSize="11"
                                   TextColor="#C2410C"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="White" Padding="12,10" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="12">

                            <VerticalStackLayout x:Name="PurposeSection" Spacing="6">
                                <Label Text="Purpose" FontSize="14" FontAttributes="Bold" TextColor="#0F172A"/>
                                <Label x:Name="PurposeHintLabel" Text="Select what this printer will be used for." FontSize="12" TextColor="#94A3B8" Margin="0,-2,0,2"/>
                                <HorizontalStackLayout Spacing="8">
                                    <Border x:Name="TypeReceiptBorder" BackgroundColor="#22C55E" Padding="14,8" StrokeThickness="0">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTypeReceiptTapped"/></Border.GestureRecognizers>
                                        <Label x:Name="TypeReceiptLabel" Text="Receipt" FontSize="13" FontAttributes="Bold" TextColor="White"/>
                                    </Border>
                                    <Border x:Name="TypeKitchenBorder" BackgroundColor="#F8FAFC" Padding="14,8" Stroke="#E2E8F0" StrokeThickness="1">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTypeKitchenTapped"/></Border.GestureRecognizers>
                                        <Label x:Name="TypeKitchenLabel" Text="Kitchen" FontSize="13" FontAttributes="Bold" TextColor="#334155"/>
                                    </Border>
                                    <Border x:Name="TypeBarBorder" BackgroundColor="#F8FAFC" Padding="14,8" Stroke="#E2E8F0" StrokeThickness="1">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTypeBarTapped"/></Border.GestureRecognizers>
                                        <Label x:Name="TypeBarLabel" Text="Bar" FontSize="13" FontAttributes="Bold" TextColor="#334155"/>
                                    </Border>
                                    <Border x:Name="TypeOnlineBorder" BackgroundColor="#F8FAFC" Padding="14,8" Stroke="#E2E8F0" StrokeThickness="1">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTypeOnlineTapped"/></Border.GestureRecognizers>
                                        <Label x:Name="TypeOnlineLabel" Text="Online Receipt" FontSize="13" FontAttributes="Bold" TextColor="#334155"/>
                                    </Border>
                                    <Border x:Name="TypeTakeawayBorder" BackgroundColor="#F8FAFC" Padding="14,8" Stroke="#E2E8F0" StrokeThickness="1">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTypeTakeawayTapped"/></Border.GestureRecognizers>
                                        <Label x:Name="TypeTakeawayLabel" Text="Takeaway Kitchen" FontSize="13" FontAttributes="Bold" TextColor="#334155"/>
                                    </Border>
                                    <Border x:Name="TypeLabelBorder" BackgroundColor="#F8FAFC" Padding="14,8" Stroke="#E2E8F0" StrokeThickness="1">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTypeLabelTapped"/></Border.GestureRecognizers>
                                        <Label x:Name="TypeLabelLabel" Text="Label" FontSize="13" FontAttributes="Bold" TextColor="#334155"/>
                                    </Border>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <VerticalStackLayout x:Name="PrintGroupSection" Spacing="4">
                                <Label Text="Print group / station" FontSize="14" FontAttributes="Bold" TextColor="#0F172A"/>
                                <Label Text="Assign this printer to a group or station." FontSize="12" TextColor="#94A3B8"/>
                                <Border x:Name="PrintGroupField" BackgroundColor="White" Padding="12,8" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 8" HeightRequest="40">
                                    <Grid>
                                        <Entry x:Name="PrintGroupEntry" IsVisible="False"/>
                                        <Label x:Name="PrintGroupValueLabel" Text="Kitchen, Bar, Grill, Dessert, Tandoor" FontSize="13" TextColor="#94A3B8" VerticalOptions="Center" InputTransparent="True"/>
                                        <Button x:Name="PrintGroupTap" BackgroundColor="Transparent" BorderWidth="0" Text="" Style="{x:Null}" MinimumHeightRequest="0" MinimumWidthRequest="0" HorizontalOptions="Fill" VerticalOptions="Fill" ZIndex="2"/>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout x:Name="GeneralFeaturesSection" Spacing="6">
                                <Label Text="Features" FontSize="14" FontAttributes="Bold" TextColor="#0F172A"/>
                                <Label Text="Enable or disable optional features for this printer." FontSize="12" TextColor="#94A3B8"/>
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                                    <Border BackgroundColor="#F8FAFC" Padding="10,8" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                                        <HorizontalStackLayout Spacing="8">
                                            <CheckBox x:Name="CashDrawerCheckbox" Color="#16A34A" VerticalOptions="Center"/>
                                            <Label Text="Cash drawer" VerticalOptions="Center" TextColor="#334155" FontSize="13"/>
                                        </HorizontalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" BackgroundColor="#F8FAFC" Padding="10,8" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                                        <HorizontalStackLayout Spacing="8">
                                            <CheckBox x:Name="CutterCheckbox" IsChecked="True" Color="#16A34A" VerticalOptions="Center"/>
                                            <Label Text="Auto cutter" VerticalOptions="Center" TextColor="#334155" FontSize="13"/>
                                        </HorizontalStackLayout>
                                    </Border>
                                    <Border Grid.Column="2" BackgroundColor="#F8FAFC" Padding="10,8" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                                        <HorizontalStackLayout Spacing="8">
                                            <CheckBox x:Name="BuzzerCheckbox" Color="#16A34A" VerticalOptions="Center"/>
                                            <Label Text="Buzzer" VerticalOptions="Center" TextColor="#334155" FontSize="13"/>
                                        </HorizontalStackLayout>
                                    </Border>
                                    <Border Grid.Column="3" BackgroundColor="#F8FAFC" Padding="10,8" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                                        <HorizontalStackLayout Spacing="8">
                                            <CheckBox x:Name="TwoColorCheckbox" Color="#DC2626" VerticalOptions="Center"/>
                                            <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                                <Label Text="Black + red" TextColor="#334155" FontSize="13"/>
                                                <Label Text="Two-colour ribbon" TextColor="#94A3B8" FontSize="11"/>
                                            </VerticalStackLayout>
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>

                            <VerticalStackLayout x:Name="LabelConfigurationSection" Spacing="8" IsVisible="False">
                                <Label Text="Sticker size" FontSize="14" FontAttributes="Bold" TextColor="#0F172A"/>
                                <Label Text="Pick the roll in the printer. Mother sets the rest." FontSize="12" TextColor="#94A3B8"/>
                                <HorizontalStackLayout Spacing="8">
                                    <Border x:Name="LabelSizeNormalBorder" BackgroundColor="#0F172A" Padding="14,10" StrokeThickness="0">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnLabelSizeNormalTapped"/></Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="1">
                                            <Label x:Name="LabelSizeNormalLabel" Text="60 × 40" FontSize="14" FontAttributes="Bold" TextColor="White"/>
                                            <Label x:Name="LabelSizeNormalHint" Text="Normal" FontSize="11" TextColor="#E2E8F0"/>
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border x:Name="LabelSizeSmallBorder" BackgroundColor="#F8FAFC" Padding="14,10" Stroke="#E2E8F0" StrokeThickness="1">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnLabelSizeSmallTapped"/></Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="1">
                                            <Label x:Name="LabelSizeSmallLabel" Text="51 × 30" FontSize="14" FontAttributes="Bold" TextColor="#334155"/>
                                            <Label x:Name="LabelSizeSmallHint" Text="Small" FontSize="11" TextColor="#94A3B8"/>
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border x:Name="LabelSizeDeliveryBorder" BackgroundColor="#F8FAFC" Padding="14,10" Stroke="#E2E8F0" StrokeThickness="1">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnLabelSizeDeliveryTapped"/></Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="1">
                                            <Label x:Name="LabelSizeDeliveryLabel" Text="80 × 50" FontSize="14" FontAttributes="Bold" TextColor="#334155"/>
                                            <Label x:Name="LabelSizeDeliveryHint" Text="Delivery" FontSize="11" TextColor="#94A3B8"/>
                                        </VerticalStackLayout>
                                    </Border>
                                </HorizontalStackLayout>
                                <Picker x:Name="LabelProfilePicker" IsVisible="False" SelectedIndexChanged="OnLabelProfileChanged">
                                    <Picker.Items>
                                        <x:String>60 × 40</x:String>
                                        <x:String>51 × 30</x:String>
                                        <x:String>80 × 50</x:String>
                                    </Picker.Items>
                                </Picker>
                                <Entry x:Name="MediaWidthEntry" IsVisible="False" Text="60"/>
                                <Entry x:Name="LabelWidthEntry" IsVisible="False" Text="60"/>
                                <Entry x:Name="LabelHeightEntry" IsVisible="False" Text="40"/>
                                <Picker x:Name="SensorTypePicker" IsVisible="False" SelectedIndex="0" SelectedIndexChanged="OnSensorTypeChanged">
                                    <Picker.Items><x:String>Gap</x:String><x:String>Black mark</x:String><x:String>Continuous</x:String></Picker.Items>
                                </Picker>
                                <Entry x:Name="GapSizeEntry" IsVisible="False" Text="3"/>
                                <Entry x:Name="PrintSpeedEntry" IsVisible="False" Text="4"/>
                                <Entry x:Name="PrintDarknessEntry" IsVisible="False" Text="0"/>
                                <Entry x:Name="HorizontalOffsetEntry" IsVisible="False" Text="0"/>
                                <Entry x:Name="VerticalOffsetEntry" IsVisible="False" Text="0"/>
                                <Picker x:Name="FinishingModePicker" IsVisible="False" SelectedIndex="0">
                                    <Picker.Items><x:String>Tear-off</x:String><x:String>Cutter</x:String></Picker.Items>
                                </Picker>
                                <Entry x:Name="NumberOfCopiesEntry" IsVisible="False" Text="1"/>
                                <CheckBox x:Name="CutterInstalledCheckbox" IsVisible="False"/>
                                <CheckBox x:Name="LabelEnabledCheckbox" IsChecked="True" IsVisible="False"/>
                                <CheckBox x:Name="DefaultLabelPrinterCheckbox" IsVisible="False"/>
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="#F1F5F9"/>

                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                <Label x:Name="ConnectionStatusLabel"
                                       Text="Not tested"
                                       FontSize="12"
                                       TextColor="#94A3B8"
                                       VerticalOptions="Center"/>
                                <Button x:Name="TestConnectionButton"
                                        Grid.Column="1"
                                        Text="Test connection"
                                        BackgroundColor="White"
                                        TextColor="#2563EB"
                                        BorderColor="#BFDBFE"
                                        BorderWidth="1"
                                        CornerRadius="8"
                                        HeightRequest="34"
                                        MinimumHeightRequest="34"
                                        Padding="12,0"
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        Style="{x:Null}"
                                        Clicked="OnTestConnectionClicked"/>
                                <Button Grid.Column="2"
                                        Text="Cancel"
                                        BackgroundColor="White"
                                        TextColor="#475569"
                                        BorderColor="#E2E8F0"
                                        BorderWidth="1"
                                        CornerRadius="8"
                                        HeightRequest="34"
                                        MinimumHeightRequest="34"
                                        Padding="12,0"
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        Style="{x:Null}"
                                        Clicked="OnCloseFormClicked"/>
                                <Button x:Name="SavePrinterButton"
                                        Grid.Column="3"
                                        Text="Save Printer"
                                        BackgroundColor="#0F172A"
                                        TextColor="White"
                                        CornerRadius="8"
                                        HeightRequest="34"
                                        MinimumHeightRequest="34"
                                        Padding="14,0"
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        Style="{x:Null}"
                                        Clicked="OnSavePrinterClicked"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="White" Padding="12,10" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Printers" FontSize="14" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center"/>
                                <Label x:Name="AddedPrintersSummary"
                                       Grid.Column="1"
                                       Text="0 connected"
                                       FontSize="12"
                                       TextColor="#64748B"
                                       VerticalOptions="Center"/>
                            </Grid>
                            <Label x:Name="NoAddedPrintersLabel"
                                   Text="No printers configured yet"
                                   FontSize="12"
                                   TextColor="#94A3B8"/>
                            <VerticalStackLayout x:Name="AddedPrintersList" Spacing="6"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            HeightRequest="28"
                            HorizontalOptions="Fill"/>
                </VerticalStackLayout>

            </Grid>
        </ScrollView>
        </Grid>
        
        <!-- Dialog Overlay Container (Always on top) -->
        <ContentView x:Name="DialogOverlay"
                     AbsoluteLayout.LayoutBounds="0,0,1,1"
                     AbsoluteLayout.LayoutFlags="All"
                     IsVisible="False"
                     InputTransparent="False" />
    </AbsoluteLayout>
</ContentPage>

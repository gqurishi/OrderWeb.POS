<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_in_NET.Pages.FoodMenuManagement"
             xmlns:views="clr-namespace:POS_in_NET.Views"
             xmlns:controls="clr-namespace:POS_in_NET.Controls"
             Title="Food Menu Management"
             BackgroundColor="#F1F5F9">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Top Bar -->
        <views:TopBar x:Name="TopBar" Grid.Row="0" />
        
        <!-- Toast Notification Overlay -->
        <controls:ToastNotification x:Name="ToastNotification" 
                                   Grid.RowSpan="3"
                                   ZIndex="2000"
                                   InputTransparent="True"/>
        
        <!-- Clean Segmented Tab Bar -->
        <Border Grid.Row="1" 
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeThickness="0,0,0,1"
                Padding="20,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Tab Buttons - Clean Segmented Style -->
                <Border Grid.Column="0"
                        BackgroundColor="#F8FAFC"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 25"
                        Padding="4">
                    <HorizontalStackLayout Spacing="0">
                        <!-- Items Tab -->
                        <Border x:Name="ItemsTabBorder"
                                BackgroundColor="#3B82F6"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 22"
                                Padding="20,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnItemsTabClicked"/>
                            </Border.GestureRecognizers>
                            <Label x:Name="ItemsTabLabel"
                                   Text="Items"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   VerticalOptions="Center"/>
                        </Border>
                        
                        <!-- Sub-Categories Tab -->
                        <Border x:Name="SubCategoriesTabBorder"
                                BackgroundColor="Transparent"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 22"
                                Padding="20,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSubCategoriesTabClicked"/>
                            </Border.GestureRecognizers>
                            <Label x:Name="SubCategoriesTabLabel"
                                   Text="Sub-Categories"
                                   FontSize="14"
                                   TextColor="#64748B"
                                   VerticalOptions="Center"/>
                        </Border>
                        
                        <!-- Categories Tab -->
                        <Border x:Name="CategoriesTabBorder"
                                BackgroundColor="Transparent"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 22"
                                Padding="20,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCategoriesTabClicked"/>
                            </Border.GestureRecognizers>
                            <Label x:Name="CategoriesTabLabel"
                                   Text="Categories"
                                   FontSize="14"
                                   TextColor="#64748B"
                                   VerticalOptions="Center"/>
                        </Border>
                        
                        <!-- Meal Deals Tab -->
                        <Border x:Name="MealDealsTabBorder"
                                BackgroundColor="Transparent"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 22"
                                Padding="20,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMealDealsTabClicked"/>
                            </Border.GestureRecognizers>
                            <Label x:Name="MealDealsTabLabel"
                                   Text="Meal Deals"
                                   FontSize="14"
                                   TextColor="#64748B"
                                   VerticalOptions="Center"/>
                        </Border>

                        <!-- Tasting Menus Tab -->
                        <Border x:Name="TastingMenusTabBorder"
                                BackgroundColor="Transparent"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 22"
                                Padding="20,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTastingMenusTabClicked"/>
                            </Border.GestureRecognizers>
                            <Label x:Name="TastingMenusTabLabel"
                                   Text="Tasting Menus"
                                   FontSize="14"
                                   TextColor="#64748B"
                                   VerticalOptions="Center"/>
                        </Border>
                    </HorizontalStackLayout>
                </Border>
                
                <!-- Search Bar on Right Side -->
                <Border Grid.Column="2"
                        BackgroundColor="#F8FAFC"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 25"
                        Padding="4,0"
                        WidthRequest="300"
                        HeightRequest="46">
                    <Grid ColumnDefinitions="*,Auto" Padding="16,0">
                        <Entry x:Name="SearchEntry"
                               Grid.Column="0"
                               Placeholder="Search items, categories..."
                               PlaceholderColor="#94A3B8"
                               FontSize="14"
                               TextColor="#1E293B"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center"
                               TextChanged="OnSearchTextChanged"/>
                        <Border Grid.Column="1"
                                BackgroundColor="#E2E8F0"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                Padding="8,4"
                                IsVisible="{Binding Source={x:Reference SearchEntry}, Path=Text.Length}"
                                VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnClearSearchClicked"/>
                            </Border.GestureRecognizers>
                            <Label Text=""
                                   FontSize="12"
                                   TextColor="#64748B"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="2" Padding="20">
            
            <!-- ==================== CATEGORIES CONTENT ==================== -->
            <Border x:Name="CategoriesContent" 
                    IsVisible="False"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="0">
                
                <Grid RowDefinitions="Auto,*">
                    <!-- Header -->
                    <Grid Grid.Row="0" 
                          Padding="20,12"
                          ColumnDefinitions="Auto,*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Categories"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#1E293B"/>
                            <Label Text="Organize your menu with categories and sub-categories"
                                   FontSize="12"
                                   TextColor="#64748B"/>
                        </VerticalStackLayout>
                        
                        <Button Grid.Column="2"
                                Text="+ Add Category"
                                BackgroundColor="#10B981"
                                TextColor="White"
                                FontSize="13"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                Padding="16,8"
                                Clicked="OnAddCategoryClicked"/>
                    </Grid>
                    
                    <!-- Categories List -->
                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout Spacing="0">
                            <!-- Table Column Headers -->
                            <Grid ColumnDefinitions="36,*,78,86,86" ColumnSpacing="8" Padding="16,8" BackgroundColor="White">
                                <Label Grid.Column="0" Text="" FontSize="12" TextColor="#64748B" FontAttributes="Bold"/>
                                <Label Grid.Column="1" Text="Category" FontSize="12" TextColor="#64748B" FontAttributes="Bold"/>
                                <Label Grid.Column="2" Text="Items" FontSize="12" TextColor="#64748B" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label Grid.Column="3" Text="Status" FontSize="12" TextColor="#64748B" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label Grid.Column="4" Text="Actions" FontSize="12" TextColor="#64748B" FontAttributes="Bold" HorizontalOptions="Center"/>
                            </Grid>
                            <BoxView HeightRequest="1" Color="#E2E8F0"/>
                            <!-- List Items Container -->
                            <VerticalStackLayout x:Name="CategoriesListContainer" Spacing="0"/>
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </Border>
            
            <!-- ==================== SUB-CATEGORIES CONTENT ==================== -->
            <Border x:Name="SubCategoriesContent" 
                    IsVisible="False"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="0">
                
                <Grid RowDefinitions="Auto,*">
                    <!-- Header -->
                    <Grid Grid.Row="0" 
                          Padding="20,12"
                          ColumnDefinitions="Auto,*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Sub-Categories"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#1E293B"/>
                            <Label Text="Create sub-categories under main categories"
                                   FontSize="12"
                                   TextColor="#64748B"/>
                        </VerticalStackLayout>
                        
                        <Button Grid.Column="2"
                                Text="+ Add Sub-Category"
                                BackgroundColor="#8B5CF6"
                                TextColor="White"
                                FontSize="13"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                Padding="16,8"
                                Clicked="OnAddSubCategoryClicked"/>
                    </Grid>
                    
                    <!-- Sub-Categories List -->
                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout Spacing="0">
                            <!-- Table Column Headers -->
                            <Grid ColumnDefinitions="36,*,140,72,86,86" ColumnSpacing="8" Padding="16,8" BackgroundColor="White">
                                <Label Grid.Column="1" Text="Sub-Category" FontSize="12" TextColor="#64748B" FontAttributes="Bold"/>
                                <Label Grid.Column="2" Text="Parent Category" FontSize="12" TextColor="#64748B" FontAttributes="Bold"/>
                                <Label Grid.Column="3" Text="Items" FontSize="12" TextColor="#64748B" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label Grid.Column="4" Text="Status" FontSize="12" TextColor="#64748B" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label Grid.Column="5" Text="Actions" FontSize="12" TextColor="#64748B" FontAttributes="Bold" HorizontalOptions="Center"/>
                            </Grid>
                            <BoxView HeightRequest="1" Color="#E2E8F0"/>
                            <!-- List Items Container -->
                            <VerticalStackLayout x:Name="SubCategoriesListContainer" Spacing="0"/>
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </Border>
            
            <!-- ==================== ITEMS CONTENT ==================== -->
            <Border x:Name="ItemsContent" 
                    IsVisible="True"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="0">
                
                <Grid RowDefinitions="Auto,*">
                    <!-- Header -->
                    <Grid Grid.Row="0" 
                          Padding="20,12"
                          ColumnDefinitions="Auto,*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Menu Items"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#1E293B"/>
                            <Label Text="Manage your food items, set menus, and add-ons"
                                   FontSize="12"
                                   TextColor="#64748B"/>
                        </VerticalStackLayout>
                        
                        <Button Grid.Column="2"
                                Text="+ Add Item"
                                BackgroundColor="#3B82F6"
                                TextColor="White"
                                FontSize="13"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                Padding="16,8"
                                Clicked="OnAddItemClicked"/>
                    </Grid>
                    
                    <!-- Items List -->
                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout Spacing="0">
                            <!-- Table Column Headers -->
                            <Grid ColumnDefinitions="48,*,110,130,90,100" ColumnSpacing="8" Padding="16,8" BackgroundColor="White">
                                <Label Grid.Column="0" Text="#" FontSize="12" TextColor="#64748B" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label Grid.Column="1" Text="Item" FontSize="12" TextColor="#64748B" FontAttributes="Bold"/>
                                <Label Grid.Column="2" Text="Price" FontSize="12" TextColor="#64748B" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label Grid.Column="3" Text="Category" FontSize="12" TextColor="#64748B" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label Grid.Column="4" Text="Status" FontSize="12" TextColor="#64748B" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label Grid.Column="5" Text="Actions" FontSize="12" TextColor="#64748B" FontAttributes="Bold" HorizontalOptions="Center"/>
                            </Grid>
                            <BoxView HeightRequest="1" Color="#E2E8F0"/>
                            <!-- List Items Container -->
                            <VerticalStackLayout x:Name="ItemsListContainer" Spacing="0"/>
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </Border>
            
            <!-- ==================== MEAL DEALS CONTENT ==================== -->
            <Border x:Name="MealDealsContent" 
                    IsVisible="False"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="0">
                
                <Grid RowDefinitions="Auto,*">
                    <!-- Header -->
                    <Grid Grid.Row="0" 
                          Padding="24,20"
                          ColumnDefinitions="Auto,*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Meal Deals"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="#1E293B"/>
                            <Label Text="Create bundle offers and combo deals"
                                   FontSize="13"
                                   TextColor="#64748B"/>
                        </VerticalStackLayout>
                        
                        <Button Grid.Column="2"
                                Text="+ Create Meal Deal"
                                BackgroundColor="#F59E0B"
                                TextColor="White"
                                FontSize="14"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                Padding="20,12"
                                Clicked="OnAddMealDealClicked"/>
                    </Grid>
                    
                    <!-- Meal Deals List -->
                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout Spacing="0">
                            <!-- Table Column Headers -->
                            <Grid ColumnDefinitions="*,100,120,100,100" ColumnSpacing="10" Padding="24,12" BackgroundColor="White">
                                <Label Grid.Column="0" Text="Deal Name" FontSize="12" TextColor="#64748B" FontAttributes="Bold"/>
                                <Label Grid.Column="1" Text="Price" FontSize="12" TextColor="#64748B" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label Grid.Column="2" Text="Items" FontSize="12" TextColor="#64748B" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label Grid.Column="3" Text="Status" FontSize="12" TextColor="#64748B" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label Grid.Column="4" Text="Actions" FontSize="12" TextColor="#64748B" FontAttributes="Bold" HorizontalOptions="Center"/>
                            </Grid>
                            <BoxView HeightRequest="1" Color="#E2E8F0"/>
                            <!-- List Items Container -->
                            <VerticalStackLayout x:Name="MealDealsListContainer" Spacing="0"/>
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </Border>

            <!-- ==================== TASTING MENUS CONTENT ==================== -->
            <Border x:Name="TastingMenusContent" 
                    IsVisible="False"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="0">
                
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" 
                          Padding="24,20"
                          ColumnDefinitions="Auto,*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Tasting Menus"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="#1E293B"/>
                            <Label Text="Create priced multi-course packages with wine options"
                                   FontSize="13"
                                   TextColor="#64748B"/>
                        </VerticalStackLayout>
                        
                        <Button Grid.Column="2"
                                Text="+ Create Tasting Menu"
                                BackgroundColor="#0EA5E9"
                                TextColor="White"
                                FontSize="14"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                Padding="20,12"
                                Clicked="OnAddTastingMenuClicked"/>
                    </Grid>
                    
                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="*,220,120,100,100" ColumnSpacing="10" Padding="24,12" BackgroundColor="White">
                                <Label Grid.Column="0" Text="Menu Name" FontSize="12" TextColor="#64748B" FontAttributes="Bold"/>
                                <Label Grid.Column="1" Text="Options" FontSize="12" TextColor="#64748B" FontAttributes="Bold"/>
                                <Label Grid.Column="2" Text="Courses" FontSize="12" TextColor="#64748B" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label Grid.Column="3" Text="Status" FontSize="12" TextColor="#64748B" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label Grid.Column="4" Text="Actions" FontSize="12" TextColor="#64748B" FontAttributes="Bold" HorizontalOptions="Center"/>
                            </Grid>
                            <BoxView HeightRequest="1" Color="#E2E8F0"/>
                            <VerticalStackLayout x:Name="TastingMenusListContainer" Spacing="0"/>
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </Border>
            
        </Grid>
        
        <!-- Add Category Dialog Overlay -->
        <Grid x:Name="AddCategoryDialog"
              Grid.RowSpan="3"
              IsVisible="False"
              BackgroundColor="#80000000"
              ZIndex="1000">
            <Border BackgroundColor="White"
                    WidthRequest="400"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="0">
                <Border.Shadow>
                    <Shadow Brush="#0F172A" Offset="0,6" Radius="16" Opacity="0.12"/>
                </Border.Shadow>

                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Header -->
                    <Grid Grid.Row="0" Padding="16,14" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label x:Name="CategoryDialogTitle"
                                   Text="Add category"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A" />
                            <Label Text="Name, colour, then save"
                                   FontSize="12"
                                   TextColor="#64748B" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1"
                                BackgroundColor="#F1F5F9"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                WidthRequest="32"
                                HeightRequest="32"
                                VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCategoryDialogClose"/>
                            </Border.GestureRecognizers>
                            <Label Text="×"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#64748B"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                        </Border>
                    </Grid>

                    <VerticalStackLayout Grid.Row="1" Padding="16,0,16,8" Spacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Name *"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#475569"/>
                            <Border BackgroundColor="#F8FAFC"
                                    Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12,0"
                                    HeightRequest="42">
                                <Entry x:Name="CategoryNameEntry"
                                       Placeholder="e.g. Starters"
                                       PlaceholderColor="#94A3B8"
                                       FontSize="14"
                                       TextColor="#0F172A"
                                       BackgroundColor="Transparent"
                                       VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Colour"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#475569"/>
                            <FlexLayout x:Name="ColorPickerContainer"
                                        Wrap="Wrap"
                                        JustifyContent="Start"
                                        AlignItems="Center"/>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="Custom"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#64748B"
                                       VerticalOptions="Center"/>
                                <Border Grid.Column="1"
                                        BackgroundColor="#F8FAFC"
                                        Stroke="#E2E8F0"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="10,0"
                                        HeightRequest="36">
                                    <Entry x:Name="CustomColorEntry"
                                           Placeholder="#HEX"
                                           PlaceholderColor="#94A3B8"
                                           FontSize="13"
                                           TextColor="#0F172A"
                                           BackgroundColor="Transparent"
                                           VerticalOptions="Center"
                                           TextChanged="OnCustomColorTextChanged"/>
                                </Border>
                                <Border x:Name="CustomColorPreview"
                                        Grid.Column="2"
                                        BackgroundColor="#E2E8F0"
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        StrokeShape="RoundRectangle 14"
                                        StrokeThickness="2"
                                        Stroke="#FFFFFF"
                                        VerticalOptions="Center"/>
                            </Grid>
                        </VerticalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Active"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#475569"
                                   VerticalOptions="Center"/>
                            <Switch x:Name="CategoryActiveSwitch"
                                    IsToggled="True"
                                    OnColor="#059669"
                                    ThumbColor="White"
                                    Scale="0.85"
                                    VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <Grid Grid.Row="2"
                          ColumnDefinitions="*,*"
                          ColumnSpacing="8"
                          Padding="16,10">
                        <Button Grid.Column="0"
                                Text="Cancel"
                                BackgroundColor="#F8FAFC"
                                TextColor="#475569"
                                BorderColor="#E2E8F0"
                                BorderWidth="1"
                                FontSize="13"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                HeightRequest="40"
                                Clicked="OnCategoryDialogClose"/>
                        <Button Grid.Column="1"
                                x:Name="SaveCategoryButton"
                                Text="Save category"
                                BackgroundColor="#059669"
                                TextColor="White"
                                FontSize="13"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                HeightRequest="40"
                                Clicked="OnSaveCategoryClicked"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Add Sub-Category Dialog Overlay -->
        <Grid x:Name="AddSubCategoryDialog"
              Grid.RowSpan="3"
              IsVisible="False"
              BackgroundColor="#80000000"
              ZIndex="1000">
            <Border BackgroundColor="White"
                    WidthRequest="420"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    Padding="0">
                <Border.Shadow>
                    <Shadow Brush="#0F172A" Offset="0,6" Radius="16" Opacity="0.12"/>
                </Border.Shadow>

                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Grid.Row="0" Padding="16,14" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label x:Name="SubCategoryDialogTitle"
                                   Text="Add sub-category"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A" />
                            <Label Text="Pick a parent, then name it"
                                   FontSize="12"
                                   TextColor="#64748B" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1"
                                BackgroundColor="#F1F5F9"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                WidthRequest="32"
                                HeightRequest="32"
                                VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSubCategoryDialogClose"/>
                            </Border.GestureRecognizers>
                            <Label Text="×"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#64748B"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                        </Border>
                    </Grid>

                    <VerticalStackLayout Grid.Row="1" Padding="16,0,16,8" Spacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Name *"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#475569"/>
                            <Border BackgroundColor="#F8FAFC"
                                    Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12,0"
                                    HeightRequest="42">
                                <Entry x:Name="SubCategoryNameEntry"
                                       Placeholder="e.g. Vegetarian"
                                       PlaceholderColor="#94A3B8"
                                       FontSize="14"
                                       TextColor="#0F172A"
                                       BackgroundColor="Transparent"
                                       VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Parent category *"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#475569"/>
                            <Border BackgroundColor="#F8FAFC"
                                    Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="12,0"
                                    HeightRequest="42">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label x:Name="ParentCategoryLabel"
                                           Grid.Column="0"
                                           Text="Select parent…"
                                           FontSize="14"
                                           TextColor="#94A3B8"
                                           VerticalOptions="Center"/>
                                    <Label Grid.Column="1"
                                           Text="▼"
                                           FontSize="11"
                                           TextColor="#64748B"
                                           VerticalOptions="Center"/>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnParentCategoryFieldTapped"/>
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Colour"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#475569"/>
                            <FlexLayout x:Name="SubCategoryColorPickerContainer"
                                        Wrap="Wrap"
                                        JustifyContent="Start"
                                        AlignItems="Center"/>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="Custom"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#64748B"
                                       VerticalOptions="Center"/>
                                <Border Grid.Column="1"
                                        BackgroundColor="#F8FAFC"
                                        Stroke="#E2E8F0"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="10,0"
                                        HeightRequest="36">
                                    <Entry x:Name="SubCategoryCustomColorEntry"
                                           Placeholder="#HEX"
                                           PlaceholderColor="#94A3B8"
                                           FontSize="13"
                                           TextColor="#0F172A"
                                           BackgroundColor="Transparent"
                                           VerticalOptions="Center"
                                           TextChanged="OnSubCategoryCustomColorTextChanged"/>
                                </Border>
                                <Border x:Name="SubCategoryCustomColorPreview"
                                        Grid.Column="2"
                                        BackgroundColor="#E2E8F0"
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        StrokeShape="RoundRectangle 14"
                                        StrokeThickness="2"
                                        Stroke="#FFFFFF"
                                        VerticalOptions="Center"/>
                            </Grid>
                        </VerticalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Active"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#475569"
                                   VerticalOptions="Center"/>
                            <Switch x:Name="SubCategoryActiveSwitch"
                                    IsToggled="True"
                                    OnColor="#7C3AED"
                                    ThumbColor="White"
                                    Scale="0.85"
                                    VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <Grid Grid.Row="2"
                          ColumnDefinitions="*,*"
                          ColumnSpacing="8"
                          Padding="16,10">
                        <Button Grid.Column="0"
                                Text="Cancel"
                                BackgroundColor="#F8FAFC"
                                TextColor="#475569"
                                BorderColor="#E2E8F0"
                                BorderWidth="1"
                                FontSize="13"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                HeightRequest="40"
                                Clicked="OnSubCategoryDialogClose"/>
                        <Button Grid.Column="1"
                                x:Name="SaveSubCategoryButton"
                                Text="Save sub-category"
                                BackgroundColor="#7C3AED"
                                TextColor="White"
                                FontSize="13"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                HeightRequest="40"
                                Clicked="OnSaveSubCategoryClicked"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Parent Category Selection Dialog -->
        <Grid x:Name="ParentCategorySelectionDialog"
              Grid.RowSpan="3"
              IsVisible="False"
              BackgroundColor="#80000000"
              ZIndex="2000"
              Padding="40">
            <Border BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 14"
                    WidthRequest="420"
                    MaximumHeightRequest="520"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="#0F172A" Offset="0,6" Radius="16" Opacity="0.12"/>
                </Border.Shadow>
                <Grid RowDefinitions="Auto,*" Padding="0">
                    <Grid Grid.Row="0"
                          Padding="16,14"
                          ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="Parent category"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A"
                                   VerticalOptions="Center"/>
                            <Label Text="Choose where this sub-category belongs"
                                   FontSize="12"
                                   TextColor="#64748B"/>
                        </VerticalStackLayout>
                        <Border Grid.Column="1"
                                BackgroundColor="#F1F5F9"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                WidthRequest="32"
                                HeightRequest="32"
                                VerticalOptions="Center">
                            <Label Text="×"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#64748B"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="Center"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCloseParentCategoryDialog"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>

                    <ScrollView Grid.Row="1" Padding="12,0,12,14" MaximumHeightRequest="420">
                        <VerticalStackLayout x:Name="ParentCategoryListContainer"
                                           Spacing="8"
                                           Padding="0"/>
                    </ScrollView>
                </Grid>
            </Border>
        </Grid>

        <!-- Delete Confirmation Dialog -->
        <Grid x:Name="DeleteConfirmDialog"
              Grid.RowSpan="3"
              IsVisible="False"
              BackgroundColor="#80000000"
              ZIndex="2500"
              Padding="40">
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 20"
                    WidthRequest="560"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,10" Radius="26" Opacity="0.2"/>
                </Border.Shadow>

                <Grid RowDefinitions="Auto,Auto,Auto" Padding="32,28">
                    <!-- Title -->
                    <Label x:Name="DeleteConfirmTitleLabel"
                           Grid.Row="0"
                           Text="Delete Category"
                           FontSize="34"
                           FontAttributes="Bold"
                           TextColor="#1E293B"
                           HorizontalOptions="Center"/>

                    <!-- Message -->
                    <VerticalStackLayout Grid.Row="1" Spacing="16" Margin="0,24,0,0">
                        <Label x:Name="DeleteConfirmMessageLabel"
                               Text="Are you sure you want to delete this item?"
                               FontSize="19"
                               TextColor="#334155"
                               HorizontalTextAlignment="Center"/>

                        <Border x:Name="DeleteConfirmWarningBox"
                                IsVisible="False"
                                BackgroundColor="#FEF3C7"
                                Stroke="#FDE68A"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="14,10">
                            <Label x:Name="DeleteConfirmWarningLabel"
                                   Text=""
                                   FontSize="14"
                                   TextColor="#92400E"
                                   HorizontalTextAlignment="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Actions -->
                    <Grid Grid.Row="2"
                          ColumnDefinitions="*,*"
                          ColumnSpacing="14"
                          Margin="0,30,0,0">
                        <Button Grid.Column="0"
                                Text="Cancel"
                                BackgroundColor="#E2E8F0"
                                TextColor="#475569"
                                FontSize="17"
                                FontAttributes="Bold"
                                CornerRadius="14"
                                HeightRequest="56"
                                Clicked="OnDeleteConfirmCancelClicked"/>

                        <Button Grid.Column="1"
                                Text="Delete"
                                BackgroundColor="#EF4444"
                                TextColor="White"
                                FontSize="17"
                                FontAttributes="Bold"
                                CornerRadius="14"
                                HeightRequest="56"
                                Clicked="OnDeleteConfirmAcceptClicked"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        
    </Grid>
</ContentPage>

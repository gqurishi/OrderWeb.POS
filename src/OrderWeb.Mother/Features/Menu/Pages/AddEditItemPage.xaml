<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:inputs="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
             x:Class="POS_in_NET.Pages.AddEditItemPage"
             Title="Menu Item"
             BackgroundColor="{StaticResource Background}">

    <AbsoluteLayout>
        <!-- Main Content -->
        <Grid RowDefinitions="Auto,*,Auto"
              AbsoluteLayout.LayoutBounds="0,0,1,1"
              AbsoluteLayout.LayoutFlags="All"
              x:Name="MainContentGrid">
        
        <!-- Modern Header -->
        <Border Grid.Row="0" 
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="0">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,2" Radius="10" Opacity="0.05" />
            </Border.Shadow>
            
            <Grid Padding="16,10" ColumnDefinitions="Auto,*,Auto">
                <!-- Back/Close Button -->
                <Button Grid.Column="0"
                        Text="← Back"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="#64748B"
                        BackgroundColor="#F1F5F9"
                        CornerRadius="8"
                        Padding="12,6"
                        Clicked="OnBackClicked"
                        HorizontalOptions="Start"
                        VerticalOptions="Center" />
                
                <VerticalStackLayout Grid.Column="1" Spacing="1" Margin="12,0,0,0">
                    <Label x:Name="PageTitle"
                           Text="Add New Item"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#1E293B" />
                    <Label Text="Fill in the details below to create a new menu item"
                           FontSize="12"
                           TextColor="#64748B" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Scrollable Content with Syncfusion Components -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,10" Spacing="10">

                <!-- BASIC INFORMATION - Using Syncfusion TextInputLayout -->
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        Padding="14">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,1" Radius="12" Opacity="0.06" />
                    </Border.Shadow>
                    
                    <VerticalStackLayout Spacing="10">
                        <!-- Section Title -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <BoxView Grid.Column="0"
                                     WidthRequest="4"
                                     HeightRequest="14"
                                     CornerRadius="2"
                                     BackgroundColor="#10B981"
                                     VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="Basic Information"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#1E293B"
                                   VerticalOptions="Center" />
                        </Grid>

                        <!-- Item Name with Description -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Item Name *"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#475569" />
                            <Label Text="Enter the menu item name (max 50 characters)"
                                   FontSize="11"
                                   TextColor="#94A3B8" />
                            <Border BackgroundColor="White"
                                    StrokeThickness="1"
                                    Stroke="#E2E8F0"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="0">
                                <Entry x:Name="ItemNameEntry"
                                       Placeholder="e.g., Grilled Chicken"
                                       FontSize="14"
                                       TextColor="#0F172A"
                                       BackgroundColor="Transparent"
                                       MaxLength="50"
                                       Margin="12,8"
                                       TextChanged="OnItemNameChanged" />
                            </Border>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <!-- Category ComboBox -->
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Category *"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#475569" />
                                <inputs:SfComboBox x:Name="CategoryComboBox"
                                                  Placeholder="Select a category"
                                                  HeightRequest="42"
                                                  TextColor="#0F172A"
                                                  PlaceholderColor="#94A3B8"
                                                  Stroke="#E2E8F0"
                                                  SelectionChanged="OnCategoryChanged" />
                            </VerticalStackLayout>

                            <!-- Sub-Category ComboBox -->
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="4"
                                                 x:Name="SubCategorySection"
                                                 IsVisible="True">
                                <Label Text="Sub-Category (optional)"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#475569" />
                                <inputs:SfComboBox x:Name="SubCategoryComboBox"
                                                  Placeholder="Select a sub-category or leave blank"
                                                  HeightRequest="42"
                                                  TextColor="#0F172A"
                                                  PlaceholderColor="#94A3B8"
                                                  Stroke="#E2E8F0"
                                                  SelectionChanged="OnSubCategoryChanged" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Report Type -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Report Type *"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#475569" />
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Button x:Name="FoodTypeButton"
                                        Grid.Column="0"
                                        Text="Food"
                                        StyleId="Food"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        CornerRadius="8"
                                        HeightRequest="38"
                                        Clicked="OnItemTypeClicked" />
                                <Button x:Name="DrinkTypeButton"
                                        Grid.Column="1"
                                        Text="Drink"
                                        StyleId="Drink"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        CornerRadius="8"
                                        HeightRequest="38"
                                        Clicked="OnItemTypeClicked" />
                                <Button x:Name="OtherTypeButton"
                                        Grid.Column="2"
                                        Text="Other"
                                        StyleId="Other"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        CornerRadius="8"
                                        HeightRequest="38"
                                        Clicked="OnItemTypeClicked" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Color Selection with Custom Chips -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Color Theme"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#475569" />
                            <Label Text="Choose a color to visually identify this item"
                                   FontSize="11"
                                   TextColor="#94A3B8" />
                            
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                                <!-- Preset Colors -->
                                <HorizontalStackLayout Grid.Row="0" Spacing="6">
                                    <Border x:Name="ColorChip1"
                                            StyleId="ColorChip1"
                                            BackgroundColor="#FEE2E2"
                                            StrokeThickness="2"
                                            Stroke="#FEE2E2"
                                            StrokeShape="RoundRectangle 22"
                                            Padding="10,4">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnColorChipTapped" />
                                        </Border.GestureRecognizers>
                                        <Label Text="Red"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#DC2626" />
                                    </Border>
                                    
                                    <Border x:Name="ColorChip2"
                                            StyleId="ColorChip2"
                                            BackgroundColor="#FED7AA"
                                            StrokeThickness="2"
                                            Stroke="#FED7AA"
                                            StrokeShape="RoundRectangle 22"
                                            Padding="10,4">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnColorChipTapped" />
                                        </Border.GestureRecognizers>
                                        <Label Text="Orange"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#EA580C" />
                                    </Border>
                                    
                                    <Border x:Name="ColorChip3"
                                            StyleId="ColorChip3"
                                            BackgroundColor="#D1FAE5"
                                            StrokeThickness="3"
                                            Stroke="#10B981"
                                            StrokeShape="RoundRectangle 22"
                                            Padding="10,4">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnColorChipTapped" />
                                        </Border.GestureRecognizers>
                                        <Label Text="Green"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#059669" />
                                    </Border>
                                    
                                    <Border x:Name="ColorChip4"
                                            StyleId="ColorChip4"
                                            BackgroundColor="#DBEAFE"
                                            StrokeThickness="2"
                                            Stroke="#DBEAFE"
                                            StrokeShape="RoundRectangle 22"
                                            Padding="10,4">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnColorChipTapped" />
                                        </Border.GestureRecognizers>
                                        <Label Text="Blue"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#2563EB" />
                                    </Border>
                                    
                                    <Border x:Name="ColorChip5"
                                            StyleId="ColorChip5"
                                            BackgroundColor="#EDE9FE"
                                            StrokeThickness="2"
                                            Stroke="#EDE9FE"
                                            StrokeShape="RoundRectangle 22"
                                            Padding="10,4">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnColorChipTapped" />
                                        </Border.GestureRecognizers>
                                        <Label Text="Purple"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#7C3AED" />
                                    </Border>
                                    
                                    <Border x:Name="ColorChip6"
                                            StyleId="ColorChip6"
                                            BackgroundColor="#FCE7F3"
                                            StrokeThickness="2"
                                            Stroke="#FCE7F3"
                                            StrokeShape="RoundRectangle 22"
                                            Padding="10,4">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnColorChipTapped" />
                                        </Border.GestureRecognizers>
                                        <Label Text="Pink"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#DB2777" />
                                    </Border>
                                </HorizontalStackLayout>
                                
                                <!-- Custom Color Input -->
                                <VerticalStackLayout Grid.Row="1" Spacing="4">
                                    <Label Text="Or enter custom hex code"
                                           FontSize="11"
                                           TextColor="#94A3B8" />
                                    <Border BackgroundColor="White"
                                            StrokeThickness="1"
                                            Stroke="#E2E8F0"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="0"
                                            WidthRequest="180"
                                            HorizontalOptions="Start">
                                        <Entry x:Name="CustomColorEntry"
                                               Placeholder="e.g., #3B82F6"
                                               FontSize="13"
                                               TextColor="#0F172A"
                                               BackgroundColor="Transparent"
                                               MaxLength="7"
                                               Margin="10,6"
                                               TextChanged="OnCustomColorChanged" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- PRICING SECTION -->
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        Padding="14">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,1" Radius="12" Opacity="0.06" />
                    </Border.Shadow>
                    
                    <VerticalStackLayout Spacing="10">
                        <!-- Section Title -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <BoxView Grid.Column="0"
                                     WidthRequest="4"
                                     HeightRequest="14"
                                     CornerRadius="2"
                                     BackgroundColor="#3B82F6"
                                     VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="Pricing"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#1E293B"
                                   VerticalOptions="Center" />
                        </Grid>

                           <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Dine-in/Table Price *"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#475569" />
                                <Label Text="Use 0.00 for free items that still need to print to bar or kitchen."
                                       FontSize="11"
                                       TextColor="#64748B" />
                                <Border BackgroundColor="#F8FAFC"
                                        StrokeThickness="1"
                                        Stroke="#E2E8F0"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="8,2">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                        <Label Grid.Column="0"
                                               Text="£"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="#10B981"
                                               VerticalOptions="Center" />
                                        <Entry Grid.Column="1"
                                               x:Name="DineInPriceEntry"
                                               Placeholder="0.00"
                                               Keyboard="Numeric"
                                               FontSize="20"
                                               FontAttributes="Bold"
                                               TextColor="#0F172A"
                                               PlaceholderColor="#CBD5E1"
                                               BackgroundColor="Transparent"
                                               TextChanged="OnMixedItemPriceChanged" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Takeaway/Collection/Delivery Price *"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#475569" />
                                <Label Text="Use 0.00 if this item is not sold for takeaway, collection, or delivery."
                                       FontSize="11"
                                       TextColor="#64748B" />
                                <Border BackgroundColor="#F8FAFC"
                                        StrokeThickness="1"
                                        Stroke="#E2E8F0"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="8,2">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                        <Label Grid.Column="0"
                                               Text="£"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="#0EA5E9"
                                               VerticalOptions="Center" />
                                        <Entry Grid.Column="1"
                                               x:Name="TakeawayPriceEntry"
                                               Placeholder="0.00"
                                               Keyboard="Numeric"
                                               FontSize="20"
                                               FontAttributes="Bold"
                                               TextColor="#0F172A"
                                               PlaceholderColor="#CBD5E1"
                                               BackgroundColor="Transparent"
                                               TextChanged="OnMixedItemPriceChanged" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- STANDARD ITEM SECTION -->
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        Padding="14"
                        x:Name="StandardItemSection"
                        IsVisible="True">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,1" Radius="12" Opacity="0.06" />
                    </Border.Shadow>
                    
                    <VerticalStackLayout Spacing="10">
                        <!-- Section Title -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <BoxView WidthRequest="4"
                                     HeightRequest="14"
                                     CornerRadius="2"
                                     BackgroundColor="#2563EB"
                                     VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="VAT Configuration"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#1E293B"
                                   VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*" RowDefinitions="Auto" RowSpacing="14">
                            <Border Grid.Row="0"
                                    BackgroundColor="#F8FAFC"
                                    StrokeThickness="1"
                                    Stroke="#E2E8F0"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="8">
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                    <Border x:Name="ZeroVatCard"
                                            BackgroundColor="White"
                                            StrokeThickness="1"
                                            Stroke="#E2E8F0"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="8,8">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnVatRateCardTapped" CommandParameter="0" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                                            <Label Text="0%"
                                                   FontSize="18"
                                                   FontAttributes="Bold"
                                                   TextColor="#475569"
                                                   HorizontalTextAlignment="Center" />
                                            <Label Text="Zero-rated"
                                                   FontSize="11"
                                                   TextColor="#64748B"
                                                   HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <Border x:Name="StandardVatCard"
                                            Grid.Column="1"
                                            BackgroundColor="White"
                                            StrokeThickness="1"
                                            Stroke="#E2E8F0"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="8,8">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnVatRateCardTapped" CommandParameter="20" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                                            <Label Text="20%"
                                                   FontSize="18"
                                                   FontAttributes="Bold"
                                                   TextColor="#475569"
                                                   HorizontalTextAlignment="Center" />
                                            <Label Text="Standard VAT"
                                                   FontSize="11"
                                                   TextColor="#64748B"
                                                   HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <Border x:Name="MixedVatCard"
                                            Grid.Column="2"
                                            BackgroundColor="White"
                                            StrokeThickness="1"
                                            Stroke="#E2E8F0"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="8,8">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnVatRateCardTapped" CommandParameter="mix" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                                            <Label Text="Mix VAT"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="#475569"
                                                   HorizontalTextAlignment="Center" />
                                            <Label Text="Component-based"
                                                   FontSize="11"
                                                   TextColor="#64748B"
                                                   HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- MEAL DEAL SECTION -->
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        Padding="14"
                        x:Name="MealDealSection"
                        IsVisible="False">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,1" Radius="12" Opacity="0.06" />
                    </Border.Shadow>
                    
                    <VerticalStackLayout Spacing="10">
                        <!-- Section Title -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <BoxView Grid.Column="0"
                                     WidthRequest="4"
                                     HeightRequest="14"
                                     CornerRadius="2"
                                     BackgroundColor="#F59E0B"
                                     VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                Text="Mixed Item VAT Configuration"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#1E293B"
                                   VerticalOptions="Center" />
                        </Grid>

                        <!-- Meal Deal Content -->
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Components (Hot + Cold Mix) *"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#475569" />
                            
                            <!-- Components Container -->
                            <VerticalStackLayout x:Name="ComponentsContainer" Spacing="12">
                                <!-- Dynamic component cards will be added here -->
                            </VerticalStackLayout>
                            
                            <!-- Add Component Button -->
                            <Button x:Name="AddComponentButton"
                                    Text="+ Add Component"
                                    BackgroundColor="#F59E0B"
                                    TextColor="White"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    CornerRadius="10"
                                    HeightRequest="36"
                                    Clicked="OnAddComponentClicked" />
                            
                            <!-- VAT Breakdown Display -->
                            <Border x:Name="VatBreakdownBorder"
                                    BackgroundColor="#F8FAFC"
                                    StrokeThickness="1"
                                    Stroke="#E2E8F0"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="16"
                                    IsVisible="False"
                                    Margin="0,12,0,0">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="VAT Breakdown (Takeaway):"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#475569" />
                                    <VerticalStackLayout x:Name="VatBreakdownStack" Spacing="4">
                                        <!-- Dynamic VAT breakdown items -->
                                    </VerticalStackLayout>
                                    <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" Margin="0,4" />
                                     <Label x:Name="VatMismatchWarningLabel"
                                         Text="Warning: mixed item total does not match the item price. Please fix the prices."
                                         FontSize="12"
                                         FontAttributes="Bold"
                                         TextColor="#DC2626"
                                         IsVisible="False" />
                                    <HorizontalStackLayout Spacing="8">
                                         <Label Text="Total VAT Amount:"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#1E293B" />
                                        <Label x:Name="EffectiveVatLabel"
                                             Text="£0.00"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#10B981" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- PRICE VARIANTS SECTION -->
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        Padding="14">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,1" Radius="12" Opacity="0.06" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                            <BoxView Grid.Column="0"
                                     WidthRequest="4"
                                     HeightRequest="14"
                                     CornerRadius="2"
                                     BackgroundColor="#0EA5E9"
                                     VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Price Variants"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#1E293B" />
                                <Label Text="Sizes or portions with their own selling price"
                                       FontSize="12"
                                       TextColor="#94A3B8" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2"
                                    BackgroundColor="#E0F2FE"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 20"
                                    Padding="8,2"
                                    VerticalOptions="Center">
                                <Label x:Name="VariantCountLabel"
                                       Text="0 variants"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#0284C7" />
                            </Border>
                            <Button Grid.Column="3"
                                    Text="+ Add Variant"
                                    BackgroundColor="White"
                                    TextColor="#1E293B"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    BorderColor="#CBD5E1"
                                    BorderWidth="1"
                                    HeightRequest="36"
                                    Padding="16,0"
                                    VerticalOptions="Center"
                                    Clicked="OnAddVariantClicked" />
                        </Grid>

                        <VerticalStackLayout x:Name="VariantsContainer" Spacing="12">
                            <!-- Dynamic variant cards appear here -->
                        </VerticalStackLayout>

                        <Border x:Name="VariantsEmptyState"
                                BackgroundColor="#F9FAFB"
                                StrokeThickness="2"
                                Stroke="#E5E7EB"
                                StrokeDashArray="4,4"
                                StrokeShape="RoundRectangle 12"
                                Padding="14,10">
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Label Text="No price variants yet"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#6B7280"
                                       HorizontalOptions="Center" />
                                <Label Text="Items without variants use dine-in or takeaway price"
                                       FontSize="13"
                                       TextColor="#9CA3AF"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <!-- ADDONS SECTION -->
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        Padding="14">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,1" Radius="12" Opacity="0.06" />
                    </Border.Shadow>
                    
                    <VerticalStackLayout Spacing="10">
                        <!-- Section Title -->
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                            <BoxView Grid.Column="0"
                                     WidthRequest="4"
                                     HeightRequest="14"
                                     CornerRadius="2"
                                     BackgroundColor="#F59E0B"
                                     VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Add-ons (Optional)"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#1E293B" />
                                <Label Text="Optional extras customers can add"
                                       FontSize="12"
                                       TextColor="#94A3B8" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2"
                                    BackgroundColor="#FEF3C7"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 20"
                                    Padding="8,2"
                                    VerticalOptions="Center">
                                <Label x:Name="AddonCountLabel"
                                       Text="0 addons"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#D97706" />
                            </Border>
                            <Button Grid.Column="3"
                                    Text="+ Add Add-on"
                                    BackgroundColor="White"
                                    TextColor="#1E293B"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    BorderColor="#CBD5E1"
                                    BorderWidth="1"
                                    HeightRequest="36"
                                    Padding="16,0"
                                    VerticalOptions="Center"
                                    Clicked="OnAddAddonClicked" />
                        </Grid>

                        <!-- Addons List -->
                        <VerticalStackLayout x:Name="AddonsContainer" Spacing="12">
                            <!-- Dynamic addon cards appear here -->
                        </VerticalStackLayout>

                        <!-- Empty State -->
                        <Border x:Name="AddonsEmptyState"
                                BackgroundColor="#F9FAFB"
                                StrokeThickness="2"
                                Stroke="#E5E7EB"
                                StrokeDashArray="4,4"
                                StrokeShape="RoundRectangle 12"
                                Padding="14,10">
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Label Text="No add-ons yet"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#6B7280"
                                       HorizontalOptions="Center" />
                                <Label Text="Click the button below to add optional extras"
                                       FontSize="13"
                                       TextColor="#9CA3AF"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <!-- QUICK NOTES SECTION -->
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        Padding="14">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,1" Radius="12" Opacity="0.06" />
                    </Border.Shadow>
                    
                    <VerticalStackLayout Spacing="10">
                        <!-- Section Title -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <BoxView Grid.Column="0"
                                     WidthRequest="4"
                                     HeightRequest="14"
                                     CornerRadius="2"
                                     BackgroundColor="#6366F1"
                                     VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="Quick Notes"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#1E293B"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="2"
                                   x:Name="QuickNotesCountLabel"
                                   Text="0/6"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#94A3B8"
                                   VerticalOptions="Center" />
                        </Grid>
                        
                        <Label Text="Add up to 6 quick notes for fast order customization"
                               FontSize="13"
                               TextColor="#64748B" />

                        <!-- Quick Notes List -->
                        <Border BackgroundColor="#F8FAFC"
                                StrokeThickness="1"
                                Stroke="#E2E8F0"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="12"
                                    MinimumHeightRequest="56">
                                <VerticalStackLayout Spacing="8">
                                    <VerticalStackLayout x:Name="QuickNotesListContainer"
                                                         Spacing="8" />
                                    
                                    <!-- Add Quick Note Button -->
                                    <Button x:Name="AddQuickNoteButton"
                                            Text="+ Add Quick Note"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            BackgroundColor="#6366F1"
                                            TextColor="White"
                                            CornerRadius="8"
                                            HeightRequest="36"
                                            Clicked="OnAddQuickNoteClicked" />
                                </VerticalStackLayout>
                            </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- LABEL PRINT SETTINGS -->
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        Padding="14">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,1" Radius="12" Opacity="0.06" />
                    </Border.Shadow>
                    
                    <VerticalStackLayout Spacing="10">
                        <!-- Section Title -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <BoxView Grid.Column="0"
                                     WidthRequest="4"
                                     HeightRequest="14"
                                     CornerRadius="2"
                                     BackgroundColor="#8B5CF6"
                                     VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="Print Settings"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#1E293B"
                                   VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Label Text" FontSize="14" FontAttributes="Bold" TextColor="#475569" />
                            <Label Text="Leave empty for no standard item label. The item name is always the main heading; this is optional fixed preparation or identification text."
                                   FontSize="12" TextColor="#94A3B8" LineBreakMode="WordWrap" />
                            <Border BackgroundColor="White" StrokeThickness="1" Stroke="#E2E8F0" StrokeShape="RoundRectangle 8" Padding="0">
                                <Entry x:Name="LabelTextEntry" Placeholder="e.g., Contains one mint sauce" FontSize="14"
                                       TextColor="#0F172A" BackgroundColor="Transparent" MaxLength="100" Margin="10,6" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Print Component Labels Toggle (Always Visible) -->
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="Print Component Labels"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#475569" />
                                    <Label Text="Print individual labels for each component automatically"
                                           FontSize="12"
                                           TextColor="#94A3B8" />
                                </VerticalStackLayout>
                                <Switch x:Name="PrintComponentLabelsSwitch"
                                        Grid.Column="1"
                                        OnColor="#8B5CF6"
                                        ThumbColor="White"
                                        VerticalOptions="Center"
                                        Toggled="OnPrintComponentLabelsToggled" />
                             </Grid>

                            <Grid x:Name="AlsoPrintMainLabelContainer" ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="False">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="Also Print Main Item Label" FontSize="14" FontAttributes="Bold" TextColor="#475569" />
                                    <Label Text="Off: component labels replace the main label. On: print both component labels and the main item label."
                                           FontSize="12" TextColor="#94A3B8" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                                <Switch x:Name="AlsoPrintMainLabelSwitch" Grid.Column="1" OnColor="#8B5CF6" ThumbColor="White" VerticalOptions="Center" />
                            </Grid>
                            
                            <!-- Components List (Visible when toggle is ON) -->
                            <VerticalStackLayout x:Name="ComponentsListContainer" 
                                                Spacing="8"
                                                IsVisible="False">
                                <Label Text="Component Labels to Print"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#64748B" />
                                <Label Text="Add component names (e.g., Roti, Curry, Rice). Each will print as a separate label."
                                       FontSize="12"
                                       TextColor="#94A3B8"
                                       LineBreakMode="WordWrap" />
                                
                                <CollectionView x:Name="ComponentLabelsCollectionView"
                                               SelectionMode="None">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto,Auto"
                                                  ColumnSpacing="8"
                                                  Padding="0,4">
                                                <Label Text="{Binding Name}"
                                                       FontSize="14"
                                                       TextColor="#0F172A"
                                                       VerticalOptions="Center"
                                                       Grid.Column="0" />
                                                <Entry Grid.Column="1" Text="{Binding Quantity, Mode=TwoWay}" Keyboard="Numeric"
                                                       WidthRequest="58" MaxLength="2" HorizontalTextAlignment="Center" />
                                                <Button Text=""
                                                        BackgroundColor="#EF4444"
                                                        TextColor="White"
                                                        FontSize="12"
                                                        WidthRequest="30"
                                                        HeightRequest="30"
                                                        CornerRadius="15"
                                                        Padding="0"
                                                        Clicked="OnRemoveComponentLabel"
                                                        CommandParameter="{Binding .}"
                                                        Grid.Column="2" />
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                                
                                <Button Text="+ Add Component Label"
                                        BackgroundColor="#8B5CF6"
                                        TextColor="White"
                                        FontSize="14"
                                        CornerRadius="8"
                                        Padding="0,10"
                                        Clicked="OnAddComponentLabelClicked" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <!-- Print Group Selection -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Print Group"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#475569" />
                            <Label Text="Select which printer group this item should route to"
                                   FontSize="12"
                                   TextColor="#94A3B8"
                                   Margin="0,0,0,4" />
                            <Border BackgroundColor="White"
                                    StrokeThickness="1"
                                    Stroke="#E2E8F0"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="0">
                                <Button x:Name="PrintGroupButton"
                                        Text="Select Print Group..."
                                        FontSize="14"
                                        TextColor="#0F172A"
                                        BackgroundColor="Transparent"
                                        HorizontalOptions="FillAndExpand"
                                        Padding="10,8"
                                        Clicked="OnSelectPrintGroupClicked" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Kitchen ink colour -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Print Kitchen Item in Red"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#475569" />
                                <Label Text="Prints the item, modifiers and item notes in red on a configured two-colour kitchen printer"
                                       FontSize="12"
                                       TextColor="#94A3B8"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Switch x:Name="PrintInRedSwitch"
                                    Grid.Column="1"
                                    OnColor="#EF4444"
                                    ThumbColor="White"
                                    VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="2"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                Padding="16,10">
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="Cancel"
                        BackgroundColor="White"
                        TextColor="#64748B"
                        BorderColor="#E2E8F0"
                        BorderWidth="1"
                        FontSize="14"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="42"
                        Clicked="OnCancelClicked" />

                <Button Grid.Column="1"
                        x:Name="SaveButton"
                        Text="Save Item"
                        BackgroundColor="#10B981"
                        TextColor="White"
                        FontSize="14"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="42"
                        Clicked="OnSaveClicked" />
            </Grid>
        </Border>
        </Grid>
        
        <!-- Dialog Overlay Container (Always on top) -->
        <ContentView x:Name="DialogOverlay"
                     AbsoluteLayout.LayoutBounds="0,0,1,1"
                     AbsoluteLayout.LayoutFlags="All"
                     IsVisible="False"
                     InputTransparent="False" />
    </AbsoluteLayout>
</ContentPage>

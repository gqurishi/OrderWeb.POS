<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_in_NET.Pages.AddEditMealDealPage"
             Title="Meal Deal"
             BackgroundColor="#F1F5F9">

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="24,20">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.06" />
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0"
                        Text="← Back"
                        FontFamily="OpenSansSemibold"
                        FontSize="14"
                        TextColor="#64748B"
                        BackgroundColor="#F1F5F9"
                        CornerRadius="10"
                        Padding="16,10"
                        Clicked="OnBackClicked" />
                <VerticalStackLayout Grid.Column="1" Spacing="4" Margin="16,0,0,0">
                    <Label x:Name="PageTitle"
                           Text="Create Meal Deal"
                           FontFamily="OpenSansSemibold"
                           FontSize="24"
                           TextColor="#1E293B" />
                    <Label x:Name="PageSubtitle"
                           Text="Set one price and let customers pick items from your list"
                           FontSize="13"
                           TextColor="#64748B" />
                </VerticalStackLayout>
                <Button Grid.Column="2"
                        x:Name="SaveButton"
                        Text="Save Deal"
                        FontFamily="OpenSansSemibold"
                        FontSize="14"
                        TextColor="White"
                        BackgroundColor="#F59E0B"
                        CornerRadius="10"
                        Padding="20,12"
                        Clicked="OnSaveClicked" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="20">

                <Border BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="24">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Deal Information"
                               FontFamily="OpenSansSemibold"
                               FontSize="18"
                               TextColor="#1E293B" />

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Deal Name *" FontSize="13" FontAttributes="Bold" TextColor="#475569" />
                            <Entry x:Name="DealNameEntry"
                                   Placeholder="e.g. Meal Deal 1"
                                   FontSize="16"
                                   MaxLength="80" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Description (optional)" FontSize="13" FontAttributes="Bold" TextColor="#475569" />
                            <Entry x:Name="DescriptionEntry"
                                   Placeholder="e.g. Choose any 2 items"
                                   FontSize="16"
                                   MaxLength="200" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <VerticalStackLayout Grid.Column="0" Spacing="6">
                                <Label Text="Deal Price *" FontSize="13" FontAttributes="Bold" TextColor="#475569" />
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Grid.Column="0" Text="£" FontSize="18" VerticalOptions="Center" Margin="0,0,8,0" />
                                    <Entry x:Name="PriceEntry"
                                           Grid.Column="1"
                                           Placeholder="10.00"
                                           Keyboard="Numeric"
                                           FontSize="16" />
                                </Grid>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="Customer picks *" FontSize="13" FontAttributes="Bold" TextColor="#475569" />
                                <Entry x:Name="PickCountEntry"
                                       Placeholder="2"
                                       Keyboard="Numeric"
                                       FontSize="16"
                                       Text="2" />
                                <Label Text="How many items the customer must choose"
                                       FontSize="11"
                                       TextColor="#94A3B8" />
                            </VerticalStackLayout>
                        </Grid>

                        <HorizontalStackLayout Spacing="12">
                            <Label Text="Active" FontSize="14" FontAttributes="Bold" TextColor="#475569" VerticalOptions="Center" />
                            <Switch x:Name="ActiveSwitch" IsToggled="True" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="24">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Customer Choices"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="18"
                                       TextColor="#1E293B" />
                                <Label Text="Names only — no price per choice"
                                       FontSize="12"
                                       TextColor="#64748B" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="+ Add Choice"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="13"
                                    TextColor="White"
                                    BackgroundColor="#3B82F6"
                                    CornerRadius="8"
                                    Padding="14,8"
                                    Clicked="OnAddChoiceClicked" />
                        </Grid>

                        <VerticalStackLayout x:Name="ChoicesContainer" Spacing="10" />
                        <Label x:Name="ChoicesEmptyLabel"
                               Text="Add at least 2 choices (e.g. Rice, Dal, Chicken...)"
                               FontSize="13"
                               TextColor="#94A3B8"
                               HorizontalOptions="Center"
                               Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

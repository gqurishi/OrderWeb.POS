<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_in_NET.Pages.AddEditMealDealPage"
             Title="Meal Deal"
             BackgroundColor="#F1F5F9">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0"
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="0">
            <Grid Padding="16,10" ColumnDefinitions="Auto,*">
                <Button Grid.Column="0"
                        Text="← Back"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="#D97706"
                        BackgroundColor="#FFFBEB"
                        BorderColor="#FDE68A"
                        BorderWidth="1"
                        CornerRadius="8"
                        Padding="12,6"
                        Clicked="OnBackClicked"
                        VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" Spacing="0" Margin="12,0,0,0" VerticalOptions="Center">
                    <Label x:Name="PageTitle"
                           Text="Create meal deal"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="#0F172A" />
                    <Label x:Name="PageSubtitle"
                           Text="One price · customer picks from your list"
                           FontSize="12"
                           TextColor="#64748B" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="16,12,16,24" Spacing="12" MaximumWidthRequest="720" HorizontalOptions="Center">

                <!-- Deal details -->
                <Border BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="16,14">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Deal"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="#64748B"
                                   VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                <Label Text="Active"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#475569"
                                       VerticalOptions="Center" />
                                <Switch x:Name="ActiveSwitch"
                                        IsToggled="True"
                                        OnColor="#F59E0B"
                                        ThumbColor="White"
                                        Scale="0.85"
                                        VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Name *"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#475569" />
                            <Border BackgroundColor="#F8FAFC"
                                    StrokeThickness="1"
                                    Stroke="#E2E8F0"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="0"
                                    HeightRequest="42">
                                <Entry x:Name="DealNameEntry"
                                       Placeholder="e.g. Meal Deal 1"
                                       FontSize="14"
                                       TextColor="#0F172A"
                                       BackgroundColor="Transparent"
                                       MaxLength="80"
                                       Margin="12,0"
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Description"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#475569" />
                            <Border BackgroundColor="#F8FAFC"
                                    StrokeThickness="1"
                                    Stroke="#E2E8F0"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="0"
                                    HeightRequest="42">
                                <Entry x:Name="DescriptionEntry"
                                       Placeholder="Optional — e.g. Choose any 2 items"
                                       FontSize="14"
                                       TextColor="#0F172A"
                                       BackgroundColor="Transparent"
                                       MaxLength="200"
                                       Margin="12,0"
                                       VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Price *"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#475569" />
                                <Border BackgroundColor="#FFFBEB"
                                        StrokeThickness="1"
                                        Stroke="#FDE68A"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="10,0"
                                        HeightRequest="42">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                                        <Label Grid.Column="0"
                                               Text="£"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="#D97706"
                                               VerticalOptions="Center" />
                                        <Entry x:Name="PriceEntry"
                                               Grid.Column="1"
                                               Placeholder="10.00"
                                               Keyboard="Numeric"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="#0F172A"
                                               PlaceholderColor="#CBD5E1"
                                               BackgroundColor="Transparent"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Customer picks *"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#475569" />
                                <Border BackgroundColor="#F8FAFC"
                                        StrokeThickness="1"
                                        Stroke="#E2E8F0"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="0"
                                        HeightRequest="42">
                                    <Entry x:Name="PickCountEntry"
                                           Placeholder="2"
                                           Keyboard="Numeric"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="#0F172A"
                                           BackgroundColor="Transparent"
                                           Text="2"
                                           Margin="12,0"
                                           VerticalOptions="Center" />
                                </Border>
                                <Label Text="Items they must choose"
                                       FontSize="11"
                                       TextColor="#94A3B8" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Choices -->
                <Border BackgroundColor="White"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="16,14">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                <Label Text="Choices"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#64748B" />
                                <Label Text="Names only — no price per choice"
                                       FontSize="11"
                                       TextColor="#94A3B8" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="+ Add"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="White"
                                    BackgroundColor="#2563EB"
                                    CornerRadius="8"
                                    HeightRequest="36"
                                    Padding="14,0"
                                    VerticalOptions="Center"
                                    Clicked="OnAddChoiceClicked" />
                        </Grid>

                        <VerticalStackLayout x:Name="ChoicesContainer" Spacing="8" />

                        <Border x:Name="ChoicesEmptyLabel"
                                BackgroundColor="#F8FAFC"
                                StrokeThickness="1"
                                Stroke="#E2E8F0"
                                StrokeShape="RoundRectangle 8"
                                Padding="12,14"
                                IsVisible="False">
                            <Label Text="Add at least 2 choices — e.g. Rice, Dal, Chicken"
                                   FontSize="12"
                                   TextColor="#94A3B8"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Footer -->
        <Border Grid.Row="2"
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="16,10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Button Grid.Column="1"
                        x:Name="SaveButton"
                        Text="Save deal"
                        BackgroundColor="#F59E0B"
                        TextColor="White"
                        FontSize="13"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        WidthRequest="140"
                        HeightRequest="40"
                        Padding="0"
                        Clicked="OnSaveClicked" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>

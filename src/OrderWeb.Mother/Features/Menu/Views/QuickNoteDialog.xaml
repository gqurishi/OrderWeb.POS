<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_in_NET.Views.QuickNoteDialog"
             BackgroundColor="{StaticResource DialogOverlayColor}"
             VerticalOptions="Fill"
             HorizontalOptions="Fill">

    <Grid VerticalOptions="Center"
          HorizontalOptions="Center"
          Padding="36">
        <Border BackgroundColor="White"
                Stroke="{StaticResource DialogShellStrokeColor}"
                StrokeThickness="1"
                Padding="30"
                WidthRequest="460"
                VerticalOptions="Center"
                HorizontalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="22"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#0F172A" Opacity="0.16" Radius="20" Offset="0,8"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="18">
                <Border BackgroundColor="{StaticResource DialogPrimaryColor}"
                        Stroke="#FFFFFF"
                        StrokeThickness="2"
                        WidthRequest="74"
                        HeightRequest="74"
                        HorizontalOptions="Center"
                        Margin="0,0,0,4">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="37"/>
                    </Border.StrokeShape>
                    <Label Text="+"
                           FontSize="36"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

                <Label x:Name="TitleLabel"
                       Text="Add Quick Note"
                       Style="{StaticResource DialogTitleStyle}"/>

                <Label Text="Create a quick note that staff can select when taking orders"
                       Style="{StaticResource DialogMessageStyle}"/>

                <Label Text="Note Text (max 50 characters)"
                       Style="{StaticResource DialogFieldLabelStyle}"/>

                <Border BackgroundColor="{StaticResource DialogInputBackgroundColor}"
                        Stroke="{StaticResource DialogInputStrokeColor}"
                        StrokeThickness="1"
                        Padding="14,12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Entry x:Name="InputEntry"
                           Placeholder="e.g., No onions, Extra sauce, Well done"
                           Style="{StaticResource DialogInputEntryStyle}"
                           MaxLength="50"/>
                </Border>

                <Label x:Name="CharCountLabel"
                       Text="0/50"
                       FontSize="11"
                       TextColor="#94A3B8"
                       HorizontalOptions="End"/>

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="14"
                      Margin="0,8,0,0">
                    <Button Grid.Column="0"
                            x:Name="CancelButton"
                            Text="Cancel"
                            Style="{StaticResource DialogCancelButtonStyle}"
                            Clicked="OnCancelClicked"/>
                    <Button Grid.Column="1"
                            x:Name="SaveButton"
                            Text="Add Note"
                            Style="{StaticResource DialogPrimaryButtonStyle}"
                            Clicked="OnSaveClicked"/>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>

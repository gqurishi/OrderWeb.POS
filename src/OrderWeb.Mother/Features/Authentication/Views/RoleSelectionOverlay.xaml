<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:OrderWeb.SharedUI.Controls;assembly=OrderWeb.SharedUI"
             x:Class="POS_in_NET.Views.RoleSelectionOverlay"
             x:Name="RoleOverlay"
             IsVisible="False">

    <shared:RoleSelectionView x:Name="RoleView"
                              Title="Select User Role"
                              IsOverlay="True"
                              RoleSelected="OnSharedRoleSelected"
                              Dismissed="OnSharedDismissed" />

</ContentView>

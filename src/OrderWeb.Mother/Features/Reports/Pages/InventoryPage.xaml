<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:POS_in_NET.Views"
             xmlns:sharedViews="clr-namespace:OrderWeb.SharedUI.Views;assembly=OrderWeb.SharedUI"
             x:Class="POS_in_NET.Pages.InventoryPage"
             Title="Bar Inventory"
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto,*">
        <views:TopBar x:Name="TopBar" Grid.Row="0" />
        <sharedViews:BarInventoryView x:Name="Inventory"
                                      Grid.Row="1" />
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:POS_in_NET.Controls"
             xmlns:views="clr-namespace:POS_in_NET.Views"
             xmlns:converters="clr-namespace:POS_in_NET.Converters"
             xmlns:shared="clr-namespace:OrderWeb.SharedUI.Controls;assembly=OrderWeb.SharedUI"
             x:Class="POS_in_NET.Pages.UnifiedSettingsPage"
             Title="Settings"
             BackgroundColor="#F8F9FA">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:FirstLetterConverter x:Key="FirstLetterConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="0">
        
        <!-- Top Navigation Bar -->
        <views:TopBar x:Name="TopBar" Grid.Row="0"/>
        
        <shared:ChefLoaderView x:Name="LoadingIndicator"
                               Grid.Row="0"
                               Grid.RowSpan="4"
                               Mode="Fullscreen"
                               Size="Md"
                               Message="Cooking up your data…"
                               DelayMilliseconds="0"
                               IsLoading="False"
                               ZIndex="100" />
        
        <!-- Toast Notification -->
        <controls:ToastNotification x:Name="ToastNotification" 
                                    Grid.Row="1"
                                    IsVisible="False" />
        
        <Border Grid.Row="2"
                BackgroundColor="#F8FAFC"
                Padding="16,12"
                StrokeThickness="0">
            <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="10">
                <Border x:Name="BusinessTabBorder"
                        BackgroundColor="#2563EB"
                        Padding="0"
                        HeightRequest="48"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12">
                    <Button BackgroundColor="Transparent"
                            TextColor="White"
                            Text="Business Info"
                            FontSize="14"
                            FontAttributes="Bold"
                            Padding="12,8"
                            CornerRadius="12"
                            HeightRequest="48"
                            MinimumHeightRequest="48"
                            Style="{x:Null}"
                            Clicked="OnBusinessTabClicked"/>
                </Border>
                <Border x:Name="UserTabBorder"
                        Grid.Column="1"
                        BackgroundColor="#FFFFFF"
                        Padding="0"
                        HeightRequest="48"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12">
                    <Button BackgroundColor="Transparent"
                            TextColor="#475569"
                            Text="User Management"
                            FontSize="14"
                            FontAttributes="Bold"
                            Padding="12,8"
                            CornerRadius="12"
                            HeightRequest="48"
                            MinimumHeightRequest="48"
                            Style="{x:Null}"
                            Clicked="OnUserTabClicked"/>
                </Border>
                <Border x:Name="OrderWebTabBorder"
                        Grid.Column="2"
                        BackgroundColor="#FFFFFF"
                        Padding="0"
                        HeightRequest="48"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12">
                    <Button BackgroundColor="Transparent"
                            TextColor="#475569"
                            Text="OrderWeb"
                            FontSize="14"
                            FontAttributes="Bold"
                            Padding="12,8"
                            CornerRadius="12"
                            HeightRequest="48"
                            MinimumHeightRequest="48"
                            Style="{x:Null}"
                            Clicked="OnOrderWebTabClicked"/>
                </Border>
                <Border x:Name="DeliveryZoneTabBorder"
                        Grid.Column="3"
                        BackgroundColor="#FFFFFF"
                        Padding="0"
                        HeightRequest="48"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12">
                    <Button BackgroundColor="Transparent"
                            TextColor="#475569"
                            Text="Delivery Zone"
                            FontSize="14"
                            FontAttributes="Bold"
                            Padding="12,8"
                            CornerRadius="12"
                            HeightRequest="48"
                            MinimumHeightRequest="48"
                            Style="{x:Null}"
                            Clicked="OnDeliveryZoneTabClicked"/>
                </Border>
                <Border x:Name="BackupTabBorder"
                        Grid.Column="4"
                        BackgroundColor="#FFFFFF"
                        Padding="0"
                        HeightRequest="48"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12">
                    <Button BackgroundColor="Transparent"
                            TextColor="#475569"
                            Text="Backup"
                            FontSize="14"
                            FontAttributes="Bold"
                            Padding="12,8"
                            CornerRadius="12"
                            HeightRequest="48"
                            MinimumHeightRequest="48"
                            Style="{x:Null}"
                            Clicked="OnBackupTabClicked"/>
                </Border>
            </Grid>
        </Border>
        
        <!-- Content Area -->
        <ScrollView Grid.Row="3" x:Name="MainScrollView" BackgroundColor="#F8F9FA">
            <StackLayout Padding="0">
                
                <!-- Business Info Content -->
                <StackLayout x:Name="BusinessInfoContent" IsVisible="True" Padding="16,12,16,16" Spacing="0">
                    <Grid ColumnDefinitions="1.45*,*" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                BackgroundColor="White"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                Padding="14,12"
                                StrokeShape="RoundRectangle 14">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                        <Label Text="Business Information"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="#0F172A"/>
                                        <Label Text="Restaurant details used on receipts and orders"
                                               FontSize="12"
                                               TextColor="#64748B"/>
                                    </VerticalStackLayout>
                                    <Button Text="Save"
                                            Grid.Column="1"
                                            BackgroundColor="#10B981"
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            CornerRadius="8"
                                            HeightRequest="36"
                                            MinimumHeightRequest="36"
                                            Padding="16,0"
                                            VerticalOptions="Center"
                                            Clicked="OnSaveBusinessInfoClicked"/>
                                </Grid>

                                <BoxView HeightRequest="1" BackgroundColor="#F1F5F9"/>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                        <Label Text="Restaurant Name" FontSize="11" TextColor="#64748B"/>
                                        <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="0" HeightRequest="36" StrokeShape="RoundRectangle 8">
                                            <Grid>
                                                <Entry x:Name="RestaurantNameEntry" Placeholder="Restaurant name" IsReadOnly="True" IsVisible="False" InputTransparent="True"/>
                                                <Label x:Name="RestaurantNameDisplay" Text="Restaurant name" FontSize="14" TextColor="#94A3B8" VerticalOptions="Center" Margin="10,0" InputTransparent="True"/>
                                                <Button Text="" BackgroundColor="Transparent" BorderWidth="0" Padding="0" Style="{x:Null}" MinimumHeightRequest="0" MinimumWidthRequest="0" Clicked="OnBusinessFieldClicked" CommandParameter="Restaurant name"/>
                                            </Grid>
                                        </Border>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="2">
                                        <Label Text="Email" FontSize="11" TextColor="#64748B"/>
                                        <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="0" HeightRequest="36" StrokeShape="RoundRectangle 8">
                                            <Grid>
                                                <Entry x:Name="EmailEntry" Placeholder="Email" Keyboard="Email" IsReadOnly="True" IsVisible="False" InputTransparent="True"/>
                                                <Label x:Name="EmailDisplay" Text="Email" FontSize="14" TextColor="#94A3B8" VerticalOptions="Center" Margin="10,0" InputTransparent="True"/>
                                                <Button Text="" BackgroundColor="Transparent" BorderWidth="0" Padding="0" Style="{x:Null}" MinimumHeightRequest="0" MinimumWidthRequest="0" Clicked="OnBusinessFieldClicked" CommandParameter="Email"/>
                                            </Grid>
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="2">
                                        <Label Text="Phone Number" FontSize="11" TextColor="#64748B"/>
                                        <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="0" HeightRequest="36" StrokeShape="RoundRectangle 8">
                                            <Grid>
                                                <Entry x:Name="PhoneEntry" Placeholder="Phone number" Keyboard="Telephone" IsReadOnly="True" IsVisible="False" InputTransparent="True"/>
                                                <Label x:Name="PhoneDisplay" Text="Phone number" FontSize="14" TextColor="#94A3B8" VerticalOptions="Center" Margin="10,0" InputTransparent="True"/>
                                                <Button Text="" BackgroundColor="Transparent" BorderWidth="0" Padding="0" Style="{x:Null}" MinimumHeightRequest="0" MinimumWidthRequest="0" Clicked="OnBusinessFieldClicked" CommandParameter="Phone number"/>
                                            </Grid>
                                        </Border>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                                        <Label Text="Website" FontSize="11" TextColor="#64748B"/>
                                        <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="0" HeightRequest="36" StrokeShape="RoundRectangle 8">
                                            <Grid>
                                                <Entry x:Name="WebsiteEntry" Placeholder="Website" IsReadOnly="True" IsVisible="False" InputTransparent="True"/>
                                                <Label x:Name="WebsiteDisplay" Text="Website" FontSize="14" TextColor="#94A3B8" VerticalOptions="Center" Margin="10,0" InputTransparent="True"/>
                                                <Button Text="" BackgroundColor="Transparent" BorderWidth="0" Padding="0" Style="{x:Null}" MinimumHeightRequest="0" MinimumWidthRequest="0" Clicked="OnBusinessFieldClicked" CommandParameter="Website"/>
                                            </Grid>
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="2">
                                        <Label Text="Address" FontSize="11" TextColor="#64748B"/>
                                        <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="0" HeightRequest="36" StrokeShape="RoundRectangle 8">
                                            <Grid>
                                                <Entry x:Name="AddressEntry" Placeholder="Address" IsReadOnly="True" IsVisible="False" InputTransparent="True"/>
                                                <Label x:Name="AddressDisplay" Text="Address" FontSize="14" TextColor="#94A3B8" VerticalOptions="Center" Margin="10,0" InputTransparent="True"/>
                                                <Button Text="" BackgroundColor="Transparent" BorderWidth="0" Padding="0" Style="{x:Null}" MinimumHeightRequest="0" MinimumWidthRequest="0" Clicked="OnBusinessFieldClicked" CommandParameter="Address"/>
                                            </Grid>
                                        </Border>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="2">
                                        <Label Text="City" FontSize="11" TextColor="#64748B"/>
                                        <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="0" HeightRequest="36" StrokeShape="RoundRectangle 8">
                                            <Grid>
                                                <Entry x:Name="CityEntry" Placeholder="City" IsReadOnly="True" IsVisible="False" InputTransparent="True"/>
                                                <Label x:Name="CityDisplay" Text="City" FontSize="14" TextColor="#94A3B8" VerticalOptions="Center" Margin="10,0" InputTransparent="True"/>
                                                <Button Text="" BackgroundColor="Transparent" BorderWidth="0" Padding="0" Style="{x:Null}" MinimumHeightRequest="0" MinimumWidthRequest="0" Clicked="OnBusinessFieldClicked" CommandParameter="City"/>
                                            </Grid>
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="3" Grid.Column="0" Spacing="2">
                                        <Label Text="Postcode" FontSize="11" TextColor="#64748B"/>
                                        <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="0" HeightRequest="36" StrokeShape="RoundRectangle 8">
                                            <Grid>
                                                <Entry x:Name="PostcodeEntry" Placeholder="Postcode" IsReadOnly="True" IsVisible="False" InputTransparent="True"/>
                                                <Label x:Name="PostcodeDisplay" Text="Postcode" FontSize="14" TextColor="#94A3B8" VerticalOptions="Center" Margin="10,0" InputTransparent="True"/>
                                                <Button Text="" BackgroundColor="Transparent" BorderWidth="0" Padding="0" Style="{x:Null}" MinimumHeightRequest="0" MinimumWidthRequest="0" Clicked="OnBusinessFieldClicked" CommandParameter="Postcode"/>
                                            </Grid>
                                        </Border>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="3" Grid.Column="1" Spacing="2">
                                        <Label Text="County" FontSize="11" TextColor="#64748B"/>
                                        <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="0" HeightRequest="36" StrokeShape="RoundRectangle 8">
                                            <Grid>
                                                <Entry x:Name="CountyEntry" Placeholder="County" IsReadOnly="True" IsVisible="False" InputTransparent="True"/>
                                                <Label x:Name="CountyDisplay" Text="County" FontSize="14" TextColor="#94A3B8" VerticalOptions="Center" Margin="10,0" InputTransparent="True"/>
                                                <Button Text="" BackgroundColor="Transparent" BorderWidth="0" Padding="0" Style="{x:Null}" MinimumHeightRequest="0" MinimumWidthRequest="0" Clicked="OnBusinessFieldClicked" CommandParameter="County"/>
                                            </Grid>
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="4" Grid.Column="0" Spacing="2">
                                        <Label Text="VAT Number" FontSize="11" TextColor="#64748B"/>
                                        <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="0" HeightRequest="36" StrokeShape="RoundRectangle 8">
                                            <Grid>
                                                <Entry x:Name="VATNumberEntry" Placeholder="VAT number" IsReadOnly="True" IsVisible="False" InputTransparent="True"/>
                                                <Label x:Name="VATNumberDisplay" Text="VAT number" FontSize="14" TextColor="#94A3B8" VerticalOptions="Center" Margin="10,0" InputTransparent="True"/>
                                                <Button Text="" BackgroundColor="Transparent" BorderWidth="0" Padding="0" Style="{x:Null}" MinimumHeightRequest="0" MinimumWidthRequest="0" Clicked="OnBusinessFieldClicked" CommandParameter="VAT number"/>
                                            </Grid>
                                        </Border>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="4" Grid.Column="1" Spacing="2">
                                        <Label Text="Country" FontSize="11" TextColor="#64748B"/>
                                        <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="0" HeightRequest="36" StrokeShape="RoundRectangle 8">
                                            <Grid>
                                                <Entry x:Name="CountryEntry" Placeholder="Country" IsReadOnly="True" IsVisible="False" InputTransparent="True"/>
                                                <Label x:Name="CountryDisplay" Text="Country" FontSize="14" TextColor="#94A3B8" VerticalOptions="Center" Margin="10,0" InputTransparent="True"/>
                                                <Button Text="" BackgroundColor="Transparent" BorderWidth="0" Padding="0" Style="{x:Null}" MinimumHeightRequest="0" MinimumWidthRequest="0" Clicked="OnBusinessFieldClicked" CommandParameter="Country"/>
                                            </Grid>
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>

                                <VerticalStackLayout x:Name="LogoutMinutesPanel" Spacing="6" IsVisible="False">
                                    <BoxView HeightRequest="1" BackgroundColor="#F1F5F9"/>
                                    <Grid ColumnDefinitions="*,120" ColumnSpacing="12">
                                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                            <Label Text="Auto logout (minutes)"
                                                   FontSize="11"
                                                   TextColor="#64748B"/>
                                            <Label Text="User, Manager, and Cashier. 3 to 60. Empty means 3. Both tills use this."
                                                   FontSize="11"
                                                   TextColor="#94A3B8"
                                                   LineBreakMode="WordWrap"/>
                                        </VerticalStackLayout>
                                        <Border Grid.Column="1"
                                                Stroke="#E2E8F0"
                                                StrokeThickness="1"
                                                BackgroundColor="#F8FAFC"
                                                Padding="8,0"
                                                HeightRequest="36"
                                                StrokeShape="RoundRectangle 8"
                                                VerticalOptions="Center">
                                            <Entry x:Name="LogoutMinutesEntry"
                                                   Keyboard="Numeric"
                                                   FontSize="14"
                                                   BackgroundColor="Transparent"
                                                   TextColor="#0F172A"
                                                   HeightRequest="36"
                                                   MinimumHeightRequest="36"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalOptions="Center"/>
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="10">
                            <Border BackgroundColor="White"
                                    Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    Padding="12,10"
                                    StrokeShape="RoundRectangle 14">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="Brand"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#0F172A"/>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Border x:Name="LogoPreviewBorder"
                                                WidthRequest="72"
                                                HeightRequest="72"
                                                BackgroundColor="#F8FAFC"
                                                Stroke="#E2E8F0"
                                                StrokeThickness="1"
                                                StrokeDashArray="4,3"
                                                VerticalOptions="Start"
                                                StrokeShape="RoundRectangle 10">
                                            <Grid>
                                                <Grid x:Name="LogoPlaceholder">
                                                    <Label Text="Logo"
                                                           FontSize="11"
                                                           TextColor="#94A3B8"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center"/>
                                                </Grid>
                                                <Image x:Name="LogoImage"
                                                       Aspect="AspectFit"
                                                       IsVisible="False"
                                                       Margin="4">
                                                    <Image.Clip>
                                                        <RoundRectangleGeometry Rect="0,0,72,72" CornerRadius="8"/>
                                                    </Image.Clip>
                                                </Image>
                                            </Grid>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                            <Button x:Name="UploadLogoButton"
                                                    Text="Choose logo"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#2563EB"
                                                    FontSize="13"
                                                    FontAttributes="Bold"
                                                    BorderColor="#BFDBFE"
                                                    BorderWidth="1"
                                                    CornerRadius="8"
                                                    HeightRequest="32"
                                                    MinimumHeightRequest="32"
                                                    Padding="12,0"
                                                    Clicked="OnUploadLogoClicked"
                                                    HorizontalOptions="Start"/>
                                            <Label Text="JPG, PNG, SVG · up to 5MB · 200px square"
                                                   FontSize="11"
                                                   TextColor="#94A3B8"/>
                                            <HorizontalStackLayout Spacing="8">
                                                <Button x:Name="RemoveLogoButton"
                                                        Text="Remove"
                                                        BackgroundColor="Transparent"
                                                        TextColor="#EF4444"
                                                        FontSize="12"
                                                        BorderColor="#FECACA"
                                                        BorderWidth="1"
                                                        CornerRadius="8"
                                                        HeightRequest="28"
                                                        MinimumHeightRequest="28"
                                                        Padding="10,0"
                                                        Clicked="OnRemoveLogoClicked"
                                                        IsVisible="False"/>
                                                <Label x:Name="LogoStatusLabel"
                                                       Text="Ready to upload"
                                                       FontSize="12"
                                                       TextColor="#16A34A"
                                                       VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <BoxView HeightRequest="1" BackgroundColor="#F1F5F9"/>

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                            <Label Text="Order number code"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="#1E3A8A"/>
                                            <Label x:Name="OrderExampleLabel"
                                                   Text="Example: KITT0001"
                                                   FontSize="11"
                                                   TextColor="#64748B"/>
                                        </VerticalStackLayout>
                                        <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                            <Border Stroke="#DBEAFE" StrokeThickness="1" BackgroundColor="#EFF6FF" Padding="0" WidthRequest="72" HeightRequest="40" StrokeShape="RoundRectangle 8">
                                                <Grid>
                                                    <Entry x:Name="OrderPrefixEntry"
                                                           Placeholder="KIT"
                                                           MaxLength="3"
                                                           IsReadOnly="True"
                                                           IsVisible="False"
                                                           InputTransparent="True"/>
                                                    <Label x:Name="OrderPrefixDisplay"
                                                           Text="KIT"
                                                           FontSize="15"
                                                           FontAttributes="Bold"
                                                           TextColor="#94A3B8"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center"
                                                           InputTransparent="True"/>
                                                    <Button Text=""
                                                            BackgroundColor="Transparent"
                                                            BorderWidth="0"
                                                            Padding="0"
                                                            Style="{x:Null}"
                                                            MinimumHeightRequest="0"
                                                            MinimumWidthRequest="0"
                                                            Clicked="OnOrderPrefixClicked"/>
                                                </Grid>
                                            </Border>
                                            <Button Text="Save"
                                                    BackgroundColor="#2563EB"
                                                    TextColor="White"
                                                    FontSize="13"
                                                    FontAttributes="Bold"
                                                    CornerRadius="8"
                                                    HeightRequest="40"
                                                    MinimumHeightRequest="40"
                                                    Padding="14,0"
                                                    VerticalOptions="Center"
                                                    Clicked="OnSaveOrderCodeClicked"/>
                                        </HorizontalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <Border x:Name="OrderServicesCard"
                                    IsVisible="False"
                                    BackgroundColor="White"
                                    Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    Padding="12,10"
                                    StrokeShape="RoundRectangle 14">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Order services"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#0F172A"
                                               VerticalOptions="Center"/>
                                        <Button x:Name="SaveOrderServicesButton"
                                                Grid.Column="1"
                                                Text="Save"
                                                BackgroundColor="#2563EB"
                                                TextColor="White"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                CornerRadius="8"
                                                HeightRequest="32"
                                                MinimumHeightRequest="32"
                                                Padding="14,0"
                                                Clicked="OnSaveOrderServicesClicked"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                        <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" Padding="8,6" StrokeShape="RoundRectangle 10">
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="0">
                                                <Label Text="Table Service" FontSize="13" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center"/>
                                                <Switch x:Name="TableServiceSwitch" Grid.Column="1" Grid.RowSpan="2" Toggled="OnOrderServiceSwitchToggled" OnColor="#059669" Scale="0.8" VerticalOptions="Center"/>
                                                <Label x:Name="TableServiceStateLabel" Grid.Row="1" Text="Enabled" FontSize="11" TextColor="#047857"/>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="1" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" Padding="8,6" StrokeShape="RoundRectangle 10">
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="0">
                                                <Label Text="Collection" FontSize="13" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center"/>
                                                <Switch x:Name="CollectionServiceSwitch" Grid.Column="1" Grid.RowSpan="2" Toggled="OnOrderServiceSwitchToggled" OnColor="#059669" Scale="0.8" VerticalOptions="Center"/>
                                                <Label x:Name="CollectionServiceStateLabel" Grid.Row="1" Text="Enabled" FontSize="11" TextColor="#047857"/>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="2" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" Padding="8,6" StrokeShape="RoundRectangle 10">
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="0">
                                                <Label Text="Delivery" FontSize="13" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center"/>
                                                <Switch x:Name="DeliveryServiceSwitch" Grid.Column="1" Grid.RowSpan="2" Toggled="OnOrderServiceSwitchToggled" OnColor="#059669" Scale="0.8" VerticalOptions="Center"/>
                                                <Label x:Name="DeliveryServiceStateLabel" Grid.Row="1" Text="Enabled" FontSize="11" TextColor="#047857"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <Border x:Name="TableServiceChargeCard"
                                    IsVisible="False"
                                    BackgroundColor="White"
                                    Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    Padding="12,10"
                                    StrokeShape="RoundRectangle 14">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Table service charge"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#0F172A"
                                               VerticalOptions="Center"/>
                                        <Button x:Name="SaveServiceChargeButton"
                                                Grid.Column="1"
                                                Text="Save"
                                                BackgroundColor="#059669"
                                                TextColor="White"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                CornerRadius="8"
                                                HeightRequest="32"
                                                MinimumHeightRequest="32"
                                                Padding="14,0"
                                                Clicked="OnSaveServiceChargeClicked"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Button x:Name="NoServiceChargeButton"
                                                Text="No service charge"
                                                HeightRequest="36"
                                                MinimumHeightRequest="36"
                                                CornerRadius="8"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                Clicked="OnNoServiceChargeClicked"/>
                                        <Button x:Name="PercentageServiceChargeButton"
                                                Grid.Column="1"
                                                Text="Service charge"
                                                HeightRequest="36"
                                                MinimumHeightRequest="36"
                                                CornerRadius="8"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                Clicked="OnPercentageServiceChargeClicked"/>
                                    </Grid>
                                    <VerticalStackLayout x:Name="ServiceChargePercentagePanel"
                                                         IsVisible="False"
                                                         Spacing="4">
                                        <Label Text="Service charge %"
                                               FontSize="11"
                                               TextColor="#64748B"/>
                                        <Border BackgroundColor="#F8FAFC"
                                                Stroke="#E2E8F0"
                                                StrokeThickness="1"
                                                HeightRequest="36"
                                                StrokeShape="RoundRectangle 8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Entry x:Name="ServiceChargePercentageEntry"
                                                       Placeholder="Enter percentage"
                                                       Keyboard="Numeric"
                                                       MaxLength="5"
                                                       FontSize="14"
                                                       TextColor="#0F172A"
                                                       BackgroundColor="Transparent"
                                                       Margin="8,0,0,0"
                                                       HeightRequest="36"
                                                       MinimumHeightRequest="36"
                                                       VerticalOptions="Center"
                                                       TextChanged="OnServiceChargePercentageTextChanged"/>
                                                <Label Grid.Column="1"
                                                       Text="%"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="#475569"
                                                       Margin="8,0,10,0"
                                                       VerticalOptions="Center"/>
                                            </Grid>
                                        </Border>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </StackLayout>
                <!-- User Management Content -->
                <StackLayout x:Name="UserInfoContent" IsVisible="False" Padding="16,12,16,16" Spacing="10">
                    <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="14,12"
                            StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout Spacing="10">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="User Management"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#0F172A"/>
                                <Label Text="Add a team member, then set their role"
                                       FontSize="12"
                                       TextColor="#64748B"/>
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="*,*,1.2*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Full Name" FontSize="11" TextColor="#64748B"/>
                                    <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="8,0" HeightRequest="36" StrokeShape="RoundRectangle 8">
                                        <Entry x:Name="NameEntry"
                                               Placeholder="Enter full name"
                                               FontSize="14"
                                               TextColor="#0F172A"
                                               BackgroundColor="Transparent"
                                               PlaceholderColor="#94A3B8"
                                               HeightRequest="36"
                                               MinimumHeightRequest="36"
                                               VerticalOptions="Center"/>
                                    </Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Security PIN" FontSize="11" TextColor="#64748B"/>
                                    <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="0" HeightRequest="36" StrokeShape="RoundRectangle 8">
                                        <Grid>
                                            <Entry x:Name="PINEntry"
                                                   Placeholder="4-digit PIN"
                                                   FontSize="14"
                                                   TextColor="#0F172A"
                                                   BackgroundColor="Transparent"
                                                   IsPassword="True"
                                                   IsReadOnly="True"
                                                   InputTransparent="True"
                                                   Keyboard="Numeric"
                                                   MaxLength="4"
                                                   IsVisible="False"/>
                                            <Label x:Name="PinDisplayLabel"
                                                   Text="4-digit PIN"
                                                   FontSize="14"
                                                   TextColor="#94A3B8"
                                                   VerticalOptions="Center"
                                                   Margin="10,0"
                                                   InputTransparent="True"/>
                                            <Button Text=""
                                                    BackgroundColor="Transparent"
                                                    BorderWidth="0"
                                                    Padding="0"
                                                    Style="{x:Null}"
                                                    MinimumHeightRequest="0"
                                                    MinimumWidthRequest="0"
                                                    Clicked="OnSecurityPinClicked"/>
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="2">
                                    <Label Text="Role" FontSize="11" TextColor="#64748B"/>
                                    <Border BackgroundColor="#F8FAFC"
                                            Stroke="#E2E8F0"
                                            StrokeThickness="1"
                                            Padding="10,0"
                                            HeightRequest="36"
                                            StrokeShape="RoundRectangle 8">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnSelectRoleClicked"/>
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label x:Name="SelectedRoleLabel"
                                                   Text="Choose user role"
                                                   FontSize="14"
                                                   TextColor="#64748B"
                                                   VerticalOptions="Center"
                                                   LineBreakMode="TailTruncation"/>
                                            <Label Grid.Column="1"
                                                   Text="Change"
                                                   FontSize="12"
                                                   TextColor="#7C3AED"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>
                                <Button Grid.Column="3"
                                        Text="Add user"
                                        BackgroundColor="#7C3AED"
                                        TextColor="White"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        CornerRadius="8"
                                        HeightRequest="36"
                                        MinimumHeightRequest="36"
                                        Padding="16,0"
                                        VerticalOptions="End"
                                        Clicked="OnAddUserClicked"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="14,12"
                            StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                    <Label Text="Team members"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="#0F172A"/>
                                    <Label Text="Edit a role, pause an account, or remove someone"
                                           FontSize="12"
                                           TextColor="#64748B"/>
                                </VerticalStackLayout>
                                <Border Grid.Column="1"
                                        BackgroundColor="#F5F3FF"
                                        Stroke="#DDD6FE"
                                        StrokeThickness="1"
                                        Padding="10,4"
                                        VerticalOptions="Center"
                                        StrokeShape="RoundRectangle 10">
                                    <Label x:Name="UserCountLabel"
                                           Text="0 Users"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#6D28D9"/>
                                </Border>
                            </Grid>

                            <CollectionView x:Name="UsersCollectionView"
                                            ItemsSource="{Binding Users}"
                                            ItemSizingStrategy="MeasureAllItems">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="6"/>
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BackgroundColor="#F8FAFC"
                                                Stroke="#E2E8F0"
                                                StrokeThickness="1"
                                                Padding="10,8"
                                                StrokeShape="RoundRectangle 10">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <Border Grid.Column="0"
                                                        WidthRequest="36"
                                                        HeightRequest="36"
                                                        BackgroundColor="#7C3AED"
                                                        VerticalOptions="Center"
                                                        StrokeShape="RoundRectangle 18">
                                                    <Label Text="{Binding Name, Converter={StaticResource FirstLetterConverter}}"
                                                           TextColor="White"
                                                           FontSize="14"
                                                           FontAttributes="Bold"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center"/>
                                                </Border>
                                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                    <Label Text="{Binding Name}"
                                                           FontSize="14"
                                                           FontAttributes="Bold"
                                                           TextColor="#0F172A"
                                                           LineBreakMode="TailTruncation"/>
                                                    <HorizontalStackLayout Spacing="6">
                                                        <Label Text="{Binding Role}"
                                                               FontSize="11"
                                                               TextColor="#6D28D9"
                                                               VerticalOptions="Center"/>
                                                        <Label Text="·"
                                                               FontSize="11"
                                                               TextColor="#CBD5E1"
                                                               VerticalOptions="Center"/>
                                                        <Ellipse Fill="{Binding StatusDotColor}"
                                                                 WidthRequest="6"
                                                                 HeightRequest="6"
                                                                 VerticalOptions="Center"/>
                                                        <Label Text="{Binding StatusText}"
                                                               FontSize="11"
                                                               TextColor="{Binding StatusTextColor}"
                                                               VerticalOptions="Center"/>
                                                    </HorizontalStackLayout>
                                                </VerticalStackLayout>
                                                <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                                    <Button Text="Edit"
                                                            BackgroundColor="#2563EB"
                                                            TextColor="White"
                                                            FontSize="12"
                                                            FontAttributes="Bold"
                                                            Padding="12,0"
                                                            CornerRadius="8"
                                                            HeightRequest="32"
                                                            MinimumHeightRequest="32"
                                                            Clicked="OnEditUserClicked"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Text="{Binding DeactivateButtonText}"
                                                            BackgroundColor="{Binding DeactivateButtonBackgroundColor}"
                                                            TextColor="{Binding DeactivateButtonTextColor}"
                                                            FontSize="12"
                                                            FontAttributes="Bold"
                                                            Padding="10,0"
                                                            CornerRadius="8"
                                                            HeightRequest="32"
                                                            MinimumHeightRequest="32"
                                                            IsEnabled="{Binding CanDeactivate}"
                                                            Clicked="OnDeleteUserClicked"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Text="Remove"
                                                            BackgroundColor="#FEF2F2"
                                                            TextColor="#B91C1C"
                                                            FontSize="12"
                                                            FontAttributes="Bold"
                                                            Padding="10,0"
                                                            CornerRadius="8"
                                                            HeightRequest="32"
                                                            MinimumHeightRequest="32"
                                                            Clicked="OnPermanentDeleteUserClicked"
                                                            CommandParameter="{Binding}"/>
                                                </HorizontalStackLayout>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                                <CollectionView.EmptyView>
                                    <Label Text="No team members yet. Add a name, PIN, and role above."
                                           FontSize="13"
                                           TextColor="#94A3B8"
                                           Margin="0,8"/>
                                </CollectionView.EmptyView>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </StackLayout>

                <!-- Delivery Zone Content -->
                <StackLayout x:Name="DeliveryZoneContent" IsVisible="False" Padding="16,12,16,16" Spacing="10">
                    <VerticalStackLayout Spacing="1" Margin="2,0,0,0">
                        <Label Text="Delivery Zone"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#0F172A"/>
                        <Label Text="Set delivery prices and review postcodes that did not match a zone"
                               FontSize="12"
                               TextColor="#64748B"/>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="300,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="10">
                            <Border BackgroundColor="White"
                                    Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    Padding="12,10"
                                    StrokeShape="RoundRectangle 14">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="Create zone"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#0F172A"/>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Zone name" FontSize="11" TextColor="#64748B"/>
                                        <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="0" HeightRequest="36" StrokeShape="RoundRectangle 8">
                                            <Grid>
                                                <Entry x:Name="DeliveryZoneNameEntry"
                                                       Placeholder="Local, Zone 1, Far Area"
                                                       IsReadOnly="True"
                                                       IsVisible="False"
                                                       InputTransparent="True"/>
                                                <Label x:Name="DeliveryZoneNameDisplay"
                                                       Text="Local, Zone 1, Far Area"
                                                       FontSize="13"
                                                       TextColor="#94A3B8"
                                                       VerticalOptions="Center"
                                                       Margin="10,0"
                                                       InputTransparent="True"/>
                                                <Button Text=""
                                                        BackgroundColor="Transparent"
                                                        BorderWidth="0"
                                                        Padding="0"
                                                        Style="{x:Null}"
                                                        MinimumHeightRequest="0"
                                                        MinimumWidthRequest="0"
                                                        Clicked="OnDeliveryZoneNameClicked"/>
                                            </Grid>
                                        </Border>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Delivery fee" FontSize="11" TextColor="#64748B"/>
                                        <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="0" HeightRequest="36" StrokeShape="RoundRectangle 8">
                                            <Grid>
                                                <Entry x:Name="DeliveryZoneFeeEntry"
                                                       Placeholder="0.00"
                                                       Keyboard="Numeric"
                                                       IsReadOnly="True"
                                                       IsVisible="False"
                                                       InputTransparent="True"/>
                                                <Label x:Name="DeliveryZoneFeeDisplay"
                                                       Text="0.00"
                                                       FontSize="13"
                                                       TextColor="#94A3B8"
                                                       VerticalOptions="Center"
                                                       Margin="10,0"
                                                       InputTransparent="True"/>
                                                <Button Text=""
                                                        BackgroundColor="Transparent"
                                                        BorderWidth="0"
                                                        Padding="0"
                                                        Style="{x:Null}"
                                                        MinimumHeightRequest="0"
                                                        MinimumWidthRequest="0"
                                                        Clicked="OnDeliveryZoneFeeClicked"/>
                                            </Grid>
                                        </Border>
                                    </VerticalStackLayout>
                                    <Button Text="Create zone"
                                            BackgroundColor="#2563EB"
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            HeightRequest="34"
                                            MinimumHeightRequest="34"
                                            CornerRadius="8"
                                            Clicked="OnCreateDeliveryZoneClicked"/>
                                </VerticalStackLayout>
                            </Border>

                            <Border BackgroundColor="White"
                                    Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    Padding="12,10"
                                    StrokeShape="RoundRectangle 14">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="Test postcode"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#0F172A"/>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="0" HeightRequest="36" StrokeShape="RoundRectangle 8">
                                            <Grid>
                                                <Entry x:Name="DeliveryZoneTestPostcodeEntry"
                                                       Placeholder="SE4 2PJ"
                                                       IsReadOnly="True"
                                                       IsVisible="False"
                                                       InputTransparent="True"/>
                                                <Label x:Name="DeliveryZoneTestDisplay"
                                                       Text="SE4 2PJ"
                                                       FontSize="13"
                                                       TextColor="#94A3B8"
                                                       VerticalOptions="Center"
                                                       Margin="10,0"
                                                       InputTransparent="True"/>
                                                <Button Text=""
                                                        BackgroundColor="Transparent"
                                                        BorderWidth="0"
                                                        Padding="0"
                                                        Style="{x:Null}"
                                                        MinimumHeightRequest="0"
                                                        MinimumWidthRequest="0"
                                                        Clicked="OnDeliveryZoneTestClicked"/>
                                            </Grid>
                                        </Border>
                                        <Button Grid.Column="1"
                                                Text="Check"
                                                BackgroundColor="#0F766E"
                                                TextColor="White"
                                                FontAttributes="Bold"
                                                FontSize="12"
                                                HeightRequest="36"
                                                MinimumHeightRequest="36"
                                                Padding="12,0"
                                                CornerRadius="8"
                                                Clicked="OnTestDeliveryZonePostcodeClicked"/>
                                    </Grid>
                                    <Label x:Name="DeliveryZoneTestResultLabel"
                                           Text=""
                                           FontSize="12"
                                           TextColor="#64748B"
                                           LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="10">
                            <Border BackgroundColor="White"
                                    Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    Padding="12,10"
                                    StrokeShape="RoundRectangle 14">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Zones"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#0F172A"
                                               VerticalOptions="Center"/>
                                        <Label x:Name="DeliveryZoneCountLabel"
                                               Grid.Column="1"
                                               Text="0 zones"
                                               FontSize="12"
                                               TextColor="#64748B"
                                               VerticalOptions="Center"/>
                                    </Grid>
                                    <CollectionView x:Name="DeliveryZonesCollectionView" ItemSizingStrategy="MeasureAllItems">
                                        <CollectionView.ItemsLayout>
                                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
                                        </CollectionView.ItemsLayout>
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" Padding="10,8" StrokeShape="RoundRectangle 10">
                                                    <VerticalStackLayout Spacing="6">
                                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                            <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                                                <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="#0F172A"/>
                                                                <Label Text="{Binding PostcodeSummary}" FontSize="11" TextColor="#64748B" LineBreakMode="TailTruncation"/>
                                                            </VerticalStackLayout>
                                                            <Label Grid.Column="1" Text="{Binding DeliveryFeeDisplay}" FontSize="14" FontAttributes="Bold" TextColor="#0F766E" VerticalOptions="Center"/>
                                                            <Button Grid.Column="2"
                                                                    Text="Delete"
                                                                    BackgroundColor="#FEF2F2"
                                                                    TextColor="#B91C1C"
                                                                    FontSize="12"
                                                                    FontAttributes="Bold"
                                                                    HeightRequest="30"
                                                                    MinimumHeightRequest="30"
                                                                    Padding="10,0"
                                                                    CornerRadius="8"
                                                                    CommandParameter="{Binding}"
                                                                    Clicked="OnDeleteDeliveryZoneClicked"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                            <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White" Padding="0" HeightRequest="32" StrokeShape="RoundRectangle 8">
                                                                <Grid>
                                                                    <Entry Placeholder="Add postcode, e.g. SE4 2PJ"
                                                                           IsReadOnly="True"
                                                                           IsVisible="False"
                                                                           InputTransparent="True"/>
                                                                    <Label Text="Add postcode, e.g. SE4 2PJ"
                                                                           FontSize="12"
                                                                           TextColor="#94A3B8"
                                                                           VerticalOptions="Center"
                                                                           Margin="8,0"
                                                                           InputTransparent="True"/>
                                                                    <Button Text=""
                                                                            BackgroundColor="Transparent"
                                                                            BorderWidth="0"
                                                                            Padding="0"
                                                                            Style="{x:Null}"
                                                                            MinimumHeightRequest="0"
                                                                            MinimumWidthRequest="0"
                                                                            Clicked="OnZonePostcodeFieldClicked"/>
                                                                </Grid>
                                                            </Border>
                                                            <Button Grid.Column="1"
                                                                    Text="Add"
                                                                    BackgroundColor="#2563EB"
                                                                    TextColor="White"
                                                                    FontSize="12"
                                                                    FontAttributes="Bold"
                                                                    HeightRequest="32"
                                                                    MinimumHeightRequest="32"
                                                                    Padding="12,0"
                                                                    CornerRadius="8"
                                                                    CommandParameter="{Binding}"
                                                                    Clicked="OnAddPostcodeToZoneClicked"/>
                                                        </Grid>
                                                        <FlexLayout BindableLayout.ItemsSource="{Binding Postcodes}"
                                                                    Wrap="Wrap"
                                                                    Direction="Row"
                                                                    AlignItems="Start">
                                                            <BindableLayout.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" Padding="8,2" Margin="0,0,6,6" StrokeShape="RoundRectangle 8">
                                                                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="4">
                                                                            <Label Text="{Binding Postcode}" FontSize="12" TextColor="#0F172A" VerticalOptions="Center"/>
                                                                            <Button Grid.Column="1"
                                                                                    Text="x"
                                                                                    FontSize="11"
                                                                                    BackgroundColor="Transparent"
                                                                                    TextColor="#EF4444"
                                                                                    Padding="0"
                                                                                    WidthRequest="22"
                                                                                    HeightRequest="22"
                                                                                    MinimumHeightRequest="22"
                                                                                    MinimumWidthRequest="22"
                                                                                    CommandParameter="{Binding}"
                                                                                    Clicked="OnRemoveDeliveryPostcodeClicked"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </BindableLayout.ItemTemplate>
                                                        </FlexLayout>
                                                    </VerticalStackLayout>
                                                </Border>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </VerticalStackLayout>
                            </Border>

                            <Border BackgroundColor="White"
                                    Stroke="#E2E8F0"
                                    StrokeThickness="1"
                                    Padding="12,10"
                                    StrokeShape="RoundRectangle 14">
                                <VerticalStackLayout Spacing="8">
                                    <VerticalStackLayout Spacing="1">
                                        <Label Text="Unassigned postcodes"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#0F172A"/>
                                        <Label Text="Customers tried these, but no zone matched"
                                               FontSize="12"
                                               TextColor="#64748B"/>
                                    </VerticalStackLayout>
                                    <CollectionView x:Name="UnassignedPostcodesCollectionView" ItemSizingStrategy="MeasureAllItems">
                                        <CollectionView.ItemsLayout>
                                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="6"/>
                                        </CollectionView.ItemsLayout>
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Border BackgroundColor="#FFFBEB" Stroke="#FDE68A" StrokeThickness="1" Padding="10,6" StrokeShape="RoundRectangle 10">
                                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                        <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                                            <Label Text="{Binding Postcode}" FontSize="13" FontAttributes="Bold" TextColor="#92400E"/>
                                                            <Label Text="{Binding RequestCount, StringFormat='{0} request(s)'}" FontSize="11" TextColor="#B45309"/>
                                                        </VerticalStackLayout>
                                                        <Button Grid.Column="1"
                                                                Text="Copy"
                                                                BackgroundColor="#F59E0B"
                                                                TextColor="White"
                                                                FontSize="12"
                                                                FontAttributes="Bold"
                                                                HeightRequest="30"
                                                                MinimumHeightRequest="30"
                                                                Padding="12,0"
                                                                CornerRadius="8"
                                                                CommandParameter="{Binding}"
                                                                Clicked="OnCopyUnassignedPostcodeClicked"/>
                                                        <Button Grid.Column="2"
                                                                Text="Delete"
                                                                BackgroundColor="#FEF2F2"
                                                                TextColor="#B91C1C"
                                                                FontSize="12"
                                                                FontAttributes="Bold"
                                                                HeightRequest="30"
                                                                MinimumHeightRequest="30"
                                                                Padding="10,0"
                                                                CornerRadius="8"
                                                                CommandParameter="{Binding}"
                                                                Clicked="OnDeleteUnassignedPostcodeClicked"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </StackLayout>

                <!-- Backup Content -->
                <StackLayout x:Name="BackupContent" IsVisible="False" Padding="16,12,16,16" Spacing="10">
                    <VerticalStackLayout Spacing="1" Margin="2,0,0,0">
                        <Label Text="Database backup"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#0F172A"/>
                        <Label Text="Backup, export, verify, and restore the Mother terminal database"
                               FontSize="12"
                               TextColor="#64748B"/>
                    </VerticalStackLayout>

                    <Border BackgroundColor="#F8FAFC"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="12,8"
                            StrokeShape="RoundRectangle 12">
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                <Label Text="Terminal" FontSize="11" TextColor="#64748B"/>
                                <Label x:Name="BackupTerminalLabel" Text="Checking..." FontSize="13" FontAttributes="Bold" TextColor="#0F172A"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="Database" FontSize="11" TextColor="#64748B"/>
                                <Label x:Name="BackupDatabaseLabel" Text="Checking..." FontSize="13" FontAttributes="Bold" TextColor="#0F172A"/>
                            </VerticalStackLayout>
                            <Label x:Name="BackupStatusLabel"
                                   Grid.Column="2"
                                   Text="Ready"
                                   FontSize="12"
                                   TextColor="#047857"
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="End"
                                   LineBreakMode="WordWrap"/>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border BackgroundColor="White"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                Padding="12,10"
                                StrokeShape="RoundRectangle 14">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Backup" FontSize="14" FontAttributes="Bold" TextColor="#0F172A"/>
                                <Label Text="Full copy of orders, payments, menu, reports, users, and settings. Automatic backups run every 3 days and keep the latest 15."
                                       FontSize="12"
                                       TextColor="#64748B"
                                       LineBreakMode="WordWrap"/>
                                <Button x:Name="BackupNowButton"
                                        Text="Backup Now"
                                        BackgroundColor="#059669"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        FontSize="13"
                                        CornerRadius="8"
                                        HeightRequest="36"
                                        MinimumHeightRequest="36"
                                        Clicked="OnBackupNowClicked"/>
                                <Button x:Name="OpenBackupFolderButton"
                                        Text="Open backup folder"
                                        BackgroundColor="Transparent"
                                        BorderColor="#BAE6FD"
                                        BorderWidth="1"
                                        TextColor="#0369A1"
                                        FontAttributes="Bold"
                                        FontSize="13"
                                        CornerRadius="8"
                                        HeightRequest="36"
                                        MinimumHeightRequest="36"
                                        Clicked="OnOpenBackupFolderClicked"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1"
                                BackgroundColor="White"
                                Stroke="#E2E8F0"
                                StrokeThickness="1"
                                Padding="12,10"
                                StrokeShape="RoundRectangle 14">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Restore" FontSize="14" FontAttributes="Bold" TextColor="#0F172A"/>
                                <Label Text="Upload an OrderWeb backup package. A safety backup is created first."
                                       FontSize="12"
                                       TextColor="#64748B"
                                       LineBreakMode="WordWrap"/>
                                <Button x:Name="UploadRestoreButton"
                                        Text="Upload and restore"
                                        BackgroundColor="#DC2626"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        FontSize="13"
                                        CornerRadius="8"
                                        HeightRequest="36"
                                        MinimumHeightRequest="36"
                                        Clicked="OnUploadRestoreBackupClicked"/>
                                <Button x:Name="VerifyDatabaseButton"
                                        Text="Verify database"
                                        BackgroundColor="Transparent"
                                        BorderColor="#E2E8F0"
                                        BorderWidth="1"
                                        TextColor="#334155"
                                        FontAttributes="Bold"
                                        FontSize="13"
                                        CornerRadius="8"
                                        HeightRequest="36"
                                        MinimumHeightRequest="36"
                                        Clicked="OnVerifyDatabaseClicked"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="12,10"
                            StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Backup history"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#0F172A"
                                       VerticalOptions="Center"/>
                                <Button Grid.Column="1"
                                        Text="Refresh"
                                        BackgroundColor="#F8FAFC"
                                        BorderColor="#E2E8F0"
                                        BorderWidth="1"
                                        TextColor="#475569"
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        CornerRadius="8"
                                        HeightRequest="30"
                                        MinimumHeightRequest="30"
                                        Padding="12,0"
                                        Clicked="OnRefreshBackupsClicked"/>
                            </Grid>
                            <CollectionView x:Name="BackupHistoryCollectionView" EmptyView="No backups yet.">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="6"/>
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" Padding="10,8" StrokeShape="RoundRectangle 10">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                                    <Label Text="{Binding FileName}" FontSize="13" FontAttributes="Bold" TextColor="#0F172A" LineBreakMode="TailTruncation"/>
                                                    <HorizontalStackLayout Spacing="6">
                                                        <Label Text="{Binding CreatedAt, StringFormat='{0:dd MMM yyyy HH:mm}'}" FontSize="11" TextColor="#64748B" VerticalOptions="Center"/>
                                                        <Label Text="·" FontSize="11" TextColor="#CBD5E1" VerticalOptions="Center"/>
                                                        <Label Text="{Binding BackupType}" FontSize="11" TextColor="#0369A1" VerticalOptions="Center"/>
                                                    </HorizontalStackLayout>
                                                </VerticalStackLayout>
                                                <Button Grid.Column="1"
                                                        Text="Export"
                                                        BackgroundColor="#0284C7"
                                                        TextColor="White"
                                                        FontAttributes="Bold"
                                                        FontSize="12"
                                                        CornerRadius="8"
                                                        HeightRequest="30"
                                                        MinimumHeightRequest="30"
                                                        Padding="12,0"
                                                        CommandParameter="{Binding .}"
                                                        Clicked="OnExportBackupClicked"/>
                                                <Button Grid.Column="2"
                                                        Text="Restore"
                                                        BackgroundColor="#FEF2F2"
                                                        TextColor="#B91C1C"
                                                        FontAttributes="Bold"
                                                        FontSize="12"
                                                        CornerRadius="8"
                                                        HeightRequest="30"
                                                        MinimumHeightRequest="30"
                                                        Padding="12,0"
                                                        CommandParameter="{Binding .}"
                                                        Clicked="OnRestoreHistoryBackupClicked"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </StackLayout>

                <!-- OrderWeb Content with Expandable Sections -->
                <StackLayout x:Name="OrderWebContent" IsVisible="False" Padding="16,12,16,16" Spacing="10">
                    <VerticalStackLayout Spacing="1" Margin="2,0,0,0">
                        <Label Text="OrderWeb"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#0F172A"/>
                        <Label Text="Cloud connection and postcode lookup"
                               FontSize="12"
                               TextColor="#64748B"/>
                    </VerticalStackLayout>

                    <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="0"
                            StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout>
                            <Border BackgroundColor="White" Padding="14,12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCloudSectionToggled"/>
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                        <Label Text="Cloud Connect Settings"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="#0F172A"/>
                                        <Label Text="Tenant, API key, and order sync"
                                               FontSize="12"
                                               TextColor="#64748B"/>
                                    </VerticalStackLayout>
                                    <Label x:Name="CloudToggleIcon"
                                           Grid.Column="1"
                                           Text="▶"
                                           FontSize="12"
                                           TextColor="#64748B"
                                           VerticalOptions="Center"/>
                                </Grid>
                            </Border>

                            <StackLayout x:Name="CloudContent" Padding="14,0,14,12" IsVisible="False" Spacing="8">
                                <BoxView HeightRequest="1" BackgroundColor="#F1F5F9"/>
                                <HorizontalStackLayout Spacing="8">
                                    <Switch x:Name="CloudOnlineMasterSwitch"
                                            Toggled="OnCloudOnlineMasterToggled"
                                            Scale="0.85"
                                            VerticalOptions="Center"/>
                                    <Label x:Name="CloudOnlineMasterLabel"
                                           Text="Online order master terminal"
                                           FontSize="13"
                                           TextColor="#475569"
                                           VerticalOptions="Center"
                                           LineBreakMode="WordWrap"/>
                                </HorizontalStackLayout>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Tenant slug" FontSize="11" TextColor="#64748B"/>
                                        <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="8,0" HeightRequest="36" StrokeShape="RoundRectangle 8">
                                            <Entry x:Name="TenantSlugEntry"
                                                   Placeholder="your-restaurant-slug"
                                                   FontSize="13"
                                                   TextColor="#0F172A"
                                                   PlaceholderColor="#94A3B8"
                                                   BackgroundColor="Transparent"
                                                   TextChanged="OnCloudFieldChanged"
                                                   HeightRequest="36"
                                                   MinimumHeightRequest="36"
                                                   VerticalOptions="Center"/>
                                        </Border>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="WebSocket URL" FontSize="11" TextColor="#64748B"/>
                                        <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="8,0" HeightRequest="36" StrokeShape="RoundRectangle 8">
                                            <Entry x:Name="CloudWebSocketUrlEntry"
                                                   Placeholder="wss://orderweb.net/ws/pos"
                                                   FontSize="13"
                                                   TextColor="#0F172A"
                                                   PlaceholderColor="#94A3B8"
                                                   BackgroundColor="Transparent"
                                                   TextChanged="OnCloudFieldChanged"
                                                   HeightRequest="36"
                                                   MinimumHeightRequest="36"
                                                   VerticalOptions="Center"/>
                                        </Border>
                                        <Label Text="Base URL only — tenant is sent separately."
                                               FontSize="11"
                                               TextColor="#94A3B8"/>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="1" Spacing="2">
                                        <Label Text="API key" FontSize="11" TextColor="#64748B"/>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="8,0" HeightRequest="36" StrokeShape="RoundRectangle 8">
                                                <Entry x:Name="CloudApiKeyEntry"
                                                       Placeholder="Enter API key"
                                                       FontSize="13"
                                                       TextColor="#0F172A"
                                                       PlaceholderColor="#94A3B8"
                                                       BackgroundColor="Transparent"
                                                       IsPassword="True"
                                                       TextChanged="OnCloudFieldChanged"
                                                       HeightRequest="36"
                                                       MinimumHeightRequest="36"
                                                       VerticalOptions="Center"/>
                                            </Border>
                                            <Button x:Name="ToggleCloudApiKeyButton"
                                                    Grid.Column="1"
                                                    Text="Show"
                                                    BackgroundColor="#F1F5F9"
                                                    TextColor="#334155"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    WidthRequest="56"
                                                    HeightRequest="36"
                                                    MinimumHeightRequest="36"
                                                    CornerRadius="8"
                                                    Clicked="OnToggleCloudApiKeyClicked"/>
                                        </Grid>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                                        <Label Text="REST API URL" FontSize="11" TextColor="#64748B"/>
                                        <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="8,0" HeightRequest="36" StrokeShape="RoundRectangle 8">
                                            <Entry x:Name="CloudRestApiUrlEntry"
                                                   Placeholder="https://orderweb.net/api"
                                                   FontSize="13"
                                                   TextColor="#0F172A"
                                                   PlaceholderColor="#94A3B8"
                                                   BackgroundColor="Transparent"
                                                   TextChanged="OnCloudFieldChanged"
                                                   HeightRequest="36"
                                                   MinimumHeightRequest="36"
                                                   VerticalOptions="Center"/>
                                        </Border>
                                        <Label Text="Base URL only — do not add /bistro or tenant slug."
                                               FontSize="11"
                                               TextColor="#94A3B8"/>
                                    </VerticalStackLayout>
                                </Grid>

                                <HorizontalStackLayout Spacing="8">
                                    <Button x:Name="CloudSaveSettingsButton"
                                            Text="Save"
                                            BackgroundColor="#0F766E"
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            HeightRequest="34"
                                            MinimumHeightRequest="34"
                                            Padding="14,0"
                                            CornerRadius="8"
                                            Clicked="OnCloudSaveSettingsClicked"/>
                                    <Button x:Name="CloudConnectButton"
                                            Text="Connect"
                                            BackgroundColor="#2563EB"
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            HeightRequest="34"
                                            MinimumHeightRequest="34"
                                            Padding="14,0"
                                            CornerRadius="8"
                                            Clicked="OnCloudConnectClicked"/>
                                    <Button x:Name="CloudSyncOrdersButton"
                                            Text="Sync orders"
                                            BackgroundColor="#059669"
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            HeightRequest="34"
                                            MinimumHeightRequest="34"
                                            Padding="14,0"
                                            CornerRadius="8"
                                            Clicked="OnCloudSyncOrdersClicked"/>
                                    <Button x:Name="CloudSyncHistoricalButton"
                                            Text="Sync historical"
                                            BackgroundColor="#7C3AED"
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            HeightRequest="34"
                                            MinimumHeightRequest="34"
                                            Padding="14,0"
                                            CornerRadius="8"
                                            Clicked="OnCloudSyncHistoricalClicked"/>
                                </HorizontalStackLayout>

                                <Border x:Name="CloudConnectionStatusFrame"
                                        BackgroundColor="#FFFBEB"
                                        Stroke="#FDE68A"
                                        StrokeThickness="1"
                                        Padding="10,8"
                                        StrokeShape="RoundRectangle 10">
                                    <VerticalStackLayout Spacing="1">
                                        <Label x:Name="CloudConnectionStatusText"
                                               Text="Not Connected"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="#92400E"/>
                                        <Label x:Name="CloudConnectionStatusDescription"
                                               Text="Configure your connection settings to get started"
                                               FontSize="12"
                                               TextColor="#B45309"/>
                                    </VerticalStackLayout>
                                </Border>

                                <StackLayout x:Name="CloudSystemStatusSection" IsVisible="False" Spacing="8">
                                    <Label Text="System status"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#0F172A"/>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Border BackgroundColor="#F0FDF4"
                                                Stroke="#BBF7D0"
                                                StrokeThickness="1"
                                                Padding="10,8"
                                                StrokeShape="RoundRectangle 10">
                                            <VerticalStackLayout Spacing="2">
                                                <HorizontalStackLayout Spacing="6">
                                                    <Label x:Name="CloudStatusConnectionIcon" Text="" FontSize="13" VerticalOptions="Center"/>
                                                    <Label x:Name="CloudStatusConnectionText"
                                                           Text="Connected"
                                                           FontSize="13"
                                                           FontAttributes="Bold"
                                                           TextColor="#15803D"
                                                           VerticalOptions="Center"/>
                                                </HorizontalStackLayout>
                                                <Label Text="Real-time sync active" FontSize="11" TextColor="#166534"/>
                                            </VerticalStackLayout>
                                        </Border>
                                        <Border Grid.Column="1"
                                                BackgroundColor="#F0F9FF"
                                                Stroke="#BAE6FD"
                                                StrokeThickness="1"
                                                Padding="10,8"
                                                StrokeShape="RoundRectangle 10">
                                            <VerticalStackLayout Spacing="2">
                                                <HorizontalStackLayout Spacing="6">
                                                    <Label x:Name="CloudStatusBackupIcon" Text="" FontSize="13" VerticalOptions="Center"/>
                                                    <Label x:Name="CloudStatusBackupText"
                                                           Text="Backup Active"
                                                           FontSize="13"
                                                           FontAttributes="Bold"
                                                           TextColor="#0C4A6E"
                                                           VerticalOptions="Center"/>
                                                </HorizontalStackLayout>
                                                <Label x:Name="CloudStatusLastCheckText"
                                                       Text="Last backup: 2 minutes ago"
                                                       FontSize="11"
                                                       TextColor="#075985"/>
                                            </VerticalStackLayout>
                                        </Border>
                                    </Grid>
                                    <Label x:Name="CloudDeviceInfoText"
                                           Text="Device ID: POS-ABC123 | Location: Main Terminal"
                                           FontSize="11"
                                           TextColor="#64748B"/>
                                </StackLayout>
                            </StackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="0"
                            StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout>
                            <Border BackgroundColor="White" Padding="14,12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPostcodeSectionToggled"/>
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                        <Label Text="Postcode Lookup Settings"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="#0F172A"/>
                                        <Label Text="Shared address lookup key"
                                               FontSize="12"
                                               TextColor="#64748B"/>
                                    </VerticalStackLayout>
                                    <Label x:Name="PostcodeToggleIcon"
                                           Grid.Column="1"
                                           Text="▶"
                                           FontSize="12"
                                           TextColor="#64748B"
                                           VerticalOptions="Center"/>
                                </Grid>
                            </Border>

                            <StackLayout x:Name="PostcodeContent" Padding="14,0,14,12" IsVisible="False" Spacing="8">
                                <BoxView HeightRequest="1" BackgroundColor="#F1F5F9"/>
                                <Label Text="Shared OrderWeb address API key (owp_...). Same for every restaurant. Delivery fees still use local zones."
                                       FontSize="12"
                                       TextColor="#64748B"
                                       LineBreakMode="WordWrap"/>
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                    <Border Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="#F8FAFC" Padding="8,0" HeightRequest="36" StrokeShape="RoundRectangle 8">
                                        <Entry x:Name="OrderWebAddressApiKeyEntry"
                                               Placeholder="owp_..."
                                               FontSize="13"
                                               TextColor="#0F172A"
                                               PlaceholderColor="#94A3B8"
                                               BackgroundColor="Transparent"
                                               IsPassword="True"
                                               HeightRequest="36"
                                               MinimumHeightRequest="36"
                                               VerticalOptions="Center"/>
                                    </Border>
                                    <Button x:Name="ToggleOrderWebAddressApiKeyButton"
                                            Grid.Column="1"
                                            Text="Show"
                                            BackgroundColor="#F1F5F9"
                                            TextColor="#334155"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            WidthRequest="56"
                                            HeightRequest="36"
                                            MinimumHeightRequest="36"
                                            CornerRadius="8"
                                            Clicked="OnToggleOrderWebAddressApiKeyClicked"/>
                                    <Button x:Name="TestOrderWebAddressButton"
                                            Grid.Column="2"
                                            Text="Test"
                                            BackgroundColor="#2563EB"
                                            TextColor="White"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            WidthRequest="56"
                                            HeightRequest="36"
                                            MinimumHeightRequest="36"
                                            CornerRadius="8"
                                            Clicked="OnTestOrderWebAddressClicked"/>
                                    <Button Grid.Column="3"
                                            Text="Save"
                                            Clicked="OnSaveOrderWebAddressSettingsClicked"
                                            BackgroundColor="#059669"
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            FontSize="12"
                                            HeightRequest="36"
                                            MinimumHeightRequest="36"
                                            Padding="14,0"
                                            CornerRadius="8"/>
                                </Grid>
                                <Border x:Name="OrderWebAddressStatusFrame"
                                        IsVisible="False"
                                        StrokeThickness="1"
                                        Stroke="#E2E8F0"
                                        BackgroundColor="#F8FAFC"
                                        Padding="10,8"
                                        StrokeShape="RoundRectangle 8">
                                    <Label x:Name="OrderWebAddressStatusText"
                                           FontSize="12"
                                           TextColor="#334155"
                                           LineBreakMode="WordWrap"/>
                                </Border>
                                <Border x:Name="OrderWebAddressStatsFrame"
                                        IsVisible="False"
                                        BackgroundColor="#F0F9FF"
                                        Stroke="#BAE6FD"
                                        StrokeThickness="1"
                                        Padding="10,8"
                                        StrokeShape="RoundRectangle 8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Usage"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#075985"/>
                                        <Label x:Name="OrderWebAddressUsageLabel"
                                               Text="Total Lookups: 0"
                                               FontSize="12"
                                               TextColor="#075985"/>
                                        <Label x:Name="OrderWebAddressLastUsedLabel"
                                               Text="Last Used: Never"
                                               FontSize="12"
                                               TextColor="#075985"/>
                                    </VerticalStackLayout>
                                </Border>
                            </StackLayout>
                        </VerticalStackLayout>
                    </Border>
                </StackLayout>

            </StackLayout>
        </ScrollView>

        <!-- Edit User Overlay -->
        <views:EditUserOverlay x:Name="EditUserOverlay" 
                               Grid.Row="0" 
                               Grid.RowSpan="4" 
                               IsVisible="False" />
        
        <!-- Role Selection Overlay - Must be last to appear on top -->
        <views:RoleSelectionOverlay x:Name="RoleSelectionOverlay" 
                                    Grid.Row="0" 
                                    Grid.RowSpan="4" 
                                    IsVisible="False" />
        
    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:POS_in_NET.Controls"
             xmlns:views="clr-namespace:POS_in_NET.Views"
             xmlns:converters="clr-namespace:POS_in_NET.Converters"
             xmlns:shared="clr-namespace:OrderWeb.SharedUI.Controls;assembly=OrderWeb.SharedUI"
             x:Class="POS_in_NET.Pages.UnifiedSettingsPage"
             Title="Settings"
             BackgroundColor="#F8F9FA">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:FirstLetterConverter x:Key="FirstLetterConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="0">
        
        <!-- Top Navigation Bar -->
        <views:TopBar x:Name="TopBar" Grid.Row="0"/>
        
        <shared:ChefLoaderView x:Name="LoadingIndicator"
                               Grid.Row="0"
                               Grid.RowSpan="4"
                               Mode="Fullscreen"
                               Size="Md"
                               Message="Cooking up your data…"
                               DelayMilliseconds="0"
                               IsLoading="False"
                               ZIndex="100" />
        
        <!-- Toast Notification -->
        <controls:ToastNotification x:Name="ToastNotification" 
                                    Grid.Row="1"
                                    IsVisible="False" />
        
        <!-- Elegant Professional Tab Bar -->
        <Border Grid.Row="2" 
                BackgroundColor="White"
                Padding="0"
                Stroke="#F1F5F9"
                StrokeThickness="1">
            <Border.Shadow>
                <Shadow Brush="#E2E8F0" Radius="8" Opacity="0.06" Offset="0,2"/>
            </Border.Shadow>
            
            <Grid ColumnDefinitions="*,*,*,*,*" Padding="2,2,2,2" ColumnSpacing="2">
                
                <!-- Business Info Tab -->
                <Border x:Name="BusinessTabBorder"
                        Grid.Column="0"
                        BackgroundColor="#3B82F6"
                        Padding="0"
                        HeightRequest="56">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#3B82F6" Radius="12" Opacity="0.20" Offset="0,3"/>
                    </Border.Shadow>
                    <Grid>
                        <!-- Active indicator -->
                        <Rectangle Fill="#1E40AF" 
                                   HeightRequest="3" 
                                   VerticalOptions="End"
                                   Margin="16,0,16,0"/>
                        <Button BackgroundColor="Transparent"
                                TextColor="White"
                                Text="Business Info"
                                FontSize="15"
                                FontAttributes="Bold"
                                Padding="24,0"
                                Clicked="OnBusinessTabClicked"/>
                    </Grid>
                </Border>
                
                <!-- User Management Tab -->
                <Border x:Name="UserTabBorder"
                        Grid.Column="1"
                        BackgroundColor="Transparent"
                        Padding="0"
                        HeightRequest="56">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Grid>
                        <!-- Hover effect background -->
                        <Rectangle Fill="#F8FAFC" 
                                   Opacity="0"/>
                        <Button BackgroundColor="Transparent"
                                TextColor="#475569"
                                Text="User Management"
                                FontSize="15"
                                FontAttributes="Bold"
                                Padding="24,0"
                                Clicked="OnUserTabClicked"/>
                    </Grid>
                </Border>
                
                <!-- OrderWeb Tab -->
                <Border x:Name="OrderWebTabBorder"
                        Grid.Column="2"
                        BackgroundColor="Transparent"
                        Padding="0"
                        HeightRequest="56">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Grid>
                        <!-- Hover effect background -->
                        <Rectangle Fill="#F8FAFC" 
                                   Opacity="0"/>
                        <Button BackgroundColor="Transparent"
                                TextColor="#475569"
                                Text="OrderWeb"
                                FontSize="15"
                                FontAttributes="Bold"
                                Padding="24,0"
                                Clicked="OnOrderWebTabClicked"/>
                    </Grid>
                </Border>

                <!-- Delivery Zone Tab -->
                <Border x:Name="DeliveryZoneTabBorder"
                        Grid.Column="3"
                        BackgroundColor="Transparent"
                        Padding="0"
                        HeightRequest="56">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Grid>
                        <Rectangle Fill="#F8FAFC" Opacity="0"/>
                        <Button BackgroundColor="Transparent"
                                TextColor="#475569"
                                Text="Delivery Zone"
                                FontSize="15"
                                FontAttributes="Bold"
                                Padding="24,0"
                                Clicked="OnDeliveryZoneTabClicked"/>
                    </Grid>
                </Border>

                <!-- Backup Tab -->
                <Border x:Name="BackupTabBorder"
                        Grid.Column="4"
                        BackgroundColor="Transparent"
                        Padding="0"
                        HeightRequest="56">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>
                    <Grid>
                        <Rectangle Fill="#F8FAFC" Opacity="0"/>
                        <Button BackgroundColor="Transparent"
                                TextColor="#475569"
                                Text="Backup"
                                FontSize="15"
                                FontAttributes="Bold"
                                Padding="24,0"
                                Clicked="OnBackupTabClicked"/>
                    </Grid>
                </Border>
                
            </Grid>
        </Border>
        
        <!-- Content Area -->
        <ScrollView Grid.Row="3" x:Name="MainScrollView" BackgroundColor="#F8F9FA">
            <StackLayout Padding="0">
                
                <!-- Business Info Content -->
                <StackLayout x:Name="BusinessInfoContent" IsVisible="True" Padding="32,32,32,0">
                    
                    <!-- Enhanced Header -->
                    <Border BackgroundColor="White" 
                            Padding="0,32,0,28"
                            Margin="0,0,0,28">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#E5E7EB" Radius="20" Opacity="0.08" Offset="0,6"/>
                        </Border.Shadow>
                        <StackLayout>
                            <!-- Modern icon with gradient -->
                            <Border BackgroundColor="#3B82F6"
                                    WidthRequest="64"
                                    HeightRequest="64"
                                    HorizontalOptions="Center"
                                    Margin="0,0,0,16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16"/>
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#3B82F6" Radius="16" Opacity="0.25" Offset="0,4"/>
                                </Border.Shadow>
                                <Label Text="BI" 
                                       FontSize="24" 
                                       FontAttributes="Bold" 
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            <Label Text="Business Information" 
                                   FontSize="28" 
                                   FontAttributes="Bold" 
                                   TextColor="#0F172A"
                                   HorizontalOptions="Center"
                                   Margin="0,0,0,8"/>
                            <Label Text="Manage your restaurant details and system configuration" 
                                   FontSize="15" 
                                   TextColor="#64748B"
                                   HorizontalOptions="Center"/>
                        </StackLayout>
                    </Border>
                    
                    <!-- Logo Upload Section -->
                    <Border BackgroundColor="White" 
                            Padding="28"
                            Margin="0,0,0,20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#E5E7EB" Radius="20" Opacity="0.08" Offset="0,6"/>
                        </Border.Shadow>
                        <StackLayout>
                            
                            <!-- Logo Section Header -->
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,24">
                                <Border BackgroundColor="#8B5CF6"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        Grid.Column="0"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8"/>
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="#8B5CF6" Radius="8" Opacity="0.3" Offset="0,2"/>
                                    </Border.Shadow>
                                    <Label Text="" 
                                           FontSize="16" 
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>
                                <StackLayout Grid.Column="1" 
                                             VerticalOptions="Center"
                                             Margin="16,0,0,0">
                                    <Label Text="Restaurant Logo" 
                                           FontSize="20" 
                                           FontAttributes="Bold" 
                                           TextColor="#0F172A"/>
                                    <Label Text="Upload your restaurant logo to personalize your brand" 
                                           FontSize="14" 
                                           TextColor="#64748B"/>
                                </StackLayout>
                                <Border Grid.Column="2"
                                        BackgroundColor="#F8FAFC"
                                        Stroke="#DBEAFE"
                                        StrokeThickness="1"
                                        Padding="12,10"
                                        VerticalOptions="Center"
                                        MinimumWidthRequest="260">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <StackLayout Spacing="6">
                                        <Label Text="Order Number Code"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#1E3A8A"/>
                                        <Grid ColumnDefinitions="90,*" ColumnSpacing="8" VerticalOptions="Center">
                                            <Label Text="First 3:" 
                                                   FontSize="12"
                                                   TextColor="#64748B"
                                                   VerticalOptions="Center"/>
                                            <Entry x:Name="OrderPrefixEntry"
                                                   Grid.Column="1"
                                                   Placeholder="KIT"
                                                   MaxLength="3"
                                                   FontSize="15"
                                                   FontAttributes="Bold"
                                                   BackgroundColor="#EFF6FF"
                                                   TextColor="#1E3A8A"
                                                   HorizontalTextAlignment="Center"
                                                   HeightRequest="36"/>
                                        </Grid>
                                        <Label x:Name="OrderExampleLabel"
                                               Text="Example: KITT0001"
                                               FontSize="12"
                                               TextColor="#475569"/>
                                        <Button Text="Save"
                                                BackgroundColor="#2563EB"
                                                TextColor="White"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                CornerRadius="8"
                                                HeightRequest="32"
                                                HorizontalOptions="End"
                                                WidthRequest="90"
                                                Clicked="OnSaveOrderCodeClicked"/>
                                    </StackLayout>
                                </Border>
                            </Grid>
                            
                            <!-- Logo Display Area -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="24">
                                
                                <!-- Current Logo Preview -->
                                <Border x:Name="LogoPreviewBorder"
                                        Grid.Column="0"
                                        WidthRequest="140"
                                        HeightRequest="140"
                                        BackgroundColor="#FAFBFC"
                                        Stroke="#E5E7EB"
                                        StrokeThickness="2"
                                        StrokeDashArray="8,4">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16"/>
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="#E5E7EB" Radius="8" Opacity="0.1" Offset="0,2"/>
                                    </Border.Shadow>
                                    
                                    <!-- Default Logo Placeholder -->
                                    <Grid x:Name="LogoPlaceholder">
                                        <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                                            <Border BackgroundColor="#F3F4F6"
                                                    WidthRequest="48"
                                                    HeightRequest="48">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12"/>
                                                </Border.StrokeShape>
                                                <Label Text="" 
                                                       FontSize="24" 
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"/>
                                            </Border>
                                            <Label Text="No Logo" 
                                                   FontSize="13" 
                                                   FontAttributes="Bold"
                                                   TextColor="#9CA3AF"
                                                   HorizontalOptions="Center"/>
                                            <Label Text="Click to upload" 
                                                   FontSize="11" 
                                                   TextColor="#D1D5DB"
                                                   HorizontalOptions="Center"/>
                                        </StackLayout>
                                    </Grid>
                                    
                                    <!-- Actual Logo Image (Initially Hidden) -->
                                    <Image x:Name="LogoImage"
                                           Aspect="AspectFit"
                                           IsVisible="False">
                                        <Image.Clip>
                                            <RoundRectangleGeometry Rect="0,0,140,140" CornerRadius="12"/>
                                        </Image.Clip>
                                    </Image>
                                </Border>
                                
                                <!-- Logo Upload Instructions -->
                                <StackLayout Grid.Column="1" 
                                             VerticalOptions="Center"
                                             Spacing="16">
                                    
                                    <!-- Upload Button -->
                                    <Button x:Name="UploadLogoButton"
                                            Text="Choose Logo File"
                                            BackgroundColor="Transparent"
                                            TextColor="#3B82F6"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            BorderColor="#3B82F6"
                                            BorderWidth="2"
                                            CornerRadius="12"
                                            HeightRequest="48"
                                            Clicked="OnUploadLogoClicked"
                                            HorizontalOptions="Start"
                                            Padding="20,12">
                                        <Button.Shadow>
                                            <Shadow Brush="#3B82F6" Radius="8" Opacity="0.15" Offset="0,2"/>
                                        </Button.Shadow>
                                    </Button>
                                    
                                    <!-- Upload Guidelines -->
                                    <Border BackgroundColor="#F8F9FA"
                                            Stroke="#E5E7EB"
                                            StrokeThickness="1"
                                            Padding="16">
                                        <StackLayout Spacing="8">
                                            <Label Text="Upload Guidelines" 
                                                   FontSize="14" 
                                                   FontAttributes="Bold"
                                                   TextColor="#374151"/>
                                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="8">
                                                <Label Text="" FontSize="12" TextColor="#10B981" Grid.Row="0" Grid.Column="0" VerticalOptions="Center"/>
                                                <Label Text="Recommended size: 200x200 pixels or higher" FontSize="12" TextColor="#6B7280" Grid.Row="0" Grid.Column="1"/>
                                                
                                                <Label Text="" FontSize="12" TextColor="#10B981" Grid.Row="1" Grid.Column="0" VerticalOptions="Center"/>
                                                <Label Text="Supported formats: JPG, PNG, SVG" FontSize="12" TextColor="#6B7280" Grid.Row="1" Grid.Column="1"/>
                                                
                                                <Label Text="" FontSize="12" TextColor="#10B981" Grid.Row="2" Grid.Column="0" VerticalOptions="Center"/>
                                                <Label Text="Maximum file size: 5MB" FontSize="12" TextColor="#6B7280" Grid.Row="2" Grid.Column="1"/>
                                                
                                                <Label Text="" FontSize="12" TextColor="#10B981" Grid.Row="3" Grid.Column="0" VerticalOptions="Center"/>
                                                <Label Text="Square or circular logos work best" FontSize="12" TextColor="#6B7280" Grid.Row="3" Grid.Column="1"/>
                                            </Grid>
                                        </StackLayout>
                                    </Border>
                                    
                                    <!-- Logo Status and Actions -->
                                    <StackLayout Orientation="Horizontal" 
                                                 Spacing="12" 
                                                 Margin="0,0,0,0">
                                        <Button x:Name="RemoveLogoButton"
                                                Text="Remove"
                                                BackgroundColor="Transparent"
                                                TextColor="#EF4444"
                                                FontSize="14"
                                                BorderColor="#EF4444"
                                                BorderWidth="1"
                                                CornerRadius="8"
                                                Padding="12,8"
                                                Clicked="OnRemoveLogoClicked"
                                                IsVisible="False"/>
                                        <Border BackgroundColor="#F0FDF4" 
                                                Stroke="#BBF7D0" 
                                                StrokeThickness="1"
                                                Padding="12,8"
                                                VerticalOptions="Center">
                                            <Label x:Name="LogoStatusLabel"
                                                   Text="Ready to upload"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="#16A34A"/>
                                        </Border>
                                    </StackLayout>
                                </StackLayout>
                            </Grid>
                        </StackLayout>
                    </Border>

                    <!-- Order Services (Administrator only) -->
                    <Border x:Name="OrderServicesCard"
                            IsVisible="False"
                            BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="28"
                            Margin="0,0,0,20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#CBD5E1" Radius="18" Opacity="0.10" Offset="0,5"/>
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="18">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                <Border WidthRequest="44" HeightRequest="44" BackgroundColor="#EFF6FF" Stroke="#BFDBFE">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                                    <Label Text="ON" FontSize="12" FontAttributes="Bold" TextColor="#1D4ED8" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Grid.Column="1" Text="Order Services" FontSize="21" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center"/>
                            </Grid>

                            <BoxView HeightRequest="1" BackgroundColor="#E2E8F0"/>

                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                <Border BackgroundColor="#F8FAFC" Stroke="#CBD5E1" Padding="16" StrokeShape="RoundRectangle 14">
                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="5">
                                        <Label Text="Table Service" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center"/>
                                        <Switch x:Name="TableServiceSwitch" Grid.Column="1" Toggled="OnOrderServiceSwitchToggled" OnColor="#059669"/>
                                        <Label x:Name="TableServiceStateLabel" Grid.Row="1" Grid.ColumnSpan="2" Text="Enabled" FontSize="12" TextColor="#047857"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1" BackgroundColor="#F8FAFC" Stroke="#CBD5E1" Padding="16" StrokeShape="RoundRectangle 14">
                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="5">
                                        <Label Text="Collection" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center"/>
                                        <Switch x:Name="CollectionServiceSwitch" Grid.Column="1" Toggled="OnOrderServiceSwitchToggled" OnColor="#059669"/>
                                        <Label x:Name="CollectionServiceStateLabel" Grid.Row="1" Grid.ColumnSpan="2" Text="Enabled" FontSize="12" TextColor="#047857"/>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" BackgroundColor="#F8FAFC" Stroke="#CBD5E1" Padding="16" StrokeShape="RoundRectangle 14">
                                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="5">
                                        <Label Text="Delivery" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center"/>
                                        <Switch x:Name="DeliveryServiceSwitch" Grid.Column="1" Toggled="OnOrderServiceSwitchToggled" OnColor="#059669"/>
                                        <Label x:Name="DeliveryServiceStateLabel" Grid.Row="1" Grid.ColumnSpan="2" Text="Enabled" FontSize="12" TextColor="#047857"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Button x:Name="SaveOrderServicesButton"
                                    Text="SAVE SERVICES"
                                    BackgroundColor="#2563EB"
                                    TextColor="White"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    HeightRequest="52"
                                    HorizontalOptions="End"
                                    MinimumWidthRequest="180"
                                    Clicked="OnSaveOrderServicesClicked"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Table Service Charge (Administrator only) -->
                    <Border x:Name="TableServiceChargeCard"
                            IsVisible="False"
                            BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="28"
                            Margin="0,0,0,20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#CBD5E1" Radius="18" Opacity="0.10" Offset="0,5"/>
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="18">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                <Border Grid.Column="0"
                                        WidthRequest="44"
                                        HeightRequest="44"
                                        BackgroundColor="#ECFDF5"
                                        Stroke="#A7F3D0"
                                        StrokeThickness="1"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <Label Text="%"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="#047857"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>
                                <Label Grid.Column="1"
                                       Text="Table Service Charge"
                                       FontSize="21"
                                       FontAttributes="Bold"
                                       TextColor="#0F172A"
                                       VerticalOptions="Center"/>
                            </Grid>

                            <BoxView HeightRequest="1" BackgroundColor="#E2E8F0"/>

                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <Button x:Name="NoServiceChargeButton"
                                            Grid.Column="0"
                                            Text="NO SERVICE CHARGE"
                                            HeightRequest="54"
                                            CornerRadius="12"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            Clicked="OnNoServiceChargeClicked"/>
                                    <Button x:Name="PercentageServiceChargeButton"
                                            Grid.Column="1"
                                            Text="SERVICE CHARGE"
                                            HeightRequest="54"
                                            CornerRadius="12"
                                            FontSize="14"
                                            FontAttributes="Bold"
                                            Clicked="OnPercentageServiceChargeClicked"/>
                                </Grid>
                            </VerticalStackLayout>

                            <VerticalStackLayout x:Name="ServiceChargePercentagePanel"
                                                 IsVisible="False"
                                                 Spacing="16">
                                <Grid ColumnDefinitions="*">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="Service charge %"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="#334155"/>
                                        <Border BackgroundColor="#F8FAFC"
                                                Stroke="#CBD5E1"
                                                StrokeThickness="1"
                                                HeightRequest="54">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12"/>
                                            </Border.StrokeShape>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Entry x:Name="ServiceChargePercentageEntry"
                                                       Grid.Column="0"
                                                       Placeholder="Enter percentage"
                                                       Keyboard="Numeric"
                                                       MaxLength="5"
                                                       FontSize="18"
                                                       TextColor="#0F172A"
                                                       BackgroundColor="Transparent"
                                                       Margin="10,0,0,0"
                                                       TextChanged="OnServiceChargePercentageTextChanged"/>
                                                <Label Grid.Column="1"
                                                       Text="%"
                                                       FontSize="18"
                                                       FontAttributes="Bold"
                                                       TextColor="#475569"
                                                       Margin="10,0,16,0"
                                                       VerticalOptions="Center"/>
                                            </Grid>
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>

                            </VerticalStackLayout>

                            <Button x:Name="SaveServiceChargeButton"
                                    Text="SAVE"
                                    BackgroundColor="#059669"
                                    TextColor="White"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    HeightRequest="52"
                                    HorizontalOptions="End"
                                    MinimumWidthRequest="160"
                                    Padding="20,10"
                                    Clicked="OnSaveServiceChargeClicked"/>
                        </VerticalStackLayout>
                    </Border>
                    
                    <!-- Main Business Info Card -->
                    <Border BackgroundColor="White" 
                            Padding="28">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#E5E7EB" Radius="20" Opacity="0.08" Offset="0,6"/>
                        </Border.Shadow>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="24" RowSpacing="20">
                            
                            <!-- Column 1 -->
                            <Label Text="Restaurant Name" FontSize="16" FontAttributes="Bold" TextColor="#374151" Grid.Row="0" Grid.Column="0"/>
                            <Entry x:Name="RestaurantNameEntry" FontSize="16" BackgroundColor="#F9FAFB" TextColor="#1F2937" Grid.Row="1" Grid.Column="0"/>
                            
                            <Label Text="Phone Number" FontSize="16" FontAttributes="Bold" TextColor="#374151" Grid.Row="2" Grid.Column="0"/>
                            <Entry x:Name="PhoneEntry" FontSize="16" BackgroundColor="#F9FAFB" TextColor="#1F2937" Grid.Row="3" Grid.Column="0"/>
                            
                            <Label Text="Address" FontSize="16" FontAttributes="Bold" TextColor="#374151" Grid.Row="4" Grid.Column="0"/>
                            <Entry x:Name="AddressEntry" FontSize="16" BackgroundColor="#F9FAFB" TextColor="#1F2937" Grid.Row="5" Grid.Column="0"/>
                            
                            <Label Text="Postcode" FontSize="16" FontAttributes="Bold" TextColor="#374151" Grid.Row="6" Grid.Column="0"/>
                            <Entry x:Name="PostcodeEntry" FontSize="16" BackgroundColor="#F9FAFB" TextColor="#1F2937" Grid.Row="7" Grid.Column="0"/>
                            
                            <Label Text="VAT Number" FontSize="16" FontAttributes="Bold" TextColor="#374151" Grid.Row="8" Grid.Column="0"/>
                            <Entry x:Name="VATNumberEntry" FontSize="16" BackgroundColor="#F9FAFB" TextColor="#1F2937" Grid.Row="9" Grid.Column="0"/>
                            
                            <!-- Column 2 -->
                            <Label Text="Email" FontSize="16" FontAttributes="Bold" TextColor="#374151" Grid.Row="0" Grid.Column="1"/>
                            <Entry x:Name="EmailEntry" FontSize="16" BackgroundColor="#F9FAFB" TextColor="#1F2937" Grid.Row="1" Grid.Column="1"/>
                            
                            <Label Text="Website" FontSize="16" FontAttributes="Bold" TextColor="#374151" Grid.Row="2" Grid.Column="1"/>
                            <Entry x:Name="WebsiteEntry" FontSize="16" BackgroundColor="#F9FAFB" TextColor="#1F2937" Grid.Row="3" Grid.Column="1"/>
                            
                            <Label Text="City" FontSize="16" FontAttributes="Bold" TextColor="#374151" Grid.Row="4" Grid.Column="1"/>
                            <Entry x:Name="CityEntry" FontSize="16" BackgroundColor="#F9FAFB" TextColor="#1F2937" Grid.Row="5" Grid.Column="1"/>
                            
                            <Label Text="County" FontSize="16" FontAttributes="Bold" TextColor="#374151" Grid.Row="6" Grid.Column="1"/>
                            <Entry x:Name="CountyEntry" FontSize="16" BackgroundColor="#F9FAFB" TextColor="#1F2937" Grid.Row="7" Grid.Column="1"/>
                            
                            <Label Text="Country" FontSize="16" FontAttributes="Bold" TextColor="#374151" Grid.Row="8" Grid.Column="1"/>
                            <Entry x:Name="CountryEntry" FontSize="16" BackgroundColor="#F9FAFB" TextColor="#1F2937" Grid.Row="9" Grid.Column="1"/>
                            
                            <!-- Save Button -->
                            <Button Text="Save Business Info" 
                                    BackgroundColor="#10B981" 
                                    TextColor="White" 
                                    FontAttributes="Bold"
                                    FontSize="16"
                                    CornerRadius="12"
                                    HeightRequest="48"
                                    Padding="20,12"
                                    Clicked="OnSaveBusinessInfoClicked"
                                    Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2"
                                    Margin="0,20,0,0"/>
                        </Grid>
                    </Border>
                    
                </StackLayout>
                
                <!-- User Management Content -->
                <StackLayout x:Name="UserInfoContent" IsVisible="False" Padding="32,32,32,0">
                    
                    <!-- Enhanced Header -->
                    <Border BackgroundColor="White" 
                            Padding="0,32,0,28"
                            Margin="0,0,0,28">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#E5E7EB" Radius="20" Opacity="0.08" Offset="0,6"/>
                        </Border.Shadow>
                        <StackLayout>
                            <!-- Modern icon for User Management -->
                            <Border BackgroundColor="#8B5CF6"
                                    WidthRequest="64"
                                    HeightRequest="64"
                                    HorizontalOptions="Center"
                                    Margin="0,0,0,16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16"/>
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#8B5CF6" Radius="16" Opacity="0.25" Offset="0,4"/>
                                </Border.Shadow>
                                <Label Text="UM" 
                                       FontSize="24" 
                                       FontAttributes="Bold" 
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            <Label Text="User Management" 
                                   FontSize="28" 
                                   FontAttributes="Bold" 
                                   TextColor="#0F172A"
                                   HorizontalOptions="Center"
                                   Margin="0,0,0,8"/>
                            <Label Text="Manage user accounts, roles and permissions" 
                                   FontSize="15" 
                                   TextColor="#64748B"
                                   HorizontalOptions="Center"/>
                        </StackLayout>
                    </Border>
                    
                    <!-- Elegant Add New User Section -->
                    <Border BackgroundColor="White" 
                            Margin="0,0,0,24"
                            Stroke="#E1E7EF"
                            StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Radius="32" Opacity="0.04" Offset="0,8"/>
                        </Border.Shadow>
                        
                        <StackLayout Padding="32">
                            <!-- Section Header -->
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,28">
                                <Border BackgroundColor="#8B5CF6" 
                                        WidthRequest="48" 
                                        HeightRequest="48"
                                        Grid.Column="0"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14"/>
                                    </Border.StrokeShape>
                                    <Label Text="+" 
                                           FontSize="24" 
                                           FontAttributes="Bold" 
                                           TextColor="White"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>
                                
                                <StackLayout Grid.Column="1" Margin="16,0,0,0" VerticalOptions="Center">
                                    <Label Text="Add New Team Member" 
                                           FontSize="22" 
                                           FontAttributes="Bold" 
                                           TextColor="#0F172A"
                                           Margin="0,0,0,4"/>
                                    <Label Text="Create new user account with role and permissions" 
                                           FontSize="15" 
                                           TextColor="#64748B"/>
                                </StackLayout>
                            </Grid>
                            
                            <!-- Elegant Form Layout -->
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="24">
                                
                                <!-- Row 1: Name and PIN -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="20" Grid.Row="0">
                                    <!-- Name Field -->
                                    <StackLayout Grid.Column="0">
                                        <Label Text="Full Name" 
                                               FontSize="15" 
                                               FontAttributes="Bold"
                                               TextColor="#374151" 
                                               Margin="0,0,0,8"/>
                                        <Border BackgroundColor="#FAFBFC" 
                                                Stroke="#D1D5DB" 
                                                StrokeThickness="1.5"
                                                Padding="16,14">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12"/>
                                            </Border.StrokeShape>
                                            <Entry x:Name="NameEntry" 
                                                   Placeholder="Enter full name" 
                                                   FontSize="16" 
                                                   TextColor="#1F2937"
                                                   BackgroundColor="Transparent"
                                                   PlaceholderColor="#9CA3AF"/>
                                        </Border>
                                    </StackLayout>
                                    
                                    <!-- PIN Field -->
                                    <StackLayout Grid.Column="1">
                                        <Label Text="Security PIN" 
                                               FontSize="15" 
                                               FontAttributes="Bold"
                                               TextColor="#374151" 
                                               Margin="0,0,0,8"/>
                                        <Border BackgroundColor="#FAFBFC" 
                                                Stroke="#D1D5DB" 
                                                StrokeThickness="1.5"
                                                Padding="16,14">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12"/>
                                            </Border.StrokeShape>
                                            <Entry x:Name="PINEntry" 
                                                   Placeholder="Enter 4-digit PIN" 
                                                   FontSize="16" 
                                                   TextColor="#1F2937"
                                                   BackgroundColor="Transparent"
                                                   PlaceholderColor="#9CA3AF"
                                                   IsPassword="True" 
                                                   Keyboard="Numeric" 
                                                   MaxLength="4"/>
                                        </Border>
                                    </StackLayout>
                                </Grid>
                                
                                <!-- Row 2: Role Selection -->
                                <StackLayout Grid.Row="1">
                                    <Label Text="User Role and Permissions" 
                                           FontSize="15" 
                                           FontAttributes="Bold"
                                           TextColor="#374151" 
                                           Margin="0,0,0,8"/>
                                    <Border BackgroundColor="#FAFBFC" 
                                            Stroke="#D1D5DB" 
                                            StrokeThickness="1.5"
                                            Padding="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12"/>
                                        </Border.StrokeShape>
                                        <Border BackgroundColor="Transparent"
                                                Padding="16,14">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnSelectRoleClicked" />
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackLayout Grid.Column="0" 
                                                             HorizontalOptions="StartAndExpand"
                                                             VerticalOptions="Center">
                                                    <Label x:Name="SelectedRoleLabel" 
                                                           Text="Choose user role" 
                                                           FontSize="16" 
                                                           TextColor="#6B7280"
                                                           HorizontalOptions="Start"/>
                                                </StackLayout>
                                                <Label Text="⌄" 
                                                       FontSize="18" 
                                                       TextColor="#9CA3AF"
                                                       Grid.Column="1"
                                                       VerticalOptions="Center"/>
                                            </Grid>
                                        </Border>
                                    </Border>
                                </StackLayout>
                                
                                <!-- Row 3: Action Button -->
                                <Grid Grid.Row="2" Margin="0,8,0,0">
                                    <Button Text="+ Add User" 
                                            BackgroundColor="#8B5CF6" 
                                            TextColor="White" 
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            Padding="0,16"
                                            CornerRadius="12"
                                            Clicked="OnAddUserClicked"
                                            HorizontalOptions="End"
                                            WidthRequest="140">
                                        <Button.Shadow>
                                            <Shadow Brush="#8B5CF6" Radius="16" Opacity="0.3" Offset="0,4"/>
                                        </Button.Shadow>
                                    </Button>
                                </Grid>
                                
                            </Grid>
                        </StackLayout>
                    </Border>
                    
                    <!-- Elegant Current Users Section -->
                    <Border BackgroundColor="White" 
                            Stroke="#E1E7EF"
                            StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Radius="32" Opacity="0.04" Offset="0,8"/>
                        </Border.Shadow>
                        
                        <StackLayout Padding="32">
                            <!-- Section Header -->
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,28">
                                <Border BackgroundColor="#3B82F6" 
                                        WidthRequest="48" 
                                        HeightRequest="48"
                                        Grid.Column="0"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14"/>
                                    </Border.StrokeShape>
                                    <Label Text="TM" 
                                           FontSize="20" 
                                           TextColor="White"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>
                                
                                <StackLayout Grid.Column="1" Margin="16,0,0,0" VerticalOptions="Center">
                                    <Label Text="Team Members" 
                                           FontSize="22" 
                                           FontAttributes="Bold" 
                                           TextColor="#0F172A"
                                           Margin="0,0,0,4"/>
                                    <Label Text="Manage existing user accounts and permissions" 
                                           FontSize="15" 
                                           TextColor="#64748B"/>
                                </StackLayout>
                                
                                <!-- User Count Badge -->
                                <Border BackgroundColor="#F0F9FF" 
                                        Stroke="#3B82F6" 
                                        StrokeThickness="1"
                                        Padding="12,6"
                                        Grid.Column="2"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20"/>
                                    </Border.StrokeShape>
                                    <Label x:Name="UserCountLabel"
                                           Text="0 Users" 
                                           FontSize="14" 
                                           FontAttributes="Bold"
                                           TextColor="#1E40AF"/>
                                </Border>
                            </Grid>
                            
                            <!-- Users List with Enhanced Cards -->
                            <CollectionView x:Name="UsersCollectionView" 
                                            ItemsSource="{Binding Users}"
                                            ItemSizingStrategy="MeasureAllItems">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="16"/>
                                </CollectionView.ItemsLayout>
                                
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BackgroundColor="#FAFBFC" 
                                                Stroke="#E5E7EB" 
                                                StrokeThickness="1"
                                                Padding="20">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="16"/>
                                            </Border.StrokeShape>
                                            
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="16">
                                                
                                                <!-- Enhanced User Avatar -->
                                                <Border Grid.Column="0" 
                                                        WidthRequest="56" 
                                                        HeightRequest="56"
                                                        VerticalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <Ellipse/>
                                                    </Border.StrokeShape>
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#8B5CF6" Offset="0"/>
                                                            <GradientStop Color="#3B82F6" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Border.Shadow>
                                                        <Shadow Brush="#8B5CF6" Radius="12" Opacity="0.2" Offset="0,2"/>
                                                    </Border.Shadow>
                                                    
                                                    <Label Text="{Binding Name, Converter={StaticResource FirstLetterConverter}}" 
                                                           TextColor="White" 
                                                           FontSize="20" 
                                                           FontAttributes="Bold"
                                                           HorizontalOptions="Center" 
                                                           VerticalOptions="Center"/>
                                                </Border>
                                                
                                                <!-- User Information -->
                                                <StackLayout Grid.Column="1" 
                                                             VerticalOptions="Center"
                                                             Spacing="4">
                                                    <Label Text="{Binding Name}" 
                                                           FontSize="18" 
                                                           FontAttributes="Bold" 
                                                           TextColor="#0F172A"/>
                                                    
                                                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
                                                        <!-- Role Badge -->
                                                        <Border BackgroundColor="#EEF2FF" 
                                                                Stroke="#A5B4FC" 
                                                                StrokeThickness="1"
                                                                Padding="8,4"
                                                                Grid.Column="0">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="8"/>
                                                            </Border.StrokeShape>
                                                            <Label Text="{Binding Role}" 
                                                                   FontSize="13" 
                                                                   FontAttributes="Bold"
                                                                   TextColor="#4F46E5"/>
                                                        </Border>
                                                        
                                                        <!-- Status Indicator -->
                                                        <Border BackgroundColor="{Binding StatusBackgroundColor}" 
                                                                Stroke="{Binding StatusBorderColor}" 
                                                                StrokeThickness="1"
                                                                Padding="8,4"
                                                                Grid.Column="1">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="8"/>
                                                            </Border.StrokeShape>
                                                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                                                                <Ellipse Fill="{Binding StatusDotColor}" 
                                                                         WidthRequest="8" 
                                                                         HeightRequest="8"
                                                                         Grid.Column="0"
                                                                         VerticalOptions="Center"/>
                                                                <Label Text="{Binding StatusText}" 
                                                                       FontSize="13" 
                                                                       FontAttributes="Bold"
                                                                       TextColor="{Binding StatusTextColor}"
                                                                       Grid.Column="1"/>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </StackLayout>
                                                
                                                <!-- Action Buttons -->
                                                <StackLayout Orientation="Horizontal" 
                                                             Grid.Column="2"
                                                             Spacing="8"
                                                             VerticalOptions="Center">
                                                    
                                                    <!-- Edit Button -->
                                                    <Button Text="Edit" 
                                                            BackgroundColor="#3B82F6" 
                                                            TextColor="White"
                                                            FontSize="14"
                                                            FontAttributes="Bold"
                                                            Padding="16,10"
                                                            CornerRadius="10"
                                                            WidthRequest="80"
                                                            Clicked="OnEditUserClicked"
                                                            CommandParameter="{Binding}">
                                                        <Button.Shadow>
                                                            <Shadow Brush="#3B82F6" Radius="8" Opacity="0.2" Offset="0,2"/>
                                                        </Button.Shadow>
                                                    </Button>
                                                    
                                                    <!-- Deactivate Button -->
                                                    <Button Text="{Binding DeactivateButtonText}" 
                                                            BackgroundColor="{Binding DeactivateButtonBackgroundColor}" 
                                                            TextColor="{Binding DeactivateButtonTextColor}"
                                                            FontSize="14"
                                                            FontAttributes="Bold"
                                                            Padding="16,10"
                                                            CornerRadius="10"
                                                            WidthRequest="112"
                                                            IsEnabled="{Binding CanDeactivate}"
                                                            Clicked="OnDeleteUserClicked"
                                                            CommandParameter="{Binding}">
                                                        <Button.Shadow>
                                                            <Shadow Brush="#EF4444" Radius="8" Opacity="0.2" Offset="0,2"/>
                                                        </Button.Shadow>
                                                    </Button>

                                                    <!-- Archive/remove employee while preserving historical records -->
                                                    <Button Text="Remove"
                                                            BackgroundColor="#FEE2E2"
                                                            TextColor="#B91C1C"
                                                            FontSize="12"
                                                            FontAttributes="Bold"
                                                            Padding="0"
                                                            CornerRadius="10"
                                                            WidthRequest="72"
                                                            HeightRequest="44"
                                                            Clicked="OnPermanentDeleteUserClicked"
                                                            CommandParameter="{Binding}">
                                                        <Button.Shadow>
                                                            <Shadow Brush="#EF4444" Radius="8" Opacity="0.16" Offset="0,2"/>
                                                        </Button.Shadow>
                                                    </Button>
                                                    
                                                </StackLayout>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                                
                                <!-- Empty State -->
                                <CollectionView.EmptyView>
                                    <StackLayout HorizontalOptions="Center" 
                                                 VerticalOptions="Center"
                                                 Padding="40">
                                        <Border BackgroundColor="#F3F4F6" 
                                                WidthRequest="80" 
                                                HeightRequest="80"
                                                HorizontalOptions="Center"
                                                Margin="0,0,0,16">
                                            <Border.StrokeShape>
                                                <Ellipse/>
                                            </Border.StrokeShape>
                                            <Label Text="TM" 
                                                   FontSize="32" 
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                        </Border>
                                        <Label Text="No team members yet" 
                                               FontSize="18" 
                                               FontAttributes="Bold" 
                                               TextColor="#6B7280"
                                               HorizontalOptions="Center"
                                               Margin="0,0,0,8"/>
                                        <Label Text="Add your first team member to get started" 
                                               FontSize="15" 
                                               TextColor="#9CA3AF"
                                               HorizontalOptions="Center"/>
                                    </StackLayout>
                                </CollectionView.EmptyView>
                            </CollectionView>
                        </StackLayout>
                    </Border>
                    
                </StackLayout>
                
                <!-- Delivery Zone Content -->
                <StackLayout x:Name="DeliveryZoneContent" IsVisible="False" Padding="32,32,32,0">
                    <Border BackgroundColor="White" Padding="0,32,0,28" Margin="0,0,0,28">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#E5E7EB" Radius="20" Opacity="0.08" Offset="0,6"/>
                        </Border.Shadow>
                        <StackLayout>
                            <Border BackgroundColor="#F59E0B"
                                    WidthRequest="64"
                                    HeightRequest="64"
                                    HorizontalOptions="Center"
                                    Margin="0,0,0,16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16"/>
                                </Border.StrokeShape>
                                <Label Text="DZ"
                                       FontSize="24"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            <Label Text="Delivery Zone"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A"
                                   HorizontalOptions="Center"
                                   Margin="0,0,0,8"/>
                            <Label Text="Set postcode delivery prices and review new delivery requests"
                                   FontSize="15"
                                   TextColor="#64748B"
                                   HorizontalOptions="Center"/>
                        </StackLayout>
                    </Border>

                    <Grid ColumnDefinitions="360,*" ColumnSpacing="20">
                        <StackLayout Grid.Column="0" Spacing="20">
                            <Border BackgroundColor="White" Padding="24">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16"/>
                                </Border.StrokeShape>
                                <StackLayout Spacing="16">
                                    <Label Text="Create Zone" FontSize="20" FontAttributes="Bold" TextColor="#0F172A"/>
                                    <Label Text="Zone Name" FontSize="13" FontAttributes="Bold" TextColor="#334155"/>
                                    <Border Stroke="#D1D5DB" StrokeThickness="1" BackgroundColor="White">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8"/>
                                        </Border.StrokeShape>
                                        <Entry x:Name="DeliveryZoneNameEntry"
                                               Placeholder="Local, Zone 1, Far Area"
                                               FontSize="14"
                                               TextColor="#111827"
                                               PlaceholderColor="#9CA3AF"
                                               Margin="12,8"/>
                                    </Border>
                                    <Label Text="Delivery Fee" FontSize="13" FontAttributes="Bold" TextColor="#334155"/>
                                    <Border Stroke="#D1D5DB" StrokeThickness="1" BackgroundColor="White">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8"/>
                                        </Border.StrokeShape>
                                        <Entry x:Name="DeliveryZoneFeeEntry"
                                               Placeholder="0.00"
                                               Keyboard="Numeric"
                                               FontSize="14"
                                               TextColor="#111827"
                                               PlaceholderColor="#9CA3AF"
                                               Margin="12,8"/>
                                    </Border>
                                    <Button Text="Create Zone"
                                            BackgroundColor="#2563EB"
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            HeightRequest="44"
                                            CornerRadius="8"
                                            Clicked="OnCreateDeliveryZoneClicked"/>
                                </StackLayout>
                            </Border>

                            <Border BackgroundColor="White" Padding="24">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16"/>
                                </Border.StrokeShape>
                                <StackLayout Spacing="12">
                                    <Label Text="Test Postcode" FontSize="20" FontAttributes="Bold" TextColor="#0F172A"/>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Border Grid.Column="0" Stroke="#D1D5DB" StrokeThickness="1" BackgroundColor="White">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8"/>
                                            </Border.StrokeShape>
                                            <Entry x:Name="DeliveryZoneTestPostcodeEntry"
                                                   Placeholder="SE4 2PJ"
                                                   FontSize="14"
                                                   TextColor="#111827"
                                                   PlaceholderColor="#9CA3AF"
                                                   Margin="12,8"/>
                                        </Border>
                                        <Button Grid.Column="1"
                                                Text="Check"
                                                BackgroundColor="#0F766E"
                                                TextColor="White"
                                                FontAttributes="Bold"
                                                CornerRadius="8"
                                                Clicked="OnTestDeliveryZonePostcodeClicked"/>
                                    </Grid>
                                    <Label x:Name="DeliveryZoneTestResultLabel"
                                           Text=""
                                           FontSize="13"
                                           TextColor="#64748B"
                                           LineBreakMode="WordWrap"/>
                                </StackLayout>
                            </Border>
                        </StackLayout>

                        <StackLayout Grid.Column="1" Spacing="20">
                            <Border BackgroundColor="White" Padding="24">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16"/>
                                </Border.StrokeShape>
                                <StackLayout Spacing="16">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Zones" FontSize="20" FontAttributes="Bold" TextColor="#0F172A"/>
                                        <Label x:Name="DeliveryZoneCountLabel" Grid.Column="1" Text="0 zones" FontSize="14" TextColor="#64748B" VerticalOptions="Center"/>
                                    </Grid>
                                    <CollectionView x:Name="DeliveryZonesCollectionView" ItemSizingStrategy="MeasureAllItems">
                                        <CollectionView.ItemsLayout>
                                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="12"/>
                                        </CollectionView.ItemsLayout>
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" Padding="18">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="12"/>
                                                    </Border.StrokeShape>
                                                    <StackLayout Spacing="12">
                                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                                            <StackLayout Grid.Column="0" Spacing="4">
                                                                <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" TextColor="#0F172A"/>
                                                                <Label Text="{Binding PostcodeSummary}" FontSize="13" TextColor="#64748B" LineBreakMode="WordWrap"/>
                                                            </StackLayout>
                                                            <Label Grid.Column="1" Text="{Binding DeliveryFeeDisplay}" FontSize="18" FontAttributes="Bold" TextColor="#0F766E" VerticalOptions="Center"/>
                                                            <Button Grid.Column="2"
                                                                    Text="Delete"
                                                                    BackgroundColor="#EF4444"
                                                                    TextColor="White"
                                                                    CornerRadius="8"
                                                                    CommandParameter="{Binding}"
                                                                    Clicked="OnDeleteDeliveryZoneClicked"/>
                                                        </Grid>
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                            <Border Grid.Column="0" Stroke="#CBD5E1" StrokeThickness="1" BackgroundColor="White">
                                                                <Border.StrokeShape>
                                                                    <RoundRectangle CornerRadius="8"/>
                                                                </Border.StrokeShape>
                                                                <Entry Placeholder="Add full postcode, e.g. SE4 2PJ"
                                                                       FontSize="14"
                                                                       TextColor="#111827"
                                                                       PlaceholderColor="#94A3B8"
                                                                       Margin="12,8"/>
                                                            </Border>
                                                            <Button Grid.Column="1"
                                                                    Text="Add"
                                                                    BackgroundColor="#2563EB"
                                                                    TextColor="White"
                                                                    CornerRadius="8"
                                                                    CommandParameter="{Binding}"
                                                                    Clicked="OnAddPostcodeToZoneClicked"/>
                                                        </Grid>
                                                        <FlexLayout BindableLayout.ItemsSource="{Binding Postcodes}"
                                                                    Wrap="Wrap"
                                                                    Direction="Row"
                                                                    AlignItems="Start">
                                                            <BindableLayout.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border BackgroundColor="White" Stroke="#CBD5E1" StrokeThickness="1" Padding="10,6" Margin="0,0,8,8">
                                                                        <Border.StrokeShape>
                                                                            <RoundRectangle CornerRadius="8"/>
                                                                        </Border.StrokeShape>
                                                                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="6">
                                                                            <Label Text="{Binding Postcode}" FontSize="13" TextColor="#0F172A" VerticalOptions="Center"/>
                                                                            <Button Grid.Column="1"
                                                                                    Text="x"
                                                                                    FontSize="12"
                                                                                    BackgroundColor="Transparent"
                                                                                    TextColor="#EF4444"
                                                                                    Padding="0"
                                                                                    WidthRequest="24"
                                                                                    HeightRequest="24"
                                                                                    CommandParameter="{Binding}"
                                                                                    Clicked="OnRemoveDeliveryPostcodeClicked"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </BindableLayout.ItemTemplate>
                                                        </FlexLayout>
                                                    </StackLayout>
                                                </Border>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </StackLayout>
                            </Border>

                            <Border BackgroundColor="White" Padding="24" Margin="0,0,0,24">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16"/>
                                </Border.StrokeShape>
                                <StackLayout Spacing="14">
                                    <Label Text="Unassigned Postcodes" FontSize="20" FontAttributes="Bold" TextColor="#0F172A"/>
                                    <Label Text="Postcodes that customers tried but no zone matched yet" FontSize="13" TextColor="#64748B"/>
                                    <CollectionView x:Name="UnassignedPostcodesCollectionView" ItemSizingStrategy="MeasureAllItems">
                                        <CollectionView.ItemsLayout>
                                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
                                        </CollectionView.ItemsLayout>
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Border BackgroundColor="#FFFBEB" Stroke="#FDE68A" StrokeThickness="1" Padding="14">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="10"/>
                                                    </Border.StrokeShape>
                                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                                        <StackLayout Grid.Column="0" Spacing="2">
                                                            <Label Text="{Binding Postcode}" FontSize="16" FontAttributes="Bold" TextColor="#92400E"/>
                                                            <Label Text="{Binding RequestCount, StringFormat='{0} request(s)'}" FontSize="12" TextColor="#B45309"/>
                                                        </StackLayout>
                                                        <Button Grid.Column="1"
                                                                Text="Copy"
                                                                BackgroundColor="#F59E0B"
                                                                TextColor="White"
                                                                CornerRadius="8"
                                                                CommandParameter="{Binding}"
                                                                Clicked="OnCopyUnassignedPostcodeClicked"/>
                                                        <Button Grid.Column="2"
                                                                Text="Delete"
                                                                BackgroundColor="#EF4444"
                                                                TextColor="White"
                                                                CornerRadius="8"
                                                                CommandParameter="{Binding}"
                                                                Clicked="OnDeleteUnassignedPostcodeClicked"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </StackLayout>
                            </Border>
                        </StackLayout>
                    </Grid>
                </StackLayout>

                <!-- Backup Content -->
                <StackLayout x:Name="BackupContent" IsVisible="False" Padding="32,32,32,32">
                    <Border BackgroundColor="White" Padding="0,32,0,28" Margin="0,0,0,28">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#E5E7EB" Radius="20" Opacity="0.08" Offset="0,6"/>
                        </Border.Shadow>
                        <StackLayout>
                            <Border BackgroundColor="#0EA5E9" WidthRequest="64" HeightRequest="64" HorizontalOptions="Center" Margin="0,0,0,16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16"/>
                                </Border.StrokeShape>
                                <Label Text="DB" FontSize="24" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Text="Database Backup" FontSize="28" FontAttributes="Bold" TextColor="#0F172A" HorizontalOptions="Center" Margin="0,0,0,8"/>
                            <Label Text="Backup, export, verify, and restore the Mother terminal database" FontSize="15" TextColor="#64748B" HorizontalOptions="Center"/>
                        </StackLayout>
                    </Border>

                    <Border BackgroundColor="#EFF6FF" Stroke="#BFDBFE" StrokeThickness="1" Padding="20" Margin="0,0,0,20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="20" RowSpacing="10">
                            <Label Text="Terminal" FontSize="13" FontAttributes="Bold" TextColor="#1E3A8A" Grid.Row="0" Grid.Column="0"/>
                            <Label x:Name="BackupTerminalLabel" Text="Checking..." FontSize="15" TextColor="#1E293B" Grid.Row="1" Grid.Column="0"/>
                            <Label Text="Database" FontSize="13" FontAttributes="Bold" TextColor="#1E3A8A" Grid.Row="0" Grid.Column="1"/>
                            <Label x:Name="BackupDatabaseLabel" Text="Checking..." FontSize="15" TextColor="#1E293B" Grid.Row="1" Grid.Column="1"/>
                            <Label x:Name="BackupStatusLabel" Text="Ready" FontSize="14" TextColor="#475569" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"/>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="20" Margin="0,0,0,20">
                        <Border BackgroundColor="White" Padding="24" Grid.Column="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#E5E7EB" Radius="16" Opacity="0.08" Offset="0,4"/>
                            </Border.Shadow>
                            <StackLayout Spacing="14">
                                <Label Text="Backup" FontSize="20" FontAttributes="Bold" TextColor="#0F172A"/>
                                <Label Text="Create a full database backup containing orders, payments, menu items, reports, users and settings. Automatic backups run every 3 days and retain the latest 15 packages." FontSize="14" TextColor="#64748B"/>
                                <Button x:Name="BackupNowButton" Text="Backup Now" BackgroundColor="#10B981" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="46" Clicked="OnBackupNowClicked"/>
                                <Button x:Name="OpenBackupFolderButton" Text="Open Backup Folder" BackgroundColor="Transparent" BorderColor="#0EA5E9" BorderWidth="1" TextColor="#0369A1" FontAttributes="Bold" CornerRadius="12" HeightRequest="46" Clicked="OnOpenBackupFolderClicked"/>
                            </StackLayout>
                        </Border>

                        <Border BackgroundColor="White" Padding="24" Grid.Column="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#E5E7EB" Radius="16" Opacity="0.08" Offset="0,4"/>
                            </Border.Shadow>
                            <StackLayout Spacing="14">
                                <Label Text="Restore" FontSize="20" FontAttributes="Bold" TextColor="#0F172A"/>
                                <Label Text="Upload an OrderWeb backup package. A safety backup is created first." FontSize="14" TextColor="#64748B"/>
                                <Button x:Name="UploadRestoreButton" Text="Upload &amp; Restore Backup" BackgroundColor="#DC2626" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="46" Clicked="OnUploadRestoreBackupClicked"/>
                                <Button x:Name="VerifyDatabaseButton" Text="Verify Database" BackgroundColor="Transparent" BorderColor="#64748B" BorderWidth="1" TextColor="#334155" FontAttributes="Bold" CornerRadius="12" HeightRequest="46" Clicked="OnVerifyDatabaseClicked"/>
                            </StackLayout>
                        </Border>
                    </Grid>

                    <Border BackgroundColor="White" Padding="24">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#E5E7EB" Radius="16" Opacity="0.08" Offset="0,4"/>
                        </Border.Shadow>
                        <StackLayout Spacing="16">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Backup History" FontSize="20" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center"/>
                                <Button Text="Refresh" Grid.Column="1" BackgroundColor="Transparent" BorderColor="#CBD5E1" BorderWidth="1" TextColor="#475569" FontAttributes="Bold" CornerRadius="10" HeightRequest="38" Clicked="OnRefreshBackupsClicked"/>
                            </Grid>

                            <CollectionView x:Name="BackupHistoryCollectionView" EmptyView="No backups yet.">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" Padding="16" Margin="0,0,0,10">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12"/>
                                            </Border.StrokeShape>
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                                <StackLayout Spacing="4">
                                                    <Label Text="{Binding FileName}" FontSize="14" FontAttributes="Bold" TextColor="#0F172A"/>
                                                    <Label Text="{Binding CreatedAt, StringFormat='Created {0:dd MMM yyyy HH:mm}'}" FontSize="12" TextColor="#64748B"/>
                                                    <Label Text="{Binding BackupType}" FontSize="12" TextColor="#0369A1"/>
                                                </StackLayout>
                                                <Button Text="Export" Grid.Column="1" BackgroundColor="#0EA5E9" TextColor="White" FontAttributes="Bold" CornerRadius="10" HeightRequest="38" CommandParameter="{Binding .}" Clicked="OnExportBackupClicked"/>
                                                <Button Text="Restore" Grid.Column="2" BackgroundColor="#FEE2E2" TextColor="#B91C1C" FontAttributes="Bold" CornerRadius="10" HeightRequest="38" CommandParameter="{Binding .}" Clicked="OnRestoreHistoryBackupClicked"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </StackLayout>
                    </Border>
                </StackLayout>

                <!-- OrderWeb Content with Expandable Sections -->
                <StackLayout x:Name="OrderWebContent" IsVisible="False" Padding="32,32,32,0">
                    
                    <!-- Enhanced Header -->
                    <Border BackgroundColor="White" 
                            Padding="0,32,0,28"
                            Margin="0,0,0,28">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#E5E7EB" Radius="20" Opacity="0.08" Offset="0,6"/>
                        </Border.Shadow>
                        <StackLayout>
                            <!-- Modern icon for OrderWeb -->
                            <Border BackgroundColor="#10B981"
                                    WidthRequest="64"
                                    HeightRequest="64"
                                    HorizontalOptions="Center"
                                    Margin="0,0,0,16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16"/>
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#10B981" Radius="16" Opacity="0.25" Offset="0,4"/>
                                </Border.Shadow>
                                <Label Text="OW" 
                                       FontSize="24" 
                                       FontAttributes="Bold" 
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                            <Label Text="OrderWeb Settings" 
                                   FontSize="28" 
                                   FontAttributes="Bold" 
                                   TextColor="#0F172A"
                                   HorizontalOptions="Center"
                                   Margin="0,0,0,8"/>
                            <Label Text="Configure postcode lookup and cloud connectivity" 
                                   FontSize="15" 
                                   TextColor="#64748B"
                                   HorizontalOptions="Center"/>
                        </StackLayout>
                    </Border>

                    <!-- Cloud Connect Section -->
                    <Border BackgroundColor="White" 
                            Padding="0"
                            Margin="0,0,0,20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#E5E7EB" Radius="20" Opacity="0.08" Offset="0,6"/>
                        </Border.Shadow>
                        <StackLayout>
                            
                            <!-- Cloud Section Header (Clickable) -->
                            <Border BackgroundColor="#F8FAFC" 
                                    Padding="28,20">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCloudSectionToggled"/>
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                    <Border BackgroundColor="#8B5CF6" 
                                            WidthRequest="4" 
                                            HeightRequest="24" 
                                            Grid.Column="0" 
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="2" />
                                        </Border.StrokeShape>
                                    </Border>
                                    <Label Text="Cloud Connect Settings" 
                                           FontSize="20" 
                                           FontAttributes="Bold" 
                                           TextColor="#1E293B"
                                           Grid.Column="1"
                                           VerticalOptions="Center"/>
                                    <Label x:Name="CloudToggleIcon" 
                                           Text="▶" 
                                           FontSize="16" 
                                           TextColor="#64748B"
                                           Grid.Column="2"
                                           VerticalOptions="Center"/>
                                </Grid>
                            </Border>
                            
                            <!-- Cloud Content (Expandable) -->
                            <StackLayout x:Name="CloudContent" Padding="28" IsVisible="False">
                                
                                <!-- OrderWeb Connect Configuration -->
                                <Label Text="OrderWeb Connect Configuration" FontSize="18" FontAttributes="Bold" TextColor="#1E293B" Margin="0,0,0,16"/>

                                <HorizontalStackLayout Spacing="12" Margin="0,0,0,16">
                                    <Switch x:Name="CloudOnlineMasterSwitch"
                                            Toggled="OnCloudOnlineMasterToggled"/>
                                    <Label x:Name="CloudOnlineMasterLabel"
                                           Text="Online order master terminal"
                                           FontSize="14"
                                           TextColor="#475569"
                                           VerticalOptions="Center"
                                           LineBreakMode="WordWrap"/>
                                </HorizontalStackLayout>
                                
                                <!-- Connection Settings Grid -->
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="24" RowSpacing="20">
                                    
                                    <!-- Column 1 -->
                                    <Label Text="Tenant Slug" FontSize="14" FontAttributes="Bold" TextColor="#374151" Grid.Row="0" Grid.Column="0"/>
                                    <Border Grid.Row="1" Grid.Column="0" StrokeThickness="1" Stroke="#D1D5DB" BackgroundColor="#FFFFFF">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Entry x:Name="TenantSlugEntry" 
                                               Placeholder="your-restaurant-slug"
                                               FontSize="14" 
                                               TextColor="#1F2937" 
                                               PlaceholderColor="#9CA3AF"
                                               TextChanged="OnCloudFieldChanged"
                                               Margin="12,8" />
                                    </Border>
                                    
                                    <Label Text="API Key" FontSize="14" FontAttributes="Bold" TextColor="#374151" Grid.Row="2" Grid.Column="0"/>
                                    <Grid Grid.Row="3" Grid.Column="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Border Grid.Column="0" StrokeThickness="1" Stroke="#D1D5DB" BackgroundColor="#FFFFFF">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <Entry x:Name="CloudApiKeyEntry"
                                                   Placeholder="Enter API key"
                                                   FontSize="14"
                                                   TextColor="#1F2937"
                                                   PlaceholderColor="#9CA3AF"
                                                   IsPassword="True"
                                                   TextChanged="OnCloudFieldChanged"
                                                   Margin="12,8" />
                                        </Border>
                                        <Button x:Name="ToggleCloudApiKeyButton"
                                                Text="Show"
                                                BackgroundColor="#6B7280"
                                                TextColor="White"
                                                FontSize="12"
                                                WidthRequest="50"
                                                HeightRequest="40"
                                                CornerRadius="6"
                                                Clicked="OnToggleCloudApiKeyClicked"
                                                Grid.Column="1"/>
                                    </Grid>
                                    
                                    <Label Text="REST API URL" FontSize="14" FontAttributes="Bold" TextColor="#374151" Grid.Row="4" Grid.Column="0"/>
                                    <Border Grid.Row="5" Grid.Column="0" StrokeThickness="1" Stroke="#D1D5DB" BackgroundColor="#FFFFFF">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Entry x:Name="CloudRestApiUrlEntry"
                                               Placeholder="https://orderweb.net/api"
                                               FontSize="14"
                                               TextColor="#1F2937"
                                               PlaceholderColor="#9CA3AF"
                                               TextChanged="OnCloudFieldChanged"
                                               Margin="12,8" />
                                    </Border>
                                    <Label Grid.Row="6" Grid.Column="0"
                                           Text="Base URL only — do not add /bistro or tenant slug."
                                           FontSize="12"
                                           TextColor="#64748B"/>
                                    
                                    <!-- Column 2 -->
                                    <Label Text="WebSocket URL" FontSize="14" FontAttributes="Bold" TextColor="#374151" Grid.Row="0" Grid.Column="1"/>
                                    <Border Grid.Row="1" Grid.Column="1" StrokeThickness="1" Stroke="#D1D5DB" BackgroundColor="#FFFFFF">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Entry x:Name="CloudWebSocketUrlEntry"
                                               Placeholder="wss://orderweb.net/ws/pos"
                                               FontSize="14"
                                               TextColor="#1F2937"
                                               PlaceholderColor="#9CA3AF"
                                               TextChanged="OnCloudFieldChanged"
                                               Margin="12,8" />
                                    </Border>
                                    <Label Grid.Row="2" Grid.Column="1"
                                           Text="Base URL only — tenant is sent separately."
                                           FontSize="12"
                                           TextColor="#64748B"/>
                                    
                                    <!-- Connection Actions -->
                                    <HorizontalStackLayout Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Spacing="12" Margin="0,24,0,0">
                                        <Button x:Name="CloudSaveSettingsButton"
                                                Text="Save Settings"
                                                BackgroundColor="#0F766E"
                                                TextColor="White"
                                                FontAttributes="Bold"
                                                FontSize="14"
                                                HeightRequest="44"
                                                CornerRadius="8"
                                                Clicked="OnCloudSaveSettingsClicked"/>
                                        <Button x:Name="CloudConnectButton"
                                                Text="Connect"
                                                BackgroundColor="#3B82F6"
                                                TextColor="White"
                                                FontAttributes="Bold"
                                                FontSize="14"
                                                HeightRequest="44"
                                                CornerRadius="8"
                                                Clicked="OnCloudConnectClicked"/>
                                        <Button x:Name="CloudSyncOrdersButton"
                                                Text="Sync Orders"
                                                BackgroundColor="#10B981"
                                                TextColor="White"
                                                FontAttributes="Bold"
                                                FontSize="14"
                                                HeightRequest="44"
                                                CornerRadius="8"
                                                Clicked="OnCloudSyncOrdersClicked"/>
                                        <Button x:Name="CloudSyncHistoricalButton"
                                                Text="Sync Historical"
                                                BackgroundColor="#8B5CF6"
                                                TextColor="White"
                                                FontAttributes="Bold"
                                                FontSize="14"
                                                HeightRequest="44"
                                                CornerRadius="8"
                                                Clicked="OnCloudSyncHistoricalClicked"/>
                                    </HorizontalStackLayout>
                                    
                                </Grid>
                                
                                <!-- Connection Status -->
                                <Border x:Name="CloudConnectionStatusFrame"
                                        BackgroundColor="#FEF3C7"
                                        Stroke="#F59E0B"
                                        StrokeThickness="1"
                                        Padding="20"
                                        Margin="0,24,0,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <StackLayout>
                                        <HorizontalStackLayout Spacing="12" Margin="0,0,0,8">
                                            <Border BackgroundColor="#F59E0B" 
                                                    WidthRequest="8" 
                                                    HeightRequest="8" 
                                                    VerticalOptions="Center">
                                                <Border.StrokeShape>
                                                    <Ellipse />
                                                </Border.StrokeShape>
                                            </Border>
                                            <StackLayout VerticalOptions="Center">
                                                <Label x:Name="CloudConnectionStatusText" 
                                                       Text="Not Connected" 
                                                       FontSize="16" 
                                                       FontAttributes="Bold"
                                                       TextColor="#92400E"/>
                                                <Label x:Name="CloudConnectionStatusDescription"
                                                       Text="Configure your connection settings to get started"
                                                       FontSize="14"
                                                       TextColor="#B45309"/>
                                            </StackLayout>
                                        </HorizontalStackLayout>
                                    </StackLayout>
                                </Border>
                                
                                <!-- System Status Section -->
                                <StackLayout x:Name="CloudSystemStatusSection" IsVisible="False" Margin="0,24,0,0">
                                    <Label Text="System Status" FontSize="18" FontAttributes="Bold" TextColor="#1E293B" Margin="0,0,0,16"/>
                                    
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                                        
                                        <!-- Connection Status -->
                                        <Border BackgroundColor="#F0FDF4" 
                                                Stroke="#16A34A" 
                                                StrokeThickness="1" 
                                                Padding="16"
                                                Grid.Column="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12"/>
                                            </Border.StrokeShape>
                                            <StackLayout>
                                                <HorizontalStackLayout Spacing="8">
                                                    <Label x:Name="CloudStatusConnectionIcon" Text="" FontSize="18"/>
                                                    <Label x:Name="CloudStatusConnectionText" 
                                                           Text="Connected" 
                                                           FontSize="16" 
                                                           FontAttributes="Bold"
                                                           TextColor="#15803D"/>
                                                </HorizontalStackLayout>
                                                <Label Text="Real-time sync active" FontSize="14" TextColor="#166534" Margin="26,4,0,0"/>
                                            </StackLayout>
                                        </Border>
                                        
                                        <!-- Backup Status -->
                                        <Border BackgroundColor="#F0F9FF" 
                                                Stroke="#0EA5E9" 
                                                StrokeThickness="1" 
                                                Padding="16"
                                                Grid.Column="1">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12"/>
                                            </Border.StrokeShape>
                                            <StackLayout>
                                                <HorizontalStackLayout Spacing="8">
                                                    <Label x:Name="CloudStatusBackupIcon" Text="" FontSize="18"/>
                                                    <Label x:Name="CloudStatusBackupText" 
                                                           Text="Backup Active" 
                                                           FontSize="16" 
                                                           FontAttributes="Bold"
                                                           TextColor="#0C4A6E"/>
                                                </HorizontalStackLayout>
                                                <Label x:Name="CloudStatusLastCheckText" 
                                                       Text="Last backup: 2 minutes ago" 
                                                       FontSize="14" 
                                                       TextColor="#075985" 
                                                       Margin="26,4,0,0"/>
                                            </StackLayout>
                                        </Border>
                                        
                                    </Grid>
                                    
                                    <!-- Device Information -->
                                    <Label x:Name="CloudDeviceInfoText" 
                                           Text="Device ID: POS-ABC123 | Location: Main Terminal" 
                                           FontSize="14" 
                                           TextColor="#6B7280"
                                           HorizontalOptions="Center"
                                           Margin="0,16,0,0"/>
                                    
                                </StackLayout>
                                
                            </StackLayout>
                        </StackLayout>
                    </Border>

                    <!-- UK Address Lookup (OrderWeb platform owp_ key) -->
                    <Border BackgroundColor="White"
                            Padding="0"
                            Margin="0,0,0,20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#E5E7EB" Radius="20" Opacity="0.08" Offset="0,6"/>
                        </Border.Shadow>
                        <StackLayout>
                            <Border BackgroundColor="#F8FAFC"
                                    Padding="28,20">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPostcodeSectionToggled"/>
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                    <Border BackgroundColor="#0EA5E9"
                                            WidthRequest="4"
                                            HeightRequest="24"
                                            Grid.Column="0"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="2" />
                                        </Border.StrokeShape>
                                    </Border>
                                    <Label Text="Postcode Lookup Settings"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="#1E293B"
                                           Grid.Column="1"
                                           VerticalOptions="Center"/>
                                    <Label x:Name="PostcodeToggleIcon"
                                           Text="▶"
                                           FontSize="16"
                                           TextColor="#64748B"
                                           Grid.Column="2"
                                           VerticalOptions="Center"/>
                                </Grid>
                            </Border>

                            <StackLayout x:Name="PostcodeContent" Padding="28" IsVisible="False" Spacing="16">
                                <Label Text="Shared OrderWeb address API key (owp_...). Same for every restaurant. Delivery fees still use local zones."
                                       FontSize="14"
                                       TextColor="#64748B"
                                       LineBreakMode="WordWrap"/>

                                <Label Text="OrderWeb Address API Key" FontSize="14" FontAttributes="Bold" TextColor="#374151"/>
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <Border Grid.Column="0" StrokeThickness="1" Stroke="#D1D5DB" BackgroundColor="#FFFFFF">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Entry x:Name="OrderWebAddressApiKeyEntry"
                                               Placeholder="owp_..."
                                               FontSize="14"
                                               TextColor="#1F2937"
                                               PlaceholderColor="#9CA3AF"
                                               IsPassword="True"
                                               Margin="12,8" />
                                    </Border>
                                    <Button x:Name="ToggleOrderWebAddressApiKeyButton"
                                            Text="Show"
                                            BackgroundColor="#6B7280"
                                            TextColor="White"
                                            FontSize="12"
                                            WidthRequest="50"
                                            HeightRequest="40"
                                            CornerRadius="6"
                                            Clicked="OnToggleOrderWebAddressApiKeyClicked"
                                            Grid.Column="1"/>
                                    <Button x:Name="TestOrderWebAddressButton"
                                            Text="Test"
                                            BackgroundColor="#3B82F6"
                                            TextColor="White"
                                            FontSize="12"
                                            WidthRequest="60"
                                            HeightRequest="40"
                                            CornerRadius="6"
                                            Clicked="OnTestOrderWebAddressClicked"
                                            Grid.Column="2"/>
                                </Grid>

                                <Border x:Name="OrderWebAddressStatusFrame"
                                        IsVisible="False"
                                        StrokeThickness="1"
                                        Stroke="#E2E8F0"
                                        BackgroundColor="#F8FAFC"
                                        Padding="12">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8"/>
                                    </Border.StrokeShape>
                                    <Label x:Name="OrderWebAddressStatusText"
                                           FontSize="13"
                                           TextColor="#334155"
                                           LineBreakMode="WordWrap"/>
                                </Border>

                                <Button Text="Save Settings"
                                        Clicked="OnSaveOrderWebAddressSettingsClicked"
                                        BackgroundColor="#10B981"
                                        TextColor="White"
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        HeightRequest="44"
                                        CornerRadius="8"/>

                                <Border x:Name="OrderWebAddressStatsFrame"
                                        IsVisible="False"
                                        BackgroundColor="#E0F2FE"
                                        Stroke="#7DD3FC"
                                        StrokeThickness="1"
                                        Padding="16">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10"/>
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Usage Statistics"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#075985"/>
                                        <Label x:Name="OrderWebAddressUsageLabel"
                                               Text="Total Lookups: 0"
                                               FontSize="14"
                                               TextColor="#075985"/>
                                        <Label x:Name="OrderWebAddressLastUsedLabel"
                                               Text="Last Used: Never"
                                               FontSize="14"
                                               TextColor="#075985"/>
                                    </VerticalStackLayout>
                                </Border>
                            </StackLayout>
                        </StackLayout>
                    </Border>
                    
                </StackLayout>
                
            </StackLayout>
        </ScrollView>
        
        <!-- Edit User Overlay -->
        <views:EditUserOverlay x:Name="EditUserOverlay" 
                               Grid.Row="0" 
                               Grid.RowSpan="4" 
                               IsVisible="False" />
        
        <!-- Role Selection Overlay - Must be last to appear on top -->
        <views:RoleSelectionOverlay x:Name="RoleSelectionOverlay" 
                                    Grid.Row="0" 
                                    Grid.RowSpan="4" 
                                    IsVisible="False" />
        
    </Grid>
</ContentPage>

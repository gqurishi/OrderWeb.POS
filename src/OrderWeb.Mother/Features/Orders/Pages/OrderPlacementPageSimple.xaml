<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:POS_in_NET.Views"
             xmlns:controls="clr-namespace:POS_in_NET.Controls"
             xmlns:shared="clr-namespace:OrderWeb.SharedUI.Controls;assembly=OrderWeb.SharedUI"
             x:Class="POS_in_NET.Pages.OrderPlacementPageSimple"
             Title="Order Placement"
             BackgroundColor="#F1F5F9">

    <!-- Full-bleed Order Place; flyout menu lives inside SharedUI category toolbar. -->
    <Grid>

        <views:TopBar x:Name="TopBar"
                      IsVisible="False"
                      HeightRequest="0"
                      InputTransparent="True"/>

        <controls:ToastNotification x:Name="ToastNotification"
                                    ZIndex="1000"
                                    InputTransparent="True"
                                    Placement="BottomCenter"/>

        <Grid x:Name="MainContentGrid" Padding="4">
            <ContentView x:Name="ShellHost" />
        </Grid>

        <shared:ChefLoaderView x:Name="LoadingOverlay"
                               Mode="Fullscreen"
                               Size="Md"
                               Message="Cooking up your data…"
                               DelayMilliseconds="0"
                               IsLoading="False"
                               IsVisible="False"
                               ZIndex="50" />
    </Grid>

</ContentPage>

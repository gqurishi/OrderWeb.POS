<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:POS_in_NET.Views"
             xmlns:controls="clr-namespace:POS_in_NET.Controls"
             xmlns:shared="clr-namespace:OrderWeb.SharedUI.Controls;assembly=OrderWeb.SharedUI"
             xmlns:op="clr-namespace:OrderWeb.SharedUI.Controls.OrderPlace;assembly=OrderWeb.SharedUI"
             x:Class="POS_in_NET.Pages.OrderPlacementPageSimple"
             Title="Order Placement"
             BackgroundColor="#F1F5F9">

    <!-- Phase 2 shell: Header | Left (~70%) | Right (~30%). Page does not scroll. -->
    <Grid RowDefinitions="Auto,*">

        <!-- Slim header: nav + order title + time/status + brand (via TopBar/PosHeader) -->
        <views:TopBar x:Name="TopBar" Grid.Row="0"/>

        <controls:ToastNotification x:Name="ToastNotification"
                                    Grid.RowSpan="2"
                                    ZIndex="1000"
                                    InputTransparent="True"
                                    Placement="BottomCenter"/>

        <Grid x:Name="MainContentGrid"
              Grid.Row="1"
              ColumnDefinitions="7*,3*"
              ColumnSpacing="12"
              Padding="12">

            <!-- LEFT (~70%): Search → categories → subcategories → product host -->
            <Border x:Name="MenuPanel"
                    Grid.Column="0"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    Padding="12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>

                <Grid x:Name="MenuWorkspaceGrid"
                      RowDefinitions="Auto,Auto,Auto,*"
                      RowSpacing="12">

                    <!-- Search -->
                    <Border x:Name="SearchBarBorder"
                            Grid.Row="0"
                            BackgroundColor="#F1F5F9"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="14,10"
                            HeightRequest="48">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSearchBarTapped"/>
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label x:Name="SearchDisplayLabel"
                                   Grid.Column="0"
                                   Text="Search menu items..."
                                   TextColor="#94A3B8"
                                   FontSize="15"
                                   VerticalOptions="Center"/>
                            <Button x:Name="ClearSearchButton"
                                    Grid.Column="1"
                                    Text="X"
                                    FontSize="14"
                                    TextColor="#64748B"
                                    BackgroundColor="Transparent"
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    Padding="0"
                                    IsVisible="False"
                                    Clicked="OnClearSearchClicked"/>
                        </Grid>
                    </Border>

                    <!-- Main categories: one strong horizontal row (scroll if overflow) -->
                    <op:HorizontalChipScroller x:Name="CategoryChipScroller"
                                               Grid.Row="1"
                                               HeightRequest="52"/>

                    <!-- Subcategories: one lighter horizontal row -->
                    <op:HorizontalChipScroller x:Name="SubCategorySection"
                                               Grid.Row="2"
                                               HeightRequest="42"
                                               IsVisible="False"/>

                    <!-- Adaptive product grid (only left scroll region) -->
                    <ScrollView x:Name="ProductScrollHost" Grid.Row="3">
                        <op:OrderPlaceProductGrid x:Name="ProductGrid"/>
                    </ScrollView>
                </Grid>
            </Border>

            <!-- RIGHT (~30%): fixed identity → scroll lines → fixed totals + actions -->
            <Border x:Name="OrderPanel"
                    Grid.Column="1"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeThickness="1"
                    Padding="12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>

                <Grid x:Name="OrderWorkspaceGrid"
                      RowDefinitions="Auto,*,Auto"
                      RowSpacing="8">

                    <!-- Fixed order header (table/guests or customer) — Payment removed from here -->
                    <Border x:Name="OrderHeaderRegion"
                            Grid.Row="0"
                            BackgroundColor="#F8FAFC"
                            Stroke="#E2E8F0"
                            StrokeThickness="1"
                            Padding="12,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label x:Name="OrderIdentityLabel"
                                   Text="Order # Table 1"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1"/>
                            <Label x:Name="GuestsLabel"
                                   Text="Guests = 2"
                                   FontSize="13"
                                   TextColor="#475569"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Scrollable order lines (only right scroll region) -->
                    <ScrollView x:Name="OrderLinesScrollHost" Grid.Row="1">
                        <VerticalStackLayout x:Name="OrderItemsContainer" Spacing="8"/>
                    </ScrollView>

                    <!-- Fixed bottom action station: totals → NOTES/VOID/MORE → SEND/PRINT → PAYMENT -->
                    <Border x:Name="OrderActionsCard"
                            Grid.Row="2"
                            BackgroundColor="#FFFFFF"
                            Stroke="#E5E7EB"
                            StrokeThickness="1"
                            Padding="12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.06" Radius="8" Offset="0,-2"/>
                        </Border.Shadow>

                        <VerticalStackLayout x:Name="OrderActionsLayout" Spacing="10">
                            <Border BackgroundColor="#F9FAFB"
                                    Stroke="#E2E8F0"
                                    Padding="12"
                                    Margin="0,0,0,2">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="5">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="Subtotal" TextColor="#475569" FontSize="13"/>
                                        <Label x:Name="SubtotalLabel" Grid.Column="1" Text="£0.00" TextColor="#0F172A" FontSize="13"/>
                                    </Grid>
                                    <Grid x:Name="DiscountRow" ColumnDefinitions="*,Auto" IsVisible="False">
                                        <Label x:Name="DiscountReasonLabel" Text="Discount" TextColor="#475569" FontSize="13"/>
                                        <Label x:Name="DiscountLabel" Grid.Column="1" Text="-£0.00" TextColor="#DC2626" FontSize="13"/>
                                    </Grid>
                                    <Grid x:Name="ServiceChargeRow" ColumnDefinitions="*,Auto" IsVisible="False">
                                        <Label x:Name="ServiceChargeDescriptionLabel" Text="Service charge" TextColor="#475569" FontSize="13"/>
                                        <Label x:Name="ServiceChargeLabel" Grid.Column="1" Text="£0.00" TextColor="#0F766E" FontSize="13" FontAttributes="Bold"/>
                                    </Grid>
                                    <!-- Phase 5 type policy will show this for Delivery -->
                                    <Grid x:Name="DeliveryFeeRow" ColumnDefinitions="*,Auto" IsVisible="False">
                                        <Label x:Name="DeliveryFeeDescriptionLabel" Text="Delivery fee" TextColor="#475569" FontSize="13"/>
                                        <Label x:Name="DeliveryFeeLabel" Grid.Column="1" Text="£0.00" TextColor="#0F766E" FontSize="13" FontAttributes="Bold"/>
                                    </Grid>
                                    <BoxView HeightRequest="1" Color="#CBD5E1" Margin="0,2"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="TOTAL" FontSize="15" TextColor="#334155" FontAttributes="Bold" VerticalOptions="Center"/>
                                        <Label x:Name="TotalLabel" Grid.Column="1" Text="£0.00" FontSize="22" TextColor="#059669" FontAttributes="Bold" VerticalOptions="Center"/>
                                    </Grid>
                                    <Label x:Name="VATLabel" Text="£0.00" IsVisible="False"/>
                                </VerticalStackLayout>
                            </Border>

                            <Grid x:Name="QuickActionsGrid" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <op:PosActionButton x:Name="NotesButton"
                                                    Grid.Column="0"
                                                    Text="NOTES"
                                                    Role="Secondary"
                                                    Tapped="OnNotesClicked"/>
                                <op:PosActionButton x:Name="VoidButton"
                                                    Grid.Column="1"
                                                    Text="VOID"
                                                    Role="Destructive"
                                                    Tapped="OnVoidClicked"/>
                                <op:PosActionButton x:Name="MoreButton"
                                                    Grid.Column="2"
                                                    Text="MORE ▼"
                                                    Role="Utility"
                                                    Tapped="OnMoreClicked"/>
                            </Grid>

                            <Grid x:Name="MainActionsGrid" ColumnDefinitions="1.4*,*" ColumnSpacing="8">
                                <op:PosActionButton x:Name="SendButton"
                                                    Grid.Column="0"
                                                    Text="SEND TO KITCHEN"
                                                    Role="Primary"
                                                    Tapped="OnSendClicked"/>
                                <op:PosActionButton x:Name="PrintButton"
                                                    Grid.Column="1"
                                                    Text="PRINT"
                                                    Role="Secondary"
                                                    Tapped="OnPrintReceiptClicked"/>
                            </Grid>

                            <op:PosActionButton x:Name="PaymentButton"
                                                Text="PAYMENT"
                                                Role="Payment"
                                                HorizontalOptions="Fill"
                                                Tapped="OnPayClicked"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </Border>

            <shared:ChefLoaderView x:Name="LoadingOverlay"
                                   Grid.ColumnSpan="2"
                                   Mode="Fullscreen"
                                   Size="Md"
                                   Message="Cooking up your data…"
                                   DelayMilliseconds="0"
                                   IsLoading="False"
                                   IsVisible="False"
                                   ZIndex="50" />
        </Grid>
    </Grid>

</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:POS_in_NET.Views"
             xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
             x:Class="POS_in_NET.Pages.DashboardPage"
             Title=""
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*">
        
        <!-- Top Bar -->
        <views:TopBar x:Name="TopBar" Grid.Row="0"/>
        
        <!-- Main Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,20,24,28" Spacing="20">
                
                <!-- KPI Cards -->
                <Grid RowDefinitions="Auto" ColumnDefinitions="*,*,*" ColumnSpacing="16">
                    
                    <!-- Today's Sales Card -->
                    <Frame Grid.Row="0" Grid.Column="0" Style="{StaticResource KPICard}">
                        <VerticalStackLayout Spacing="12">
                            <HorizontalStackLayout Spacing="12">
                                <Frame BackgroundColor="#DCFCE7" 
                                       CornerRadius="24" 
                                       HeightRequest="48" 
                                       WidthRequest="48"
                                       Padding="0"
                                       HasShadow="False">
                                    <Label Text="£" 
                                           FontSize="24" 
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center" 
                                           VerticalOptions="Center" />
                                </Frame>
                                <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                                    <Label Text="Today's Sales" 
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextSecondary}" />
                                    <Label x:Name="TodaysSalesLabel"
                                           Text="£0.00"
                                           FontSize="32"
                                           FontAttributes="Bold"
                                           TextColor="#10B981" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Weekly Sales Card -->
                    <Frame Grid.Row="0" Grid.Column="1" Style="{StaticResource KPICard}">
                        <VerticalStackLayout Spacing="12">
                            <HorizontalStackLayout Spacing="12">
                                <Frame BackgroundColor="#DBEAFE" 
                                       CornerRadius="24" 
                                       HeightRequest="48" 
                                       WidthRequest="48"
                                       Padding="0"
                                       HasShadow="False">
                                    <Label Text="7D" 
                                           FontSize="20" 
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center" 
                                           VerticalOptions="Center" />
                                </Frame>
                                <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                                     <Label Text="Last 7 Days Sales" 
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextSecondary}" />
                                    <Label x:Name="WeeklySalesLabel"
                                           Text="£0.00"
                                           FontSize="32"
                                           FontAttributes="Bold"
                                           TextColor="#3B82F6" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Today's Orders Card -->
                    <Frame Grid.Row="0" Grid.Column="2" Style="{StaticResource KPICard}">
                        <VerticalStackLayout Spacing="12">
                            <HorizontalStackLayout Spacing="12">
                                <Frame BackgroundColor="#FEF3C7" 
                                       CornerRadius="24" 
                                       HeightRequest="48" 
                                       WidthRequest="48"
                                       Padding="0"
                                       HasShadow="False">
                                    <Label Text="#" 
                                           FontSize="24" 
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center" 
                                           VerticalOptions="Center" />
                                </Frame>
                                <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                                    <Label Text="Today's Total Orders" 
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextSecondary}" />
                                    <Label x:Name="TodaysOrdersLabel"
                                           Text="0"
                                           FontSize="32"
                                           FontAttributes="Bold"
                                           TextColor="#F59E0B" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Frame>

                </Grid>

                <!-- Z-Report Live Summary (Admin only) -->
                <Border Stroke="#BFDBFE"
                        StrokeThickness="1"
                        BackgroundColor="#FFFFFF"
                        StrokeShape="RoundRectangle 20"
                        Padding="18">
                    <Border.Shadow>
                        <Shadow Brush="#93C5FD" Offset="0,6" Radius="18" Opacity="0.08" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="14">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                            <Button x:Name="ZReportRefreshButton"
                                    Grid.Row="0"
                                    Text="Refresh"
                                    Clicked="OnZReportRefreshClicked"
                                    BackgroundColor="#EFF6FF"
                                    TextColor="#1D4ED8"
                                    FontAttributes="Bold"
                                    CornerRadius="10"
                                    HeightRequest="44"
                                    HorizontalOptions="Fill" />
                            <VerticalStackLayout Grid.Row="1" Spacing="4">
                                <Label x:Name="ZReportDateLabel"
                                       Text="Live day summary"
                                       FontSize="13"
                                       TextColor="#64748B" />
                                <Label x:Name="ZReportUpdatedLabel"
                                       Text="Updated --:--:--"
                                       FontSize="12"
                                       TextColor="#94A3B8" />
                            </VerticalStackLayout>
                        </Grid>

                        <Label x:Name="ZReportMotherTerminalLabel"
                               IsVisible="False"
                               Text="Print Z-Report runs on the mother terminal only."
                               FontSize="12"
                               TextColor="#B45309"
                               LineBreakMode="WordWrap" />

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                            <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#F0FDF4" Stroke="#BBF7D0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Gross" FontSize="11" TextColor="#166534" />
                                    <Label x:Name="ZReportGrossLabel" Text="£0.00" FontSize="18" FontAttributes="Bold" TextColor="#14532D" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#EFF6FF" Stroke="#BFDBFE" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Net" FontSize="11" TextColor="#1D4ED8" />
                                    <Label x:Name="ZReportNetLabel" Text="£0.00" FontSize="18" FontAttributes="Bold" TextColor="#1E3A8A" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="2" BackgroundColor="#FFF7ED" Stroke="#FED7AA" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="VAT" FontSize="11" TextColor="#C2410C" />
                                    <Label x:Name="ZReportVatLabel" Text="£0.00" FontSize="18" FontAttributes="Bold" TextColor="#9A3412" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Cash" FontSize="11" TextColor="#475569" />
                                    <Label x:Name="ZReportCashLabel" Text="£0.00" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Card" FontSize="11" TextColor="#475569" />
                                    <Label x:Name="ZReportCardLabel" Text="£0.00" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Gift / Tips" FontSize="11" TextColor="#475569" />
                                    <Label x:Name="ZReportGiftTipsLabel" Text="£0.00" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="0" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="POS Sales" FontSize="11" TextColor="#475569" />
                                    <Label x:Name="ZReportPosLabel" Text="£0.00" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="1" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Online Sales" FontSize="11" TextColor="#475569" />
                                    <Label x:Name="ZReportOnlineLabel" Text="£0.00" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="2" BackgroundColor="#FEF2F2" Stroke="#FECACA" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Petty Cash Out" FontSize="11" TextColor="#991B1B" />
                                    <Label x:Name="ZReportTillOutLabel" Text="£0.00" FontSize="16" FontAttributes="Bold" TextColor="#7F1D1D" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="#ECFDF5" Stroke="#A7F3D0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Expected Cash in Till" FontSize="11" TextColor="#047857" />
                                    <Label x:Name="ZReportExpectedCashLabel" Text="£0.00" FontSize="16" FontAttributes="Bold" TextColor="#065F46" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Row="3" Grid.Column="2" BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="vs Yesterday" FontSize="11" TextColor="#475569" />
                                    <Label x:Name="ZReportVsYesterdayLabel" Text="--" FontSize="14" FontAttributes="Bold" TextColor="#0F172A" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,2,0,0">
                            <Button x:Name="ZReportPrintTodayButton"
                                    Grid.Column="0"
                                    Text="Z Print Today"
                                    Clicked="OnPrintZReportTodayClicked"
                                    BackgroundColor="#0F766E"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    HeightRequest="48" />
                            <Button x:Name="ZReportPrintYesterdayButton"
                                    Grid.Column="1"
                                    Text="Reprint Yesterday"
                                    Clicked="OnPrintZReportYesterdayClicked"
                                    BackgroundColor="#EFF6FF"
                                    TextColor="#1D4ED8"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    HeightRequest="48" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Quick Actions Section -->
                <VerticalStackLayout Spacing="14" Padding="0,4,0,0">
                    <Grid RowDefinitions="Auto"
                          ColumnDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="96"
                          HorizontalOptions="Center">
                        <!-- Restaurant/Dine-in Button -->
                        <Border Grid.Row="0" Grid.Column="0"
                                BackgroundColor="Transparent"
                                StrokeThickness="0"
                                Padding="10"
                                HorizontalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRestaurantClicked" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                                <Image Source="restaurant.png"
                                       WidthRequest="170"
                                       HeightRequest="170"
                                       HorizontalOptions="Center" />
                                <Label Text="Restaurant"
                                       FontFamily="InterBold"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#1D4ED8"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Delivery Button -->
                        <Border Grid.Row="0" Grid.Column="1"
                                BackgroundColor="Transparent"
                                StrokeThickness="0"
                                Padding="10"
                                HorizontalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDeliveryClicked" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                                <Image Source="delivery.png"
                                       WidthRequest="170"
                                       HeightRequest="170"
                                       HorizontalOptions="Center" />
                                <Label Text="Delivery"
                                       FontFamily="InterBold"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#1D4ED8"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Collection Button -->
                        <Border Grid.Row="0" Grid.Column="2"
                                BackgroundColor="Transparent"
                                StrokeThickness="0"
                                Padding="10"
                                HorizontalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCollectionClicked" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                                <Image Source="collection.png"
                                       WidthRequest="170"
                                       HeightRequest="170"
                                       HorizontalOptions="Center" />
                                <Label Text="Collection"
                                       FontFamily="InterBold"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#1D4ED8"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

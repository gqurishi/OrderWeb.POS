<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:POS_in_NET.Views"
             x:Class="POS_in_NET.Pages.OrderHistoryPage"
             BackgroundColor="#F8F9FA">

    <Grid RowDefinitions="Auto,*,Auto">
        
        <!-- Top Bar -->
        <views:TopBar x:Name="TopBar" Grid.Row="0"/>

        <!-- Main Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="16">

                <!-- Header Actions -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <!-- Date Card -->
                    <Border Grid.Column="0"
                            BackgroundColor="#EEF7F2"
                            Stroke="#B7E4C7"
                            StrokeThickness="1"
                            Padding="16"
                            MinimumHeightRequest="92">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCalendarClicked"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="FILTER BY DATE"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#16A34A"/>
                            <Label x:Name="SelectedDateLabel"
                                   Text="April 16, 2026"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#14532D"/>
                            <Label Text="Tap to choose a different date"
                                   FontSize="11"
                                   TextColor="#15803D"/>
                        </VerticalStackLayout>
                    </Border>

                        <!-- Search Card -->
                    <Border Grid.Column="1"
                            BackgroundColor="#EFF6FF"
                            Stroke="#BFDBFE"
                            StrokeThickness="1"
                            Padding="16"
                            MinimumHeightRequest="92">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSearchClicked"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="SEARCH ORDERS"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#2563EB"/>
                            <Label Text="Order number or phone"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#1E3A8A"/>
                            <Label Text="Tap to type and search"
                                   FontSize="11"
                                   TextColor="#1D4ED8"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Order Type Tabs -->
                <Frame BackgroundColor="White" 
                       Padding="0"
                       CornerRadius="12"
                       HasShadow="False"
                       BorderColor="#E5E7EB">
                    <HorizontalStackLayout Spacing="12" HorizontalOptions="Center" Padding="16">
                        
                        <Border x:Name="AllTabBorder"
                                BackgroundColor="#10B981"
                                StrokeThickness="0"
                                Padding="24,10"
                                HeightRequest="44">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAllTabClicked"/>
                            </Border.GestureRecognizers>
                            <Label x:Name="AllTabLabel"
                                   Text="All" 
                                   TextColor="White"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"/>
                        </Border>

                        <Border x:Name="CollectionTabBorder"
                                BackgroundColor="#F5F5F5"
                                StrokeThickness="0"
                                Padding="24,10"
                                HeightRequest="44">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCollectionTabClicked"/>
                            </Border.GestureRecognizers>
                            <Label x:Name="CollectionTabLabel"
                                   Text="Collection" 
                                   TextColor="#6B7280"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"/>
                        </Border>

                        <Border x:Name="DeliveryTabBorder"
                                BackgroundColor="#F5F5F5"
                                StrokeThickness="0"
                                Padding="24,10"
                                HeightRequest="44">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDeliveryTabClicked"/>
                            </Border.GestureRecognizers>
                            <Label x:Name="DeliveryTabLabel"
                                   Text="Delivery" 
                                   TextColor="#6B7280"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"/>
                        </Border>

                        <Border x:Name="TableTabBorder"
                                BackgroundColor="#F5F5F5"
                                StrokeThickness="0"
                                Padding="24,10"
                                HeightRequest="44">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTableTabClicked"/>
                            </Border.GestureRecognizers>
                            <Label x:Name="TableTabLabel"
                                   Text="Table" 
                                   TextColor="#6B7280"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"/>
                        </Border>

                        <Border x:Name="WebTabBorder"
                                BackgroundColor="#F5F5F5"
                                StrokeThickness="0"
                                Padding="24,10"
                                HeightRequest="44">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnWebTabClicked"/>
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="7" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="●" FontSize="10" TextColor="#2563EB" VerticalOptions="Center"/>
                                <Label x:Name="WebTabLabel" Text="Web" TextColor="#6B7280"
                                       FontSize="15" FontAttributes="Bold" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>

                    </HorizontalStackLayout>
                </Frame>

                <Border x:Name="SearchStatusBorder" IsVisible="False"
                        BackgroundColor="#EFF6FF" Stroke="#BFDBFE" StrokeThickness="1"
                        Padding="14,10">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label x:Name="SearchStatusLabel" FontSize="13" FontAttributes="Bold" TextColor="#1E3A8A"/>
                            <Label x:Name="SearchSourceLabel" FontSize="11" TextColor="#2563EB"/>
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Clear" Clicked="OnClearSearchClicked"
                                BackgroundColor="White" TextColor="#1D4ED8" BorderColor="#93C5FD"
                                BorderWidth="1" HeightRequest="38" Padding="16,4"/>
                    </Grid>
                </Border>

                <!-- Completed Orders Section -->
                <VerticalStackLayout x:Name="CompletedOrdersLayout" Spacing="12">
                    <CollectionView x:Name="CompletedOrdersCollection"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="White"
                                        Stroke="#E2E8F0"
                                        StrokeThickness="1"
                                        Padding="16,12"
                                        Margin="0,0,0,6"
                                        MinimumHeightRequest="72">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                                    <Grid ColumnDefinitions="2*,1.05*,1.25*,Auto,Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding OrderNumber}" FontSize="16" FontAttributes="Bold"
                                                   TextColor="#172033" LineBreakMode="TailTruncation"/>
                                            <Label Text="{Binding OrderDateTime}" FontSize="12" TextColor="#64748B"/>
                                            <Label Text="{Binding CustomerDisplay}" FontSize="11" TextColor="#64748B" LineBreakMode="TailTruncation"/>
                                        </VerticalStackLayout>
                                        <Border Grid.Column="1" BackgroundColor="#EEF2FF" Stroke="#C7D2FE"
                                                StrokeThickness="1" Padding="12,7" HorizontalOptions="Start" VerticalOptions="Center">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                                            <Label Text="{Binding OrderTypeDisplay}" FontSize="12" FontAttributes="Bold" TextColor="#4338CA"/>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding PaymentDisplay}" FontSize="12" FontAttributes="Bold" TextColor="#334155"/>
                                            <Label Text="{Binding StatusDisplay}" FontSize="11" TextColor="#64748B"/>
                                        </VerticalStackLayout>
                                        <Label Grid.Column="3" Text="{Binding TotalAmount, StringFormat='£{0:F2}'}"
                                               FontSize="17" FontAttributes="Bold" TextColor="#059669"
                                               Margin="6,0" VerticalOptions="Center"/>
                                        <Border Grid.Column="4" BackgroundColor="#2563EB" StrokeThickness="0"
                                                WidthRequest="80" HeightRequest="42" VerticalOptions="Center">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnViewOrderClicked"/></Border.GestureRecognizers>
                                            <Label Text="View" TextColor="White" FontSize="13" FontAttributes="Bold"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Empty State -->
                    <Label x:Name="CompletedEmptyLabel"
                           Text="No orders found for this date"
                           FontSize="16"
                           TextColor="#9CA3AF"
                           HorizontalOptions="Center"
                           Margin="0,40,0,0"
                           IsVisible="False"/>
                </VerticalStackLayout>

                <!-- Voided Orders Section -->
                <VerticalStackLayout x:Name="VoidedOrdersLayout" Spacing="12" IsVisible="False">
                    
                    <!-- Separator -->
                    <Grid ColumnDefinitions="*,Auto,*" Margin="0,20,0,12">
                        <BoxView BackgroundColor="#E5E7EB" HeightRequest="1" VerticalOptions="Center" Grid.Column="0"/>
                        <Label Text="Voided Orders" 
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#6B7280"
                               Padding="12,0"
                               Grid.Column="1"/>
                        <BoxView BackgroundColor="#E5E7EB" HeightRequest="1" VerticalOptions="Center" Grid.Column="2"/>
                    </Grid>

                    <CollectionView x:Name="VoidedOrdersCollection"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#FFF7F7" Stroke="#FCA5A5" StrokeThickness="1"
                                        Padding="16,12" Margin="0,0,0,6" MinimumHeightRequest="72">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                                    <Grid ColumnDefinitions="2*,1.05*,1.25*,Auto,Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding OrderNumber}" FontSize="16" FontAttributes="Bold"
                                                   TextColor="#991B1B" LineBreakMode="TailTruncation"/>
                                            <Label Text="{Binding OrderDateTime}" FontSize="12" TextColor="#B91C1C"/>
                                            <Label Text="{Binding CustomerDisplay}" FontSize="11" TextColor="#B91C1C" LineBreakMode="TailTruncation"/>
                                        </VerticalStackLayout>
                                        <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                            <Label Text="{Binding OrderTypeDisplay}" FontSize="12" FontAttributes="Bold" TextColor="#7F1D1D"/>
                                            <Label Text="VOID" FontSize="11" FontAttributes="Bold" TextColor="#DC2626"/>
                                        </HorizontalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding PaymentDisplay}" FontSize="12" FontAttributes="Bold"
                                               TextColor="#7F1D1D" VerticalOptions="Center"/>
                                        <Label Grid.Column="3" Text="{Binding TotalAmount, StringFormat='£{0:F2}'}"
                                               FontSize="17" FontAttributes="Bold" TextColor="#DC2626"
                                               Margin="6,0" VerticalOptions="Center"/>
                                        <Border Grid.Column="4" BackgroundColor="#2563EB" StrokeThickness="0"
                                                WidthRequest="80" HeightRequest="42" VerticalOptions="Center">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnViewOrderClicked"/></Border.GestureRecognizers>
                                            <Label Text="View" TextColor="White" FontSize="13" FontAttributes="Bold"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Fixed footer stays above the taskbar while the results body scrolls. -->
        <Border Grid.Row="2" BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1"
                Padding="{DynamicResource ResponsiveCompactPadding}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12">
                <Button Grid.Column="0" Text="Back" Clicked="OnCancelClicked"
                        BackgroundColor="#E2E8F0" TextColor="#334155" WidthRequest="100"/>
                <Button Grid.Column="2" x:Name="PreviousPageButton" Text="Previous"
                        Clicked="OnPreviousPageClicked" BackgroundColor="#E2E8F0"
                        TextColor="#334155" FontAttributes="Bold" WidthRequest="112"/>
                <Label Grid.Column="3" x:Name="PageNumberLabel" Text="Page 1"
                       FontAttributes="Bold" TextColor="#334155" VerticalOptions="Center"
                       MinimumWidthRequest="70" HorizontalTextAlignment="Center"/>
                <Button Grid.Column="4" x:Name="NextPageButton" Text="Next"
                        Clicked="OnNextPageClicked" BackgroundColor="#2563EB"
                        TextColor="White" FontAttributes="Bold" WidthRequest="112"/>
            </Grid>
        </Border>

    </Grid>
</ContentPage>

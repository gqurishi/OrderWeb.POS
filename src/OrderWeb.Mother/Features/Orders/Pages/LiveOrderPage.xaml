<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:POS_in_NET.Views"
             xmlns:controls="clr-namespace:POS_in_NET.Controls"
             xmlns:sharedViews="clr-namespace:OrderWeb.SharedUI.Views;assembly=OrderWeb.SharedUI"
             x:Class="POS_in_NET.Pages.LiveOrderPage"
             Title=""
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*">
        <views:TopBar x:Name="TopBar" Grid.Row="0"/>

        <controls:ToastNotification x:Name="ToastNotification"
                                   Grid.RowSpan="2"
                                   ZIndex="2000"
                                   InputTransparent="True"/>

        <!-- SharedUI Live Order board (Mother look). Host owns data + navigation. -->
        <sharedViews:LiveOrderBoardView x:Name="Board"
                                        Grid.Row="1"/>
    </Grid>
</ContentPage>

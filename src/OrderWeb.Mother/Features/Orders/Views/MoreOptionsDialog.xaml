<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_in_NET.Views.MoreOptionsDialog"
             BackgroundColor="{StaticResource DialogOverlayColor}"
             VerticalOptions="Fill"
             HorizontalOptions="Fill">

    <Grid VerticalOptions="Center"
          HorizontalOptions="Fill"
          Padding="12">
        <Border x:Name="DialogCard" BackgroundColor="White"
                Stroke="{StaticResource DialogShellStrokeColor}"
                StrokeThickness="1"
                Padding="30"
               MaximumWidthRequest="650"
               MaximumHeightRequest="760"
               Margin="16"
                HorizontalOptions="Fill"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="22"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#0F172A" Opacity="0.16" Radius="20" Offset="0,8"/>
            </Border.Shadow>

            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="18">
                <Border BackgroundColor="{StaticResource DialogPrimaryColor}"
                        Grid.Row="0"
                        Stroke="#FFFFFF"
                        StrokeThickness="2"
                        WidthRequest="74"
                        HeightRequest="74"
                        HorizontalOptions="Center"
                        Margin="0,0,0,4">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="37"/>
                    </Border.StrokeShape>
                    <Label Text="i"
                           FontSize="30"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

                <Label Text="More Options"
                       Grid.Row="1"
                       Style="{StaticResource DialogTitleStyle}"/>

                <ScrollView Grid.Row="2">
                    <Grid x:Name="OptionsGrid"
                          ColumnDefinitions="*,*,*"
                          ColumnSpacing="10"
                          RowSpacing="10"/>
                </ScrollView>

                <Button Text="Cancel"
                        Grid.Row="3"
                        Style="{StaticResource DialogCancelButtonStyle}"
                        Margin="0,8,0,0"
                        Clicked="OnCancelClicked"/>
            </Grid>
        </Border>
    </Grid>
</ContentView>

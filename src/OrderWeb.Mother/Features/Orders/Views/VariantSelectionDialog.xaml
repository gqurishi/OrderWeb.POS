<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="POS_in_NET.Views.VariantSelectionDialog"
             BackgroundColor="{StaticResource DialogOverlayColor}"
             VerticalOptions="Fill"
             HorizontalOptions="Fill">

    <Grid VerticalOptions="Center"
          HorizontalOptions="Center"
          Padding="36">
        <Border BackgroundColor="White"
                Stroke="#DCE3EE"
                StrokeThickness="1"
                Padding="0"
                WidthRequest="520"
                VerticalOptions="Center"
                HorizontalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="22"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#0F172A" Opacity="0.16" Radius="20" Offset="0,8"/>
            </Border.Shadow>

            <VerticalStackLayout Padding="28"
                                 Spacing="18">
                <Border BackgroundColor="#EFF6FF"
                        Stroke="#BFDBFE"
                        StrokeThickness="1"
                        WidthRequest="74"
                        HeightRequest="74"
                        HorizontalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="37"/>
                    </Border.StrokeShape>
                    <Label Text="£"
                           FontSize="34"
                           FontAttributes="Bold"
                           TextColor="#2563EB"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Choose Price Variant"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#0F172A"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>

                    <Label x:Name="ItemNameLabel"
                           Text="Menu item"
                           FontSize="15"
                           TextColor="#64748B"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <Label x:Name="SubtitleLabel"
                       Text="Select one option before adding this item."
                       FontSize="14"
                       TextColor="#64748B"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>

                <Border BackgroundColor="#F8FAFC"
                        Stroke="#E2E8F0"
                        StrokeThickness="1"
                        Padding="10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>

                    <VerticalStackLayout x:Name="VariantsContainer"
                                         Spacing="10"/>
                </Border>

                <Button Text="Cancel"
                        BackgroundColor="#E2E8F0"
                        TextColor="#334155"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="52"
                        FontSize="16"
                        Clicked="OnCancelClicked"/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>

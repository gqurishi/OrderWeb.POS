<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:POS_in_NET.Views"
             xmlns:shared="clr-namespace:OrderWeb.SharedUI.Controls;assembly=OrderWeb.SharedUI"
             x:Class="POS_in_NET.Pages.RiderPage"
             BackgroundColor="#F5F7FB">
    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <views:TopBar x:Name="TopBar" Grid.Row="0"/>

        <Grid Grid.Row="1" Padding="20,16,20,8" ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <VerticalStackLayout Spacing="3">
                <Label Text="Delivery operations" FontSize="24" FontAttributes="Bold" TextColor="#0F172A"/>
                <Label x:Name="BusinessDayLabel" Text="Today · 2:00 AM operational day" FontSize="13" TextColor="#64748B"/>
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Refresh" Clicked="OnRefreshClicked" BackgroundColor="#E2E8F0"
                    TextColor="#0F172A" CornerRadius="10" Padding="22,10" FontAttributes="Bold"/>
        </Grid>

        <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout x:Name="FilterTabs" Padding="20,8,20,14" Spacing="10">
                <Button Text="All" CommandParameter="all" Clicked="OnFilterClicked" StyleClass="RiderFilter"/>
                <Button Text="Kitchen" CommandParameter="kitchen" Clicked="OnFilterClicked" StyleClass="RiderFilter"/>
                <Button Text="Ready" CommandParameter="ready" Clicked="OnFilterClicked" StyleClass="RiderFilter"/>
                <Button Text="Quote" CommandParameter="quote" Clicked="OnFilterClicked" StyleClass="RiderFilter"/>
                <Button Text="Active rider" CommandParameter="active" Clicked="OnFilterClicked" StyleClass="RiderFilter"/>
                <Button Text="Delivered" CommandParameter="delivered" Clicked="OnFilterClicked" StyleClass="RiderFilter"/>
                <Button Text="Problems" CommandParameter="problems" Clicked="OnFilterClicked" StyleClass="RiderFilter"/>
            </HorizontalStackLayout>
        </ScrollView>

        <Grid Grid.Row="3" Padding="20,0,20,18">
            <CollectionView x:Name="RiderOrdersCollection" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="14" VerticalItemSpacing="14"/>
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" Padding="30">
                        <Border WidthRequest="58" HeightRequest="58" BackgroundColor="#E0F2FE" StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="29"/></Border.StrokeShape>
                            <Label Text="✓" FontSize="26" TextColor="#0284C7" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Label Text="No delivery operations" FontSize="20" FontAttributes="Bold" TextColor="#0F172A" HorizontalTextAlignment="Center"/>
                        <Label Text="Committed web and local delivery orders will appear here automatically."
                               FontSize="13" TextColor="#64748B" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" Padding="16">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="11" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Row="0" Spacing="2">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding DisplayOrderNumber}" FontSize="18" FontAttributes="Bold" TextColor="#0F172A"/>
                                        <Border BackgroundColor="#EFF6FF" StrokeThickness="0" Padding="8,3">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                            <Label Text="{Binding SourceDisplay}" FontSize="11" FontAttributes="Bold" TextColor="#1D4ED8"/>
                                        </Border>
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding TimeDisplay}" FontSize="12" TextColor="#64748B"/>
                                </VerticalStackLayout>
                                <Border Grid.Column="1" BackgroundColor="{Binding StatusColor}" StrokeThickness="0" Padding="10,6" VerticalOptions="Start">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                                    <Label Text="{Binding OperationStatusDisplay}" FontSize="11" FontAttributes="Bold" TextColor="White"/>
                                </Border>

                                <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="3">
                                    <Label Text="{Binding CustomerDisplay}" FontSize="15" FontAttributes="Bold" TextColor="#1E293B"/>
                                    <Label Text="{Binding CustomerPhone}" FontSize="13" TextColor="#475569"/>
                                    <Label Text="{Binding CustomerAddress}" FontSize="13" TextColor="#475569" MaxLines="2" LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>

                                <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <Border BackgroundColor="#F8FAFC" StrokeThickness="0" Padding="10,8">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="9"/></Border.StrokeShape>
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="ORDER TOTAL" FontSize="10" FontAttributes="Bold" TextColor="#64748B"/>
                                            <Label Text="{Binding TotalDisplay}" FontSize="16" FontAttributes="Bold" TextColor="#0F172A"/>
                                            <Label Text="{Binding PaymentDisplay}" FontSize="11" TextColor="#475569"/>
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" BackgroundColor="#FFF7ED" StrokeThickness="0" Padding="10,8">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="9"/></Border.StrokeShape>
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="RIDER COLLECTION" FontSize="10" FontAttributes="Bold" TextColor="#9A3412"/>
                                            <Label Text="{Binding CashCollectionDisplay}" FontSize="16" FontAttributes="Bold" TextColor="#C2410C"/>
                                            <Label Text="{Binding QuoteDisplay, StringFormat='Quote: {0}'}" FontSize="11" TextColor="#9A3412"/>
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>

                                <VerticalStackLayout Grid.Row="3" Grid.ColumnSpan="2" Spacing="2" IsVisible="{Binding HasRider}">
                                    <Label Text="RIDER" FontSize="10" FontAttributes="Bold" TextColor="#64748B"/>
                                    <Label Text="{Binding RiderName}" FontSize="13" FontAttributes="Bold" TextColor="#1E293B"/>
                                    <Label Text="{Binding RiderPhone}" FontSize="12" TextColor="#475569"/>
                                </VerticalStackLayout>

                                <Grid Grid.Row="4" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Label Text="{Binding LastError}" FontSize="11" TextColor="#DC2626" VerticalOptions="Center" MaxLines="2"/>
                                    <Button Grid.Column="1" Text="{Binding PrimaryActionText}" Clicked="OnPrimaryActionClicked"
                                            BackgroundColor="#0F766E" TextColor="White" FontAttributes="Bold"
                                            CornerRadius="10" Padding="18,10" IsEnabled="{Binding CanRequestQuote}">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding HasQuote}" Value="True">
                                                <Setter Property="IsEnabled" Value="True"/>
                                                <Setter Property="BackgroundColor" Value="#2563EB"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Text" Value="Please wait…"/>
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <shared:ChefLoaderView x:Name="LoadingIndicator"
                                   Mode="Overlay"
                                   Size="Md"
                                   Message="Cooking up your data…"
                                   DelayMilliseconds="0"
                                   IsLoading="False"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill" />
        </Grid>
    </Grid>

    <ContentPage.Resources>
        <Style Class="RiderFilter" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#E2E8F0"/>
            <Setter Property="TextColor" Value="#334155"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </ContentPage.Resources>
</ContentPage>

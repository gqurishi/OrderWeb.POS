<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="OrderWeb.SharedUI.Themes.OrderWebComponentStyles">
    <!-- Authoritative control styles. Prefer Pos* style keys in new screens. -->

    <Shadow x:Key="PosCardShadow"
            Brush="{StaticResource PosShadowBrush}"
            Offset="0,2"
            Radius="8"
            Opacity="{StaticResource PosShadowOpacity}" />
    <Shadow x:Key="PosDialogShadow"
            Brush="{StaticResource PosShadowBrush}"
            Offset="0,8"
            Radius="20"
            Opacity="{StaticResource PosDialogShadowOpacity}" />

    <Style x:Key="PosCardStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource PosSurface}" />
        <Setter Property="Stroke" Value="{DynamicResource PosBorder}" />
        <Setter Property="StrokeThickness" Value="{StaticResource PosBorderThickness}" />
        <Setter Property="Padding" Value="{StaticResource PosCardPadding}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="{StaticResource PosCornerRadiusLarge}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PosPrimaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource PosPrimary}" />
        <Setter Property="TextColor" Value="{DynamicResource PosTextOnPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource PosFontSemibold}" />
        <Setter Property="FontSize" Value="{StaticResource PosFontSizeButton}" />
        <Setter Property="HeightRequest" Value="{StaticResource PosButtonHeight}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource PosTouchTargetMinimum}" />
        <Setter Property="CornerRadius" Value="{StaticResource PosCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource PosButtonPadding}" />
    </Style>

    <Style x:Key="PosSecondaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource PosSurfaceStrong}" />
        <Setter Property="TextColor" Value="{DynamicResource PosTextStrong}" />
        <Setter Property="FontFamily" Value="{StaticResource PosFontSemibold}" />
        <Setter Property="FontSize" Value="{StaticResource PosFontSizeButton}" />
        <Setter Property="HeightRequest" Value="{StaticResource PosButtonHeight}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource PosTouchTargetMinimum}" />
        <Setter Property="CornerRadius" Value="{StaticResource PosCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource PosButtonPadding}" />
    </Style>

    <Style x:Key="PosSuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource PosPrimaryButtonStyle}">
        <Setter Property="BackgroundColor" Value="{DynamicResource PosSuccessStrong}" />
    </Style>
    <Style x:Key="PosDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PosPrimaryButtonStyle}">
        <Setter Property="BackgroundColor" Value="{DynamicResource PosErrorStrong}" />
    </Style>

    <Style x:Key="PosEntryStyle" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="{DynamicResource PosBackground}" />
        <Setter Property="TextColor" Value="{DynamicResource PosTextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource PosTextPlaceholder}" />
        <Setter Property="FontFamily" Value="{StaticResource PosFontRegular}" />
        <Setter Property="FontSize" Value="{StaticResource PosFontSizeInput}" />
        <Setter Property="HeightRequest" Value="{StaticResource PosInputHeight}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource PosTouchTargetMinimum}" />
    </Style>

    <Style x:Key="PosDialogShellStyle" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource PosSurface}" />
        <Setter Property="Stroke" Value="{DynamicResource PosBorder}" />
        <Setter Property="StrokeThickness" Value="{StaticResource PosBorderThickness}" />
        <Setter Property="Padding" Value="{StaticResource PosDialogPadding}" />
        <Setter Property="Shadow" Value="{StaticResource PosDialogShadow}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="{StaticResource PosDialogCornerRadius}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PosStatusSuccessPanelStyle" TargetType="Border" BasedOn="{StaticResource PosCardStyle}">
        <Setter Property="BackgroundColor" Value="{DynamicResource PosSuccessSoft}" />
        <Setter Property="Stroke" Value="{DynamicResource PosSuccess}" />
    </Style>
    <Style x:Key="PosStatusWarningPanelStyle" TargetType="Border" BasedOn="{StaticResource PosCardStyle}">
        <Setter Property="BackgroundColor" Value="{DynamicResource PosWarningSoft}" />
        <Setter Property="Stroke" Value="{DynamicResource PosWarningBorder}" />
    </Style>
    <Style x:Key="PosStatusErrorPanelStyle" TargetType="Border" BasedOn="{StaticResource PosCardStyle}">
        <Setter Property="BackgroundColor" Value="{DynamicResource PosErrorSoft}" />
        <Setter Property="Stroke" Value="{DynamicResource PosErrorBorder}" />
    </Style>
    <Style x:Key="PosStatusInfoPanelStyle" TargetType="Border" BasedOn="{StaticResource PosCardStyle}">
        <Setter Property="BackgroundColor" Value="{DynamicResource PosInfoSoft}" />
        <Setter Property="Stroke" Value="{DynamicResource PosPrimarySoftBorder}" />
    </Style>

    <Style x:Key="PosStatusSuccessTextStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource PosFontSemibold}" />
        <Setter Property="TextColor" Value="{DynamicResource PosSuccessText}" />
    </Style>
    <Style x:Key="PosStatusWarningTextStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource PosFontSemibold}" />
        <Setter Property="TextColor" Value="{DynamicResource PosWarningText}" />
    </Style>
    <Style x:Key="PosStatusErrorTextStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource PosFontSemibold}" />
        <Setter Property="TextColor" Value="{DynamicResource PosErrorText}" />
    </Style>
</ResourceDictionary>

<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="OrderWeb.SharedUI.Themes.OrderWebTypography">
    <!--
      Authoritative POS typography. Hosts must register the same font aliases
      in MauiProgram (OpenSansRegular / Semibold / Bold).
    -->

    <x:String x:Key="PosFontRegular">OpenSansRegular</x:String>
    <x:String x:Key="PosFontMedium">OpenSansSemibold</x:String>
    <x:String x:Key="PosFontSemibold">OpenSansSemibold</x:String>
    <x:String x:Key="PosFontBold">OpenSansBold</x:String>

    <!-- Font sizes -->
    <x:Double x:Key="PosFontSizeCaption">12</x:Double>
    <x:Double x:Key="PosFontSizeSmall">13</x:Double>
    <x:Double x:Key="PosFontSizeBody">15</x:Double>
    <x:Double x:Key="PosFontSizeBodyLarge">16</x:Double>
    <x:Double x:Key="PosFontSizeInput">16</x:Double>
    <x:Double x:Key="PosFontSizeButton">16</x:Double>
    <x:Double x:Key="PosFontSizeButtonLarge">18</x:Double>
    <x:Double x:Key="PosFontSizeCardTitle">18</x:Double>
    <x:Double x:Key="PosFontSizeSectionTitle">22</x:Double>
    <x:Double x:Key="PosFontSizeDialogTitle">22</x:Double>
    <x:Double x:Key="PosFontSizePageTitle">32</x:Double>
    <x:Double x:Key="PosFontSizeDisplayTitle">38</x:Double>

    <!-- Semantic text styles -->
    <Style x:Key="PosBodyTextStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource PosFontRegular}" />
        <Setter Property="FontSize" Value="{StaticResource PosFontSizeBody}" />
        <Setter Property="TextColor" Value="{DynamicResource PosTextSecondary}" />
    </Style>
    <Style x:Key="PosCaptionTextStyle" TargetType="Label" BasedOn="{StaticResource PosBodyTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource PosFontSizeCaption}" />
        <Setter Property="TextColor" Value="{DynamicResource PosTextMuted}" />
    </Style>
    <Style x:Key="PosCardTitleStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource PosFontSemibold}" />
        <Setter Property="FontSize" Value="{StaticResource PosFontSizeCardTitle}" />
        <Setter Property="TextColor" Value="{DynamicResource PosTextPrimary}" />
    </Style>
    <Style x:Key="PosSectionTitleStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource PosFontSemibold}" />
        <Setter Property="FontSize" Value="{StaticResource PosFontSizeSectionTitle}" />
        <Setter Property="TextColor" Value="{DynamicResource PosTextPrimary}" />
    </Style>
    <Style x:Key="PosPageTitleStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource PosFontSemibold}" />
        <Setter Property="FontSize" Value="{StaticResource PosFontSizePageTitle}" />
        <Setter Property="TextColor" Value="{DynamicResource PosTextPrimary}" />
    </Style>
    <Style x:Key="PosDialogTitleStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource PosFontBold}" />
        <Setter Property="FontSize" Value="{StaticResource PosFontSizeDialogTitle}" />
        <Setter Property="TextColor" Value="{DynamicResource PosTextStrong}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>
</ResourceDictionary>

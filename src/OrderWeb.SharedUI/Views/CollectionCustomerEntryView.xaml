<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OrderWeb.SharedUI.Views.CollectionCustomerEntryView">

    <!-- Exact Mother CollectionCustomerModal / Client CollectionOrderPage layout (px, spacing, colors). -->
    <Grid>
    <Grid Padding="44" RowDefinitions="Auto,*,Auto">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FBFCFE" Offset="0" />
                <GradientStop Color="#F3F6FA" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0"
                             Spacing="12"
                             HorizontalOptions="Center"
                             Margin="0,24,0,34">
            <Label Text="Collection Order"
                   FontFamily="OpenSansSemibold"
                   FontAttributes="Bold"
                   FontSize="40"
                   HorizontalOptions="Center"
                   TextColor="#111827" />
            <Label Text="Customer Information"
                   FontFamily="OpenSansSemibold"
                   FontSize="17"
                   HorizontalOptions="Center"
                   TextColor="#64748B" />
            <BoxView HeightRequest="3"
                     WidthRequest="66"
                     BackgroundColor="#10B981"
                     HorizontalOptions="Center"
                     CornerRadius="2" />
        </VerticalStackLayout>

        <!-- Simple customer form -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="26"
                                 WidthRequest="560"
                                 HorizontalOptions="Center">

                <VerticalStackLayout Spacing="10">
                    <Label Text="Customer Name"
                           FontFamily="OpenSansSemibold"
                           FontAttributes="Bold"
                           FontSize="15"
                           TextColor="#475569" />
                    <Border BackgroundColor="White"
                            Stroke="#CBD5E1"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14"
                            Padding="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCustomerNameFieldTapped" />
                        </Border.GestureRecognizers>
                        <Entry x:Name="CustomerNameEntry"
                               Placeholder="e.g., John Smith"
                               FontFamily="OpenSansRegular"
                               FontSize="16"
                               TextColor="#111827"
                               PlaceholderColor="#94A3B8"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="Never"
                               IsReadOnly="True"
                               InputTransparent="True"
                               HeightRequest="58"
                               Margin="18,0" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Phone Number"
                           FontFamily="OpenSansSemibold"
                           FontAttributes="Bold"
                           FontSize="15"
                           TextColor="#475569" />
                    <Border BackgroundColor="White"
                            Stroke="#CBD5E1"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14"
                            Padding="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPhoneNumberFieldTapped" />
                        </Border.GestureRecognizers>
                        <Entry x:Name="PhoneNumberEntry"
                               Placeholder="e.g., 07123 456789"
                               Keyboard="Telephone"
                               FontFamily="OpenSansRegular"
                               FontSize="16"
                               TextColor="#111827"
                               PlaceholderColor="#94A3B8"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="Never"
                               IsReadOnly="True"
                               InputTransparent="True"
                               HeightRequest="58"
                               Margin="18,0" />
                    </Border>
                </VerticalStackLayout>

                <!-- Optional advance collection date / time -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Collection date / time (optional)"
                           FontFamily="OpenSansSemibold"
                           FontAttributes="Bold"
                           FontSize="15"
                           TextColor="#475569" />
                    <Label Text="Leave blank for ASAP. If you set one, you will be asked for the other."
                           FontFamily="OpenSansRegular"
                           FontSize="13"
                           TextColor="#64748B"
                           LineBreakMode="WordWrap" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Date"
                                   FontFamily="OpenSansSemibold"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   TextColor="#334155" />
                            <Border BackgroundColor="White"
                                    Stroke="#CBD5E1"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="18,0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDateFieldTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" HeightRequest="58">
                                    <Label x:Name="DateDisplayLabel"
                                           Text="ASAP"
                                           FontSize="16"
                                           TextColor="#94A3B8"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="Set"
                                           FontFamily="OpenSansSemibold"
                                           FontAttributes="Bold"
                                           FontSize="13"
                                           TextColor="#10B981"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="8">
                            <Label Text="Time"
                                   FontFamily="OpenSansSemibold"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   TextColor="#334155" />
                            <Border BackgroundColor="White"
                                    Stroke="#CBD5E1"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="18,0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTimeFieldTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" HeightRequest="58">
                                    <Label x:Name="TimeDisplayLabel"
                                           Text="ASAP"
                                           FontSize="16"
                                           TextColor="#94A3B8"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="Set"
                                           FontFamily="OpenSansSemibold"
                                           FontAttributes="Bold"
                                           FontSize="13"
                                           TextColor="#10B981"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                    <Button x:Name="ClearScheduleButton"
                            Text="Clear date &amp; time (ASAP)"
                            IsVisible="False"
                            BackgroundColor="Transparent"
                            TextColor="#64748B"
                            FontSize="14"
                            HeightRequest="40"
                            Padding="0"
                            HorizontalOptions="Start"
                            Clicked="OnClearScheduleClicked" />
                </VerticalStackLayout>

                <Button x:Name="SearchButton"
                        Text="Search Existing Customer"
                        Clicked="OnSearchClicked"
                        BackgroundColor="#3B82F6"
                        TextColor="White"
                        FontFamily="OpenSansSemibold"
                        FontAttributes="Bold"
                        FontSize="16"
                        HeightRequest="58"
                        CornerRadius="14">
                    <Button.Shadow>
                        <Shadow Brush="#2563EB" Opacity="0.22" Radius="12" Offset="0,6" />
                    </Button.Shadow>
                </Button>

                <Label x:Name="NoResultsLabel"
                       Text="No existing customer found. You can continue to create a new collection customer."
                       IsVisible="False"
                       FontFamily="OpenSansRegular"
                       FontSize="14"
                       TextColor="#64748B"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap" />

                <Border x:Name="SearchResultsBorder"
                        IsVisible="False"
                        BackgroundColor="White"
                        Stroke="#D8E1EC"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="0">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="Select Existing Customer"
                               FontFamily="OpenSansSemibold"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="#334155"
                               Padding="16,14,16,10" />

                        <CollectionView x:Name="SearchResultsCollection"
                                        SelectionMode="Single"
                                        SelectionChanged="OnCustomerSelected"
                                        MaximumHeightRequest="240">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="16,12"
                                          ColumnDefinitions="*,Auto"
                                          BackgroundColor="White">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="{Binding Name}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="15"
                                                   TextColor="#111827" />
                                            <Label Text="{Binding Phone}"
                                                   FontFamily="OpenSansRegular"
                                                   FontSize="13"
                                                   TextColor="#64748B" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1"
                                                Text="Use"
                                                Clicked="OnCustomerTapped"
                                                BackgroundColor="#ECFDF5"
                                                TextColor="#047857"
                                                FontFamily="OpenSansSemibold"
                                                FontSize="13"
                                                HeightRequest="38"
                                                WidthRequest="72"
                                                CornerRadius="14"
                                                VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <Label x:Name="StatusLabel"
                       Text=""
                       IsVisible="False"
                       FontFamily="OpenSansRegular"
                       FontSize="14"
                       TextColor="#64748B"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom actions -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,*"
              ColumnSpacing="18"
              WidthRequest="560"
              HorizontalOptions="Center"
              Margin="0,26,0,16">
            <Button x:Name="CancelButton"
                    Text="Cancel"
                    Clicked="OnCancelClicked"
                    BackgroundColor="White"
                    BorderColor="#CBD5E1"
                    BorderWidth="1"
                    TextColor="#334155"
                    FontFamily="OpenSansRegular"
                    FontSize="16"
                    HeightRequest="58"
                    CornerRadius="14" />

            <Button x:Name="ContinueButton"
                    Grid.Column="1"
                    Text="Continue to Order"
                    Clicked="OnContinueClicked"
                    BackgroundColor="#10B981"
                    TextColor="White"
                    FontFamily="OpenSansSemibold"
                    FontAttributes="Bold"
                    FontSize="16"
                    HeightRequest="58"
                    CornerRadius="14">
                <Button.Shadow>
                    <Shadow Brush="#059669" Opacity="0.2" Radius="12" Offset="0,6" />
                </Button.Shadow>
            </Button>
        </Grid>
    </Grid>

        <!-- Date / time picker overlay -->
        <Grid x:Name="PickerOverlay"
              IsVisible="False"
              InputTransparent="True"
              BackgroundColor="#660F172A"
              ZIndex="20">
            <Border BackgroundColor="White"
                    Stroke="#CBD5E1"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    WidthRequest="430"
                    Padding="18"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="#0F172A" Opacity="0.18" Radius="18" Offset="0,8" />
                </Border.Shadow>

                <Grid>
                    <Grid x:Name="DatePickerPanel"
                          RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="14"
                          IsVisible="False">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                            <Button Text="‹"
                                    Style="{x:Null}"
                                    WidthRequest="42"
                                    HeightRequest="38"
                                    MinimumWidthRequest="42"
                                    MinimumHeightRequest="38"
                                    CornerRadius="12"
                                    BackgroundColor="#F1F5F9"
                                    TextColor="#0F172A"
                                    FontSize="18"
                                    Padding="0"
                                    Clicked="OnPreviousMonthClicked" />
                            <Label x:Name="PickerMonthLabel"
                                   Grid.Column="1"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A"
                                   HorizontalTextAlignment="Center"
                                   VerticalOptions="Center" />
                            <Button Grid.Column="2"
                                    Text="›"
                                    Style="{x:Null}"
                                    WidthRequest="42"
                                    HeightRequest="38"
                                    MinimumWidthRequest="42"
                                    MinimumHeightRequest="38"
                                    CornerRadius="12"
                                    BackgroundColor="#ECFDF5"
                                    TextColor="#065F46"
                                    FontSize="18"
                                    Padding="0"
                                    Clicked="OnNextMonthClicked" />
                            <Button Grid.Column="3"
                                    Text="X"
                                    Style="{x:Null}"
                                    WidthRequest="38"
                                    HeightRequest="38"
                                    MinimumWidthRequest="38"
                                    MinimumHeightRequest="38"
                                    CornerRadius="19"
                                    BackgroundColor="#FEE2E2"
                                    TextColor="#DC2626"
                                    FontSize="16"
                                    Padding="0"
                                    Clicked="OnPickerCancelClicked" />
                        </Grid>

                        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*,*,*">
                            <Label Text="Mon" FontSize="12" FontAttributes="Bold" TextColor="#64748B" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="1" Text="Tue" FontSize="12" FontAttributes="Bold" TextColor="#64748B" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="2" Text="Wed" FontSize="12" FontAttributes="Bold" TextColor="#64748B" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="3" Text="Thu" FontSize="12" FontAttributes="Bold" TextColor="#64748B" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="4" Text="Fri" FontSize="12" FontAttributes="Bold" TextColor="#64748B" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="5" Text="Sat" FontSize="12" FontAttributes="Bold" TextColor="#64748B" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="6" Text="Sun" FontSize="12" FontAttributes="Bold" TextColor="#64748B" HorizontalTextAlignment="Center" />
                        </Grid>

                        <Grid x:Name="CalendarDaysGrid"
                              Grid.Row="2"
                              ColumnDefinitions="*,*,*,*,*,*,*"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                              ColumnSpacing="6"
                              RowSpacing="6" />
                    </Grid>

                    <Grid x:Name="TimePickerPanel"
                          RowDefinitions="Auto,Auto,Auto,Auto"
                          RowSpacing="14"
                          IsVisible="False">
                        <Label Text="Choose collection time"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#0F172A"
                               HorizontalTextAlignment="Center" />
                        <Border Grid.Row="1"
                                BackgroundColor="#ECFDF5"
                                Stroke="#A7F3D0"
                                StrokeShape="RoundRectangle 16"
                                Padding="16,12">
                            <Label x:Name="PickerTimePreviewLabel"
                                   FontSize="30"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A"
                                   HorizontalTextAlignment="Center" />
                        </Border>
                        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Hour"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#64748B"
                                       HorizontalTextAlignment="Center" />
                                <Border BackgroundColor="#F8FAFC"
                                        Stroke="#E2E8F0"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="6">
                                    <ScrollView HeightRequest="180">
                                        <VerticalStackLayout x:Name="HourOptionsStack" Spacing="6" />
                                    </ScrollView>
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="Minute"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#64748B"
                                       HorizontalTextAlignment="Center" />
                                <Border BackgroundColor="#F8FAFC"
                                        Stroke="#E2E8F0"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="6">
                                    <ScrollView HeightRequest="180">
                                        <VerticalStackLayout x:Name="MinuteOptionsStack" Spacing="6" />
                                    </ScrollView>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                        <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Button Text="Cancel"
                                    Style="{x:Null}"
                                    HeightRequest="46"
                                    MinimumHeightRequest="46"
                                    CornerRadius="12"
                                    BackgroundColor="#F1F5F9"
                                    TextColor="#64748B"
                                    FontSize="15"
                                    Padding="0"
                                    Clicked="OnPickerCancelClicked" />
                            <Button Grid.Column="1"
                                    Text="Use Time"
                                    Style="{x:Null}"
                                    HeightRequest="46"
                                    MinimumHeightRequest="46"
                                    CornerRadius="12"
                                    FontAttributes="Bold"
                                    FontSize="15"
                                    BackgroundColor="#10B981"
                                    TextColor="White"
                                    Padding="0"
                                    Clicked="OnPickerDoneClicked" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentView>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:OrderWeb.SharedUI.Controls;assembly=OrderWeb.SharedUI"
             x:Class="OrderWeb.SharedUI.Views.ReservationView">

    <Grid x:Name="RootLayout"
          BackgroundColor="{DynamicResource OwBackground}"
          VerticalOptions="Fill"
          HorizontalOptions="Fill">

        <Grid x:Name="MainLayoutGrid"
              Padding="12,8,12,10"
              ColumnDefinitions="348,*"
              ColumnSpacing="10"
              VerticalOptions="Fill"
              HorizontalOptions="Fill">

            <!-- Actions, counts, calendar. Extra space sits under the calendar. -->
            <Grid Grid.Column="0"
                  RowDefinitions="Auto,Auto,Auto,*"
                  RowSpacing="8"
                  VerticalOptions="Fill">
                <Grid Grid.Row="0"
                      ColumnDefinitions="*,*"
                      ColumnSpacing="8">
                    <Button Text="Refresh"
                            Style="{x:Null}"
                            BackgroundColor="{DynamicResource OwPrimarySoft}"
                            TextColor="{DynamicResource OwInfoText}"
                            FontAttributes="Bold"
                            FontSize="14"
                            CornerRadius="10"
                            HeightRequest="42"
                            MinimumHeightRequest="42"
                            MinimumWidthRequest="0"
                            Padding="0"
                            HorizontalOptions="Fill"
                            Clicked="OnUpdateClicked" />
                    <Button Grid.Column="1"
                            Text="New booking"
                            Style="{x:Null}"
                            BackgroundColor="{DynamicResource OwPrimary}"
                            TextColor="{DynamicResource OwTextOnPrimary}"
                            FontAttributes="Bold"
                            FontSize="14"
                            CornerRadius="10"
                            HeightRequest="42"
                            MinimumHeightRequest="42"
                            MinimumWidthRequest="0"
                            Padding="0"
                            HorizontalOptions="Fill"
                            Clicked="OnNewReservationClicked" />
                </Grid>
                <Grid Grid.Row="1"
                      ColumnDefinitions="*,*"
                      ColumnSpacing="8"
                      HeightRequest="48">
                    <Border BackgroundColor="{DynamicResource OwSurface}"
                            Stroke="{DynamicResource OwBorder}"
                            StrokeThickness="1"
                            Padding="10,4"
                            VerticalOptions="Fill"
                            StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="0"
                                             VerticalOptions="Center">
                            <Label Text="BOOKINGS TODAY"
                                   FontSize="9"
                                   FontAttributes="Bold"
                                   CharacterSpacing="0.5"
                                   TextColor="{DynamicResource OwTextMuted}" />
                            <Label Text="{Binding TodayCountText}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource OwTextStrong}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1"
                            BackgroundColor="{DynamicResource OwSurface}"
                            Stroke="{DynamicResource OwBorder}"
                            StrokeThickness="1"
                            Padding="10,4"
                            VerticalOptions="Fill"
                            StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="0"
                                             VerticalOptions="Center">
                            <Label Text="GUESTS TODAY"
                                   FontSize="9"
                                   FontAttributes="Bold"
                                   CharacterSpacing="0.5"
                                   TextColor="{DynamicResource OwTextMuted}" />
                            <Label Text="{Binding GuestCountText}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource OwSuccessStrong}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

            <Border Grid.Row="2"
                    BackgroundColor="{DynamicResource OwSurface}"
                    Stroke="{DynamicResource OwBorder}"
                    StrokeThickness="1"
                    Padding="10"
                    StrokeShape="RoundRectangle 12"
                    VerticalOptions="Start">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                        <Button Text="Prev"
                                Style="{x:Null}"
                                WidthRequest="52"
                                HeightRequest="30"
                                MinimumHeightRequest="30"
                                MinimumWidthRequest="52"
                                BackgroundColor="{DynamicResource OwSurfaceMuted}"
                                TextColor="{DynamicResource OwTextStrong}"
                                FontAttributes="Bold"
                                FontSize="12"
                                CornerRadius="8"
                                Padding="0"
                                Clicked="OnPreviousMonthClicked" />
                        <Label Grid.Column="1"
                               Text="{Binding CalendarMonthText}"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource OwTextStrong}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        <Button Grid.Column="2"
                                Text="Next"
                                Style="{x:Null}"
                                WidthRequest="52"
                                HeightRequest="30"
                                MinimumHeightRequest="30"
                                MinimumWidthRequest="52"
                                BackgroundColor="{DynamicResource OwSuccessSoft}"
                                TextColor="{DynamicResource OwSuccessText}"
                                FontAttributes="Bold"
                                FontSize="12"
                                CornerRadius="8"
                                Padding="0"
                                Clicked="OnNextMonthClicked" />
                    </Grid>

                    <Button Text="Jump to today"
                            Style="{x:Null}"
                            BackgroundColor="{DynamicResource OwPrimarySoft}"
                            TextColor="{DynamicResource OwPrimary}"
                            FontAttributes="Bold"
                            FontSize="12"
                            CornerRadius="8"
                            HeightRequest="30"
                            MinimumHeightRequest="30"
                            MinimumWidthRequest="0"
                            Padding="0"
                            Clicked="OnTodayClicked" />

                    <Grid ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="2">
                        <Label Text="Mo" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource OwTextMuted}" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="1" Text="Tu" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource OwTextMuted}" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="2" Text="We" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource OwTextMuted}" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="3" Text="Th" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource OwTextMuted}" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="4" Text="Fr" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource OwTextMuted}" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="5" Text="Sa" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource OwTextMuted}" HorizontalTextAlignment="Center" />
                        <Label Grid.Column="6" Text="Su" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource OwTextMuted}" HorizontalTextAlignment="Center" />
                    </Grid>

                    <CollectionView x:Name="CalendarCollectionView"
                                    ItemsSource="{Binding CalendarDays}"
                                    SelectionMode="Single"
                                    SelectionChanged="OnCalendarDaySelected"
                                    HeightRequest="296"
                                    ItemSizingStrategy="MeasureFirstItem">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical"
                                             Span="7"
                                             HorizontalItemSpacing="4"
                                             VerticalItemSpacing="4" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{Binding BackgroundColor}"
                                        Stroke="{Binding BorderColor}"
                                        StrokeThickness="{Binding StrokeThickness}"
                                        Padding="2"
                                        HeightRequest="46"
                                        InputTransparent="{Binding IsPlaceholder}"
                                        StrokeShape="RoundRectangle 12">
                                    <VerticalStackLayout Spacing="2"
                                                         HorizontalOptions="Center"
                                                         VerticalOptions="Center"
                                                         InputTransparent="{Binding IsPlaceholder}">
                                        <Label Text="{Binding DayText}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{Binding TextColor}"
                                               HorizontalTextAlignment="Center" />
                                        <BoxView WidthRequest="5"
                                                 HeightRequest="5"
                                                 CornerRadius="2.5"
                                                 Color="{Binding DotColor}"
                                                 IsVisible="{Binding HasBookings}"
                                                 HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>
            </Grid>

            <!-- Booking list fills the right from the top. -->
            <Grid Grid.Column="1"
                  RowDefinitions="Auto,*"
                  RowSpacing="6"
                  VerticalOptions="Fill"
                  HorizontalOptions="Fill">

                <Border Grid.Row="0"
                        BackgroundColor="{DynamicResource OwSurface}"
                        Stroke="{DynamicResource OwBorder}"
                        StrokeThickness="1"
                        Padding="10,6"
                        StrokeShape="RoundRectangle 10">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="0"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding SelectedDateDisplay}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource OwTextStrong}" />
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding SyncStatusText}"
                                           FontSize="11"
                                           TextColor="{DynamicResource OwTextMuted}" />
                                    <Label Text="{Binding LastUpdatedText}"
                                           FontSize="11"
                                           TextColor="{DynamicResource OwTextPlaceholder}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <shared:ChefLoaderView Grid.Column="1"
                                                   Mode="Inline"
                                                   Size="Sm"
                                                   Message=""
                                                   DelayMilliseconds="0"
                                                   IsLoading="{Binding IsLoading}"
                                                   VerticalOptions="Center" />
                            <Button Grid.Column="2"
                                    Text="Today"
                                    Style="{x:Null}"
                                    BackgroundColor="{DynamicResource OwSurfaceMuted}"
                                    TextColor="{DynamicResource OwTextStrong}"
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    CornerRadius="8"
                                    HeightRequest="28"
                                    MinimumHeightRequest="28"
                                    MinimumWidthRequest="64"
                                    WidthRequest="64"
                                    Padding="0"
                                    Clicked="OnTodayClicked" />
                        </Grid>

                        <Border Grid.Row="1"
                                BackgroundColor="{DynamicResource OwBackground}"
                                Stroke="{DynamicResource OwInputBorder}"
                                StrokeThickness="1"
                                Padding="10,0"
                                HeightRequest="32"
                                StrokeShape="RoundRectangle 8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSearchBoxTapped" />
                            </Border.GestureRecognizers>
                            <Entry x:Name="SearchEntry"
                                   Placeholder="Search by name or phone"
                                   BackgroundColor="Transparent"
                                   TextColor="{DynamicResource OwTextPrimary}"
                                   PlaceholderColor="{DynamicResource OwTextPlaceholder}"
                                   FontSize="13"
                                   HeightRequest="32"
                                   VerticalOptions="Center"
                                   Keyboard="Text"
                                   TextChanged="OnSearchTextChanged" />
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        BackgroundColor="{DynamicResource OwSurface}"
                        Stroke="{DynamicResource OwBorder}"
                        StrokeThickness="1"
                        Padding="6"
                        StrokeShape="RoundRectangle 16"
                        VerticalOptions="Fill"
                        HorizontalOptions="Fill">
                    <CollectionView x:Name="BookingListCollectionView"
                                    ItemsSource="{Binding Reservations}"
                                    SelectionMode="None"
                                    ItemSizingStrategy="MeasureAllItems"
                                    VerticalOptions="Fill"
                                    HorizontalOptions="Fill"
                                    VerticalScrollBarVisibility="Default">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical"
                                               ItemSpacing="0" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="36"
                                                 Spacing="10"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="Center">
                                <Label Text="No reservations for this date"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource OwTextStrong}"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="Synced website bookings and walk-ins will appear here."
                                       FontSize="14"
                                       TextColor="{DynamicResource OwTextMuted}"
                                       HorizontalTextAlignment="Center" />
                                <Button Text="Refresh bookings"
                                        Margin="0,8,0,0"
                                        BackgroundColor="{DynamicResource OwPrimarySoft}"
                                        TextColor="{DynamicResource OwInfoText}"
                                        FontAttributes="Bold"
                                        CornerRadius="12"
                                        HeightRequest="44"
                                        WidthRequest="180"
                                        Clicked="OnUpdateClicked" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="2,2"
                                        BackgroundColor="{DynamicResource OwBackground}"
                                        Stroke="{DynamicResource OwBorder}"
                                        StrokeThickness="1"
                                        Padding="8"
                                        StrokeShape="RoundRectangle 12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnReservationRowTapped" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="64,*,Auto"
                                          ColumnSpacing="8">
                                        <Border BackgroundColor="{DynamicResource OwPrimarySoft}"
                                                Stroke="{DynamicResource OwPrimarySoftBorder}"
                                                StrokeThickness="1"
                                                Padding="4"
                                                HeightRequest="48"
                                                StrokeShape="RoundRectangle 10"
                                                VerticalOptions="Center">
                                            <VerticalStackLayout Spacing="0"
                                                                 HorizontalOptions="Center"
                                                                 VerticalOptions="Center">
                                                <Label Text="{Binding TimeText}"
                                                       FontSize="15"
                                                       FontAttributes="Bold"
                                                       TextColor="{DynamicResource OwPrimary}"
                                                       HorizontalTextAlignment="Center" />
                                                <Label Text="{Binding SourceDisplay}"
                                                       FontSize="9"
                                                       FontAttributes="Bold"
                                                       TextColor="{DynamicResource OwTextMuted}"
                                                       HorizontalTextAlignment="Center"
                                                       LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1"
                                                             Spacing="4"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding Name}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{DynamicResource OwTextStrong}"
                                                   LineBreakMode="TailTruncation" />
                                            <FlexLayout Wrap="Wrap"
                                                        Direction="Row"
                                                        AlignItems="Start"
                                                        JustifyContent="Start">
                                                <Border BackgroundColor="{DynamicResource OwSuccessSoft}"
                                                        Stroke="#A7F3D0"
                                                        StrokeThickness="1"
                                                        Padding="6,2"
                                                        Margin="0,0,4,2"
                                                        StrokeShape="RoundRectangle 6">
                                                    <Label Text="{Binding GuestsText}"
                                                           FontSize="10"
                                                           FontAttributes="Bold"
                                                           TextColor="{DynamicResource OwSuccessText}" />
                                                </Border>
                                                <Border BackgroundColor="{DynamicResource OwPrimarySoft}"
                                                        Stroke="{DynamicResource OwPrimarySoftBorder}"
                                                        StrokeThickness="1"
                                                        Padding="6,2"
                                                        Margin="0,0,4,2"
                                                        StrokeShape="RoundRectangle 6">
                                                    <Label Text="{Binding TableDisplay}"
                                                           FontSize="10"
                                                           FontAttributes="Bold"
                                                           TextColor="{DynamicResource OwInfoText}" />
                                                </Border>
                                                <Border BackgroundColor="{DynamicResource OwSurface}"
                                                        Stroke="{DynamicResource OwBorder}"
                                                        StrokeThickness="1"
                                                        Padding="6,2"
                                                        Margin="0,0,4,2"
                                                        StrokeShape="RoundRectangle 6">
                                                    <Label Text="{Binding PhoneDisplay}"
                                                           FontSize="10"
                                                           TextColor="{DynamicResource OwTextSecondary}"
                                                           LineBreakMode="TailTruncation" />
                                                </Border>
                                                <Border BackgroundColor="{DynamicResource OwPrimarySoft}"
                                                        Stroke="{DynamicResource OwPrimarySoftBorder}"
                                                        StrokeThickness="1"
                                                        Padding="6,2"
                                                        Margin="0,0,4,2"
                                                        StrokeShape="RoundRectangle 6"
                                                        IsVisible="{Binding HasPromoCode}">
                                                    <Label Text="{Binding PromoBadgeText}"
                                                           FontSize="10"
                                                           FontAttributes="Bold"
                                                           TextColor="{DynamicResource OwPrimary}" />
                                                </Border>
                                                <Border BackgroundColor="{DynamicResource OwWarningSoft}"
                                                        Stroke="{DynamicResource OwWarningBorder}"
                                                        StrokeThickness="1"
                                                        Padding="6,2"
                                                        Margin="0,0,4,2"
                                                        StrokeShape="RoundRectangle 6"
                                                        IsVisible="{Binding HasAllergies}">
                                                    <Label Text="Dietary"
                                                           FontSize="9"
                                                           FontAttributes="Bold"
                                                           TextColor="{DynamicResource OwWarningText}" />
                                                </Border>
                                                <Border BackgroundColor="{DynamicResource OwSuccessSoft}"
                                                        Stroke="#A7F3D0"
                                                        StrokeThickness="1"
                                                        Padding="6,2"
                                                        Margin="0,0,4,2"
                                                        StrokeShape="RoundRectangle 6"
                                                        IsVisible="{Binding HasSpecialRequests}">
                                                    <Label Text="Requests"
                                                           FontSize="9"
                                                           FontAttributes="Bold"
                                                           TextColor="{DynamicResource OwSuccessText}" />
                                                </Border>
                                            </FlexLayout>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="2"
                                                             Spacing="4"
                                                             HorizontalOptions="End"
                                                             VerticalOptions="Center">
                                            <Border BackgroundColor="{Binding StatusBadgeBackground}"
                                                    Stroke="{Binding StatusBadgeBorder}"
                                                    StrokeThickness="1"
                                                    Padding="8,3"
                                                    HorizontalOptions="End"
                                                    StrokeShape="RoundRectangle 6">
                                                <Label Text="{Binding Status}"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       TextColor="{Binding StatusBadgeTextColor}"
                                                       HorizontalTextAlignment="Center"
                                                       LineBreakMode="TailTruncation" />
                                            </Border>
                                            <HorizontalStackLayout Spacing="4"
                                                                   HorizontalOptions="End">
                                                <Button Text="{Binding ShowButtonText}"
                                                        BackgroundColor="{Binding ShowButtonBackground}"
                                                        TextColor="{Binding ShowButtonTextColor}"
                                                        BorderColor="{Binding ShowButtonBorderColor}"
                                                        BorderWidth="1"
                                                        FontAttributes="Bold"
                                                        FontSize="11"
                                                        CornerRadius="8"
                                                        HeightRequest="30"
                                                        MinimumHeightRequest="30"
                                                        WidthRequest="64"
                                                        Padding="0"
                                                        IsVisible="{Binding IsShowButtonVisible}"
                                                        IsEnabled="{Binding IsShowButtonEnabled}"
                                                        Clicked="OnReservationShowClicked" />
                                                <Button Text="Details"
                                                        BackgroundColor="{DynamicResource OwPrimarySoft}"
                                                        TextColor="{DynamicResource OwPrimary}"
                                                        BorderColor="{DynamicResource OwPrimarySoftBorder}"
                                                        BorderWidth="1"
                                                        FontAttributes="Bold"
                                                        FontSize="11"
                                                        CornerRadius="8"
                                                        HeightRequest="30"
                                                        MinimumHeightRequest="30"
                                                        WidthRequest="68"
                                                        Padding="0"
                                                        Clicked="OnReservationDetailsClicked" />
                                                <Button Text="{Binding NoShowButtonText}"
                                                        BackgroundColor="{Binding NoShowButtonBackground}"
                                                        TextColor="{Binding NoShowButtonTextColor}"
                                                        BorderColor="{Binding NoShowButtonBorderColor}"
                                                        BorderWidth="1"
                                                        FontAttributes="Bold"
                                                        FontSize="11"
                                                        CornerRadius="8"
                                                        HeightRequest="30"
                                                        MinimumHeightRequest="30"
                                                        WidthRequest="72"
                                                        Padding="0"
                                                        IsVisible="{Binding IsNoShowButtonVisible}"
                                                        IsEnabled="{Binding IsNoShowButtonEnabled}"
                                                        Clicked="OnReservationNoShowClicked" />
                                                <Button Text="{Binding CancelButtonText}"
                                                        BackgroundColor="{Binding CancelButtonBackground}"
                                                        TextColor="{Binding CancelButtonTextColor}"
                                                        BorderColor="{Binding CancelButtonBorderColor}"
                                                        BorderWidth="1"
                                                        FontAttributes="Bold"
                                                        FontSize="11"
                                                        CornerRadius="8"
                                                        HeightRequest="30"
                                                        MinimumHeightRequest="30"
                                                        WidthRequest="70"
                                                        Padding="0"
                                                        IsVisible="{Binding IsCancelButtonVisible}"
                                                        IsEnabled="{Binding IsCancelButtonEnabled}"
                                                        Clicked="OnReservationCancelClicked" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>
            </Grid>
        </Grid>

        <!-- Details overlay -->
        <Grid BackgroundColor="{DynamicResource OwOverlay}"
              IsVisible="{Binding IsDetailsVisible}"
              InputTransparent="False"
              ZIndex="50">
            <Border BackgroundColor="{DynamicResource OwSurface}"
                    Stroke="{DynamicResource OwBorderStrong}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="28"
                    WidthRequest="640"
                    MaximumWidthRequest="720"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                      RowSpacing="16">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Reservation details"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource OwTextStrong}" />
                            <Label Text="{Binding SelectedReservation.DateTimeText}"
                                   FontSize="14"
                                   TextColor="{DynamicResource OwTextMuted}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="Close"
                                BackgroundColor="{DynamicResource OwErrorSoft}"
                                TextColor="{DynamicResource OwErrorStrong}"
                                BorderColor="{DynamicResource OwErrorBorder}"
                                BorderWidth="1"
                                FontAttributes="Bold"
                                FontSize="13"
                                CornerRadius="12"
                                HeightRequest="40"
                                Padding="14,0"
                                Clicked="OnCloseDetailsClicked" />
                    </Grid>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="*,*"
                          ColumnSpacing="12">
                        <Border BackgroundColor="{DynamicResource OwBackground}"
                                Stroke="{DynamicResource OwBorder}"
                                StrokeThickness="1"
                                Padding="16"
                                StrokeShape="RoundRectangle 14">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="GUEST"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       CharacterSpacing="0.6"
                                       TextColor="{DynamicResource OwTextMuted}" />
                                <Label Text="{Binding SelectedReservation.Name}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource OwTextStrong}" />
                                <Label Text="{Binding SelectedReservation.PhoneDisplay}"
                                       FontSize="14"
                                       TextColor="{DynamicResource OwTextSecondary}" />
                                <Label Text="{Binding SelectedReservation.EmailDisplay}"
                                       FontSize="14"
                                       TextColor="{DynamicResource OwTextSecondary}"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1"
                                BackgroundColor="{DynamicResource OwSuccessSoft}"
                                Stroke="#A7F3D0"
                                StrokeThickness="1"
                                Padding="16"
                                StrokeShape="RoundRectangle 14">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="BOOKING"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       CharacterSpacing="0.6"
                                       TextColor="{DynamicResource OwSuccessText}" />
                                <Label Text="{Binding SelectedReservation.GuestsText}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource OwSuccessStrong}" />
                                <Label Text="{Binding SelectedReservation.TableDisplay}"
                                       FontSize="14"
                                       TextColor="{DynamicResource OwTextSecondary}" />
                                <Label Text="{Binding SelectedReservation.StatusDisplay}"
                                       FontSize="14"
                                       TextColor="{DynamicResource OwTextSecondary}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2"
                          ColumnDefinitions="*,*"
                          ColumnSpacing="12">
                        <Border BackgroundColor="{DynamicResource OwPrimarySoft}"
                                Stroke="{DynamicResource OwPrimarySoftBorder}"
                                StrokeThickness="1"
                                Padding="16"
                                StrokeShape="RoundRectangle 14">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="PROMOCODE"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       CharacterSpacing="0.6"
                                       TextColor="{DynamicResource OwInfoText}" />
                                <Label Text="{Binding SelectedReservation.PromoCodeDisplay}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource OwPrimary}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1"
                                BackgroundColor="{DynamicResource OwWarningSoft}"
                                Stroke="{DynamicResource OwWarningBorder}"
                                StrokeThickness="1"
                                Padding="16"
                                StrokeShape="RoundRectangle 14">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="DIETARY NOTES"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       CharacterSpacing="0.6"
                                       TextColor="{DynamicResource OwWarningText}" />
                                <Label Text="{Binding SelectedReservation.AllergiesDisplay}"
                                       FontSize="14"
                                       TextColor="{DynamicResource OwTextStrong}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Border Grid.Row="3"
                            BackgroundColor="{DynamicResource OwBackground}"
                            Stroke="{DynamicResource OwBorder}"
                            StrokeThickness="1"
                            Padding="16"
                            StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="SPECIAL REQUESTS"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   CharacterSpacing="0.6"
                                   TextColor="{DynamicResource OwTextMuted}" />
                            <Label Text="{Binding SelectedReservation.SpecialRequestsDisplay}"
                                   FontSize="14"
                                   TextColor="{DynamicResource OwTextStrong}"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentView>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OrderWeb.SharedUI.Views.DeliveryCustomerEntryView">

    <!-- Exact Mother DeliveryCustomerModal / Client DeliveryOrderPage layout (px, spacing, colors). -->
    <Grid>
    <Grid Padding="16" RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="8" Margin="0,0,0,12">
            <Label Text="Delivery Order"
                   FontFamily="OpenSansSemibold"
                   FontSize="36"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#1A202C" />
            <Label Text="Customer Information"
                   FontFamily="OpenSansSemibold"
                   FontSize="16"
                   HorizontalOptions="Center"
                   TextColor="#718096"
                   Margin="0,5,0,0" />
            <BoxView HeightRequest="3"
                     WidthRequest="60"
                     BackgroundColor="#3B82F6"
                     HorizontalOptions="Center"
                     CornerRadius="2"
                     Margin="0,10,0,0" />
        </VerticalStackLayout>

        <!-- Main Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="14"
                                 HorizontalOptions="Center"
                                 MaximumWidthRequest="550">

                <!-- Customer Name -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="Customer Name"
                           FontFamily="OpenSansSemibold"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#4A5568" />
                    <Border BackgroundColor="White"
                            StrokeThickness="2"
                            Stroke="#E2E8F0"
                            Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCustomerNameFieldTapped" />
                        </Border.GestureRecognizers>
                        <Entry x:Name="CustomerNameEntry"
                               Placeholder="e.g., John Smith"
                               FontSize="16"
                               TextColor="#1A202C"
                               PlaceholderColor="#A0AEC0"
                               BackgroundColor="Transparent"
                               IsReadOnly="True"
                               InputTransparent="True"
                               HeightRequest="56"
                               Margin="16,0" />
                    </Border>
                </VerticalStackLayout>

                <!-- Phone Number -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="Phone Number"
                           FontFamily="OpenSansSemibold"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#4A5568" />
                    <Border BackgroundColor="White"
                            StrokeThickness="2"
                            Stroke="#E2E8F0"
                            Padding="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPhoneNumberFieldTapped" />
                        </Border.GestureRecognizers>
                        <Entry x:Name="PhoneNumberEntry"
                               Placeholder="e.g., 07123 456789"
                               Keyboard="Telephone"
                               FontSize="16"
                               TextColor="#1A202C"
                               PlaceholderColor="#A0AEC0"
                               BackgroundColor="Transparent"
                               IsReadOnly="True"
                               InputTransparent="True"
                               HeightRequest="56"
                               Margin="16,0" />
                    </Border>
                </VerticalStackLayout>

                <!-- Delivery Address -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="Delivery Address"
                           FontFamily="OpenSansSemibold"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#4A5568" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                BackgroundColor="White"
                                StrokeThickness="2"
                                Stroke="#E2E8F0"
                                Padding="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPostcodeFieldTapped" />
                            </Border.GestureRecognizers>
                            <Entry x:Name="PostcodeEntry"
                                   Placeholder="Enter address or postcode..."
                                   FontSize="16"
                                   TextColor="#1A202C"
                                   PlaceholderColor="#A0AEC0"
                                   BackgroundColor="Transparent"
                                   IsReadOnly="True"
                                   InputTransparent="True"
                                   HeightRequest="56"
                                   Margin="16,0" />
                        </Border>

                        <Button Grid.Column="1"
                                x:Name="SearchPostcodeButton"
                                Text="Search"
                                BackgroundColor="#10B981"
                                TextColor="White"
                                FontFamily="OpenSansSemibold"
                                FontSize="15"
                                FontAttributes="Bold"
                                HeightRequest="56"
                                WidthRequest="120"
                                CornerRadius="14"
                                Clicked="OnSearchPostcodeClicked" />
                    </Grid>

                    <Border x:Name="AddressResultsBorder"
                            IsVisible="False"
                            BackgroundColor="White"
                            StrokeThickness="2"
                            Stroke="#E2E8F0"
                            Padding="0"
                            MaximumHeightRequest="240"
                            MinimumHeightRequest="56"
                            Margin="0,8,0,0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <CollectionView x:Name="AddressResultsCollection"
                                        SelectionMode="Single"
                                        SelectionChanged="OnAddressSelected">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16,12"
                                            BackgroundColor="Transparent"
                                            MinimumHeightRequest="52"
                                            Margin="0,0,0,1">
                                        <Label Text="{Binding DisplayText}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="#1A202C"
                                               LineBreakMode="WordWrap" />
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>

                    <VerticalStackLayout Spacing="16" Margin="0,16,0,0">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Flat / House Number"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#1A202C" />
                            <Border BackgroundColor="White"
                                    StrokeThickness="2"
                                    Stroke="#E2E8F0"
                                    Padding="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnHouseNumberFieldTapped" />
                                </Border.GestureRecognizers>
                                <Entry x:Name="HouseNumberEntry"
                                       Placeholder="e.g., Flat 2 or 24A"
                                       FontSize="16"
                                       TextColor="#1A202C"
                                       PlaceholderColor="#A0AEC0"
                                       BackgroundColor="Transparent"
                                       IsReadOnly="True"
                                       InputTransparent="True"
                                       HeightRequest="56"
                                       Margin="16,0" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Road Name"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#1A202C" />
                            <Border BackgroundColor="White"
                                    StrokeThickness="2"
                                    Stroke="#E2E8F0"
                                    Padding="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRoadNameFieldTapped" />
                                </Border.GestureRecognizers>
                                <Entry x:Name="RoadNameEntry"
                                       Placeholder="e.g., High Street"
                                       FontSize="16"
                                       TextColor="#1A202C"
                                       PlaceholderColor="#A0AEC0"
                                       BackgroundColor="Transparent"
                                       IsReadOnly="True"
                                       InputTransparent="True"
                                       HeightRequest="56"
                                       Margin="16,0" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="City"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#1A202C" />
                            <Border BackgroundColor="White"
                                    StrokeThickness="2"
                                    Stroke="#E2E8F0"
                                    Padding="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCityFieldTapped" />
                                </Border.GestureRecognizers>
                                <Entry x:Name="CityEntry"
                                       Placeholder="City"
                                       FontSize="16"
                                       TextColor="#1A202C"
                                       PlaceholderColor="#A0AEC0"
                                       BackgroundColor="Transparent"
                                       IsReadOnly="True"
                                       InputTransparent="True"
                                       HeightRequest="56"
                                       Margin="16,0" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Postcode"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#1A202C" />
                            <Border BackgroundColor="White"
                                    StrokeThickness="2"
                                    Stroke="#E2E8F0"
                                    Padding="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPostcodeResultFieldTapped" />
                                </Border.GestureRecognizers>
                                <Entry x:Name="PostcodeResultEntry"
                                       Placeholder="Postcode"
                                       FontSize="16"
                                       TextColor="#1A202C"
                                       PlaceholderColor="#A0AEC0"
                                       BackgroundColor="Transparent"
                                       IsReadOnly="True"
                                       InputTransparent="True"
                                       HeightRequest="56"
                                       Margin="16,0" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Optional advance delivery date / time -->
                <VerticalStackLayout Spacing="10" Margin="0,8,0,0">
                    <Label Text="Delivery date / time (optional)"
                           FontFamily="OpenSansSemibold"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#4A5568" />
                    <Label Text="Leave blank for ASAP. If you set one, you will be asked for the other."
                           FontSize="13"
                           TextColor="#718096"
                           LineBreakMode="WordWrap" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Date"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#1A202C" />
                            <Border BackgroundColor="White"
                                    StrokeThickness="2"
                                    Stroke="#E2E8F0"
                                    Padding="16,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDateFieldTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" HeightRequest="56">
                                    <Label x:Name="DateDisplayLabel"
                                           Text="ASAP"
                                           FontSize="16"
                                           TextColor="#A0AEC0"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="Set"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#3B82F6"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="8">
                            <Label Text="Time"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#1A202C" />
                            <Border BackgroundColor="White"
                                    StrokeThickness="2"
                                    Stroke="#E2E8F0"
                                    Padding="16,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTimeFieldTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" HeightRequest="56">
                                    <Label x:Name="TimeDisplayLabel"
                                           Text="ASAP"
                                           FontSize="16"
                                           TextColor="#A0AEC0"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Text="Set"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#3B82F6"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                    <Button x:Name="ClearScheduleButton"
                            Text="Clear date &amp; time (ASAP)"
                            IsVisible="False"
                            BackgroundColor="Transparent"
                            TextColor="#64748B"
                            FontSize="14"
                            HeightRequest="40"
                            Padding="0"
                            HorizontalOptions="Start"
                            Clicked="OnClearScheduleClicked" />
                </VerticalStackLayout>

                <Button x:Name="SearchCustomerButton"
                        Text="Search Existing Customer"
                        BackgroundColor="#3B82F6"
                        TextColor="White"
                        FontSize="16"
                        HeightRequest="54"
                        CornerRadius="14"
                        Clicked="OnSearchCustomerClicked"
                        Margin="0,5,0,0">
                    <Button.Shadow>
                        <Shadow Brush="#3B82F6" Radius="8" Opacity="0.3" Offset="0,4" />
                    </Button.Shadow>
                </Button>

                <Border x:Name="SearchResultsBorder"
                        IsVisible="False"
                        BackgroundColor="White"
                        StrokeThickness="2"
                        Stroke="#E2E8F0"
                        Padding="0"
                        MaximumHeightRequest="320"
                        Margin="0,5,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Radius="12" Opacity="0.08" Offset="0,4" />
                    </Border.Shadow>
                    <CollectionView x:Name="SearchResultsCollection"
                                    SelectionMode="Single"
                                    SelectionChanged="OnCustomerSelected">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="18,16"
                                        BackgroundColor="Transparent"
                                        Margin="0,0,0,1">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCustomerTapped" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <VerticalStackLayout Spacing="6">
                                            <Label Text="{Binding Name}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="#1A202C" />
                                            <Label Text="{Binding Phone}"
                                                   FontSize="14"
                                                   TextColor="#718096" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1"
                                               Text="→"
                                               FontSize="22"
                                               TextColor="#3B82F6"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>

                <Border x:Name="NoResultsLabel"
                        IsVisible="False"
                        BackgroundColor="#FEF2F2"
                        StrokeThickness="2"
                        Stroke="#FEE2E2"
                        Padding="20"
                        Margin="0,5,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Label Text="No customers found matching your search"
                           FontSize="15"
                           TextColor="#DC2626"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </Border>

                <Label x:Name="StatusLabel"
                       Text=""
                       IsVisible="False"
                       FontSize="14"
                       TextColor="#718096"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Buttons -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,1.2*"
              ColumnSpacing="16"
              Margin="0,40,0,0"
              HorizontalOptions="Center"
              WidthRequest="550">
            <Button x:Name="CancelButton"
                    Text="Cancel"
                    BackgroundColor="White"
                    TextColor="#64748B"
                    FontSize="16"
                    HeightRequest="56"
                    CornerRadius="14"
                    BorderColor="#E2E8F0"
                    BorderWidth="2"
                    Clicked="OnCancelClicked" />

            <Button x:Name="ContinueButton"
                    Grid.Column="1"
                    Text="Continue to Order"
                    BackgroundColor="#3B82F6"
                    TextColor="White"
                    FontFamily="OpenSansSemibold"
                    FontSize="16"
                    FontAttributes="Bold"
                    HeightRequest="56"
                    CornerRadius="14"
                    Clicked="OnContinueClicked">
                <Button.Shadow>
                    <Shadow Brush="#3B82F6" Radius="10" Opacity="0.35" Offset="0,4" />
                </Button.Shadow>
            </Button>
        </Grid>
    </Grid>

        <!-- Date / time picker overlay (same pattern as reservation booking) -->
        <Grid x:Name="PickerOverlay"
              IsVisible="False"
              InputTransparent="True"
              BackgroundColor="#660F172A"
              ZIndex="20">
            <Border BackgroundColor="White"
                    Stroke="#CBD5E1"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    WidthRequest="430"
                    Padding="18"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="#0F172A" Opacity="0.18" Radius="18" Offset="0,8" />
                </Border.Shadow>

                <Grid>
                    <Grid x:Name="DatePickerPanel"
                          RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="14"
                          IsVisible="False">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                            <Button Text="‹"
                                    Style="{x:Null}"
                                    WidthRequest="42"
                                    HeightRequest="38"
                                    MinimumWidthRequest="42"
                                    MinimumHeightRequest="38"
                                    CornerRadius="12"
                                    BackgroundColor="#F1F5F9"
                                    TextColor="#0F172A"
                                    FontSize="18"
                                    Padding="0"
                                    Clicked="OnPreviousMonthClicked" />
                            <Label x:Name="PickerMonthLabel"
                                   Grid.Column="1"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A"
                                   HorizontalTextAlignment="Center"
                                   VerticalOptions="Center" />
                            <Button Grid.Column="2"
                                    Text="›"
                                    Style="{x:Null}"
                                    WidthRequest="42"
                                    HeightRequest="38"
                                    MinimumWidthRequest="42"
                                    MinimumHeightRequest="38"
                                    CornerRadius="12"
                                    BackgroundColor="#ECFDF5"
                                    TextColor="#065F46"
                                    FontSize="18"
                                    Padding="0"
                                    Clicked="OnNextMonthClicked" />
                            <Button Grid.Column="3"
                                    Text="X"
                                    Style="{x:Null}"
                                    WidthRequest="38"
                                    HeightRequest="38"
                                    MinimumWidthRequest="38"
                                    MinimumHeightRequest="38"
                                    CornerRadius="19"
                                    BackgroundColor="#FEE2E2"
                                    TextColor="#DC2626"
                                    FontSize="16"
                                    Padding="0"
                                    Clicked="OnPickerCancelClicked" />
                        </Grid>

                        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*,*,*">
                            <Label Text="Mon" FontSize="12" FontAttributes="Bold" TextColor="#64748B" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="1" Text="Tue" FontSize="12" FontAttributes="Bold" TextColor="#64748B" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="2" Text="Wed" FontSize="12" FontAttributes="Bold" TextColor="#64748B" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="3" Text="Thu" FontSize="12" FontAttributes="Bold" TextColor="#64748B" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="4" Text="Fri" FontSize="12" FontAttributes="Bold" TextColor="#64748B" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="5" Text="Sat" FontSize="12" FontAttributes="Bold" TextColor="#64748B" HorizontalTextAlignment="Center" />
                            <Label Grid.Column="6" Text="Sun" FontSize="12" FontAttributes="Bold" TextColor="#64748B" HorizontalTextAlignment="Center" />
                        </Grid>

                        <Grid x:Name="CalendarDaysGrid"
                              Grid.Row="2"
                              ColumnDefinitions="*,*,*,*,*,*,*"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                              ColumnSpacing="6"
                              RowSpacing="6" />
                    </Grid>

                    <Grid x:Name="TimePickerPanel"
                          RowDefinitions="Auto,Auto,Auto,Auto"
                          RowSpacing="14"
                          IsVisible="False">
                        <Label Text="Choose delivery time"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#0F172A"
                               HorizontalTextAlignment="Center" />
                        <Border Grid.Row="1"
                                BackgroundColor="#EFF6FF"
                                Stroke="#BFDBFE"
                                StrokeShape="RoundRectangle 16"
                                Padding="16,12">
                            <Label x:Name="PickerTimePreviewLabel"
                                   FontSize="30"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A"
                                   HorizontalTextAlignment="Center" />
                        </Border>
                        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Hour"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#64748B"
                                       HorizontalTextAlignment="Center" />
                                <Border BackgroundColor="#F8FAFC"
                                        Stroke="#E2E8F0"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="6">
                                    <ScrollView HeightRequest="180">
                                        <VerticalStackLayout x:Name="HourOptionsStack" Spacing="6" />
                                    </ScrollView>
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="Minute"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#64748B"
                                       HorizontalTextAlignment="Center" />
                                <Border BackgroundColor="#F8FAFC"
                                        Stroke="#E2E8F0"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="6">
                                    <ScrollView HeightRequest="180">
                                        <VerticalStackLayout x:Name="MinuteOptionsStack" Spacing="6" />
                                    </ScrollView>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                        <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Button Text="Cancel"
                                    Style="{x:Null}"
                                    HeightRequest="46"
                                    MinimumHeightRequest="46"
                                    CornerRadius="12"
                                    BackgroundColor="#F1F5F9"
                                    TextColor="#64748B"
                                    FontSize="15"
                                    Padding="0"
                                    Clicked="OnPickerCancelClicked" />
                            <Button Grid.Column="1"
                                    Text="Use Time"
                                    Style="{x:Null}"
                                    HeightRequest="46"
                                    MinimumHeightRequest="46"
                                    CornerRadius="12"
                                    FontAttributes="Bold"
                                    FontSize="15"
                                    BackgroundColor="#2563EB"
                                    TextColor="White"
                                    Padding="0"
                                    Clicked="OnPickerDoneClicked" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentView>
